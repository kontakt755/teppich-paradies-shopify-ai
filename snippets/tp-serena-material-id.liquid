{%- comment -%}
  Medien-ID des echten Materialfotos der gleichfarbigen Meterware.
  Nur Einfassprodukte mit passender Basisvariante erhalten ein zusaetzliches Bild.
{%- endcomment -%}
{%- if product.template_suffix == 'einfassung' and product.metafields.service.einfass_basis.value != blank -%}
  {%- assign basis = product.metafields.service.einfass_basis.value -%}
  {%- for basis_variant in basis.variants -%}
    {%- if basis_variant.option1 == product.selected_or_first_available_variant.option1 and basis_variant.featured_media != blank -%}
      {{- basis_variant.featured_media.id -}}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
