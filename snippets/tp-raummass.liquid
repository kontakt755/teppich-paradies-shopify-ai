{% doc %}
  Raummass-Helfer auf der Produktseite. Logik: assets/tp-raummass.js.

  art 'rolle' (im Block tp-rollware-rechner): Raumbreite und Raumlaenge
  eingeben, Bestellmass mit Zugabe (empfohlen) oder zentimetergenau ohne
  Zugabe uebernehmen. Befuellt nur die Felder des Rechners.

  art 'paket' (im Block paket-auswahl): Raumliste, die Summe in m² wird in
  das Flaechenfeld uebernommen. Verschnitt und Pakete rechnet die Auswahl.

  Beide in einer Datei, damit das gemeinsame CSS im Scope liegt.

  @param {string} art - 'rolle' oder 'paket'
  @param {string} id - Kennung des umgebenden Blocks
{% enddoc %}
<script src="{{ 'tp-raummass.js' | asset_url }}" defer></script>
{%- if art == 'paket' -%}
<details class="tp-rm tp-rm--paket" data-tp-rm-paket>
  <summary class="tp-rm__summary">
    <span class="tp-rm__summary-text">
      <span class="tp-rm__summary-titel">Fläche aus Raummaßen berechnen</span>
      <span class="tp-rm__summary-sub">Mehrere Räume eintragen, wir zählen die m² zusammen</span>
    </span>
    <span class="tp-rm__summary-aktion"><span class="tp-rm__auf">Öffnen</span><span class="tp-rm__zu">Schließen</span> <span class="tp-rm__pfeil" aria-hidden="true">▾</span></span>
  </summary>
  <div class="tp-rm__inhalt">
    <p class="tp-rm__hilfe">Breite und Länge je Raum in cm oder m (z. B. 350 oder 3,5 m). Ein L-förmiger Raum lässt sich als zwei Rechtecke eintragen.</p>
    <div class="tp-rm__liste" data-rm-liste></div>
    <button type="button" class="tp-rm__add" data-rm-add>+ Weiteren Raum hinzufügen</button>
    <p class="tp-rm__fehler" data-rm-fehler role="alert" hidden></p>
    <div class="tp-rm__summe">
      <span>Gesamtfläche</span>
      <strong data-rm-summe aria-live="polite">–</strong>
    </div>
    <button type="button" class="tp-rm__knopf tp-rm__knopf--primaer" data-rm-uebernehmen disabled>Fläche übernehmen</button>
  </div>
  <template data-rm-zeile-vorlage>
    <div class="tp-rm__zeile" data-rm-zeile>
      <span class="tp-rm__name" data-rm-name></span>
      <div class="tp-rm__feld">
        <label data-rm-for="tp-rm-pb-{{ id }}">Breite</label>
        <input type="text" data-rm-id="tp-rm-pb-{{ id }}" inputmode="decimal" autocomplete="off" placeholder="350" data-rm-b>
      </div>
      <span class="tp-rm__mal" aria-hidden="true">×</span>
      <div class="tp-rm__feld">
        <label data-rm-for="tp-rm-pl-{{ id }}">Länge</label>
        <input type="text" data-rm-id="tp-rm-pl-{{ id }}" inputmode="decimal" autocomplete="off" placeholder="420" data-rm-l>
      </div>
      <button type="button" class="tp-rm__weg" data-rm-weg aria-label="Raum entfernen">×</button>
    </div>
  </template>
</details>
{%- else -%}
<details class="tp-rm" data-tp-rm-rolle>
  <summary class="tp-rm__summary">
    <span class="tp-rm__summary-text">
      <span class="tp-rm__summary-titel">Raummaße eingeben</span>
      <span class="tp-rm__summary-sub">Wir berechnen Ihr Bestellmaß – mit oder ohne Zugabe</span>
    </span>
    <span class="tp-rm__summary-aktion"><span class="tp-rm__auf">Öffnen</span><span class="tp-rm__zu">Schließen</span> <span class="tp-rm__pfeil" aria-hidden="true">▾</span></span>
  </summary>
  <div class="tp-rm__inhalt">
    <p class="tp-rm__hilfe">Messen Sie jeweils die breiteste und die längste Stelle des Raums, auch in Türnischen.</p>
    <div class="tp-rm__felder">
      <div class="tp-rm__feld">
        <label for="tp-rm-b-{{ id }}">Raumbreite</label>
        <div class="tp-rm__wrap">
          <input type="text" id="tp-rm-b-{{ id }}" inputmode="decimal" autocomplete="off" placeholder="z. B. 350" data-rm-breite>
          <span>cm</span>
        </div>
      </div>
      <span class="tp-rm__mal" aria-hidden="true">×</span>
      <div class="tp-rm__feld">
        <label for="tp-rm-l-{{ id }}">Raumlänge</label>
        <div class="tp-rm__wrap">
          <input type="text" id="tp-rm-l-{{ id }}" inputmode="decimal" autocomplete="off" placeholder="z. B. 550" data-rm-laenge>
          <span>cm</span>
        </div>
      </div>
    </div>
    <p class="tp-rm__fehler" data-rm-fehler role="alert" hidden></p>
    <div class="tp-rm__ergebnis" data-rm-ergebnis aria-live="polite"></div>
  </div>
</details>
{%- endif -%}

{% stylesheet %}
  .tp-rm {
    margin: 0 0 14px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.18);
    border-radius: var(--style-border-radius, 8px);
    background: var(--color-background, #fff);
  }
  .tp-rm__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    cursor: pointer;
    list-style: none;
  }
  .tp-rm__summary::-webkit-details-marker { display: none; }
  .tp-rm__summary-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .tp-rm__summary-titel { font-weight: 700; font-size: 15px; }
  .tp-rm__summary-sub { font-size: 13px; color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.68); }
  .tp-rm__summary-aktion {
    flex: none;
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .tp-rm__pfeil { display: inline-block; transition: transform .2s; text-decoration: none; }
  .tp-rm[open] .tp-rm__pfeil { transform: rotate(180deg); }
  .tp-rm .tp-rm__zu, .tp-rm[open] .tp-rm__auf { display: none; }
  .tp-rm[open] .tp-rm__zu { display: inline; }
  .tp-rm__inhalt { padding: 0 14px 14px; }
  .tp-rm__hilfe { margin: 0 0 10px; font-size: 13px; color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.68); }
  .tp-rm__felder { display: flex; align-items: flex-end; gap: 8px; }
  .tp-rm__feld { flex: 1 1 0; min-width: 0; }
  .tp-rm__feld label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .tp-rm__mal { padding-bottom: 12px; font-weight: 600; }
  .tp-rm__wrap { display: flex; align-items: center; gap: 6px; }
  .tp-rm__wrap input {
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 10px;
    font-size: 16px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.3);
    border-radius: var(--style-border-radius-inputs, 6px);
    background: var(--color-background, #fff);
    color: inherit;
  }
  .tp-rm__fehler { margin: 8px 0 0; font-size: 13px; color: #b00020; }
  .tp-rm__ergebnis:not(:empty) { margin-top: 12px; display: grid; gap: 8px; }
  .tp-rm__vorschlag {
    padding: 10px 12px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.15);
    border-radius: var(--style-border-radius, 8px);
  }
  .tp-rm__vorschlag--empfohlen {
    border-color: var(--tp-hauptaktion, rgb(var(--color-foreground-rgb, 34 34 34) / 0.7));
    background: rgb(var(--color-foreground-rgb, 34 34 34) / 0.035);
  }
  .tp-rm__titel { margin: 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .tp-rm__mass { margin: 2px 0; font-size: 16px; font-weight: 700; }
  .tp-rm__preis { margin: 0 0 2px; font-size: 14px; font-weight: 600; }
  .tp-rm__info, .tp-rm__raum { margin: 0; font-size: 13px; color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.68); }
  .tp-rm__knopf {
    margin-top: 8px;
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--style-border-radius-buttons-primary, 6px);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .tp-rm__knopf--primaer {
    border-color: var(--tp-hauptaktion, var(--color-foreground, #111));
    background: var(--tp-hauptaktion, var(--color-foreground, #111));
    color: #fff;
  }

  .tp-rm--paket { margin: 0 0 12px; }
  .tp-rm__liste { display: grid; gap: 8px; }
  .tp-rm__zeile {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto;
    grid-template-areas: "name name name name" "b mal l weg";
    align-items: end;
    gap: 2px 8px;
  }
  .tp-rm__zeile .tp-rm__name { grid-area: name; font-size: 13px; font-weight: 700; }
  .tp-rm__zeile .tp-rm__feld:first-of-type { grid-area: b; }
  .tp-rm__zeile .tp-rm__mal { grid-area: mal; }
  .tp-rm__zeile .tp-rm__feld:last-of-type { grid-area: l; }
  .tp-rm__zeile label { font-weight: 400; font-size: 12px; }
  .tp-rm__zeile input {
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 10px;
    font-size: 16px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.3);
    border-radius: var(--style-border-radius-inputs, 6px);
    background: var(--color-background, #fff);
    color: inherit;
  }
  .tp-rm__weg {
    grid-area: weg;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 22px;
    cursor: pointer;
  }
  .tp-rm__add {
    margin-top: 8px;
    padding: 6px 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: inherit;
    cursor: pointer;
  }
  .tp-rm__summe {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.15);
  }
  .tp-rm__summe strong { font-size: 18px; }
  .tp-rm__knopf:disabled { opacity: .45; cursor: not-allowed; }
  .tp-rm--paket .tp-rm__knopf { width: 100%; }
{% endstylesheet %}
