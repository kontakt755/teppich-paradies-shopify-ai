{%- doc -%}
  Einstiegspreis "ab XX EUR" fuer Teppiche nach Mass - einzige Quelle der Regel.

  Der Preis gilt fuer das Einstiegsmass 80 x 150 cm (Entscheidung des Inhabers
  2026-09-20: beim technisch kleinsten Mass 50 x 50 cm greift fast ueberall der
  Mindestpreis, alle Karten zeigten "ab 99,xx EUR"). Matten nach Mass
  (service.produktwort = Matte) rechnen mit der Fussmatten-Groesse 60 x 90 cm und
  heissen zugeschnitten statt eingefasst. Er ist real kaufbar und rechnet
  wie assets/tp-masstepich-rechnung.js (mengeMitMindestpreis):
    - Flaeche in Einheiten a 0,01 m2, aufgerundet (80 x 150 cm = 120 Einheiten)
    - guenstigste Farbe (price_min, Preis je 0,01 m2)
    - Pflicht-Kettelung bei service.einfassung = Ketteln: Umfang in Einheiten
      a 0,01 lfm (4,60 m = 460) des Kettelservice-Produkts (derselbe Handle wie in
      templates/product.einfassung.json, Einstellung kettelservice_produkt).
      Ausnahme service.kante_inklusive = true: die Kettelung steckt im m2-Preis,
      es kommen keine Kantenkosten dazu und der Kettelservice wird nicht gebraucht.
    - service.mindestpreis gilt fuer den Auftrag: die Materialmenge wird in ganzen
      Einheiten angehoben, bis Material + Kante den Mindestpreis erreichen. Deshalb
      kann der Einstieg knapp ueber dem Mindestpreis liegen (99,10 statt 99,00 EUR).
    - Art "fertig" (Wunschmass vom Hersteller): Pauschale je Teppich aus dem Produkt
      wunschmass-pauschale (derselbe Handle wie in templates/product.wunschmass-fertig.json,
      Einstellung pauschale_produkt); nicht kaufbar -> kein ab-Preis.
  Optionale Extras sind nicht enthalten.

  Laesst sich der Preis nicht belegen (kein 0,01-m2-Preis, Kettelservice nicht
  kaufbar, Einstiegsmass passt nicht in service.max_breite_cm/max_laenge_cm),
  gibt das Snippet nur den Preis je m2 aus - nie einen geschaetzten Wert.
  Bei belegtem ab-Preis steht KEIN Preis je m2 dabei (Entscheidung des Inhabers
  2026-09-20: bei Teppichen komplett raus, auch im Raster). Der m2-Preis erscheint nur
  noch im Rueckfall, wenn sich kein ab-Preis belegen laesst - dann waere die Alternative
  gar kein Preis.

  Teppich ist nur, was custom.preis_pro_001_qm = true UND service.einfassung traegt.
  Zentimetergenau abgerechnete Rollenware hat ebenfalls preis_pro_001_qm, aber keine
  Einfassung - sie bekommt hier unveraendert den Preis je m2.

  @param {object} product - Produkt
  @param {boolean} [kopf] - Preis im Kopf der Produktseite: bei Kante im m2-Preis steht
    der Preis je m2 vorn statt des ab-Preises (siehe unten)
  @param {object} [variant] - gewaehlte Variante (Produktseite); ohne sie zaehlt die guenstigste Farbe.
    Ohne Variante (= Produktkarte) steht ueber dem Preis die Qualitaetszeile aus
    snippets/tp-teppich-qualitaet.
  @param {boolean} [karte] - Produktkarte mit fester Variante (Farb-Vorauswahl der Suche,
    snippets/tp-suchfarbe-variante): Preis aus variant, Darstellung wie auf jeder Karte
    (Qualitaetszeile, "ab" im Rueckfall; beim Preis je m2 mit Kante inklusive ohne "ab").
{%- enddoc -%}
{%- liquid
  assign tp_ab_breite_cm = 80
  assign tp_ab_laenge_cm = 150
  assign tp_ab_inkl_fertig = 'Einfassung und Pauschale'
  assign tp_ab_wort = product.metafields.service.produktwort.value | default: '' | strip | downcase
  if tp_ab_wort == 'matte'
    assign tp_ab_breite_cm = 60
    assign tp_ab_laenge_cm = 90
    assign tp_ab_inkl_fertig = 'Zuschnitt und Pauschale'
  endif
  # Guenstigste KAUFBARE Farbe: verfuegbar, bepreist und fuers Einfassen freigegeben -
  # dieselbe Auswahl wie im Konfigurator. product.price_min zaehlte auch gesperrte Farben
  # mit und konnte einen Preis bewerben, den niemand kaufen kann (Codex-Review 2026-09-20).
  assign tp_ab_einheit_cent = 0
  assign tp_ab_alt_einheit_cent = 0
  for tp_ab_v in product.variants
    if tp_ab_v.available and tp_ab_v.price > 0 and tp_ab_v.metafields.service.einfassen.value == 'Verfügbar'
      if tp_ab_einheit_cent == 0 or tp_ab_v.price < tp_ab_einheit_cent
        assign tp_ab_einheit_cent = tp_ab_v.price
        assign tp_ab_alt_einheit_cent = tp_ab_v.compare_at_price | default: 0
      endif
    endif
  endfor
  assign tp_ab_rueckfall_cent = product.price_min
  if variant != blank and variant.price > 0
    assign tp_ab_einheit_cent = variant.price
    assign tp_ab_alt_einheit_cent = variant.compare_at_price | default: 0
    assign tp_ab_rueckfall_cent = variant.price
  endif
  if tp_ab_einheit_cent > 0
    assign tp_ab_m2_cent = tp_ab_einheit_cent | times: 100
  else
    assign tp_ab_m2_cent = tp_ab_rueckfall_cent | times: 100
  endif
  assign tp_ab_art = product.metafields.service.einfassung.value | strip | downcase | replace: 'ß', 'ss'
  assign tp_ab_raummass = false
  if tp_ab_art == 'raummass'
    capture tp_ab_freigabe
      render 'tp-restrolle-freigegeben', product: product
    endcapture
    assign tp_ab_freigabe = tp_ab_freigabe | strip
    assign tp_ab_raum_v = product.variants.first
    if tp_ab_freigabe == 'ja' and tp_ab_raum_v.metafields.service.einfassen.value == 'Verfügbar' and tp_ab_raum_v.available
      if tp_ab_raum_v.metafields.service.basisvariante.value.id == product.metafields.service.einfass_basis.value.variants.first.id
        assign tp_ab_raummass = true
      endif
    endif
  endif
  assign tp_ab_cent = 0
  assign tp_ab_belegt = false

  if product.metafields.custom.preis_pro_001_qm.value == true and tp_ab_art != blank and tp_ab_einheit_cent > 0
    assign tp_ab_belegt = true
    if tp_ab_art == 'raummass' and tp_ab_raummass == false
      assign tp_ab_belegt = false
    endif
    # Ohne belegte Grenzen faellt der Konfigurator ganz aus - dann auch kein ab-Preis.
    # Breite aus derselben Quelle wie Karte und Konfigurator.
    capture tp_ab_max_b
      render 'tp-teppich-max-breite', product: product
    endcapture
    assign tp_ab_max_b = tp_ab_max_b | strip | times: 1
    assign tp_ab_max_l = product.metafields.service.max_laenge_cm.value | times: 1
    if tp_ab_max_b < tp_ab_breite_cm or tp_ab_max_l < tp_ab_laenge_cm
      assign tp_ab_belegt = false
    endif
    assign tp_ab_kante_einheiten = tp_ab_breite_cm | plus: tp_ab_laenge_cm | times: 2
    assign tp_ab_kante_cent = 0
    # Kante inklusive: Kettelung steckt im m2-Preis, keine Kantenkosten.
    assign tp_ab_kante_inkl = false
    assign tp_ab_ki = product.metafields.service.kante_inklusive.value | append: '' | strip | downcase
    if tp_ab_art == 'ketteln' and tp_ab_ki == 'true'
      assign tp_ab_kante_inkl = true
    endif
    if tp_ab_art == 'ketteln' and tp_ab_kante_inkl == false
      assign tp_ab_kettel_v = all_products['kettelservice'].selected_or_first_available_variant
      if tp_ab_kettel_v.available and tp_ab_kettel_v.price > 0
        assign tp_ab_kante_cent = tp_ab_kettel_v.price | times: tp_ab_kante_einheiten
      else
        assign tp_ab_belegt = false
      endif
    endif
    assign tp_ab_pauschale_cent = 0
    if tp_ab_art == 'fertig'
      assign tp_ab_pauschale_v = all_products['wunschmass-pauschale'].selected_or_first_available_variant
      if tp_ab_pauschale_v.available and tp_ab_pauschale_v.price > 0
        assign tp_ab_pauschale_cent = tp_ab_pauschale_v.price
      else
        assign tp_ab_belegt = false
      endif
    endif

    assign tp_ab_mp = product.metafields.service.mindestpreis.value
    if tp_ab_mp.amount
      assign tp_ab_mindest_cent = tp_ab_mp.amount | times: 100 | round
    else
      assign tp_ab_mindest_cent = tp_ab_mp | times: 100 | round
    endif

    assign tp_ab_menge = tp_ab_breite_cm | times: tp_ab_laenge_cm | plus: 99 | divided_by: 100
    assign tp_ab_material_cent = tp_ab_menge | times: tp_ab_einheit_cent
    assign tp_ab_rest_cent = tp_ab_mindest_cent | minus: tp_ab_kante_cent
    if tp_ab_rest_cent > tp_ab_material_cent
      assign tp_ab_menge = tp_ab_rest_cent | plus: tp_ab_einheit_cent | minus: 1 | divided_by: tp_ab_einheit_cent
      assign tp_ab_material_cent = tp_ab_menge | times: tp_ab_einheit_cent
    endif
    assign tp_ab_cent = tp_ab_material_cent | plus: tp_ab_kante_cent | plus: tp_ab_pauschale_cent

    # Streichpreis (S-30): derselbe Teppich zum alten Variantenpreis, dieselbe Formel - die
    # Kettelung ist nicht rabattiert und steckt in beiden Summen. Nur bei aktiver Aktion
    # (snippets/tp-aktion-aktiv), wie ueberall im Shop.
    assign tp_ab_alt_cent = 0
    if tp_ab_alt_einheit_cent > tp_ab_einheit_cent
      capture tp_ab_aktion
        render 'tp-rabatt-sichtbar', product: product
      endcapture
      assign tp_ab_aktion = tp_ab_aktion | strip
      if tp_ab_aktion == 'ja'
        assign tp_ab_alt_menge = tp_ab_breite_cm | times: tp_ab_laenge_cm | plus: 99 | divided_by: 100
        assign tp_ab_alt_material_cent = tp_ab_alt_menge | times: tp_ab_alt_einheit_cent
        # Greift schon beim alten Preis der Mindestpreis, kostet das Einstiegsmass vorher wie
        # nachher den Mindestpreis - die Rundung auf ganze Einheiten ergaebe einen "Rabatt"
        # von wenigen Cent. Das waere irrefuehrend: dann kein Streichpreis.
        if tp_ab_rest_cent > tp_ab_alt_material_cent
          assign tp_ab_alt_cent = 0
        else
          assign tp_ab_alt_cent = tp_ab_alt_material_cent | plus: tp_ab_kante_cent | plus: tp_ab_pauschale_cent
          if tp_ab_alt_cent <= tp_ab_cent
            assign tp_ab_alt_cent = 0
          endif
        endif
      endif
    endif
  endif
-%}
{%- liquid
  # Kopf der Produktseite (kopf: true): steckt die Kante im m2-Preis (Paspel, Band,
  # Cover, Ketteln mit service.kante_inklusive), ist der Preis je m2 der vollstaendige
  # Preis - dann steht er vorn, wie im Fachhandel ueblich (Inhaber 2026-10-12, Vorlage
  # Konkurrenzshop). Eigene Kettelung je lfm und Wunschmass mit Pauschale behalten den
  # ab-Preis, dort waere der m2-Preis nur ein Teil.
  # Dasselbe auf Karten (ohne Variante): Karte und Produktseite zeigen denselben
  # Preis je m2, "ab" nur, wenn die Farben unterschiedlich kosten. Karten mit
  # Suchfarbe (karte: true) ebenso, dort gilt der Preis genau dieser Farbe - ohne "ab".
  assign tp_ab_m2_kopf = false
  if kopf or variant == blank or karte
    if tp_ab_einheit_cent > 0 and product.metafields.custom.preis_pro_001_qm.value == true
      if tp_ab_art == 'paspelband' or tp_ab_art == 'einfassband' or tp_ab_art == 'cover'
        assign tp_ab_m2_kopf = true
      elsif tp_ab_art == 'ketteln' and tp_ab_kante_inkl
        assign tp_ab_m2_kopf = true
      elsif tp_ab_raummass
        assign tp_ab_m2_kopf = true
      endif
    endif
  endif
-%}
{%- if tp_ab_m2_kopf -%}
  {%- liquid
    assign tp_ab_m2_alt_cent = 0
    if tp_ab_alt_einheit_cent > tp_ab_einheit_cent
      capture tp_ab_aktion_kopf
        render 'tp-rabatt-sichtbar', product: product
      endcapture
      assign tp_ab_aktion_kopf = tp_ab_aktion_kopf | strip
      if tp_ab_aktion_kopf == 'ja'
        assign tp_ab_m2_alt_cent = tp_ab_alt_einheit_cent | times: 100
      endif
    endif
    case tp_ab_art
      when 'ketteln'
        assign tp_ab_kante_wort = 'Kettelung'
      when 'paspelband'
        assign tp_ab_kante_wort = 'Paspel'
      when 'einfassband'
        assign tp_ab_kante_wort = 'Einfassband'
      else
        assign tp_ab_kante_wort = 'Einfassung'
    endcase
  -%}
  {%- if variant == blank or karte -%}
    {%- capture tp_ab_qualitaet -%}{% render 'tp-teppich-qualitaet', product: product %}{%- endcapture -%}
    {%- assign tp_ab_qualitaet = tp_ab_qualitaet | strip -%}
  {%- endif -%}
  <span class="tp-ab-preis tp-ab-preis--m2" data-tp-ab-m2-cent="{{ tp_ab_m2_cent }}">
    {%- if tp_ab_qualitaet != blank -%}
      <span class="tp-ab-preis__qualitaet">{{ tp_ab_qualitaet | escape }}</span>
    {%- endif -%}
    <span class="tp-ab-preis__haupt">
      {%- if variant == blank and product.price_min != product.price_max -%}<span class="tp-ab-preis__ab">ab</span>{%- endif -%}
      <span class="tp-ab-preis__betrag">{% if tp_ab_m2_alt_cent > 0 %}<span class="visually-hidden">Aktionspreis </span>{% endif %}{{ tp_ab_m2_cent | money_without_currency | remove: ',00' }}&nbsp;€<span class="tp-ab-preis__einheit">/m²</span></span>
      {%- if tp_ab_m2_alt_cent > 0 -%}
        <s class="tp-ab-preis__alt"><span class="visually-hidden">statt </span>{{ tp_ab_m2_alt_cent | money_without_currency | remove: ',00' }}&nbsp;€/m²</s>
      {%- endif -%}
    </span>
    <span class="tp-ab-preis__grund">{% if tp_ab_raummass %}inkl. Zuschnitt, ohne Kettelung{% else %}inkl. {{ tp_ab_kante_wort }} rundum{% endif %}{% if kopf %} · Endpreis nach Ihrem Maß im Konfigurator{% endif %}</span>
    {%- comment -%} Lieferzeit nur im Kopf und nur aus service.lieferzeit (belegt) {%- endcomment -%}
    {%- assign tp_ab_lieferzeit = product.metafields.service.lieferzeit.value | strip -%}
    {%- if kopf and tp_ab_lieferzeit != blank -%}
      <span class="tp-ab-preis__lieferzeit">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true" focusable="false"><path d="M2 5h10v8H2zM12 8h3.2l2.3 2.6V13H12z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="5.5" cy="14.2" r="1.6" fill="currentColor"/><circle cx="14.5" cy="14.2" r="1.6" fill="currentColor"/></svg>
        Lieferzeit {{ tp_ab_lieferzeit | escape }}
      </span>
    {%- endif -%}
  </span>
{%- elsif tp_ab_belegt and tp_ab_cent > 0 -%}
  {%- if variant == blank or karte -%}
    {%- capture tp_ab_qualitaet -%}{% render 'tp-teppich-qualitaet', product: product %}{%- endcapture -%}
    {%- assign tp_ab_qualitaet = tp_ab_qualitaet | strip -%}
  {%- endif -%}
  <span class="tp-ab-preis" data-tp-ab-cent="{{ tp_ab_cent }}">
    {%- if tp_ab_qualitaet != blank -%}
      <span class="tp-ab-preis__qualitaet">{{ tp_ab_qualitaet | escape }}</span>
    {%- endif -%}
    <span class="tp-ab-preis__haupt">
      <span class="tp-ab-preis__ab">ab</span>
      <span class="tp-ab-preis__betrag">{% if tp_ab_alt_cent > 0 %}<span class="visually-hidden">Aktionspreis </span>{% endif %}{{ tp_ab_cent | money_without_trailing_zeros }}</span>
      {%- if tp_ab_alt_cent > 0 -%}
        <s class="tp-ab-preis__alt" data-tp-ab-alt-cent="{{ tp_ab_alt_cent }}"><span class="visually-hidden">statt </span>{{ tp_ab_alt_cent | money_without_trailing_zeros }}</s>
      {%- endif -%}
    </span>
    <span class="tp-ab-preis__grund">z.&nbsp;B. {{ tp_ab_breite_cm }}&nbsp;×&nbsp;{{ tp_ab_laenge_cm }}&nbsp;cm, inkl. {% if tp_ab_art == 'ketteln' %}Kettelung{% elsif tp_ab_art == 'fertig' %}{{ tp_ab_inkl_fertig }}{% elsif tp_ab_raummass %}Zuschnitt, ohne Kettelung{% else %}Einfassung{% endif %}</span>
  </span>
{%- else -%}
  <span class="tp-preis-je-m2">{% if variant == blank or karte %}ab {% endif %}{{ tp_ab_m2_cent | money }}<span class="tp-preis-je-m2__einheit">/m²</span></span>
{%- endif -%}
