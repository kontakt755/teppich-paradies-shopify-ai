{%- doc -%}
  Liniensymbole fuer Zubehoer-Kacheln ohne Foto. Bewusst schlicht: ein Strich,
  currentColor, keine Fuellung - damit sie in jedem Farbschema passen.

  @param {string} icon - profil | uebergang | abschluss | kleber | bauchemie | unterlage | reinigung | band | matte
{%- enddoc -%}
{%- case icon -%}
  {%- when 'uebergang' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 44h22v-8h12v8h22"/><path d="M4 52h56"/><path d="M22 30h20l6-8H16z"/></svg>
  {%- when 'abschluss' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 44h34"/><path d="M8 52h48"/><path d="M42 44V20l10 4v20"/><path d="M42 20l10 4"/></svg>
  {%- when 'kleber' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="18" y="22" width="28" height="32" rx="4"/><path d="M24 22v-6h16v6"/><path d="M28 10h8v6h-8z"/><path d="M24 34h16M24 42h10"/></svg>
  {%- when 'bauchemie' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 22h36l-4 32H18z"/><path d="M12 22h40"/><path d="M22 14h20v8H22z"/><path d="M20 40c6-4 18-4 24 0"/></svg>
  {%- when 'unterlage' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 46h52"/><path d="M6 38h52"/><path d="M6 30h52"/><path d="M8 22c8-6 16 6 24 0s16-6 24 0"/></svg>
  {%- when 'reinigung' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 24h20l3 30H19z"/><path d="M26 24v-8h12v8"/><path d="M30 10h4v6h-4z"/><path d="M26 40h12"/></svg>
  {%- when 'band' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="30" cy="30" r="18"/><circle cx="30" cy="30" r="7"/><path d="M48 30v14H58"/><path d="M30 48h28"/></svg>
  {%- when 'matte' -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 44l14-16h36L44 44z"/><path d="M6 44h38"/><path d="M14 36h26M18 32h24"/><path d="M24 20l6-4 6 4"/></svg>
  {%- else -%}
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 46h52"/><path d="M6 54h52"/><path d="M14 46V26h36v20"/><path d="M14 26l18-10 18 10"/></svg>
{%- endcase -%}
