{% doc %}
  Ausgabe der zentralen Herstellerzeile. Der bestehende Dateiname bleibt
  fuer Theme-Kompatibilitaet erhalten; die Markenpruefung steht ausschliesslich
  in tp-vorwerk-hersteller. Aufruf von dort, nicht mehr aus dem Preisblock.
  Vorwerk-Logo: https://commons.wikimedia.org/wiki/File:Vorwerk.svg
{% enddoc %}
<div class="tp-vorwerk-hersteller">
  <img src="{{ 'tp-vorwerk-logo.svg' | asset_url }}" alt="Vorwerk" width="90" height="36" loading="lazy">
  <span>Vorwerk – heute DAS TEPPICHWERK</span>
</div>
{% stylesheet %}
  .tp-vorwerk-hersteller { display: flex; align-items: center; gap: 8px 12px; margin-block-start: 8px; font-size: var(--tp-fs-sm); line-height: 1.4; flex-wrap: wrap; }
  .tp-vorwerk-hersteller img { width: 90px; height: 36px; object-fit: contain; flex: none; }
{% endstylesheet %}
