{% comment %}
  Der Modus "Verlegeservice", Phase 3 aus Issue #167.

  Grundsatz aus dem Plan: der Modus versteckt NIE etwas. Er blendet einen
  Streifen ein und laesst auf der Produktseite ein Band ueber dem Warenkorb
  erscheinen - mehr nicht. Warenkorb, Navigation und Sortiment bleiben in
  beiden Wegen unveraendert erreichbar.

  Warum die Reihenfolge der Kaufbuttons NICHT umsortiert wird: eine rein
  optische Vertauschung laesst Tastatur und Screenreader in der alten
  Reihenfolge zurueck. Genau dieser Fehler steckte in der ersten Fassung der
  Startseiten-Boxen. Ein zusaetzliches Band hat das Problem nicht.

  Wie er gesetzt wird:
    ?modus=service   schaltet ein und merkt es
    ?modus=shop      schaltet aus und vergisst es
  Danach traegt localStorage ihn ueber die Seiten. Das Attribut sitzt am
  <html>-Element, damit CSS greift, bevor der Body gezeichnet ist - sonst
  blitzt der Streifen beim Laden auf.

  Kein Cookie, kein Tracking, keine personenbezogenen Daten: nur ein Schalter
  im Browser des Besuchers.
{% endcomment %}

{{ 'tp-modus.css' | asset_url | stylesheet_tag }}

<script>
  (function () {
    var SCHLUESSEL = 'tp-modus';
    var wurzel = document.documentElement;
    var modus = null;

    try {
      var param = new URLSearchParams(window.location.search).get('modus');
      if (param === 'service' || param === 'shop') {
        modus = param === 'service' ? 'service' : null;
        try {
          if (modus) {
            window.localStorage.setItem(SCHLUESSEL, 'service');
          } else {
            window.localStorage.removeItem(SCHLUESSEL);
          }
        } catch (e) {
          /* Privater Modus oder Speicher voll: der Modus gilt dann nur fuer
             diese Seite. Kein Grund, irgendetwas abzubrechen. */
        }
      } else {
        try {
          modus = window.localStorage.getItem(SCHLUESSEL) === 'service' ? 'service' : null;
        } catch (e) {
          modus = null;
        }
      }
    } catch (e) {
      modus = null;
    }

    if (modus === 'service') {
      wurzel.setAttribute('data-tp-modus', 'service');
    } else {
      wurzel.removeAttribute('data-tp-modus');
    }
  })();
</script>
