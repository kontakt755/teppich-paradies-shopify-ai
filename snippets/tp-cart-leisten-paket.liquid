{%- doc -%}
  Hinweis im Warenkorb zum Paketvorteil "Sockelleiste inklusive" (#1452):
  Liegen mindestens 5 Pakete Klick- oder Klebevinyl im Warenkorb, aber noch
  keine Sockelleiste, steht oberhalb des Gesamtbetrags der Weg zur Leiste.
  Je 5 Pakete 5 Leisten mit je 11,90 EUR Nachlass (Belmora weiss gratis).
  Nie zwischen Gesamtbetrag und "Zur Kasse". Rein serverseitig;
  Schalter in snippets/tp-leisten-paket.
{%- enddoc -%}

{%- liquid
  assign tcl_pakete = 0
  assign tcl_hat_leiste = false
  for tcl_item in cart.items
    if tcl_item.product.type == 'Sockelleisten'
      assign tcl_hat_leiste = true
      break
    endif
    capture tcl_gilt
      render 'tp-leisten-paket', product: tcl_item.product
    endcapture
    if tcl_gilt contains 'ja'
      assign tcl_pakete = tcl_pakete | plus: tcl_item.quantity
    endif
  endfor
  assign tcl_weiss = nil
  if tcl_pakete >= 5 and tcl_hat_leiste == false
    assign tcl_weiss = all_products['belmora-sockelleiste-eckig-12x58mm']
    assign tcl_alle = collections['bodenleisten']
    assign tcl_stangen = tcl_pakete | divided_by: 5 | times: 5 | at_most: 100
  endif
-%}

{%- if tcl_weiss.available -%}
  <div class="tp-cart-lph" role="note" aria-label="Paketvorteil Sockelleiste">
    <p class="tp-cart-lph__text"><span class="tp-cart-lph__badge">Gratis</span> <strong>Sockelleiste inklusive:</strong> Zu Ihrem Vinylboden gehören {{ tcl_stangen }} Sockelleisten (je 2,4&nbsp;m) – weiß gratis, jede andere mit 11,90&nbsp;€ Nachlass.</p>
    <p class="tp-cart-lph__links">
      <a href="{{ tcl_weiss.url }}">Weiße Leiste wählen</a>
      {%- if tcl_alle %} · <a href="{{ tcl_alle.url }}">Leiste im Dekor wählen</a>{% endif -%}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-cart-lph {
    margin: 0 0 var(--margin-xs, 0.5rem);
    padding: var(--padding-sm, 0.875rem);
    border: 2px solid #8d714c;
    border-radius: var(--style-border-radius-inputs, 4px);
    background: rgb(141 113 76 / 0.12);
    font-size: var(--tp-fs-sm);
    line-height: 1.45;
  }
  .tp-cart-lph__text,
  .tp-cart-lph__links {
    margin: 0;
  }
  .tp-cart-lph__links {
    margin-top: 0.4rem;
  }
  .tp-cart-lph__links a {
    color: var(--tp-ink, inherit);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .tp-cart-lph__badge {
    padding: 2px 8px;
    border-radius: 999px;
    background: #b3261e;
    color: #fff;
    font-weight: 700;
  }
{% endstylesheet %}
