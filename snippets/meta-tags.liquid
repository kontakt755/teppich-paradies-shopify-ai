{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  # Marke in Titeln: der Shopname ist im Admin als "TeppichParadies"
  # hinterlegt, ueberall sonst heisst die Marke "Teppich Paradies". Die
  # Schreibweise im Admin zu aendern waere die saubere Loesung (wirkt auch in
  # E-Mails und Checkout) - bis dahin gleicht das Theme sie hier an.
  assign tp_marke = shop.name | replace: 'TeppichParadies', 'Teppich Paradies'
  # Startseitentitel an EINER Stelle. Ohne Homepage-Titel in den
  # Onlineshop-Einstellungen liefert Shopify nur den Shopnamen; <title> hatte
  # dafuer schon einen Fallback, og:title nicht - dort stand weiter
  # "TeppichParadies" gegen einen ausformulierten <title> (gemessen 2026-09-23).
  # Bundesweit statt lokal ausgerichtet (SEO-Audit 2026-09-30, QW 1): das
  # lokale Ranking haengt am Google-Unternehmensprofil, nicht an diesem Titel.
  assign tp_startseite_titel = 'Teppichboden & Vinylboden online kaufen | Teppich Paradies'
  assign og_title = page_title | default: tp_marke
  assign tp_canonical_url = canonical_url | default: request.origin
  # Alte ?page=2-Links der Mass-Teppiche zeigen bei bis zu 250 Qualitaeten
  # keine zweite Gruppenseite. Schon das rohe HTML soll deshalb auf die
  # gefuellte Kategorieseite verweisen, auch ohne JavaScript-Weiterleitung.
  if request.page_type == 'collection' and collection.handle == 'teppich-nach-mass' and collection.products_count > 0 and collection.products_count <= 250
    if tp_canonical_url contains '?page='
      assign tp_canonical_url = tp_canonical_url | split: '?' | first
    endif
  endif
  assign og_url = tp_canonical_url
  assign og_type = 'website'
  # Ohne eigene SEO-Beschreibung nimmt Shopify die ersten 320 Zeichen des
  # Produkt-/Kollektionstexts und klebt Absaetze ohne Leerzeichen aneinander
  # ("ca. 12 mm.Altbestand", Theme-Audit 2026-11-09). Dann den Text selbst
  # aufbauen: Absatzenden als Leerzeichen, an der Wortgrenze vor 156 Zeichen
  # enden. Eine gepflegte SEO-Beschreibung bleibt ganz unveraendert.
  assign tp_beschreibung = page_description
  assign tp_quelltext = ''
  if request.page_type == 'product' and product and product.metafields.global.description_tag == blank
    assign tp_quelltext = product.description
  elsif request.page_type == 'collection' and collection and collection.metafields.global.description_tag == blank
    assign tp_quelltext = collection.description
  endif
  if tp_quelltext != blank
    # Zeilenumbrueche erst zu <br /> und dann zu Leerzeichen; doppelte
    # Leerzeichen per replace, weil split nicht ueberall Leerlaeufe zusammenfasst.
    assign tp_quelltext = tp_quelltext | newline_to_br | replace: '</p>', ' ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | replace: '</li>', ' ' | replace: '</h2>', ' ' | replace: '</h3>', ' ' | strip_html | strip_newlines | replace: '   ', ' ' | replace: '  ', ' ' | replace: '  ', ' ' | strip
    if tp_quelltext != blank
      assign tp_beschreibung = tp_quelltext
    endif
  endif
  if tp_quelltext != blank and tp_beschreibung.size > 160
    assign tp_kurz = ''
    assign tp_worte = tp_beschreibung | split: ' '
    for tp_wort in tp_worte
      assign tp_kandidat = tp_kurz | append: ' ' | append: tp_wort | strip
      if tp_kandidat.size > 155
        break
      endif
      assign tp_kurz = tp_kandidat
    endfor
    if tp_kurz == blank
      assign tp_kurz = tp_beschreibung | truncate: 155, ''
    endif
    # Endet der gekuerzte Text auf einem Satzende, braucht er keine Auslassung.
    assign tp_letztes = tp_kurz | slice: -1
    if tp_letztes == '.' or tp_letztes == '!' or tp_letztes == '?'
      assign tp_beschreibung = tp_kurz
    else
      if tp_letztes == ',' or tp_letztes == ':' or tp_letztes == ';'
        assign tp_kurz_ende = tp_kurz.size | minus: 1
        assign tp_kurz = tp_kurz | slice: 0, tp_kurz_ende
      endif
      assign tp_beschreibung = tp_kurz | append: '…'
    endif
  endif
  assign og_description = tp_beschreibung | default: shop.description | default: tp_marke | replace: 'TeppichParadies', 'Teppich Paradies'
  assign optimized_page_title = page_title
  if request.page_type == 'index' and page_title == shop.name
    assign og_title = tp_startseite_titel
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
    if product
      # truncate schnitt hart nach 45 Zeichen ab, auch mitten im Wort: aus
      # "... Vinylboden von der Rolle" wurde "... Vinylboden von der Ro".
      # Das stand so im Browser-Tab und im Google-Ergebnis. Deshalb wortweise
      # aufbauen und abbrechen, bevor die Grenze ueberschritten wird.
      assign tp_raw_title = product.title | strip_html
      assign product_title = tp_raw_title
      if tp_raw_title.size > 45
        assign product_title = ''
        assign tp_title_words = tp_raw_title | split: ' '
        for tp_title_word in tp_title_words
          assign tp_title_candidate = product_title | append: ' ' | append: tp_title_word | strip
          if tp_title_candidate.size > 45
            break
          endif
          assign product_title = tp_title_candidate
        endfor
        if product_title == blank
          assign product_title = tp_raw_title | truncate: 45, ''
        endif
        # Ein an der Wortgrenze abgeschnittener Titel endet sonst auf einem
        # Fuellwort oder Trennzeichen ("Vinylboden von der online kaufen").
        # Mehrfach, weil am Ende auch zwei Fuellwoerter stehen koennen
        # ("... Vinylboden von der").
        # "als" fehlte und wurde am 2026-09-15 sichtbar: "Sylvara 655 -
        # Design-Klebevinyl als Einzelplanken" (48 Zeichen) brach auf 45
        # Zeichen ab und stand als "Sylvara 655 - Design-Klebevinyl als |
        # Teppich Paradies" im Browser-Tab. Die uebrigen Ergaenzungen sind
        # dieselbe Sorte Wort und kosten nichts.
        assign tp_title_fillers = 'von,der,die,das,den,dem,und,mit,aus,fuer,für,im,in,am,zum,zur,als,wie,bei,auf,an,ohne,pro,je,zu,-,–,|' | split: ','
        for tp_title_pass in (1..3)
          assign tp_title_last = product_title | split: ' ' | last | downcase
          unless tp_title_fillers contains tp_title_last
            break
          endunless
          assign tp_title_rest = product_title | split: ' '
          assign tp_title_keep = tp_title_rest.size | minus: 1
          assign product_title = ''
          for tp_title_word in tp_title_rest limit: tp_title_keep
            assign product_title = product_title | append: ' ' | append: tp_title_word
          endfor
          assign product_title = product_title | strip
        endfor
      endif
      # "online kaufen" ist ein Suchbegriff, den wir gern im Titel haetten -
      # aber der Zusatz kostet zusammen mit dem Markennamen 33 Zeichen. Bei
      # einem 45 Zeichen langen Produktnamen stehen damit 78 Zeichen im Titel,
      # und Google zeigt rund 60: der Rest wird durch "..." ersetzt. Gemessen
      # am 2026-09-15: "Alvora Eiche Bernstein - Klebevinyl 2,5mm online kaufen
      # | Teppich Paradies" = 74 Zeichen, abgeschnitten wurde ausgerechnet der
      # Markenname.
      #
      # Deshalb keine feste Entscheidung, sondern eine gerechnete: Passt die
      # lange Fassung in die Anzeige, bleibt sie. Sonst faellt "online kaufen"
      # weg - der Produktname ist fuer Relevanz und Klick wichtiger als das
      # Fuellwort.
      #
      # Der Produktname wird dabei bewusst NICHT weiter gekuerzt. Ein auf 41
      # Zeichen gestutzter Name waere der schlechtere Tausch; bis zu 64 Zeichen
      # sind in der Anzeige nur knapp ueber der Grenze, ein halber Produktname
      # ist im Ergebnis dagegen wertlos.
      # Ein im Shopify-Admin gepflegter SEO-Titel gewinnt.
      #
      # Vorher hat dieser Block ihn kommentarlos ueberschrieben. Beim
      # Kontura-Teppichboden stand im Admin "Kontura Teppichboden 400cm - 19
      # Farben"; ausgeliefert wurde "Kontura Teppichboden 400cm online kaufen |
      # Teppich Paradies". Die Zahl der Farben ist genau das Argument, das zum
      # Klick fuehrt - sie hat Google nie erreicht. Betroffen war fast jedes
      # Produkt, denn die Titel sind gepflegt. Die Meta-Description kam schon
      # immer aus dem Admin; nur der Titel wurde verworfen.
      #
      # page_title liefert bei Produkten den SEO-Titel, sonst den Produktnamen.
      # Der Vergleich mit product.title unterscheidet beide Faelle, ohne ein
      # Metafeld zu brauchen.
      #
      # Laenge wird hier bewusst NICHT geprueft: Ein eigener Titel ist eine
      # redaktionelle Entscheidung. Ihn zu kuerzen waere derselbe Fehler noch
      # einmal, nur subtiler.
      assign tp_seo_titel = ''
      if page_title != blank and page_title != product.title
        assign tp_seo_titel = page_title | replace: 'TeppichParadies', 'Teppich Paradies'
      endif

      if tp_seo_titel != blank
        assign optimized_page_title = tp_seo_titel
      else
        # Ohne eigenen Titel baut das Theme ihn aus dem Produktnamen. "online
        # kaufen" bleibt nur, solange der Titel in die Google-Anzeige passt -
        # sonst faellt der Zusatz weg, damit der Markenname sichtbar bleibt.
        assign tp_title_max = 60
        assign tp_title_lang = product_title | append: ' online kaufen | ' | append: tp_marke
        if tp_title_lang.size > tp_title_max
          assign optimized_page_title = product_title | append: ' | ' | append: tp_marke
        else
          assign optimized_page_title = tp_title_lang
        endif
      endif
      assign og_title = optimized_page_title
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ tp_marke }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape_once }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape_once }}"
>

{%- liquid
  # Vorschaubild beim Teilen. page_image ist auf Produkt- und Artikelseiten
  # gesetzt, auf Kollektionen nur bei gepflegtem Kollektionsbild und auf
  # normalen Seiten nie. Gemessen am 2026-09-16 hatten Startseite, alle acht
  # Kategorien und alle Seiten kein og:image - ein per WhatsApp geteilter Link
  # kam als graue Textzeile an. WhatsApp ist hier kein Randkanal: der Shop
  # bewirbt ihn im Kopf, in der Fusszeile und auf jeder Produktseite.
  #
  # Reihenfolge bewusst von konkret nach allgemein. Das erste Produktbild der
  # Kollektion zeigt den Belag, um den es geht; das Logo zeigt nur, dass es
  # den Shop gibt. Es steht deshalb am Ende und nicht am Anfang.
  assign tp_og_bild = page_image
  if tp_og_bild == blank and collection and collection.products.first
    assign tp_og_bild = collection.products.first.featured_media.preview_image
  endif
  # shop.brand.cover_image und shop.brand.square_logo stehen in diesem Shop
  # nicht zur Verfuegung (am 2026-09-16 im Theme gemessen, beide leer) - sie
  # waeren die schoenere Quelle, sind hier aber tote Zweige. Bleibt das Logo:
  # als Vorschau schwach, aber der Unterschied zwischen "Shop erkennbar" und
  # "graue Textzeile" im Chat.
  if tp_og_bild == blank
    assign tp_og_bild = settings.logo
  endif
-%}

{%- if tp_og_bild -%}
  <meta
    property="og:image"
    content="http:{{ tp_og_bild | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ tp_og_bild | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ tp_og_bild.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ tp_og_bild.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- comment -%}
    og:price in derselben Einheit wie offers.price im JSON-LD
    (snippets/tp-product-structured-data.liquid): Teppich nach Mass je
    0,01 m2 und Profile nach Mass je 0,01 lfm -> x100, Paketware -> Preis
    des kleinsten kaufbaren Originalpakets. Basis ist die
    gezeigte Variante statt product.price (das waere der kleinste Preis aller
    Varianten inkl. Muster). Dezimalpunkt statt Komma, ohne Tausenderpunkt.
    Teppich nach Mass mit Einfassung: Endpreis der Beispielgroesse dieser Farbe
    (snippets/tp-mass-beispiel), wie offers.price im JSON-LD und im Zusatzfeed
    (#1283); ohne Beispielgroesse bleibt es beim Preis je m2.
  {%- endcomment -%}
  {%- liquid
    assign tp_og_cents = product.selected_or_first_available_variant.price
    if product.metafields.custom.preis_pro_001_qm.value == true or product.metafields.custom.preis_pro_001_lfm.value == true
      assign tp_og_cents = tp_og_cents | times: 100
      if product.metafields.service.einfassung.value != blank
        capture tp_og_bsp
          render 'tp-mass-beispiel', product: product, variant: product.selected_or_first_available_variant
        endcapture
        assign tp_og_bsp = tp_og_bsp | strip
        if tp_og_bsp != blank
          assign tp_og_bsp_teile = tp_og_bsp | split: '|'
          assign tp_og_cents = tp_og_bsp_teile[2] | times: 1
        endif
      endif
      # Laengenware nach Mass: Endpreis der Beispielgroesse (snippets/tp-laengen-beispiel, w-331).
      if product.metafields.custom.preis_pro_001_lfm.value == true
        capture tp_og_bsp
          render 'tp-laengen-beispiel', product: product, variant: product.selected_or_first_available_variant
        endcapture
        assign tp_og_bsp = tp_og_bsp | strip
        if tp_og_bsp != blank
          assign tp_og_bsp_teile = tp_og_bsp | split: '|'
          assign tp_og_cents = tp_og_bsp_teile[2] | times: 1
        endif
      endif
    endif
    assign tp_og_euro = tp_og_cents | divided_by: 100
    assign tp_og_rest = tp_og_cents | modulo: 100
    if tp_og_rest < 10
      assign tp_og_rest = tp_og_rest | prepend: '0'
    endif
  -%}
  <meta
    property="og:price:amount"
    content="{{ tp_og_euro }}.{{ tp_og_rest }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape_once }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape_once }}"
>

<title>
  {%- if request.page_type == 'product' -%}
    {%- comment -%} page_title kommt schon maskiert: escape machte aus "&" ein sichtbares "&amp;" (2026-11-12) {%- endcomment -%}
    {{ optimized_page_title | escape_once }}
  {%- elsif request.page_type == 'index' and page_title == shop.name -%}
    {%- comment -%}
      Ohne Homepage-Titel in den Onlineshop-Einstellungen liefert Shopify nur
      den Shopnamen (15 Zeichen). Der Fallback traegt Sortiment und Marke;
      ein im Admin gesetzter Titel gewinnt weiterhin.
    {%- endcomment -%}
    {{ tp_startseite_titel }}
  {%- elsif request.page_type == 'cart' -%}
    {%- comment -%} Shopify liefert hier "Dein Warenkorb" - der Shop siezt (Audit B-17) {%- endcomment -%}
    Ihr Warenkorb &ndash; {{ tp_marke }}
  {%- elsif request.page_type == 'search' -%}
    {%- comment -%}
      Shopify liefert "Suche: 974 Ergebnisse gefunden fuer ..." - die Zahl
      stammt aus der semantischen Suche und ist auch fuer Unsinnsbegriffe
      hoch (Shopanalyse 2026-10-24). Im Tab steht deshalb nur der Begriff.
    {%- endcomment -%}
    {%- if search.terms != blank -%}
      Suche: „{{ search.terms | escape }}“ | {{ tp_marke }}
    {%- else -%}
      Suche | {{ tp_marke }}
    {%- endif -%}
  {%- else -%}
    {%- comment -%}
      Der else-Zweig fehlte nach f195de7: Kollektionen, Seiten und Suche
      lieferten einen leeren <title>. Deploy-Gate SEO hat es am 2026-09-09
      gefunden, bevor es live ging.
    {%- endcomment -%}
    {%- comment -%}
      Folgeseiten und Filter auf Deutsch (Rundgang 2026-11-06, SEO-04): aus
      "... | Teppich Paradies - Page 2" wird "... - Seite 2 | Teppich Paradies".
      Endet der Titel auf " | Marke", steht der Zusatz vor der Marke; sonst
      bleibt er wie bisher hinter dem Titel.
    {%- endcomment -%}
    {%- liquid
      assign tp_titel_basis = page_title
      assign tp_titel_marke = ''
      if current_tags or current_page != 1
        assign tp_titel_endungen = tp_marke | append: '||' | append: shop.name | split: '||'
        for tp_endung_name in tp_titel_endungen
          assign tp_endung = ' | ' | append: tp_endung_name
          if page_title.size > tp_endung.size
            assign tp_endung_start = 0 | minus: tp_endung.size
            assign tp_titel_ende = page_title | slice: tp_endung_start, tp_endung.size
            if tp_titel_ende == tp_endung
              assign tp_basis_laenge = page_title.size | minus: tp_endung.size
              assign tp_titel_basis = page_title | slice: 0, tp_basis_laenge
              assign tp_titel_marke = ' | ' | append: tp_marke
              break
            endif
          endif
        endfor
      endif
    -%}
    {{ tp_titel_basis }}
    {%- if current_tags %} &ndash; Filter: {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Seite {{ current_page }}{% endif -%}
    {{- tp_titel_marke -}}
    {%- comment -%}
      Marke nur anhaengen, wenn sie nicht schon im Titel steht (sonst
      "… | Teppich Paradies – TeppichParadies") und wenn der Titel dadurch
      nicht ueber 65 Zeichen waechst. Google schneidet laengere Titel ab, und
      abgeschnitten wird immer das Ende - also genau die Marke. Ohne sie bleibt
      der aussagekraeftige Teil vollstaendig sichtbar. Am 2026-09-14 gemessen:
      sechs Seitentypen lagen zwischen 67 und 76 Zeichen.
    {%- endcomment -%}
    {%- liquid
      assign tp_title_gesamt = page_title.size | plus: tp_marke.size | plus: 3
    -%}
    {%- unless page_title contains tp_marke or page_title contains shop.name or tp_title_gesamt > 65 %} &ndash; {{ tp_marke }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ tp_canonical_url }}"
>

{%- comment -%}
  Tag-Seiten eines Blogs (/blogs/x/tagged/y) zeigen nur einen Ausschnitt der
  Themenseite. Sie sollen verfolgt, aber nicht indexiert werden - sonst
  konkurrieren sie mit der Themenseite des Ratgebers.
{%- endcomment -%}
{%- if template.name == 'blog' and current_tags -%}
  <meta
    name="robots"
    content="noindex,follow"
  >
{%- endif %}

{%- comment -%}
  Angebots-Kollektionen spiegeln die Hauptkategorien fast vollstaendig
  (gezaehlt am 2026-09-30 ueber /collections/<handle>/products.json):
  angebote-teppichboden 110 von 113 in teppichboden, angebote-vinylboden
  281 von 281 in vinylboden-1, angebote-linoleum 9 von 9 in linoleumboden-1,
  angebote-leisten-zubehoer 69 von 69 in zubehoer/bodenleisten. Als eigene
  indexierbare Seiten konkurrieren sie mit "Teppichboden kaufen" usw.
  Verfolgt werden sie weiter, indexiert nicht (SEO-Audit 2026-09-30, 4.3).
  Echte Aktionsware (stark-reduziert) bleibt bewusst indexierbar.
  Wird eine Angebotskollektion auf echte Aktionsware begrenzt, Handle hier
  herausnehmen.
{%- endcomment -%}
{%- if request.page_type == 'collection' -%}
  {%- liquid
    assign tp_noindex_handles = 'angebote-teppichboden,angebote-vinylboden,angebote-linoleum,angebote-leisten-zubehoer' | split: ','
  -%}
  {%- if tp_noindex_handles contains collection.handle -%}
    <meta
      name="robots"
      content="noindex,follow"
    >
  {%- endif -%}
{%- endif %}

{% if tp_beschreibung != blank %}
  {%- comment -%}
    escape_once statt escape: ohne gepflegte SEO-Description liefert Shopify
    den Produkttext, und der bringt schon Entities mit (&amp;). escape machte
    daraus &amp;amp;, in der Suchvorschau als "&amp;" zu lesen - gemessen am
    2026-09-23 an der Sylvara-655-Familie (4 Produkte ohne SEO-Description).
  {%- endcomment -%}
  <meta
    name="description"
    content="{{ tp_beschreibung | replace: 'TeppichParadies', 'Teppich Paradies' | escape_once }}"
  >
{%- elsif request.page_type == 'collection' and collection.handle == 'all' -%}
  {%- comment -%}
    /collections/all ist eine von Shopify erzeugte Kollektion und laesst sich
    im Admin nicht mit einer Beschreibung versehen - sie war am 2026-09-14 die
    einzige indexierbare Seite ganz ohne Description. Bewusst nur hier und
    nicht als allgemeiner Fallback: eine generische Beschreibung auf vielen
    Seiten ist schlechter als gar keine.
  {%- endcomment -%}
  <meta
    name="description"
    content="Alle Bodenbeläge auf einen Blick: Teppichboden, Vinyl, Linoleum, Teppichfliesen, Sockelleisten und Zubehör – mit Musterservice und Fachberatung."
  >
{%- elsif request.page_type == 'policy' -%}
  {%- comment -%}
    Richtlinienseiten (/policies/...) haben in Shopify kein SEO-Feld und
    lieferten keine Description (Rundgang 2026-11-06, SEO-06). Je Richtlinie
    ein fester, neutraler Satz; die Rechtstexte selbst bleiben unveraendert.
    Unbekannte Richtlinien bekommen bewusst keinen Text.
  {%- endcomment -%}
  {%- liquid
    assign tp_policy_beschreibung = ''
    if request.path contains '/policies/legal-notice'
      assign tp_policy_beschreibung = 'Impressum der Teppich Paradies Oranienburg GmbH mit Anbieterangaben und Kontaktdaten.'
    elsif request.path contains '/policies/privacy-policy'
      assign tp_policy_beschreibung = 'Datenschutzerklärung der Teppich Paradies Oranienburg GmbH für den Onlineshop.'
    elsif request.path contains '/policies/refund-policy'
      assign tp_policy_beschreibung = 'Widerrufsrecht für Bestellungen im Onlineshop der Teppich Paradies Oranienburg GmbH.'
    elsif request.path contains '/policies/terms-of-service'
      assign tp_policy_beschreibung = 'Allgemeine Geschäftsbedingungen (AGB) der Teppich Paradies Oranienburg GmbH für den Onlineshop.'
    endif
  -%}
  {%- if tp_policy_beschreibung != blank -%}
    <meta
      name="description"
      content="{{ tp_policy_beschreibung }}"
    >
  {%- endif -%}
{% endif %}
