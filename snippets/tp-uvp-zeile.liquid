{% doc %}
  Zeile "UVP <Betrag durchgestrichen>" unter dem Verkaufspreis. Nur ausgeben,
  wenn tp-rabatt-sichtbar "uvp" meldet: Der Vergleichspreis ist dann die
  unverbindliche Preisempfehlung des Herstellers (preis.vergleich_ist_uvp,
  Inhaber 2026-10-28: UVP dauerhaft zeigen). Grau und klein, ohne Rabattbadge
  und ohne Prozent - ein UVP-Vergleich ist keine Preisermaessigung des Shops,
  deshalb steht die Herkunft des Betrags ausdruecklich dabei.
  Restrollen nennen zusaetzlich den Abstand als rote Pille "-40 % ggue. UVP"
  (Inhaber 2026-11-06, vorher grau seit 2026-11-03). Der Bezug "UVP" bleibt
  immer dabei: Die Rollen wurden nie zum hoeheren Preis verkauft, "Rabatt" oder
  "reduziert" waere deshalb irrefuehrend.

  @param {string} betrag - fertig formatierter Betrag, z. B. "68,63 €" oder "53,58"
  @param {string} [einheit] - Einheit hinter dem Betrag, z. B. "€/m²"
  @param {number} [prozent] - Abstand zur UVP in ganzen Prozent, nur bei Sonderposten
{% enddoc %}
<div class="tp-uvp">
  <span aria-hidden="true">UVP</span>
  <s><span class="visually-hidden">Unverbindliche Preisempfehlung des Herstellers: </span>{{ betrag }}{% if einheit != blank %}&nbsp;{{ einheit }}{% endif %}</s>
  {%- if prozent != blank and prozent > 0 -%}
    <span class="tp-uvp__abstand"><span aria-hidden="true">−{{ prozent }}&nbsp;% ggü. UVP</span><span class="visually-hidden">{{ prozent }}&nbsp;% unter der unverbindlichen Preisempfehlung</span></span>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Unter grossen Preisen 14 px, auf Karten nicht groesser als die Preiszeile. */
  .tp-uvp {
    margin-top: 2px;
    font-size: min(1em, var(--tp-fs-sm));
    font-weight: 400;
    line-height: 1.3;
    color: #595959;
  }

  .tp-uvp s {
    white-space: nowrap;
  }

  /* Restrollen: Abstand zur UVP als rote Pille (Rot = Rabatt, Inhaber 2026-11-06) */
  .tp-uvp__abstand {
    display: inline-block;
    margin-inline-start: 6px;
    padding: 1px 8px;
    border-radius: 999px;
    background: #b3261e;
    color: #fff;
    font-weight: 700;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Mitlaufende Kaufleiste: nur der Preis. Mit UVP blieb vom Produktnamen
     nur "K..." (Render-Test 2026-10-28); die UVP steht oben auf der Seite. */
  .sticky-add-to-cart__price .tp-uvp {
    display: none;
  }
{% endstylesheet %}
