{%- comment -%}
  Musterkasten der Teppichboden-Kategorien (Muster kostenlos, Versand, Google-Note).
  Wird von sections/tp-teppichboden-kampagne.liquid und - auf den Testkategorien
  aus snippets/tp-mobil-kompakt.liquid am Handy - vom Einschub im Produktraster
  (sections/main-collection.liquid) gerendert.
  @param {string} [variante] - 'einschub': Kasten im Raster, nur bis 749 px sichtbar;
    'nur-desktop': Kasten an seinem Platz vor dem Raster, ab 750 px sichtbar; leer: immer
{%- endcomment -%}
<div class="tp-tbk{% if variante != blank %} tp-tbk--{{ variante }}{% endif %}" role="region" aria-label="Muster und Versand für Teppichboden">
  <div class="tp-tbk__inner">
    <div class="tp-tbk__copy">
      <p class="tp-tbk__eyebrow">Erst ansehen, dann entscheiden</p>
      <h2>Teppichboden-Farbe zu Hause prüfen</h2>
      <p>Bis zu zwei Muster je Bestellung kostenlos: Farben bei Ihrem Licht vergleichen.</p>
    </div>
    <a class="tp-tbk__button" href="/pages/muster">Kostenlose Muster bestellen <span aria-hidden="true">→</span></a>
    <div class="tp-tbk__facts">
      <span>Deutschlandweit ab {{ settings.tp_versand_frei_ab }} € versandkostenfrei</span>
      <a href="/pages/versand-lieferung">Versand und Lieferung ansehen</a>
      {%- assign tp_gb_wert = shop.metafields.custom.google_bewertung.value.wert | default: settings.tp_google_wert -%}
      {%- if tp_gb_wert != blank and settings.tp_google_link != blank -%}
        <div class="tp-tbk__beleg">
          <a href="{{ settings.tp_google_link | escape }}" target="_blank" rel="noopener">{{ tp_gb_wert | escape }} ★ bei Google · Bewertungen ansehen</a>
          {%- comment -%} § 5b Abs. 3 UWG: der Hinweis gehoert direkt zur Note {%- endcomment -%}
          {%- render 'tp-bewertungshinweis', kurz: true -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
