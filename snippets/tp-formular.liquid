{% doc %}
  Formular-Feinschliff für den Rollenware-Rechner.

  Befunde aus der Prüfung gegen ui-ux-pro-max, Kategorie 8 (Forms & Feedback):
  error-placement, aria-live-errors, inline-validation, input-helper-text.

  Bewusst als nachträgliche Ergänzung per JavaScript, nicht als Änderung an
  blocks/tp-rollware-rechner.liquid. Die Rechner-Datei bleibt damit
  zeichengleich mit dem Live-Theme, und diese Ebene lässt sich durch Entfernen
  einer Zeile in layout/theme.liquid vollständig zurücknehmen. Am Rechenweg
  und am Warenkorb wird nichts angefasst.

  Was sich ändert:

  1. Der Hinweis "Länge von 1 m (100 cm) bis 50 m" steht dauerhaft unter dem Feld, statt
     erst als Fehler aufzutauchen, wenn man dagegenläuft. Eine Regel, die man
     vorher kennt, ist keine Fehlermeldung wert.

  2. Der Fehler erscheint erst beim Verlassen des Feldes. Vorher blitzte er
     beim Tippen von "500" zweimal auf - nach der "5" und nach der "50".
     Das liest sich wie Tadel für eine Eingabe, die gerade erst entsteht.

  3. Der jeweils sichtbare Fehler ist mit dem Feld verknüpft und wird über
     eine dauerhafte Statuszeile angesagt. Auch Format- und Obergrenzenfehler
     gehören dazu.

  Greift nur, wo ein Wurzelelement id="tp-rwc-…" sowohl input[data-length-input]
  als auch [data-error-min] enthält - also ausschließlich im Rollenware-Rechner
  (Stand 2026-09-14: blocks/tp-rollware-rechner.liquid). Andere Seiten sind
  unberührt.
{% enddoc %}

<script>
  (function () {
    function init() {
      document.querySelectorAll('[id^="tp-rwc-"]').forEach(function (wurzel) {
        if (wurzel.dataset.tpFormularBereit) {
          // Farbwechsel außerhalb des Rechners rechnet verzögert neu.
          if (wurzel.tpFormularAbgleichen) wurzel.tpFormularAbgleichen();
          return;
        }

        var feld = wurzel.querySelector('input[data-length-input]');
        var fehlerMin = wurzel.querySelector('[data-error-min]');
        var fehlerFormat = wurzel.querySelector('[data-error-comma]');
        var fehlerMax = wurzel.querySelector('[data-error-max]');
        var fehlerLager = wurzel.querySelector('[data-error-stock]');
        var gegenprobe = wurzel.querySelector('[data-length-echo]');
        if (!feld || !fehlerMin) return;

        wurzel.dataset.tpFormularBereit = '1';

        // --- Fehler mit dem Feld verknüpfen und Änderungen ansagen ---
        var fehler = [fehlerMin, fehlerFormat, fehlerMax, fehlerLager];
        fehler.forEach(function (el, i) {
          if (!el) return;
          if (!el.id) el.id = wurzel.id + '-fehler-' + i;
        });

        // Ein dauerhaft vorhandener Live-Bereich meldet auch Fehlertexte, die
        // im Rechner schon vor dem Einblenden feststehen (z. B. "abc").
        var status = document.createElement('p');
        status.className = 'tp-formular-status';
        status.setAttribute('role', 'status');
        status.setAttribute('aria-live', 'polite');
        status.setAttribute('aria-atomic', 'true');
        fehlerMin.parentNode.insertBefore(status, fehlerMin);

        // --- Dauerhafter Hinweis statt Fehler im Nachhinein ---
        var hinweis = document.createElement('p');
        hinweis.className = 'tp-formular-hinweis';
        hinweis.id = wurzel.id + '-hinweis';
        // Issue 162: auch die Obergrenze vorab nennen. Der Rechner gibt sie am
        // Wurzelelement mit; fehlt sie, bleibt der alte Hinweis.
        var maxCm = parseInt(wurzel.dataset.maxLaengeCm, 10);
        hinweis.textContent = maxCm > 0
          ? 'Länge von 1 m (100 cm) bis ' + (maxCm / 100) + ' m'
          : 'Mindestens 100 cm';
        fehlerMin.parentNode.insertBefore(hinweis, fehlerMin);
        // Nur der aktuelle Fehler darf in der Feldbeschreibung stehen. Sonst
        // lesen Screenreader auch verborgene, gerade unpassende Fehler vor.

        // --- Fehler erst nach dem Verlassen des Feldes ---
        // Ob die Mindestlaenge verletzt ist, entscheidet allein der Rechner
        // (blocks/tp-rollware-rechner.liquid, calculate): er zeigt die Meldung
        // auch bei "0" und "-5", verbirgt sie aber bei Komma-, Lager- und
        // Laengenfehlern zugunsten der passenderen Meldung. Diese Ebene merkt
        // sich nur seine Entscheidung und haelt die Meldung zurueck, solange
        // das Feld den Fokus hat. Bis 2026-09-14 rechnete sie selbst
        // (0 < n < 100) und ueberschrieb damit den Rechner: "0" und "-5"
        // blieben stumm.
        //
        // Der Abgleich laeuft als Microtask, also nach allen Zuhoerern des
        // Ereignisses - unabhaengig davon, ob der Rechner seinen vor oder nach
        // diesem registriert hat.
        var wurdeVerlassen = false;
        var rechnerZeigt = !fehlerMin.hidden;

        function abgleichen() {
          var zeigen = wurdeVerlassen && rechnerZeigt;
          fehlerMin.hidden = !zeigen;
          var aktiverFehler = fehler.find(function (el) { return el && !el.hidden; });
          var eingabefehler = [fehlerMin, fehlerFormat, fehlerMax].some(function (el) { return el && !el.hidden; });
          var ids = [hinweis.id];
          if (gegenprobe && !gegenprobe.hidden) ids.push(gegenprobe.id);
          if (aktiverFehler) ids.push(aktiverFehler.id);
          feld.setAttribute('aria-describedby', ids.join(' '));
          if (eingabefehler) {
            feld.setAttribute('aria-invalid', 'true');
          } else {
            feld.removeAttribute('aria-invalid');
          }
          var meldung = aktiverFehler ? aktiverFehler.textContent : '';
          if (status.textContent !== meldung) status.textContent = meldung;
        }

        function nachRechner() {
          Promise.resolve().then(function () {
            rechnerZeigt = !fehlerMin.hidden;
            abgleichen();
          });
        }
        wurzel.tpFormularAbgleichen = nachRechner;

        feld.addEventListener('input', nachRechner);
        wurzel.addEventListener('change', nachRechner);

        feld.addEventListener('blur', function () {
          wurdeVerlassen = true;
          abgleichen();
        });

        feld.addEventListener('focus', function () {
          // Neue Eingabe verdient einen unbelasteten Anfang.
          wurdeVerlassen = false;
          abgleichen();
        });

        abgleichen();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Der Rechner wird bei Variantenwechsel neu aufgebaut.
    document.addEventListener('change', function () {
      window.setTimeout(init, 200);
    });
  })();
</script>

<style>
  .tp-formular-hinweis {
    margin: 8px 0 0;
    font-size: 0.82rem;
    color: rgb(var(--color-foreground-rgb, 28 25 23) / 0.62);
  }
  .tp-formular-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
