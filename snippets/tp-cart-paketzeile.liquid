{%- doc -%}
  Klartextzeile fuer eine Warenkorbposition mit Paketware:
  "4 Originalpakete · Gesamtflaeche 20,00 m²".

  Bewusst aus item.quantity gerechnet und NICHT aus einer beim Hinzufuegen
  gespeicherten Line-Item-Property: Der Kunde kann die Menge im Warenkorb
  aendern, und eine mitgeschriebene Property waere danach falsch, ohne dass
  es jemand merkt. So kann Anzeige und Bestellmenge nicht auseinanderlaufen.

  @param {object} line_item - Warenkorbposition
{%- enddoc -%}
{%- liquid
  assign tp_cz_produkt = line_item.product
  assign tp_cz_paket_roh = tp_cz_produkt.metafields.custom.qm_pro_paket.value | append: ''
  assign tp_cz_paket = tp_cz_paket_roh | times: 1.0
  assign tp_cz_menge = line_item.quantity | times: 1
-%}
{%- if tp_cz_paket > 0 and tp_cz_menge > 0 -%}
  {%- liquid
    # TP-008: Nachkommastellen aus dem Rohtext des Metafelds ableiten (wie
    # snippets/tp-paketinhalt.liquid), statt fest auf Hundertstel zu runden.
    # Ein dreistelliges Paketmetafeld (z.B. 0,794 m²) braucht drei Stellen -
    # sonst verschwindet echte Praezision beim Wechsel in den Warenkorb
    # (16 x 1,892 m² zeigte bisher 30,27 statt 30,272 m²).
    if tp_cz_paket_roh contains '.'
      assign tp_cz_paket_rest = tp_cz_paket_roh | split: '.' | last
    else
      assign tp_cz_paket_rest = ''
    endif
    assign tp_cz_dezimalstellen = tp_cz_paket_rest.size | at_least: 2 | at_most: 3

    # Skalierte Ganzzahlarithmetik: die Paketflaeche wird einmalig auf ihre
    # eigene Praezision gerundet (Hundertstel oder Tausendstel) und danach nur
    # noch mit der ganzzahligen Menge multipliziert - kein Gleitkomma-Rest wie
    # 20,000000001 moeglich, weil die Multiplikation zweier Ganzzahlen exakt ist.
    assign tp_cz_skala = 100
    if tp_cz_dezimalstellen == 3
      assign tp_cz_skala = 1000
    endif
    assign tp_cz_paket_skaliert = tp_cz_paket | times: tp_cz_skala | round
    assign tp_cz_einheiten = tp_cz_paket_skaliert | times: tp_cz_menge

    assign tp_cz_ganz = tp_cz_einheiten | divided_by: tp_cz_skala
    assign tp_cz_rest_zahl = tp_cz_einheiten | modulo: tp_cz_skala
    assign tp_cz_rest = tp_cz_rest_zahl | append: ''
    # Fuehrende Nullen bis zur vollen Stellenzahl ("4" -> "04" bei Hundertstel,
    # "4" -> "004" bei Tausendstel) - sonst stuende "20,4" statt "20,04" da.
    if tp_cz_dezimalstellen == 3
      if tp_cz_rest_zahl < 10
        assign tp_cz_rest = tp_cz_rest | prepend: '00'
      elsif tp_cz_rest_zahl < 100
        assign tp_cz_rest = tp_cz_rest | prepend: '0'
      endif
    elsif tp_cz_rest_zahl < 10
      assign tp_cz_rest = tp_cz_rest | prepend: '0'
    endif
    assign tp_cz_flaeche = tp_cz_ganz | append: ',' | append: tp_cz_rest

    if tp_cz_menge == 1
      assign tp_cz_wort = 'Originalpaket'
    else
      assign tp_cz_wort = 'Originalpakete'
    endif

    assign tp_cz_stueck = tp_cz_produkt.metafields.custom.stueck_pro_paket.value | times: 1
    assign tp_cz_einheit = tp_cz_produkt.metafields.custom.stueck_bezeichnung.value | strip | default: 'Stück'
    assign tp_cz_format = tp_cz_produkt.metafields.custom.format_cm.value | strip
  -%}
  <div class="cart-items__paket">
    <span class="cart-items__paket-menge">{{ tp_cz_menge }} {{ tp_cz_wort }}</span>
    {%- if tp_cz_stueck > 0 -%}
      {%- assign tp_cz_stueck_gesamt = tp_cz_stueck | times: tp_cz_menge -%}
      <span>{{ tp_cz_stueck_gesamt }} {{ tp_cz_einheit }}{% if tp_cz_format != blank %} à&nbsp;{{ tp_cz_format | replace: ' ', '&nbsp;' }}{% endif %}</span>
    {%- endif -%}
    <span>Gesamtfläche: {{ tp_cz_flaeche }}&nbsp;m²</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-items__paket {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-top: 2px;
    font-size: 0.92em;
    line-height: 1.35;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.72);
  }

  .cart-items__paket-menge {
    font-weight: 600;
    color: var(--color-foreground, #222);
  }
{% endstylesheet %}
