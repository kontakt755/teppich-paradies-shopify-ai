{%- doc -%}
  Product media gallery content styles extracted into a standalone snippet.

  @example
  {% render 'product-media-gallery-content-styles' %}
{%- enddoc -%}

{% stylesheet %}
  media-gallery:where(.media-gallery--grid) .media-gallery__grid {
    display: none;
  }

  media-gallery.media-gallery--grid .media-gallery__grid .product-media-container {
    /* Needed for safari to stretch to full grid height */
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--two-column .media-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Display grid view as a carousel on mobile, grid on desktop */
    media-gallery:is(.media-gallery--grid) slideshow-component {
      display: none;
    }

    media-gallery:where(.media-gallery--grid) .media-gallery__grid {
      display: grid;
    }
  }

  .product-media-container__zoom-button {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: var(--layer-flat);
    cursor: zoom-in;
    background-color: transparent;

    &:hover {
      background-color: transparent;
    }
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  .product-media__drag-zoom-wrapper {
    aspect-ratio: inherit;
    min-height: inherit;
    min-width: inherit;
    display: inherit;
    flex: inherit;
  }

  .media-gallery__mobile-controls {
    grid-area: auto;
  }

  .product-media-container--zoomable.product-media-container--image {
    cursor: zoom-in;
  }

  media-gallery:not(.dialog-zoomed-gallery) .product-media-container .product-media {
    overflow: hidden;
    border-radius: var(--media-radius);
    background: rgb(var(--color-foreground-rgb) / 0.025);
  }

  media-gallery:not(.dialog-zoomed-gallery) .product-media-container .product-media__image {
    width: 100%;
    height: 100%;
    padding: clamp(10px, 2.5vw, 22px);
    object-fit: contain;
  }

  .media-gallery--carousel .product-media-gallery__arrows .slideshow-control {
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    margin-inline: 10px;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    background: rgb(var(--color-background-rgb) / 0.92);
    box-shadow: 0 3px 14px rgb(0 0 0 / 0.1);
    color: var(--color-foreground);
    opacity: 0.88;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .media-gallery--carousel .product-media-gallery__arrows .slideshow-control[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--carousel .product-media-gallery__arrows .slideshow-control {
      margin-inline: 14px;
    }

    .media-gallery--carousel slideshow-controls[thumbnails] .slideshow-controls__thumbnail {
      overflow: hidden;
      border-radius: var(--thumbnail-radius, 6px);
      background: rgb(var(--color-foreground-rgb) / 0.025);
    }

    .media-gallery--carousel slideshow-controls[thumbnails] .slideshow-controls__thumbnail img {
      object-fit: contain;
    }
  }

  /* Mobile-specific image sizing and responsiveness */
  @media screen and (max-width: 749px) {
    media-gallery .product-media-container {
      display: block;
      width: 100%;
      overflow: visible;
    }

    media-gallery slideshow-slide {
      display: block;
      width: 100%;
      height: auto;
    }

    .product-media {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: auto;
      min-height: 300px;
    }

    .product-media__image {
      max-width: 100%;
      width: 100% !important;
      height: auto !important;
    }

    media-gallery.media-gallery--grid .media-gallery__grid {
      grid-template-columns: 1fr !important;
      gap: 0.5rem;
    }
  }
  /*
    TP Galerie-Leiste (Handy): Hauptbild wischen, Nachbarbild blitzt rechts an,
    darunter eine Vorschauleiste statt Pfeilen und Zaehler. Jedes Bild ist mit
    einem Tipp erreichbar, das aktive Bild ist hervorgehoben.
  */
  @media screen and (max-width: 749px) {
    media-gallery.tp-galerie-leiste {
      --slideshow-gap: 8px;
    }

    media-gallery.tp-galerie-leiste slideshow-slide.product-media-container:not(:only-child) {
      width: 86%;
      flex: 0 0 86%;
    }

    media-gallery.tp-galerie-leiste .product-media-gallery__arrows {
      display: none;
    }

    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] {
      --thumbnail-width: 60px;

      margin-block-start: 10px;
    }

    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] .slideshow-controls__thumbnails-container {
      scroll-behavior: smooth;
      scroll-padding-inline: 16px;
      mask-image: linear-gradient(90deg, transparent 0, #000 12px, #000 calc(100% - 20px), transparent 100%);
    }

    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] .slideshow-controls__thumbnails {
      gap: 8px;
      padding: 4px 16px 6px;
      margin-inline: 0;
    }

    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] .slideshow-controls__thumbnail {
      flex: 0 0 auto;
      width: var(--thumbnail-width);
      aspect-ratio: 1;
      overflow: hidden;
      border: 0;
      border-radius: 10px;
      outline: 0;
      background: rgb(var(--color-foreground-rgb) / 0.04);
      box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.08);
      opacity: 0.55;
      transform: scale(0.92);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] .slideshow-controls__thumbnail img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: inherit;
    }

    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] .slideshow-controls__thumbnail[aria-selected='true'] {
      opacity: 1;
      transform: scale(1);
      outline: 0;
      box-shadow:
        0 0 0 2px var(--color-background),
        0 0 0 4px var(--color-foreground);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    media-gallery.tp-galerie-leiste slideshow-controls[thumbnails] .slideshow-controls__thumbnail {
      transition: none;
    }
  }
{% endstylesheet %}
