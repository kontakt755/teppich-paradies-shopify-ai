{% doc %}
  Kuratierte Navigation fuer "Bodenleisten" - Desktop-Megamenue und mobiler
  Drawer teilen sich hier dieselbe Struktur.

  Warum eigenes Snippet statt Menuepflege in Shopify: Das Hauptmenue ist
  shopweit und wird von allen Themes benutzt. Die Auswahl wird deshalb im
  Theme getroffen, das globale Menue bleibt unangetastet.

  Was gezeigt wird, kommt vollstaendig aus dem Sortiment
  (collections.bodenleisten, Tags "material:" und "hoehe:"), gelesen ueber
  'tp-leisten-merkmale' - dieselbe Quelle wie die Einstiege auf der
  Kategorieseite. Es entstehen nur Gruppen, die es wirklich gibt, jeweils mit
  Trefferzahl. Nichts ist fest verdrahtet.

  Die Ziele sind belegte, funktionierende Adressen:
  - /collections/bodenleisten
  - /collections/bodenleisten#leisten:material=<key> bzw. #leisten:hoehe=<key>
    Diese Hashes wertet assets/tp-leisten-filter.js aus (beim Laden und bei
    hashchange). Search & Discovery kennt fuer diese Kategorie nur Preis und
    Verfuegbarkeit, echte Filter-URLs gibt es fuer Material und Hoehe also
    nicht. Steht man schon auf der Kategorieseite, schliesst das Handy-Menue
    beim Tippen selbst (snippets/tp-drawer-nav.liquid).
  - Profile fuer Uebergaenge und Kanten: die Unterpunkte des Menuepunkts, die
    auf eine Profil-Kollektion zeigen und Produkte haben
    (zubehoer-uebergangsprofile, zubehoer-abschlussprofile). Bis 2026-09-11
    fehlten sie hier, weil sie frueher als Filterlinks ins Leere zeigten; seit
    #123 fuehren sie auf die richtigen Kollektionen (Audit 2026-09-11, #193).

  Bewusst nicht enthalten: "Kleber & Fixierung" - das sind Klebstoffe fuer
  Bodenbelaege, nicht fuer Leisten; sie stehen unter "Zubehoer". Ebenso
  entfaellt der doppelte Einstieg "Sockelleisten": er fuehrt zum selben
  Sortiment wie "Alle Bodenleisten". Desktop und Handy nennen den Einstieg
  gleich ("Alle Bodenleisten"), bis 2026-09-11 hiess er am Handy anders.

  @param {string} variant - 'megamenu' (Desktop) oder 'drawer' (mobil)
  @param {object} [parent_link] - Menuepunkt, liefert Titel, Ziel und Profil-Unterpunkte
  @param {object} [kacheln] - block.blocks des Header-Menue-Blocks (Bildkachel fuer die Einstiegskarte)
{% enddoc %}

{%- liquid
  assign tp_ln_collection = collections.bodenleisten
  assign tp_ln_url = parent_link.url | default: '/collections/bodenleisten'
  assign tp_ln_title = parent_link.title | default: 'Bodenleisten'

  assign tp_ln_m_keys = ''
  assign tp_ln_m_labels = ''
  assign tp_ln_h_keys = ''
  assign tp_ln_h_labels = ''

  for p in tp_ln_collection.products
    capture tp_ln_raw
      render 'tp-leisten-merkmale', product: p
    endcapture
    assign tp_ln_parts = tp_ln_raw | strip | split: '|'
    assign tp_ln_m_key = tp_ln_parts[3] | strip
    assign tp_ln_h_key = tp_ln_parts[4] | strip

    if tp_ln_m_key != blank
      assign tp_ln_probe = '|' | append: tp_ln_m_key | append: '|'
      assign tp_ln_hay = '|' | append: tp_ln_m_keys | append: '|'
      unless tp_ln_hay contains tp_ln_probe
        assign tp_ln_m_keys = tp_ln_m_keys | append: tp_ln_m_key | append: '|'
        assign tp_ln_m_labels = tp_ln_m_labels | append: tp_ln_parts[0] | strip | append: '|'
      endunless
    endif
    if tp_ln_h_key != blank
      assign tp_ln_probe = '|' | append: tp_ln_h_key | append: '|'
      assign tp_ln_hay = '|' | append: tp_ln_h_keys | append: '|'
      unless tp_ln_hay contains tp_ln_probe
        assign tp_ln_h_keys = tp_ln_h_keys | append: tp_ln_h_key | append: '|'
        assign tp_ln_h_labels = tp_ln_h_labels | append: tp_ln_parts[1] | strip | append: '|'
      endunless
    endif
  endfor

  assign tp_ln_m_key_list = tp_ln_m_keys | split: '|'
  assign tp_ln_m_label_list = tp_ln_m_labels | split: '|'
  assign tp_ln_h_key_list = tp_ln_h_keys | split: '|'
  assign tp_ln_h_label_list = tp_ln_h_labels | split: '|'

  comment
    Hoehen numerisch sortieren, damit die Reihe nicht der zufaelligen
    Produktreihenfolge folgt. Unbekannte Werte haengen hinten an.
  endcomment
  assign tp_ln_h_order = '40mm|60mm|60mm-xl|80mm|80mm-xl|100mm|120mm' | split: '|'
  assign tp_ln_h_sorted_str = ''
  for o in tp_ln_h_order
    for k in tp_ln_h_key_list
      if k == o
        assign tp_ln_h_sorted_str = tp_ln_h_sorted_str | append: k | append: '|'
      endif
    endfor
  endfor
  for k in tp_ln_h_key_list
    assign tp_ln_probe = '|' | append: k | append: '|'
    assign tp_ln_hay = '|' | append: tp_ln_h_sorted_str | append: '|'
    unless tp_ln_hay contains tp_ln_probe
      assign tp_ln_h_sorted_str = tp_ln_h_sorted_str | append: k | append: '|'
    endunless
  endfor
  assign tp_ln_h_sorted = tp_ln_h_sorted_str | split: '|'
-%}

{%- capture tp_ln_materials -%}
  {%- for m_key in tp_ln_m_key_list -%}
    {%- liquid
      assign m_label = tp_ln_m_label_list[forloop.index0]
      assign m_count = 0
      for p in tp_ln_collection.products
        for tag in p.tags
          assign tag_down = tag | downcase
          if tag_down contains 'material:'
            assign v = tag_down | remove: 'material:' | strip
            if v == m_key
              assign m_count = m_count | plus: 1
            endif
          endif
        endfor
      endfor
    -%}
    <li>
      <a class="tp-nav-link" href="{{ tp_ln_url }}#leisten:material={{ m_key | url_encode }}">
        <span class="tp-nav-link__text">{{ m_label | escape }}</span>
        <span class="tp-nav-link__count" aria-hidden="true">{{ m_count }}</span>
        <span class="visually-hidden">{{ m_count }} {% if m_count == 1 %}Produkt{% else %}Produkte{% endif %}</span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture tp_ln_hoehen -%}
  {%- for h_key in tp_ln_h_sorted -%}
    {%- liquid
      assign h_label = ''
      for k in tp_ln_h_key_list
        if k == h_key
          assign h_label = tp_ln_h_label_list[forloop.index0]
        endif
      endfor
      assign h_count = 0
      for p in tp_ln_collection.products
        for tag in p.tags
          assign tag_down = tag | downcase
          if tag_down contains 'hoehe:'
            assign v = tag_down | remove: 'hoehe:' | strip
            if v == h_key
              assign h_count = h_count | plus: 1
            endif
          endif
        endfor
      endfor
    -%}
    <li>
      <a class="tp-nav-chip" href="{{ tp_ln_url }}#leisten:hoehe={{ h_key | url_encode }}">
        <span>{{ h_label | escape }}</span>
        <span class="tp-nav-chip__count" aria-hidden="true">{{ h_count }}</span>
        <span class="visually-hidden">{{ h_count }} {% if h_count == 1 %}Produkt{% else %}Produkte{% endif %}</span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture tp_ln_profile -%}
  {%- for c in parent_link.links -%}
    {%- if c.type == 'collection_link' and c.object.handle contains 'profile' and c.object.all_products_count > 0 -%}
      <li>
        <a class="tp-nav-link" href="{{ c.url }}">
          <span class="tp-nav-link__text">{{ c.title | escape }}</span>
          <span class="tp-nav-link__count" aria-hidden="true">{{ c.object.all_products_count }}</span>
          <span class="visually-hidden">{{ c.object.all_products_count }} Produkte</span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if variant == 'drawer' -%}
  <a class="tp-dn-cta" href="{{ tp_ln_url }}">
    <span class="tp-dn-cta__text">Alle {{ tp_ln_title | escape }} ansehen</span>
    {%- if tp_ln_collection.all_products_count > 0 -%}
      <span class="tp-dn-cta__count">{{ tp_ln_collection.all_products_count }}<span class="visually-hidden"> Produkte</span></span>
    {%- endif -%}
  </a>
  {%- if tp_ln_m_key_list.size > 0 -%}
    <p class="tp-nav-group">Nach Material</p>
    <ul class="tp-nav-links list-unstyled" role="list" aria-label="Nach Material">
      {{- tp_ln_materials -}}
    </ul>
  {%- endif -%}
  {%- if tp_ln_h_sorted.size > 0 -%}
    <p class="tp-nav-group">Nach Höhe</p>
    <ul class="tp-nav-chips list-unstyled" role="list" aria-label="Nach Höhe">
      {{- tp_ln_hoehen -}}
    </ul>
  {%- endif -%}
  {%- if tp_ln_profile != blank -%}
    <p class="tp-nav-group">Profile für Übergänge und Kanten</p>
    <ul class="tp-nav-links list-unstyled" role="list" aria-label="Profile für Übergänge und Kanten">
      {{- tp_ln_profile -}}
    </ul>
  {%- endif -%}
{%- else -%}
  <div class="tp-lnav" data-testid="tp-leisten-nav">
    <div class="tp-lnav__col tp-lnav__col--lead">
      {%- comment -%}
        Einstiegskarte mit Bild: Bildkachel (Block _tp-menu-kachel) fuer den Menuepunkt,
        sonst Kollektions- bzw. erstes Produktbild. Ohne Bild bleibt die Karte Text.
      {%- endcomment -%}
      {%- capture tp_ln_img -%}
        {%- render 'tp-menu-bild', link: parent_link, kacheln: kacheln, class: 'tp-lnav__all-image', sizes: '(min-width: 990px) 20rem, 50vw' -%}
      {%- endcapture -%}
      <a class="tp-lnav__all{% if tp_ln_img contains '<img' %} tp-lnav__all--media{% endif %}" href="{{ tp_ln_url }}">
        {%- if tp_ln_img contains '<img' -%}
          <span class="tp-lnav__all-media">{{ tp_ln_img }}</span>
        {%- endif -%}
        <span class="tp-lnav__all-title">Alle {{ tp_ln_title | escape }}</span>
        {%- if tp_ln_collection.all_products_count > 0 -%}
          <span class="tp-lnav__all-meta">{{ tp_ln_collection.all_products_count }} Sockelleisten im Sortiment</span>
        {%- endif -%}
      </a>
    </div>

    {%- if tp_ln_m_key_list.size > 0 -%}
      <div class="tp-lnav__col">
        <p class="tp-nav-group" id="tp-lnav-material">Nach Material</p>
        <ul class="tp-nav-links list-unstyled" role="list" aria-labelledby="tp-lnav-material">
          {{- tp_ln_materials -}}
        </ul>
      </div>
    {%- endif -%}

    {%- if tp_ln_h_sorted.size > 0 -%}
      <div class="tp-lnav__col tp-lnav__col--wide">
        <p class="tp-nav-group" id="tp-lnav-hoehe">Nach Höhe</p>
        <ul class="tp-nav-chips list-unstyled" role="list" aria-labelledby="tp-lnav-hoehe">
          {{- tp_ln_hoehen -}}
        </ul>
      </div>
    {%- endif -%}

    {%- if tp_ln_profile != blank -%}
      <div class="tp-lnav__col tp-lnav__col--profile">
        <p class="tp-nav-group" id="tp-lnav-profile">Profile für Übergänge und Kanten</p>
        <ul class="tp-nav-links list-unstyled" role="list" aria-labelledby="tp-lnav-profile">
          {{- tp_ln_profile -}}
        </ul>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
