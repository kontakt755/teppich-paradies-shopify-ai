{% doc %}
  Globale Vergleichsleiste + Modal (max. 3 Produkte), rein clientseitig via
  localStorage. Kein neues Template/Route, keine Serverlogik - passt daher
  ohne Architekturumbau in den bestehenden Theme-Aufbau (analog zum
  bestehenden search-modal/quick-add-modal-Muster in layout/theme.liquid).
{% enddoc %}

<div class="tp-compare-bar" data-tp-compare-bar hidden>
  <button class="tp-compare-bar__compact" type="button" data-tp-compare-expand aria-label="Produktvergleich ausklappen" aria-expanded="false">
    <span aria-hidden="true">⇄</span>
    <span>Vergleich <span data-tp-compare-count>0</span></span>
  </button>
  <div class="tp-compare-bar__full">
    <span>⇄ Vergleich <span data-tp-compare-count>0</span></span>
    <button type="button" data-tp-compare-open>Vergleichen anzeigen</button>
    <button class="tp-compare-bar__dismiss" type="button" data-tp-compare-collapse aria-label="Vergleichsleiste minimieren">×</button>
  </div>
</div>

<dialog class="tp-compare-dialog" data-tp-compare-dialog id="tp-compare-dialog">
  <div class="tp-compare-dialog__header">
    <h2>Produktvergleich</h2>
    <button type="button" data-tp-compare-close aria-label="Schließen">×</button>
  </div>
  <div class="tp-compare-dialog__body" data-tp-compare-table></div>
</dialog>

<script src="{{ 'tp-compare.js' | asset_url }}" defer="defer"></script>

<style>
  .tp-compare-bar {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 30;
    display: block;
    padding: 6px;
    background: #1f1e1b;
    color: #ffffff;
    border-radius: 999px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    font-size: 13px;
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .tp-compare-bar[hidden] {
    display: none !important;
  }

  .tp-compare-bar__full {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-left: 10px;
  }

  .tp-compare-bar__compact {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
  }

  .tp-compare-bar[data-collapsed='true'] .tp-compare-bar__full {
    display: none;
  }

  .tp-compare-bar[data-collapsed='true'] .tp-compare-bar__compact {
    display: flex;
  }

  .tp-compare-bar button {
    border: 0;
    background: #b4976c;
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
  }

  .tp-compare-bar__compact:focus-visible,
  .tp-compare-bar button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .tp-compare-bar .tp-compare-bar__dismiss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    min-height: 44px;
    padding: 0;
    background: transparent;
    font-size: 22px;
    line-height: 1;
  }

  .tp-compare-dialog {
    width: min(920px, 92vw);
    max-height: 85vh;
    border: 0;
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
  }

  .tp-compare-dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .tp-compare-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.12);
  }

  .tp-compare-dialog__header h2 {
    margin: 0;
    font-size: 18px;
  }

  .tp-compare-dialog__header button {
    border: 0;
    background: transparent;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .tp-compare-dialog__body {
    padding: 16px 20px 24px;
    overflow: auto;
    max-height: calc(85vh - 60px);
  }

  .tp-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .tp-compare-table th,
  .tp-compare-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.1);
    vertical-align: top;
  }

  .tp-compare-table thead th {
    font-size: 14px;
    font-weight: 700;
  }

  .tp-compare-table tbody th {
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.7);
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .tp-compare-bar {
      left: 12px;
      right: 12px;
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
      transform: none;
    }

    .tp-compare-bar[data-collapsed='true'] {
      left: auto;
      width: fit-content;
    }

    .tp-compare-bar__full {
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-compare-bar {
      transition: none;
    }
  }
</style>
