{%- doc -%}
  Feiertage, an denen das Fachgeschaeft geschlossen ist (Brandenburg: an
  Feiertagen kein Ladenverkauf). Liste nach Angabe des Inhabers, Stand
  2026-10-22: 31.10., 25.12., 26.12., 01.01. Fuer 24.12. und 31.12. fehlen
  noch die Uhrzeiten - erst eintragen, wenn sie feststehen.
  Vergangene Tage fallen von selbst heraus; die Liste jaehrlich fortschreiben.

  @param {string} ausgabe - 'schema': Eintraege fuer openingHoursSpecification,
    jeder mit fuehrendem Komma (an die regulaeren Zeiten anhaengen);
    'hinweis': ein Satz, wenn ein Schliesstag in den naechsten 7 Tagen liegt.
{%- enddoc -%}
{%- liquid
  assign tpst_liste = '2026-10-31|Reformationstag,2026-12-25|1. Weihnachtsfeiertag,2026-12-26|2. Weihnachtsfeiertag,2027-01-01|Neujahr' | split: ','
  assign tpst_jetzt = 'now' | date: '%s' | plus: 0
  assign tpst_bald = tpst_jetzt | plus: 604800
  assign tpst_wochentage = 'Sonntag,Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag' | split: ','
-%}
{%- for tpst_eintrag in tpst_liste -%}
  {%- liquid
    assign tpst_teile = tpst_eintrag | split: '|'
    assign tpst_tag = tpst_teile[0]
    assign tpst_beginn = tpst_tag | date: '%s' | plus: 0
    assign tpst_ende = tpst_beginn | plus: 86400
  -%}
  {%- if tpst_ende > tpst_jetzt -%}
    {%- if ausgabe == 'schema' -%}
      ,{ "@type": "OpeningHoursSpecification", "validFrom": {{ tpst_tag | json }}, "validThrough": {{ tpst_tag | json }}, "opens": "00:00", "closes": "00:00" }
    {%- elsif ausgabe == 'hinweis' and tpst_beginn <= tpst_bald -%}
      {%- assign tpst_wt = tpst_tag | date: '%w' | plus: 0 -%}
      <p class="tp-sondertag" role="note">Am {{ tpst_wochentage[tpst_wt] }}, {{ tpst_tag | date: '%d.%m.' }} ({{ tpst_teile[1] }}), ist unser Fachgeschäft geschlossen.</p>
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{% stylesheet %}
  .tp-sondertag {
    margin: 6px 0 0;
    font-size: var(--tp-fs-sm);
    font-weight: 500;
  }
{% endstylesheet %}
