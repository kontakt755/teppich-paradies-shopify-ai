{% doc %}
  Seitenweite Gestaltungsregeln der Design-Runde 3 (Audit V2, V5, V9).
  Eingebunden ueber eine Zeile in layout/theme.liquid; die Zeile zu
  entfernen nimmt alles zurueck.

  Farben kommen aus den Theme-Einstellungen (TP Gestaltung), nicht aus
  festen Werten in einzelnen Bausteinen.
{% enddoc %}

<style>
  :root {
    --tp-hauptaktion: {{ settings.tp_hauptaktion_farbe | default: '#B0303F' }};
    --tp-hauptaktion-hover: {{ settings.tp_hauptaktion_hover | default: '#962836' }};
  }

  /* Schriftskala (Shopvergleich F, 2026-10-15): sechs Stufen statt rund
     20 Groessen je Seite. tp-Bausteine setzen font-size nur noch ueber
     diese Variablen; die Horizon-Typografie (h1-h6, Absatz, feste Stufen
     --font-size--*) zeigt auf dieselben Stufen. Die Typografie in
     config/settings_data.json bleibt unberuehrt - sie wird nicht deployt.
     Gewichte: Fliesstext 400, Beschriftungen 500, Ueberschriften 600/700. */
  :root {
    --tp-fs-xs: 12px;  /* Kleingedrucktes, Kartenmerkmale, Plaketten */
    --tp-fs-sm: 14px;  /* Beschriftungen, Nebeninfos, Breadcrumb */
    --tp-fs-md: 16px;  /* Fliesstext, Knoepfe, Kartentitel */
    --tp-fs-lg: 20px;  /* Preise, Zwischenueberschriften */
    --tp-fs-xl: 28px;  /* Seiten- und Abschnittsueberschriften */
    --tp-fs-2xl: 40px; /* Startseiten-Titel */

    --font-size--paragraph: var(--tp-fs-md);
    --font-size--h1: var(--tp-fs-2xl);
    --font-size--h2: var(--tp-fs-xl);
    --font-size--h3: var(--tp-fs-xl);
    --font-size--h4: var(--tp-fs-lg);
    --font-size--h5: var(--tp-fs-sm);
    --font-size--h6: var(--tp-fs-xs);
    --font-size--3xs: var(--tp-fs-xs);
    --font-size--2xs: var(--tp-fs-xs);
    --font-size--xs: var(--tp-fs-sm);
    --font-size--sm: var(--tp-fs-sm);
    --font-size--md: var(--tp-fs-md);
    --font-size--lg: var(--tp-fs-lg);
    --font-size--xl: var(--tp-fs-lg);
    --font-size--2xl: var(--tp-fs-xl);
    --font-size--3xl: var(--tp-fs-xl);
    --font-size--4xl: var(--tp-fs-2xl);
    --font-size--5xl: var(--tp-fs-2xl);
    --font-size--6xl: var(--tp-fs-2xl);
  }
  /* Ueberschriften brechen ausgeglichen um - mit der Skala rutschte sonst
     z. B. "zu" aus "Mass eingeben, wir schneiden zu" allein in Zeile zwei. */
  main :is(h1, h2, h3, h4, [role='heading']) { text-wrap: balance; }

  /* Gewichte nur 400/500/600/700: <b>/<strong> sind im Browser "bolder" und
     wurden in halbfettem Umfeld 900 (z. B. "4,9" in der Startseiten-
     Bewertung). Ohne Spezifitaet - jede eigene Regel geht vor. */
  :where(main) :where(b, strong) { font-weight: 700; }

  /* Am Telefon: kleinste Stufe 13 px (V9), grosse Stufen kleiner. */
  @media screen and (max-width: 749px) {
    :root {
      --tp-fs-xs: 13px;
      --tp-fs-lg: 18px;
      --tp-fs-xl: 24px;
      --tp-fs-2xl: 30px;
    }
  }

  /* V2: "In den Warenkorb" ist die Hauptaktion - ueberall dieselbe Farbe,
     auch in der Kaufleiste am Telefon. Die Variablen speisen die Horizon-
     Regeln fuer .button, Hover und Fokus bleiben dadurch intakt. */
  .add-to-cart-button {
    --color-primary-button-background: var(--tp-hauptaktion);
    --color-primary-button-border: var(--tp-hauptaktion);
    --color-primary-button-text: #ffffff;
    --color-primary-button-hover-background: var(--tp-hauptaktion-hover);
    --color-primary-button-hover-border: var(--tp-hauptaktion-hover);
    --color-primary-button-hover-text: #ffffff;
  }

  /* V9: Versal-Labels werden normal geschriebene, halbfette Labels in
     Stufe sm (14 px). Badges und Marken bleiben, wie sie sind. */
    html body .tp-br__label,
    html body .tp-bp__ursachen-label,
    html body .tp-bw-suche__art,
    html body .tp-category-copy__label,
    html body .tp-ek__mass-label,
    html body .tp-ek__summe span,
    html body .tp-ew__titel,
    html body .tp-farbanzeige__label,
    html body .tp-lb__tipp-label,
    html body .tp-le__label,
    html body .tp-lhero__eyebrow,
    html body .tp-lex-nav__gruppe,
    html body .menu-drawer .tp-dn__label,
    html body .tp-nav-group,
    html body .tp-rg-fakten__punkt dt,
    html body .tp-rg-kopf__art,
    html body .tp-rg-kurz__label,
    html body .tp-rg-toc__titel,
    html body .tp-rg-karte__art,
    html body .tp-ra-calc-total-label,
    html body .tp-seo__h4,
    html body .tp-step-heading__label,
    html body .tp-se__artikel-art,
    html body .tp-se__h,
    html body [class*="tp-teppich-aeb__label-"],
    html body [class*="tp-teppich-pd__key-"],
    html body .tp-tep-kicker,
    html body .tp-vs-tabelle thead th,
    html body [class*="eyebrow"],
    html body [class*="carpet-package__results-title"],
    html body .details__header {
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--tp-fs-sm);
    font-weight: 600;
  }

  /* V9: kein Grau heller als #595959. Deaktivierte Filteroptionen bleiben
     bewusst blasser. */
  html body .tp-bc__link,
  html body .tp-bc__stufe,
  html body .tp-product-breadcrumb,
  html body .tp-product-breadcrumb :is(a, span),
  html body .facets__disabled-hint,
  html body .facets .checkbox__label-text,
  html body .tp-card-product-kind,
  html body .tp-roll-order-help__measure-note {
    color: #595959;
    opacity: 1;
  }

  /* Inhaber 2026-09-28: Aktion auffaellig. Der alte Preis bleibt grau
     durchgestrichen, der neue Preis - den der Kunde zahlt - steht rot und
     fett daneben, dazu das Schild "-X %". #c8102e hat 5,9:1 Kontrast. */
  html body .compare-at-price,
  html body .price-with-unit__compare,
  html body .tp-price-per-sqm__compare {
    color: #595959;
    opacity: 1;
    font-weight: 400;
  }
  html body .price__sale .price-item--sale,
  html body .price__sale .price-item--sale :is(.price-card-per-unit, .price-card-from),
  html body .price-with-unit__compare:not([hidden]) ~ .price-with-unit__current,
  html body .tp-price-per-sqm:has(.tp-price-per-sqm__compare) .tp-price-per-sqm__amount,
  html body .tp-ab-preis:has(.tp-ab-preis__alt) .tp-ab-preis__betrag,
  html body .tp-ek__summe-werte:has(.tp-ek__summe-alt:not([hidden])) [data-summe],
  html body .tp-preis-neu {
    color: #c8102e;
    font-weight: 700;
  }
  html body .facets .checkbox__input:disabled ~ .checkbox__label .checkbox__label-text,
  html body .facets .checkbox--disabled .checkbox__label-text {
    color: rgb(0 0 0 / 0.4);
  }

  /* V9: Akkordeon-Kopfzeilen (Beschreibung, Technische Daten ...) standen
     bei 12 px - sie sind Ueberschriften, keine Fussnoten. */
  html body .accordion .details__header {
    font-size: var(--tp-fs-md);
    font-weight: 600;
  }

  /* V9: kein Text unter 12 px, am Telefon nicht unter 13 px (Stufe xs).
     Grundpreis (Horizon: 0.85em der Preiszeile) stand bei 10,2 px. */
  html body .unit-price,
  html body .tp-card-product-kind,
  html body .tp-card-roll-widths__label,
  html body .tp-card-roll-widths__values,
  html body [class*="tp-pit-lexikon__titel"],
  html body .tp-lex-inline__link {
    font-size: var(--tp-fs-xs);
  }
  @media screen and (max-width: 749px) {
    html body .tp-kat__n,
    html body .tp-card-product-kind,
    html body .tp-card-roll-widths__label,
    html body .tp-card-roll-widths__values,
    html body .tp-card-title__linie,
    html body .tp-card-actions__sample,
    html body .tp-price-card-package,
    html body .tp-muster__hinweis,
    html body .tp-s-note,
    html body .tp-bc,
    html body .tp-bc__link,
    html body .tp-price-per-sqm__label,
    html body [class*="tp-service-links"],
    html body [class*="tp-service-links"] :is(a, p, span, strong, summary),
    html body [class*="tp-muster-cta__hinweis"],
    html body .tp-preisangabe,
    html body .tp-preisangabe a,
    html body [class*="tp-pit-lexikon__titel"],
    html body .tp-lex-inline__link,
    html body .tp-roll-order-help__measure-note,
    html body [class*="tp-rwc-"] .tp-rwc-art-sub,
    html body [class*="tp-newsletter"] :is(p, a, small),
    html body [class*="tp-nl"] :is(p, a, small),
    html body .tp-hero small,
    html body .tp-trust .tp-trust__rating small,
    html body .tp-product-breadcrumb,
    html body .tp-product-breadcrumb :is(a, span),
    html body main small {
      font-size: var(--tp-fs-xs);
    }
  }

  /* V6: Leere Flaechen. Solange ein Kartenbild laedt (gedrosseltes Netz,
     Karussell, Reihe 3 und tiefer), steht eine ruhige Flaeche statt Weiss da,
     und das Rabatt-Badge erscheint erst mit dem Bild - vorher schwebte es
     ueber einer leeren Karte. Ohne JavaScript bleibt das Badge sichtbar. */
  .product-media-container { background: #f3f0eb; }
  .tp-rabatt-badge--karte { transition: opacity 0.2s ease; }
  html.tp-bild-warten :is(product-card, product-card-component, li):not([data-tp-bild-da]):not(:has([data-tp-bild-da])) .tp-rabatt-badge--karte { opacity: 0; }
  /* 2026-09-28: ohne :not(:has(...)) blieb das Badge im Kollektionsraster
     immer unsichtbar - das Raster-li wird nie markiert, nur die Karte darin. */

  {%- if request.page_type == 'collection' -%}
    /* F: Bildkarussells der Kategorieseiten (Unterkategorien wie Hochflor,
       Mittelflor, Kurzflor) in einem Format - vorher "Automatisch", also
       das Format jedes einzelnen Fotos (1,5 neben 1,33). 4:3 wie die
       Unterkategorie-Kacheln oben auf der Seite. */
    slideshow-component.carousel-content .image-block__image {
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }
  {%- endif -%}

  {%- if request.page_type == 'product' or request.page_type == 'collection' -%}
    /* V5: Rich-Text in Produkt- und Kategoriebeschreibungen - klare
       Hierarchie und eine lesbare Zeilenlaenge. */
    main .text-block.rte { max-width: 680px; }
    main .text-block.rte h2 { font-size: var(--tp-fs-lg); line-height: 1.3; margin: 1.4em 0 0.5em; }
    main .text-block.rte h3 { font-size: var(--tp-fs-md); font-weight: 600; line-height: 1.35; margin: 1.3em 0 0.4em; }
    main .text-block.rte h4 { font-size: var(--tp-fs-md); font-weight: 600; line-height: 1.4; margin: 1.2em 0 0.3em; }
    main .text-block.rte > :first-child { margin-top: 0; }
    /* V9: Listen in Beschreibungen immer mit Punkt bzw. Nummer. */
    main .text-block.rte ul { list-style: disc; padding-left: 1.25em; }
    main .text-block.rte ol { list-style: decimal; padding-left: 1.4em; }
    main .text-block.rte li { display: list-item; }
  {%- endif -%}
</style>

<script>
  (function () {
    document.documentElement.classList.add('tp-bild-warten');
    function markiere(img) {
      var karte = img.closest('product-card, product-card-component, li');
      if (karte) karte.setAttribute('data-tp-bild-da', '');
    }
    function istKartenbild(el) {
      return el && el.tagName === 'IMG' && el.classList.contains('product-media__image');
    }
    // load/error blubbern nicht - deshalb in der Capture-Phase am Dokument.
    ['load', 'error'].forEach(function (typ) {
      document.addEventListener(typ, function (e) { if (istKartenbild(e.target)) markiere(e.target); }, true);
    });
    function schonDa() {
      document.querySelectorAll('img.product-media__image').forEach(function (img) {
        if (img.complete) markiere(img);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schonDa);
    else schonDa();
  })();
</script>
