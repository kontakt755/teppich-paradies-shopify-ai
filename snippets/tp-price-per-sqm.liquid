{%- doc -%}
  Preisblock der Produktseite fuer Paketware.

  Die kundenseitige Leitgroesse ist der Quadratmeterpreis; darunter steht die
  Verkaufseinheit, die es tatsaechlich zu kaufen gibt. Shopify fuehrt intern
  weiterhin den Paketpreis als Variantenpreis - hier wird daraus nur die
  Anzeige abgeleitet.

  Die Zeile "1 Paket = ..." kommt aus snippets/tp-paketinhalt.liquid, damit
  Produktseite, Produktkarte und Warenkorb dieselbe Formulierung zeigen.

  @param {variant} selected_variant
  @param {number} sqm_per_package
  @param {object} product
{%- enddoc -%}

{%- liquid
  assign package_price = selected_variant.price
  assign package_compare_at_price = selected_variant.compare_at_price
  assign price_per_sqm = package_price | times: 1.0 | divided_by: sqm_per_package | round
  assign compare_per_sqm = blank
  assign show_compare_price = false
  if package_compare_at_price != blank and package_compare_at_price > package_price
    assign compare_per_sqm = package_compare_at_price | times: 1.0 | divided_by: sqm_per_package | round
    assign show_compare_price = true
  endif
-%}

<div class="tp-price-per-sqm">
  {% if show_compare_price %}
    <div class="tp-price-per-sqm__compare">
      {{ compare_per_sqm | money_without_currency }}&nbsp;€/m²
    </div>
  {% endif %}
  <div class="tp-price-per-sqm__unit">
    <span class="tp-price-per-sqm__amount">{{ price_per_sqm | money_without_currency }}</span>
    <span class="tp-price-per-sqm__label">€/m²</span>
  </div>
  <div class="tp-price-per-sqm__package">
    {{ package_price | money_without_currency }}&nbsp;€ pro Originalpaket
  </div>
  <div class="tp-price-per-sqm__content">
    {%- render 'tp-paketinhalt', product: product, sqm_per_package: sqm_per_package -%}
  </div>
</div>

{% stylesheet %}
  .tp-price-per-sqm__unit {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .tp-price-per-sqm__compare {
    margin-bottom: 2px;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.58);
    font-size: 0.82em;
    text-decoration: line-through;
  }

  .tp-price-per-sqm__amount {
    font-size: 1.3em;
    font-weight: 700;
  }

  .tp-price-per-sqm__label {
    font-size: 0.75em;
    font-weight: 400;
    opacity: 0.75;
  }

  /* Der Paketpreis ist die tatsaechlich kaufbare Einheit und traegt deshalb
     mehr Gewicht als eine Fussnote - aber weniger als der Leitpreis. */
  .tp-price-per-sqm__package {
    margin-top: 3px;
    font-size: 0.95em;
    font-weight: 600;
  }

  .tp-price-per-sqm__content {
    margin-top: 1px;
    font-size: 0.82em;
    font-weight: 400;
    opacity: 0.72;
  }
{% endstylesheet %}
