{%- doc -%}
  Eine Bildkarte des Megamenues - dasselbe Markup wie die Karten in
  snippets/mega-menu-list.liquid, damit assets/tp-mega-menu.css greift.
  Fuer kuratierte Untermenues (Linoleum, Kontakt), deren Punkte nicht aus der
  Navigation kommen. Ohne Bild erscheint der farbige Ersatz mit Initiale.

  @param {string} url - Ziel
  @param {string} title - Titel
  @param {string} [sub] - Kurztext unter dem Titel
  @param {string} [image_html] - fertiges img-Markup (z. B. aus tp-menu-bild)
  @param {string} [attrs] - zusaetzliche Attribute fuer den Link (z. B. rel/target)
  @param {string} [icon] - 'whatsapp' | 'phone' | 'pin': Symbolkachel statt Foto (Symbole aus tp-drawer-icon)
{%- enddoc -%}

<li class="mega-menu__column">
  <div class="tp-mm-card tp-mm-card--media">
    <a href="{{ url }}" class="mega-menu__link tp-mm-card__link" {{ attrs }}>
      <span class="tp-mm-card__media">
        {%- if icon != blank -%}
          <span class="tp-mm-card__icon tp-mm-card__icon--{{ icon }} mega-menu__link-image" aria-hidden="true">
            {%- render 'tp-drawer-icon', name: icon -%}
          </span>
        {%- elsif image_html contains '<img' -%}
          {{ image_html }}
        {%- else -%}
          <span class="tp-mm-card__placeholder mega-menu__link-image" aria-hidden="true">{{ title | strip | slice: 0, 1 | upcase }}</span>
        {%- endif -%}
      </span>
      <span class="tp-mm-card__body">
        <span class="tp-mm-card__title wrap-text">{{ title | escape }}</span>
        {%- if sub != blank -%}
          <span class="tp-mm-card__sub">{{ sub | escape }}</span>
        {%- endif -%}
      </span>
      <span class="tp-mm-card__arrow" aria-hidden="true"></span>
    </a>
  </div>
</li>
