{% doc %}
  Historischer Dateiname der frueheren Produktkachel. Der Newsletter steht nun
  ausschliesslich im Footer. Dieser Wrapper reicht dessen Block-Einstellungen
  unveraendert an das bestehende Formular weiter. Die alte Theme-Datei bleibt
  bis zu einem kontrollierten Remote-Dateiabgleich erhalten.

  @param {string} [ueberschrift] - Formularueberschrift.
  @param {string} [text] - Erklaerung unter der Ueberschrift.
  @param {string} [hinweis] - Einwilligungs- und Rabatt-Hinweis.
  @param {string} [button] - Beschriftung des Absende-Buttons.
  @param {string} [quelle] - Herkunft fuer Formular und Messung.
  @param {boolean} [kompakt] - Kompakte Darstellung im Footer.
  @param {string} [instanz] - Eindeutiger Suffix fuer die Formular-ID.
{% enddoc %}

{%- render 'tp-newsletter',
  ueberschrift: ueberschrift,
  text: text,
  hinweis: hinweis,
  button: button,
  quelle: quelle,
  kompakt: kompakt,
  instanz: instanz
-%}
