{% doc %}
  Liest die Kurzmerkmale einer Bodenleiste aus den Produkt-Tags und gibt sie
  als eine Zeile mit "|" als Trenner aus: material|hoehe|farbenanzahl|material_key|hoehe_key.

  Tags im Sortiment (Stand 2026-09-09): "material: kunststoff|mdf|hartschaum",
  "hoehe: 40mm|60mm|60mm-xl|80mm|80mm-xl|100mm". Nur vorhandene Werte werden
  ausgegeben, nichts wird erfunden. Die Farbenanzahl kommt aus der Option
  "Farbe" bzw. "Dekor".

  Ohne hoehe-Tag kommt die Hoehe aus dem Metafeld custom.leistenhoehe
  (z. B. "58 mm", seit 2026-10-08 bei allen Leisten mit belegtem Mass). Dann
  bleibt hoehe_key leer: Navigation und Vorschau gruppieren weiter nur nach
  den Tags, die Detailtabelle und die Karte zeigen die Hoehe trotzdem.

  @param {object} product - Produkt
{% enddoc %}
{%- liquid
  assign tp_lm_material = ''
  assign tp_lm_material_key = ''
  assign tp_lm_hoehe = ''
  assign tp_lm_hoehe_key = ''

  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down contains 'material:'
      assign tp_lm_material_key = tag_down | remove: 'material:' | strip
      case tp_lm_material_key
        when 'kunststoff'
          assign tp_lm_material = 'Kunststoff'
        when 'mdf'
          assign tp_lm_material = 'MDF Holzdekor'
        when 'hartschaum'
          assign tp_lm_material = 'Hartschaum'
        when 'hdf'
          assign tp_lm_material = 'HDF'
        else
          assign tp_lm_material = tp_lm_material_key | capitalize
      endcase
    elsif tag_down contains 'hoehe:'
      assign tp_lm_hoehe_key = tag_down | remove: 'hoehe:' | strip
      assign tp_lm_hoehe = tp_lm_hoehe_key | replace: 'mm-xl', ' mm XL' | replace: 'mm', ' mm'
    endif
  endfor

  if tp_lm_hoehe == blank
    assign tp_lm_hoehe = product.metafields.custom.leistenhoehe.value | strip
  endif

  assign tp_lm_farben = 0
  for option in product.options_with_values
    if option.name == 'Farbe' or option.name == 'Dekor'
      assign tp_lm_farben = option.values | size
    endif
  endfor
-%}
{{ tp_lm_material }}|{{ tp_lm_hoehe }}|{{ tp_lm_farben }}|{{ tp_lm_material_key }}|{{ tp_lm_hoehe_key }}
