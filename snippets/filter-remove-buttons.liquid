{%- doc -%}
  Renders filter remove buttons.

  Accepts:

  @param {object} filters - The filters to render
  @param {boolean} show_filter_label - Whether to show the filter label
  @param {string} results_url - The results URL
  @param {boolean} should_show_clear_all - Whether to show the clear all button
{%- enddoc -%}

<div class="facets-remove facets-remove--mobile-and-vertical">
  {%- if filters -%}
    <h3 class="visually-hidden">{{ 'accessibility.active_filters' | t }}</h3>
  {%- endif -%}

  {%- for filter in filters -%}
    {% if filter.type == 'price_range' and filter.min_value.value != null or filter.max_value.value != null %}
      {%- liquid
        assign is_active = true
      -%}
      <facet-remove-component
        class="
          pills__pill
          pills__pill--desktop-small
          facets-remove__pill
        "
        data-url="{{ filter.url_to_remove }}"
        tabindex="0"
        role="button"
        on:click="/removeFilter?form="
        on:keydown="/removeFilter?form="
      >
        {%- if filter.min_value.value != null and filter.max_value.value != null %}
          {{- filter.min_value.value | money -}}
          –
          {{- filter.max_value.value | money -}}
        {%- elsif filter.min_value.value != null -%}
          {{ filter.min_value.value | money }}–{{ filter.range_max | money }}
        {%- elsif filter.max_value.value != null -%}
          {{- 0 | money -}}
          –
          {{- filter.max_value.value | money -}}
        {%- endif -%}
        <span class="svg-wrapper svg-wrapper--smaller">
          {{- 'icon-filters-close.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'actions.remove' | t }}</span>
      </facet-remove-component>
    {% else %}
      {%- liquid
        # Audit 13.10.: zusammengefasste Masswerte (tp-filter-wertgruppen) als ein Chip
        assign tp_wg = ''
        if filter.active_values.size > 0
          capture tp_wg_roh
            render 'tp-filter-wertgruppen', filter: filter
          endcapture
          assign tp_wg = tp_wg_roh | strip | split: ';'
        endif
        assign tp_wg_genutzt = false
        if tp_wg.size == filter.values.size and tp_wg.size > 0
          assign tp_wg_genutzt = true
        endif
      -%}
      {%- for value in filter.active_values -%}
        {%- liquid
          assign tp_wg_mitwerte = ''
          assign tp_wg_t = 'N'
          if tp_wg_genutzt
            for tp_wg_v in filter.values
              if tp_wg_v.value == value.value
                assign tp_wg_t = tp_wg[forloop.index0]
                break
              endif
            endfor
            assign tp_wg_art = tp_wg_t | slice: 0
            if tp_wg_art == 'X'
              assign tp_wg_besitzer = tp_wg_t | remove_first: 'X' | plus: 0
              if filter.values[tp_wg_besitzer].active
                continue
              endif
            elsif tp_wg_art == 'R'
              assign tp_wg_teile = tp_wg_t | split: '~'
              assign tp_wg_mitwerte = tp_wg_teile[1]
            endif
          endif
          assign is_active = true
          assign tp_active_filter_value_label = value.label
          if filter.param_name == 'filter.v.m.custom.rollenbreite'
            assign tp_active_filter_value_label = value.value | times: 100 | round | append: ' cm'
          endif
        -%}
        <facet-remove-component
          class="
            pills__pill
            pills__pill--desktop-small
            facets-remove__pill
            {% if value.swatch %}pills__pill--swatch{% endif %}
          "
          data-url="{{ value.url_to_remove }}"
          {% if tp_wg_mitwerte != '' %}
            data-tp-mitwerte="{{ tp_wg_mitwerte | escape }}"
            data-tp-mitwerte-name="{{ value.param_name | escape }}"
          {% endif %}
          tabindex="0"
          role="button"
          on:click="/removeFilter?form="
          on:keydown="/removeFilter?form="
        >
          {% if value.swatch %}
            {% render 'swatch', swatch: value.swatch, mode: 'pill' %}
          {% endif %}

          {% if filter.type == 'boolean' or show_filter_label %}
            {%- if filter.param_name == 'filter.v.m.custom.rollenbreite' -%}
              Rollenbreite
            {%- else -%}
              {{ filter.label | escape }}
            {%- endif -%}: {{ tp_active_filter_value_label | escape }}
          {% else %}
            {{ tp_active_filter_value_label | escape }}
          {% endif %}

          <span class="svg-wrapper svg-wrapper--smaller">
            {{- 'icon-filters-close.svg' | inline_asset_content -}}
          </span>
          <span class="visually-hidden">{{ 'actions.remove' | t }}</span>
        </facet-remove-component>
      {%- endfor -%}
    {% endif %}
  {%- endfor -%}
  {% if should_show_clear_all and is_active %}
    <facet-remove-component
      data-url="{{ results_url }}"
      active-class="facets__clear-all-link--active"
    >
      <button
        type="button"
        class="button-unstyled facets__clear-all-link facets__clear-all-link--active"
        ref="clearButton"
        on:click="/removeFilter?form="
        on:keydown="/removeFilter?form="
      >
        {{- 'actions.clear_all' | t -}}
      </button>
    </facet-remove-component>
  {% endif %}
</div>

{% stylesheet %}
  /* Facets - Remove buttons */
  .facets-remove {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;

    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    padding: 0 var(--drawer-padding);
    margin: 0;

    @media screen and (min-width: 750px) {
      --variant-picker-swatch-width: 16px;
      --variant-picker-swatch-height: 16px;

      gap: var(--gap-2xs);
    }
  }

  .facets-remove:has(facet-remove-component) {
    display: flex;
    margin-block-start: var(--margin-2xs);
    margin-block-end: var(--margin-md);
  }

  .facets:not(.facets--drawer) .facets-remove--mobile-and-vertical {
    @media screen and (min-width: 750px) {
      padding: 0;
    }
  }

  .facets--horizontal .facets-remove--mobile-and-vertical {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .facets-remove__pill {
    .svg-wrapper,
    .swatch {
      flex-shrink: 0;
    }
  }

  .facets--horizontal .facets-remove {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }
{% endstylesheet %}
