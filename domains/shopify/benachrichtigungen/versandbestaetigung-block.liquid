{%- comment -%}
  Kundenseitiger Block fuer die Versandbestaetigung (Shop 2.0, M6/M19-20).

  Einsetzen: Admin -> Einstellungen -> Benachrichtigungen ->
  Kundenbenachrichtigungen -> "Versandbestaetigung" -> Code bearbeiten,
  direkt nach dem Header einfuegen. Der Standard-Trackingblock darf bleiben.
  Betreff: Ihre Bestellung {{ name }} ist unterwegs

  Zeigt je Sendung Versanddienstleister, Trackingnummer und Button, dazu den
  Speditionshinweis, wenn Rollenware oder Paletten in der Sendung sind (Art:
  Meterware/Raummass oder Versandart-Property). Fehlt eine Trackingnummer,
  steht das ehrlich da, mit Telefonnummer statt leerem Button.
{%- endcomment -%}

{%- liquid
  assign tp_v_spedition = false
  for line in fulfillment.fulfillment_line_items
    for p in line.line_item.properties
      if p.first == 'Art' and p.last == 'Meterware'
        assign tp_v_spedition = true
      endif
      if p.first == 'Art' and p.last == 'Raummaß'
        assign tp_v_spedition = true
      endif
    endfor
  endfor
  if fulfillment.tracking_company contains 'Spedition' or shipping_method.title contains 'Spedition'
    assign tp_v_spedition = true
  endif
  assign tp_v_anrede = 'Guten Tag'
  if shipping_address.first_name != blank
    assign tp_v_anrede = 'Guten Tag ' | append: shipping_address.first_name | append: ' ' | append: shipping_address.last_name
  endif
-%}

<div style="font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#15171a;">
  <p style="margin:0 0 12px;">{{ tp_v_anrede | strip | escape }},</p>
  <p style="margin:0 0 12px;font-size:18px;font-weight:bold;">Ihre Bestellung {{ name | escape }} ist unterwegs.</p>

  {%- if fulfillment.tracking_numbers.size > 0 -%}
    <p style="margin:0 0 8px;">Versand mit {{ fulfillment.tracking_company | default: 'unserem Versandpartner' | escape }}.</p>
    {%- for number in fulfillment.tracking_numbers -%}
      <p style="margin:0 0 8px;">Sendungsnummer: <strong>{{ number | escape }}</strong>
        {%- if fulfillment.tracking_urls[forloop.index0] != blank %}
          <br><a href="{{ fulfillment.tracking_urls[forloop.index0] }}" style="display:inline-block;margin-top:6px;padding:10px 18px;background:#15171a;color:#ffffff;text-decoration:none;border-radius:6px;">Sendung verfolgen</a>
        {%- endif -%}
      </p>
    {%- endfor -%}
  {%- else -%}
    <p style="margin:0 0 8px;">Für diese Sendung gibt es keine Online-Sendungsverfolgung. Bei Fragen zum Liefertermin rufen Sie uns an: 03301 573 37 20.</p>
  {%- endif -%}

  {%- if tp_v_spedition -%}
    <div style="margin:12px 0 16px;padding:12px 14px;background:#f2f1ef;border-radius:6px;">
      <p style="margin:0 0 6px;font-weight:bold;">Lieferung per Spedition</p>
      <p style="margin:0;">Rollenware und Paletten kommen per Spedition. Die Spedition meldet sich telefonisch zur Terminabstimmung. Die Lieferung erfolgt frei Bordsteinkante; bitte planen Sie eine zweite Person zum Tragen ein.</p>
    </div>
  {%- endif -%}

  <p style="margin:0 0 6px;font-weight:bold;">Inhalt dieser Sendung</p>
  <ul style="margin:0 0 16px;padding-left:20px;">
    {%- for line in fulfillment.fulfillment_line_items -%}
      <li>{{ line.quantity }} × {{ line.line_item.title | escape }}{% if line.line_item.variant_title != blank and line.line_item.variant_title != 'Default Title' %} – {{ line.line_item.variant_title | escape }}{% endif %}</li>
    {%- endfor -%}
  </ul>

  {%- if order_status_url != blank -%}
    <p style="margin:0 0 20px;"><a href="{{ order_status_url }}" style="color:#15171a;">Bestellstatus ansehen</a></p>
  {%- endif -%}
</div>
