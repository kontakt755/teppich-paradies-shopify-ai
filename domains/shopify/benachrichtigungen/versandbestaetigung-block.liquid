{%- comment -%}
  Kundenseitiger Block fuer die Versandbestaetigung (Shop 2.0, M6/M19-20).

  Einsetzen: Admin -> Einstellungen -> Benachrichtigungen ->
  Kundenbenachrichtigungen -> "Versandbestaetigung" -> Code bearbeiten,
  direkt nach dem Header einfuegen. Der Standard-Trackingblock darf bleiben.
  Betreff: Ihre Bestellung {{ name }} ist unterwegs

  Zeigt je Sendung Versanddienstleister, Trackingnummer und Button, dazu den
  Speditionshinweis, wenn Rollenware oder Paletten in der Sendung sind (Art:
  Meterware/Raummass oder Versandart-Property). Fehlt eine Trackingnummer,
  steht das ehrlich da, mit Telefonnummer statt leerem Button.

  Masszeilen (Teppich nach Mass, Meterware, Kettelservice ...) zeigen Mass und
  Flaeche statt der internen Menge in 0,01-Schritten (#26, Beispiel #1035:
  "1 x Rivena Teppich nach Mass - Sandbeige (036) (250 x 310 cm, 7,75 m2)").

  Musterversand gegen Gebuehr (Test 01.12.2026 bis 31.01.2027): Im Musterkasten
  steht zwischen TP-MUSTERGEBUEHR START/ENDE der Gutschein, aber nur bei reiner
  Musterbestellung mit bezahltem Versand (shipping_price > 0), nie nach Datum.
  Der Code kommt aus dem Shop-Metafeld custom.muster_gutscheincode und steht
  nie in dieser Datei. Rueckbau: Text zwischen den Markierungen loeschen.
{%- endcomment -%}

{%- liquid
  assign tp_v_spedition = false
  for line in fulfillment.fulfillment_line_items
    for p in line.line_item.properties
      if p.first == 'Art' and p.last == 'Meterware'
        assign tp_v_spedition = true
      endif
      if p.first == 'Art' and p.last == 'Raummaß'
        assign tp_v_spedition = true
      endif
    endfor
  endfor
  if fulfillment.tracking_company contains 'Spedition' or shipping_method.title contains 'Spedition'
    assign tp_v_spedition = true
  endif
  assign tp_v_anrede = 'Guten Tag'
  if shipping_address.first_name != blank
    assign tp_v_anrede = 'Guten Tag ' | append: shipping_address.first_name | append: ' ' | append: shipping_address.last_name
  endif
-%}

<div style="font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#15171a;">
  <p style="margin:0 0 12px;">{{ tp_v_anrede | strip | escape }},</p>
  <p style="margin:0 0 12px;font-size:18px;font-weight:bold;">Ihre Bestellung {{ name | escape }} ist unterwegs.</p>

  {%- if fulfillment.tracking_numbers.size > 0 -%}
    <p style="margin:0 0 8px;">Versand mit {{ fulfillment.tracking_company | default: 'unserem Versandpartner' | escape }}.</p>
    {%- for number in fulfillment.tracking_numbers -%}
      <p style="margin:0 0 8px;">Sendungsnummer: <strong>{{ number | escape }}</strong>
        {%- if fulfillment.tracking_urls[forloop.index0] != blank %}
          <br><a href="{{ fulfillment.tracking_urls[forloop.index0] }}" style="display:inline-block;margin-top:6px;padding:10px 18px;background:#15171a;color:#ffffff;text-decoration:none;border-radius:6px;">Sendung verfolgen</a>
        {%- endif -%}
      </p>
    {%- endfor -%}
  {%- else -%}
    <p style="margin:0 0 8px;">Für diese Sendung gibt es keine Online-Sendungsverfolgung. Bei Fragen zum Liefertermin rufen Sie uns an: 03301 573 37 20.</p>
  {%- endif -%}

  {%- if tp_v_spedition -%}
    <div style="margin:12px 0 16px;padding:12px 14px;background:#f2f1ef;border-radius:6px;">
      <p style="margin:0 0 6px;font-weight:bold;">Lieferung per Spedition</p>
      <p style="margin:0;">Rollenware und Paletten kommen per Spedition. Die Spedition meldet sich telefonisch zur Terminabstimmung. Die Lieferung erfolgt frei Bordsteinkante; bitte planen Sie eine zweite Person zum Tragen ein.</p>
    </div>
  {%- endif -%}

{%- comment -%} TP-MUSTER-VERSANDMAIL START (Fassung B, eingesetzt 19.11.2026, Freigabe Ahmet; Doku: vorbereitung-2026-11-06/versandmail-muster) {%- endcomment -%}
{%- liquid
  assign tp_vm_shop = 'https://www.teppich-paradies.net/products/'
  assign tp_vm_utm = 'utm_source=versandmail&utm_medium=email&utm_campaign=muster-versandmail'
  assign tp_vm_anzahl = 0
  assign tp_vm_hersteller = 0
  for tp_vm_fl in fulfillment.fulfillment_line_items
    assign tp_vm_li = tp_vm_fl.line_item
    assign tp_vm_ist = false
    assign tp_vm_kopf = tp_vm_li.sku | slice: 0, 2
    if tp_vm_kopf == 'M-' or tp_vm_li.sku == 'TP-MUSTER-000'
      assign tp_vm_ist = true
    endif
    for p in tp_vm_li.properties
      if p.first == '_Muster_ID' and p.last != blank
        assign tp_vm_ist = true
      endif
    endfor
    if tp_vm_ist
      assign tp_vm_anzahl = tp_vm_anzahl | plus: 1
      assign tp_vm_sku5 = tp_vm_li.sku | slice: 0, 5
      assign tp_vm_sku6 = tp_vm_li.sku | slice: 0, 6
      if tp_vm_sku5 == 'M-VW-' or tp_vm_sku6 == 'M-JAB-'
        assign tp_vm_hersteller = tp_vm_hersteller | plus: 1
      endif
    endif
  endfor
-%}

{%- if tp_vm_anzahl > 0 -%}
<div style="font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#15171a;margin:20px 0 24px;padding:16px 16px 6px;border:1px solid #e3e0dc;border-radius:8px;">
  <p style="margin:0 0 8px;font-size:18px;font-weight:bold;">{% if tp_vm_anzahl == 1 %}Ihr Muster ist unterwegs{% else %}Ihre Muster sind unterwegs{% endif %}</p>
  <p style="margin:0 0 12px;">{% if tp_vm_anzahl == 1 %}Ihr Muster aus der Bestellung {{ name | escape }} ist per Post auf dem Weg zu Ihnen.{% else %}Ihre Muster aus der Bestellung {{ name | escape }} sind per Post auf dem Weg zu Ihnen.{% endif %}
    {%- if tp_vm_hersteller > 0 %} Muster mit dem Hinweis „direkt vom Hersteller“ schickt der Hersteller selbst – oft in einem eigenen Umschlag und zu einem anderen Zeitpunkt.{% endif -%}
  </p>

  {%- for tp_vm_fl in fulfillment.fulfillment_line_items -%}
    {%- liquid
      assign tp_vm_li = tp_vm_fl.line_item
      assign tp_vm_ist = false
      assign tp_vm_kopf = tp_vm_li.sku | slice: 0, 2
      if tp_vm_kopf == 'M-' or tp_vm_li.sku == 'TP-MUSTER-000'
        assign tp_vm_ist = true
      endif
      assign tp_vm_handle = ''
      assign tp_vm_vid = 0
      assign tp_vm_produkt = ''
      assign tp_vm_farbe = ''
      for p in tp_vm_li.properties
        assign tp_vm_w = p.last | strip
        if tp_vm_w == blank
          continue
        endif
        case p.first
          when '_Muster_ID'
            assign tp_vm_ist = true
          when '_Quellprodukt'
            assign tp_vm_handle = tp_vm_w
          when '_Quellvariante_ID'
            assign tp_vm_vid = tp_vm_w | plus: 0
          when 'Produkt'
            assign tp_vm_produkt = tp_vm_w
          when 'Farbe', 'Dekor'
            assign tp_vm_farbe = tp_vm_w
        endcase
      endfor
      if tp_vm_handle == '' or tp_vm_vid == 0
        assign tp_vm_qv = tp_vm_li.variant.metafields.einkauf.quellvariante.value
        if tp_vm_qv.id != blank
          if tp_vm_vid == 0
            assign tp_vm_vid = tp_vm_qv.id | plus: 0
          endif
          if tp_vm_handle == '' and tp_vm_qv.product.handle != blank
            assign tp_vm_handle = tp_vm_qv.product.handle
          endif
        else
          assign tp_vm_qv_text = tp_vm_qv | append: ''
          if tp_vm_vid == 0 and tp_vm_qv_text contains 'gid://shopify/ProductVariant/'
            assign tp_vm_vid = tp_vm_qv_text | split: '/' | last | plus: 0
          endif
        endif
      endif
      if tp_vm_handle == ''
        assign tp_vm_mh = tp_vm_li.product.handle | default: ''
        assign tp_vm_mh_kopf = tp_vm_mh | slice: 0, 7
        if tp_vm_mh_kopf == 'muster-'
          assign tp_vm_handle = tp_vm_mh | remove_first: 'muster-'
        endif
      endif

      if tp_vm_produkt == ''
        assign tp_vm_produkt = tp_vm_li.title | remove_first: 'Muster ' | strip
      endif
      if tp_vm_farbe == '' and tp_vm_li.variant_title != blank and tp_vm_li.variant_title != 'Default Title'
        assign tp_vm_farbe = tp_vm_li.variant_title
      endif
      if tp_vm_farbe != '' and tp_vm_produkt contains tp_vm_farbe
        assign tp_vm_farbe = ''
      endif
      assign tp_vm_sku5 = tp_vm_li.sku | slice: 0, 5
      assign tp_vm_sku6 = tp_vm_li.sku | slice: 0, 6

      assign tp_vm_link = ''
      if tp_vm_handle != ''
        assign tp_vm_h_enc = tp_vm_handle | url_encode
        assign tp_vm_link = tp_vm_shop | append: tp_vm_h_enc
        if tp_vm_vid > 0
          assign tp_vm_link = tp_vm_link | append: '?variant=' | append: tp_vm_vid | append: '&'
        else
          assign tp_vm_link = tp_vm_link | append: '?'
        endif
        assign tp_vm_link = tp_vm_link | append: tp_vm_utm
      endif
      assign tp_vm_rechner = 'Menge und Preis berechnen'
      if tp_vm_handle contains 'nach-mass'
        assign tp_vm_rechner = 'Wunschmaß eingeben und Preis sehen'
      endif
    -%}
    {%- if tp_vm_ist -%}
    <div style="margin:0 0 14px;padding:0 0 12px;border-bottom:1px solid #eeebe7;">
      <p style="margin:0 0 6px;"><strong>{{ tp_vm_produkt | escape }}</strong>{% if tp_vm_farbe != '' %} – {{ tp_vm_farbe | escape }}{% endif %}{% if tp_vm_sku5 == 'M-VW-' or tp_vm_sku6 == 'M-JAB-' %} <span style="color:#5e5853;">(direkt vom Hersteller)</span>{% endif %}</p>
      {%- if tp_vm_link != '' -%}
      <p style="margin:0;">
        <a href="{{ tp_vm_link | append: '&utm_content=farbe' | escape }}" style="color:#15171a;text-decoration:underline;margin-right:14px;">{% if tp_vm_farbe != '' %}Farbe ansehen{% else %}Produkt ansehen{% endif %}</a>
        <a href="{{ tp_vm_link | append: '&utm_content=rechner' | escape }}" style="display:inline-block;margin-top:8px;padding:9px 16px;background:#15171a;color:#ffffff;text-decoration:none;border-radius:6px;">{{ tp_vm_rechner }}</a>
      </p>
      {%- endif -%}
    </div>
    {%- endif -%}
  {%- endfor -%}

  <p style="margin:4px 0 6px;font-weight:bold;">So geht es weiter</p>
  <ul style="margin:0 0 12px;padding-left:20px;">
    <li style="margin:0 0 4px;">Legen Sie {% if tp_vm_anzahl == 1 %}das Muster{% else %}die Muster{% endif %} dort hin, wo der Boden später liegt, und sehen Sie {% if tp_vm_anzahl == 1 %}es{% else %}sie{% endif %} bei Tageslicht und am Abend an.</li>
    <li style="margin:0 0 4px;">Passt eine Farbe? Dann bestellen Sie einfach online: Link oben öffnen, Maße eingeben – der Rechner zeigt Menge und Preis.</li>
    <li style="margin:0 0 4px;">Lieber persönlich? Rufen Sie uns an: <a href="tel:+4933015733720" style="color:#15171a;">03301 573 37 20</a> (Mo–Fr 8:30–18:00, Sa 8:30–14:30 Uhr). Nennen Sie einfach Ihre Bestellnummer {{ name | escape }}, wir rechnen die Menge gern mit Ihnen aus.</li>
  </ul>
  {%- comment -%} TP-MUSTERGEBUEHR START {%- endcomment -%}
  {%- liquid
    assign tp_vm_ware = 0
    for tp_vm_ol in line_items
      assign tp_vm_ist = false
      assign tp_vm_kopf = tp_vm_ol.sku | slice: 0, 2
      if tp_vm_kopf == 'M-' or tp_vm_ol.sku == 'TP-MUSTER-000'
        assign tp_vm_ist = true
      endif
      for p in tp_vm_ol.properties
        if p.first == '_Muster_ID' and p.last != blank
          assign tp_vm_ist = true
        endif
      endfor
      unless tp_vm_ist
        assign tp_vm_ware = tp_vm_ware | plus: 1
      endunless
    endfor
    assign tp_vm_code_feld = shop.metafields.custom.muster_gutscheincode
    assign tp_vm_code = tp_vm_code_feld.value | default: tp_vm_code_feld | strip
  -%}
  {%- comment -%}line_items.size > 0: fehlt die Bestellliste, lieber kein Kasten als einer in der Mischbestellung{%- endcomment -%}
  {%- if line_items.size > 0 and tp_vm_ware == 0 and shipping_price > 0 -%}
    <div style="margin:0 0 12px;padding:12px 14px;background:#f7f3ee;border-radius:8px;">
      <p style="margin:0 0 4px;font-weight:bold;">Ihr Gutschein für den Musterversand</p>
      <p style="margin:0 0 8px;">Wenn Sie bei uns bestellen, rechnen wir Ihnen die 4,99 € für den Musterversand an.</p>
      {%- if tp_vm_code != blank -%}
        <p style="margin:0 0 8px;">Ihr Gutscheincode: <strong style="font-size:17px;letter-spacing:1px;">{{ tp_vm_code | escape }}</strong></p>
      {%- else -%}
        <p style="margin:0 0 8px;">Ihren Gutscheincode nennen wir Ihnen gern: 03301 573 37 20 oder einfach per Antwort auf diese E-Mail.</p>
      {%- endif -%}
      <p style="margin:0;font-size:13px;line-height:1.5;color:#5e5853;">Gilt ab 150 € Warenwert, einmal einlösbar bis 31.03.2027. Code im Warenkorb eingeben. Nicht mit anderen Gutscheincodes kombinierbar.</p>
    </div>
  {%- endif -%}
  {%- comment -%} TP-MUSTERGEBUEHR ENDE {%- endcomment -%}
  <p style="margin:0 0 10px;font-size:13px;line-height:1.5;color:#5e5853;">Sie möchten solche Hinweise zu unseren Produkten nicht mehr per E-Mail? Sie können der Nutzung Ihrer E-Mail-Adresse für Werbung jederzeit widersprechen, einfach per Antwort auf diese E-Mail{% if shop.email != blank %} oder an <a href="mailto:{{ shop.email | escape }}" style="color:#5e5853;">{{ shop.email | escape }}</a>{% endif %}. Dafür entstehen Ihnen keine anderen Kosten als die Übermittlungskosten nach den Basistarifen.</p>
</div>
{%- endif -%}
{%- comment -%} TP-MUSTER-VERSANDMAIL ENDE {%- endcomment -%}

  <p style="margin:0 0 6px;font-weight:bold;">Inhalt dieser Sendung</p>
  <ul style="margin:0 0 16px;padding-left:20px;">
    {%- for line in fulfillment.fulfillment_line_items -%}
      {%- comment -%}
        Masszeilen (#26): Bei Teppich nach Mass, Meterware/Raummass, Wunschmass,
        Kettelservice und Laengenware steckt das Mass in der Menge (0,01 m2,
        0,01 m oder cm). Statt "775 x Teppich" steht dann "1 x Teppich (Masse,
        Flaeche)", der Kettelservice als "Kante umlaufend 11,20 m". Gelesen wird
        nur, was der Kunde im Warenkorb selbst gesehen hat (Properties ohne _).
        Laengenware: Stueck = versandte Menge / "Laenge je Stueck" (Menge in cm),
        damit eine Teillieferung nur die versandten Stuecke nennt.
        Fussleiste ("Zu ..." mit "Laenge" in m): Menge = Meter, deshalb kommt
        die Laenge aus der versandten Menge, nicht aus der Bestellzeile.
      {%- endcomment -%}
      {%- liquid
        assign tp_v_li = line.line_item
        assign tp_v_mass = ''
        assign tp_v_flaeche = ''
        assign tp_v_breite = ''
        assign tp_v_laenge = ''
        assign tp_v_rund = ''
        assign tp_v_seite = ''
        assign tp_v_kante = ''
        assign tp_v_zu = ''
        assign tp_v_je_stueck = ''
        for p in tp_v_li.properties
          assign tp_v_w = p.last | strip
          if tp_v_w == blank
            continue
          endif
          case p.first
            when 'Maße'
              assign tp_v_mass = tp_v_w
            when 'Fläche (abgerechnet)', 'Fläche', 'Fläche (aufgerundet)', 'Fläche (berechnet)'
              if tp_v_flaeche == ''
                assign tp_v_flaeche = tp_v_w
              endif
            when 'Ihre Breite', 'Rollenbreite', 'Breite'
              assign tp_v_breite = tp_v_w
            when 'Gewünschte Länge', 'Länge'
              assign tp_v_laenge = tp_v_w
            when 'Durchmesser'
              assign tp_v_rund = tp_v_w
            when 'Seitenlänge'
              assign tp_v_seite = tp_v_w
            when 'Kante umlaufend'
              assign tp_v_kante = tp_v_w
            when 'Zu Teppich', 'Zu Teppichboden', 'Zu Bodenbelag'
              assign tp_v_zu = tp_v_w
            when 'Länge je Stück'
              assign tp_v_je_stueck = tp_v_w
          endcase
        endfor
        if tp_v_mass == ''
          if tp_v_breite != '' and tp_v_laenge != ''
            assign tp_v_mass = tp_v_breite | append: ' × ' | append: tp_v_laenge | replace: ' cm × ', ' × '
          elsif tp_v_rund != ''
            assign tp_v_mass = 'Ø ' | append: tp_v_rund
          elsif tp_v_seite != ''
            assign tp_v_mass = tp_v_seite | append: ' × ' | append: tp_v_seite | replace: ' cm × ', ' × '
          endif
        endif
        assign tp_v_variante = ''
        if tp_v_li.variant_title != blank and tp_v_li.variant_title != 'Default Title'
          assign tp_v_variante = ' – ' | append: tp_v_li.variant_title
        endif
        if tp_v_je_stueck != ''
          assign tp_v_stueck = 0
          assign tp_v_je_cm = tp_v_je_stueck | remove: 'cm' | strip | plus: 0
          if tp_v_je_cm > 0
            assign tp_v_rest = line.quantity | modulo: tp_v_je_cm
            if tp_v_rest == 0
              assign tp_v_stueck = line.quantity | divided_by: tp_v_je_cm
            endif
          endif
          if tp_v_stueck > 0
            assign tp_v_zeile = tp_v_stueck | append: ' × ' | append: tp_v_li.title | append: tp_v_variante | append: ' (je ' | append: tp_v_je_stueck | append: ')'
          else
            assign tp_v_zeile = tp_v_li.title | append: tp_v_variante | append: ' (insgesamt ' | append: line.quantity | append: ' cm)'
          endif
        elsif tp_v_kante != '' and tp_v_mass == '' and tp_v_flaeche == ''
          assign tp_v_zeile = tp_v_li.title
          if tp_v_zu != ''
            assign tp_v_zeile = tp_v_zeile | append: ' für ' | append: tp_v_zu
          endif
          assign tp_v_zeile = tp_v_zeile | append: ' – Kante umlaufend ' | append: tp_v_kante
        elsif tp_v_mass != '' or tp_v_flaeche != ''
          assign tp_v_klammer = tp_v_mass
          if tp_v_mass != '' and tp_v_flaeche != ''
            assign tp_v_klammer = tp_v_klammer | append: ', '
          endif
          assign tp_v_klammer = tp_v_klammer | append: tp_v_flaeche
          assign tp_v_zeile = '1 × ' | append: tp_v_li.title | append: tp_v_variante | append: ' (' | append: tp_v_klammer | append: ')'
        elsif tp_v_zu != '' and tp_v_laenge != ''
          assign tp_v_einheit = tp_v_laenge | split: ' ' | last
          if tp_v_einheit == 'm'
            assign tp_v_laenge = line.quantity | append: ' m'
          endif
          assign tp_v_zeile = tp_v_li.title | append: tp_v_variante | append: ' (' | append: tp_v_laenge | append: ')'
        else
          assign tp_v_zeile = line.quantity | append: ' × ' | append: tp_v_li.title | append: tp_v_variante
        endif
      -%}
      <li>{{ tp_v_zeile | escape }}</li>
    {%- endfor -%}
  </ul>

  {%- if order_status_url != blank -%}
    <p style="margin:0 0 20px;"><a href="{{ order_status_url }}" style="color:#15171a;">Bestellstatus ansehen</a></p>
  {%- endif -%}
</div>
