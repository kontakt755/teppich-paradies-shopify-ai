{%- comment -%}
  Kundenseitiger Block fuer die Versandbestaetigung (Shop 2.0, M6/M19-20).

  Einsetzen: Admin -> Einstellungen -> Benachrichtigungen ->
  Kundenbenachrichtigungen -> "Versandbestaetigung" -> Code bearbeiten,
  direkt nach dem Header einfuegen. Der Standard-Trackingblock darf bleiben.
  Betreff: Ihre Bestellung {{ name }} ist unterwegs

  Zeigt je Sendung Versanddienstleister, Trackingnummer und Button, dazu den
  Speditionshinweis, wenn Rollenware oder Paletten in der Sendung sind (Art:
  Meterware/Raummass oder Versandart-Property). Fehlt eine Trackingnummer,
  steht das ehrlich da, mit Telefonnummer statt leerem Button.

  Masszeilen (Teppich nach Mass, Meterware, Kettelservice ...) zeigen Mass und
  Flaeche statt der internen Menge in 0,01-Schritten (#26, Beispiel #1035:
  "1 x Rivena Teppich nach Mass - Sandbeige (036) (250 x 310 cm, 7,75 m2)").
{%- endcomment -%}

{%- liquid
  assign tp_v_spedition = false
  for line in fulfillment.fulfillment_line_items
    for p in line.line_item.properties
      if p.first == 'Art' and p.last == 'Meterware'
        assign tp_v_spedition = true
      endif
      if p.first == 'Art' and p.last == 'Raummaß'
        assign tp_v_spedition = true
      endif
    endfor
  endfor
  if fulfillment.tracking_company contains 'Spedition' or shipping_method.title contains 'Spedition'
    assign tp_v_spedition = true
  endif
  assign tp_v_anrede = 'Guten Tag'
  if shipping_address.first_name != blank
    assign tp_v_anrede = 'Guten Tag ' | append: shipping_address.first_name | append: ' ' | append: shipping_address.last_name
  endif
-%}

<div style="font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#15171a;">
  <p style="margin:0 0 12px;">{{ tp_v_anrede | strip | escape }},</p>
  <p style="margin:0 0 12px;font-size:18px;font-weight:bold;">Ihre Bestellung {{ name | escape }} ist unterwegs.</p>

  {%- if fulfillment.tracking_numbers.size > 0 -%}
    <p style="margin:0 0 8px;">Versand mit {{ fulfillment.tracking_company | default: 'unserem Versandpartner' | escape }}.</p>
    {%- for number in fulfillment.tracking_numbers -%}
      <p style="margin:0 0 8px;">Sendungsnummer: <strong>{{ number | escape }}</strong>
        {%- if fulfillment.tracking_urls[forloop.index0] != blank %}
          <br><a href="{{ fulfillment.tracking_urls[forloop.index0] }}" style="display:inline-block;margin-top:6px;padding:10px 18px;background:#15171a;color:#ffffff;text-decoration:none;border-radius:6px;">Sendung verfolgen</a>
        {%- endif -%}
      </p>
    {%- endfor -%}
  {%- else -%}
    <p style="margin:0 0 8px;">Für diese Sendung gibt es keine Online-Sendungsverfolgung. Bei Fragen zum Liefertermin rufen Sie uns an: 03301 573 37 20.</p>
  {%- endif -%}

  {%- if tp_v_spedition -%}
    <div style="margin:12px 0 16px;padding:12px 14px;background:#f2f1ef;border-radius:6px;">
      <p style="margin:0 0 6px;font-weight:bold;">Lieferung per Spedition</p>
      <p style="margin:0;">Rollenware und Paletten kommen per Spedition. Die Spedition meldet sich telefonisch zur Terminabstimmung. Die Lieferung erfolgt frei Bordsteinkante; bitte planen Sie eine zweite Person zum Tragen ein.</p>
    </div>
  {%- endif -%}

  <p style="margin:0 0 6px;font-weight:bold;">Inhalt dieser Sendung</p>
  <ul style="margin:0 0 16px;padding-left:20px;">
    {%- for line in fulfillment.fulfillment_line_items -%}
      {%- comment -%}
        Masszeilen (#26): Bei Teppich nach Mass, Meterware/Raummass, Wunschmass,
        Kettelservice und Laengenware steckt das Mass in der Menge (0,01 m2,
        0,01 m oder cm). Statt "775 x Teppich" steht dann "1 x Teppich (Masse,
        Flaeche)", der Kettelservice als "Kante umlaufend 11,20 m". Gelesen wird
        nur, was der Kunde im Warenkorb selbst gesehen hat (Properties ohne _).
      {%- endcomment -%}
      {%- liquid
        assign tp_v_li = line.line_item
        assign tp_v_mass = ''
        assign tp_v_flaeche = ''
        assign tp_v_breite = ''
        assign tp_v_laenge = ''
        assign tp_v_rund = ''
        assign tp_v_seite = ''
        assign tp_v_kante = ''
        assign tp_v_zu = ''
        assign tp_v_je_stueck = ''
        assign tp_v_anzahl = ''
        for p in tp_v_li.properties
          assign tp_v_w = p.last | strip
          if tp_v_w == blank
            continue
          endif
          case p.first
            when 'Maße'
              assign tp_v_mass = tp_v_w
            when 'Fläche (abgerechnet)', 'Fläche', 'Fläche (aufgerundet)', 'Fläche (berechnet)'
              if tp_v_flaeche == ''
                assign tp_v_flaeche = tp_v_w
              endif
            when 'Ihre Breite', 'Rollenbreite', 'Breite'
              assign tp_v_breite = tp_v_w
            when 'Gewünschte Länge', 'Länge'
              assign tp_v_laenge = tp_v_w
            when 'Durchmesser'
              assign tp_v_rund = tp_v_w
            when 'Seitenlänge'
              assign tp_v_seite = tp_v_w
            when 'Kante umlaufend'
              assign tp_v_kante = tp_v_w
            when 'Zu Teppich', 'Zu Teppichboden', 'Zu Bodenbelag'
              assign tp_v_zu = tp_v_w
            when 'Länge je Stück'
              assign tp_v_je_stueck = tp_v_w
            when 'Anzahl'
              assign tp_v_anzahl = tp_v_w | remove: 'Stück' | strip
          endcase
        endfor
        if tp_v_mass == ''
          if tp_v_breite != '' and tp_v_laenge != ''
            assign tp_v_mass = tp_v_breite | append: ' × ' | append: tp_v_laenge | replace: ' cm × ', ' × '
          elsif tp_v_rund != ''
            assign tp_v_mass = 'Ø ' | append: tp_v_rund
          elsif tp_v_seite != ''
            assign tp_v_mass = tp_v_seite | append: ' × ' | append: tp_v_seite | replace: ' cm × ', ' × '
          endif
        endif
        assign tp_v_variante = ''
        if tp_v_li.variant_title != blank and tp_v_li.variant_title != 'Default Title'
          assign tp_v_variante = ' – ' | append: tp_v_li.variant_title
        endif
        if tp_v_je_stueck != ''
          assign tp_v_zeile = tp_v_anzahl | default: '1' | append: ' × ' | append: tp_v_li.title | append: tp_v_variante | append: ' (je ' | append: tp_v_je_stueck | append: ')'
        elsif tp_v_kante != '' and tp_v_mass == '' and tp_v_flaeche == ''
          assign tp_v_zeile = tp_v_li.title
          if tp_v_zu != ''
            assign tp_v_zeile = tp_v_zeile | append: ' für ' | append: tp_v_zu
          endif
          assign tp_v_zeile = tp_v_zeile | append: ' – Kante umlaufend ' | append: tp_v_kante
        elsif tp_v_mass != '' or tp_v_flaeche != ''
          assign tp_v_klammer = tp_v_mass
          if tp_v_mass != '' and tp_v_flaeche != ''
            assign tp_v_klammer = tp_v_klammer | append: ', '
          endif
          assign tp_v_klammer = tp_v_klammer | append: tp_v_flaeche
          assign tp_v_zeile = '1 × ' | append: tp_v_li.title | append: tp_v_variante | append: ' (' | append: tp_v_klammer | append: ')'
        elsif tp_v_zu != '' and tp_v_laenge != ''
          assign tp_v_zeile = tp_v_li.title | append: tp_v_variante | append: ' (' | append: tp_v_laenge | append: ')'
        else
          assign tp_v_zeile = line.quantity | append: ' × ' | append: tp_v_li.title | append: tp_v_variante
        endif
      -%}
      <li>{{ tp_v_zeile | escape }}</li>
    {%- endfor -%}
  </ul>

  {%- if order_status_url != blank -%}
    <p style="margin:0 0 20px;"><a href="{{ order_status_url }}" style="color:#15171a;">Bestellstatus ansehen</a></p>
  {%- endif -%}
</div>
