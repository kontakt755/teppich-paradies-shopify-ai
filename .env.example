# Public Shopify connection settings. Never add real credentials to this file.
SHOPIFY_SHOP=sjjyq1-6w.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WRITE_ENABLED=false

# Optional override for a secret file outside the repository.
# SHOPIFY_ENV_FILE=/absolute/path/to/shopify.env

# Optional: NVIDIA NIM API key for the NEMOTRON_REVIEW role (workflow/providers/nemotron.mjs).
# Free key from build.nvidia.com, prefix "nvapi-". Once set, it is the default
# Class-B pre-reviewer before Codex (see docs/AI_ROUTER.md) - without it,
# ai:continue falls back to Codex directly, no error.
# NVIDIA_API_KEY=

# Optional: override the Nemotron model without a code change (default:
# nvidia/nemotron-3-super-120b-a12b). E.g. to try NVIDIA's newer, smaller
# nvidia/nemotron-3.5-lightning-30b-a3b (released 2026-08-11, marketed for
# agentic workloads - a single own comparison run was inconclusive on speed).
# NEMOTRON_MODEL=
