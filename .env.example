## OpenRouter (local only; never commit a real key)
export OPENROUTER_API_KEY=''
export OPENROUTER_USAGE_LEDGER='.router/openrouter-usage.jsonl'
export OPENROUTER_MAX_OUTPUT_TOKENS='256'
# Exact models only. Do not use OpenRouter's nested auto/free routers.
export OPENROUTER_LIGHT_MODEL='cohere/north-mini-code:free'
export OPENROUTER_STANDARD_MODEL='poolside/laguna-s-2.1:free'
# The bridge retries the next exact model only after a failed/empty answer.
export OPENROUTER_LIGHT_FALLBACK_MODELS='dots-studio/dots-3-note-preview:free,cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free'
export OPENROUTER_STANDARD_FALLBACK_MODELS='poolside/laguna-s-2.1:free,cohere/north-mini-code:free'
