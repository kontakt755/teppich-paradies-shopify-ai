## OpenRouter (local only; never commit a real key)
export OPENROUTER_API_KEY=''
export AI_ROUTER_USAGE_LEDGER='.router/ai-usage.jsonl'
export OPENROUTER_MAX_OUTPUT_TOKENS='256'
# Exact models only. Do not use OpenRouter's nested auto/free routers.
export OPENROUTER_LIGHT_MODEL='cohere/north-mini-code:free'
export OPENROUTER_STANDARD_MODEL='poolside/laguna-s-2.1:free'
# The bridge retries the next exact model only after a failed/empty answer.
export OPENROUTER_LIGHT_FALLBACK_MODELS='dots-studio/dots-3-note-preview:free,cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free'
export OPENROUTER_STANDARD_FALLBACK_MODELS='poolside/laguna-s-2.1:free,cohere/north-mini-code:free'

## Gemini free tier (optional; preferred before OpenRouter when a key exists)
# Free-tier prompts may be used by Google to improve its products. The router
# sends only the current task text and never repository files or chat history.
export GEMINI_API_KEY=''
export GEMINI_MODEL='gemini-3.5-flash-lite'

## Claude worker budget for one unattended CLI invocation
export AGENT_LOOP_CLAUDE_MAX_BUDGET_USD='1'
export AGENT_LOOP_CLAUDE_MAX_TURNS='12'
export AGENT_LOOP_ANALYSIS_MAX_TURNS='8'
export AGENT_LOOP_ANALYSIS_MAX_BUDGET_USD='0.10'
export AGENT_LOOP_ANALYSIS_MODEL='haiku'
# Optional stable fallback name. Do not set ANTHROPIC_API_KEY globally if the
# subscription should be attempted first; that standard variable overrides it.
export ANTHROPIC_FALLBACK_API_KEY=''
