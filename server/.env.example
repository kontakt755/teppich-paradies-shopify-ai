# Google Places API Configuration
# Get your API key from: https://console.cloud.google.com/
# The key should be restricted to Places API only
GOOGLE_PLACES_API_KEY=AIzaSyD...your-api-key-here

# Find this ID by searching "Teppich Paradies Oranienburg GmbH" on Google Maps
# and extracting the Place ID from the URL or using the Places API
GOOGLE_BUSINESS_PLACE_ID=ChIJ...place-id-here

# Server Configuration
PORT=3001
NODE_ENV=production

# Shopify Store URL (for CORS)
SHOPIFY_STORE_URL=https://teppich-paradies-live.myshopify.com
