{%- comment -%}
  TP Kundenstimmen: Ueberschrift, Link zum Google-Profil und das Elfsight-Widget
  mit echten Rezensionen. Das Widget laedt erst nach Marketing-Einwilligung
  (Shopify Customer Privacy API) - wie in sections/google.liquid. Bis das
  Widget tatsaechlich sichtbar ist, bleibt ein direkter Weg zu Google stehen.
  Keine eingetippten Bewertungen, keine hartcodierte Zahl.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

<section class="tp-s-sec tp-bew" id="tp-bewertungen" aria-labelledby="tp-bew-h2">
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head">
      <div>
        <h2 id="tp-bew-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.elfsight_id == blank and section.settings.link != blank -%}<a class="tp-s-link" href="{{ section.settings.link }}" rel="noopener noreferrer" target="_blank">{{ section.settings.link_label | default: 'Alle Bewertungen bei Google' | escape }}</a>{%- endif -%}
    </div>
    {%- if section.settings.elfsight_id != blank -%}
      <div class="tp-bew__widget">
        <div class="elfsight-app-{{ section.settings.elfsight_id | escape }}" data-elfsight-app-lazy></div>
        <div class="tp-bew__fallback" data-tp-bew-hinweis>
          <p>Lesen Sie echte Erfahrungen mit unserem Fachgeschäft direkt bei Google. Die eingebetteten Bewertungen laden wir hier erst nach Ihrer Einwilligung.</p>
          {%- if section.settings.link != blank -%}
            <a class="tp-bew__fallback-link" href="{{ section.settings.link }}" rel="noopener noreferrer" target="_blank">{{ section.settings.link_label | default: 'Bewertungen bei Google ansehen' | escape }} <span aria-hidden="true">↗</span></a>
          {%- endif -%}
        </div>
        {%- if section.settings.link != blank -%}
          <a class="tp-bew__widget-link tp-s-link" href="{{ section.settings.link }}" rel="noopener noreferrer" target="_blank" hidden>{{ section.settings.link_label | default: 'Alle Bewertungen bei Google' | escape }}</a>
        {%- endif -%}
      </div>
      <script>
        (function () {
          var loaded = false;
          var hinweis = document.querySelector('#tp-bewertungen [data-tp-bew-hinweis]');
          var widget = document.querySelector('#tp-bewertungen [data-elfsight-app-lazy]');
          var googleLink = document.querySelector('#tp-bewertungen .tp-bew__widget-link');
          function loadElfsight() {
            if (loaded) return;
            loaded = true;
            if (widget && hinweis) {
              var observer = new MutationObserver(function () {
                if (widget.childElementCount > 0) {
                  hinweis.hidden = true;
                  if (googleLink) googleLink.hidden = false;
                  observer.disconnect();
                }
              });
              observer.observe(widget, { childList: true });
            }
            var s = document.createElement('script');
            s.src = 'https://static.elfsight.com/platform/platform.js';
            s.async = true;
            document.head.appendChild(s);
          }
          function checkConsent() {
            var privacy = window.Shopify && window.Shopify.customerPrivacy;
            if (!privacy || typeof privacy.marketingAllowed !== 'function') return;
            if (privacy.marketingAllowed()) { loadElfsight(); return; }
            document.addEventListener('visitorConsentCollected', function (event) {
              if (event.detail && event.detail.marketingAllowed) loadElfsight();
            });
          }
          if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
            window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (error) { if (!error) checkConsent(); });
          }
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .tp-bew__widget { min-height: 120px; }
  .tp-bew__fallback { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 26px 30px; border: 1px solid var(--tp-line); border-radius: var(--tp-r-lg); background: var(--tp-bg-2); }
  .tp-bew__fallback[hidden] { display: none; }
  .tp-bew__widget-link[hidden] { display: none; }
  .tp-bew__widget-link { margin-top: 16px; }
  .tp-bew__fallback p { max-width: 60ch; margin: 0; color: var(--tp-ink-2); font-size: 15px; line-height: 1.5; }
  .tp-bew__fallback-link { flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 10px 16px; border: 1px solid var(--tp-line-2); border-radius: var(--tp-r); color: var(--tp-ink); background: #fff; font-weight: 600; text-decoration: none; }
  .tp-bew__fallback-link:hover, .tp-bew__fallback-link:focus-visible { border-color: var(--tp-red); }
  @media (max-width: 767px) { .tp-bew__fallback { align-items: stretch; flex-direction: column; gap: 16px; padding: 20px; } .tp-bew__fallback-link { flex: auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Kundenstimmen (Google)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Das sagen unsere Kunden" },
    { "type": "text", "id": "text", "label": "Unterzeile", "default": "Echte Rezensionen aus dem Google-Unternehmensprofil." },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Alle Bewertungen bei Google" },
    { "type": "url", "id": "link", "label": "Link zum Google-Profil" },
    { "type": "text", "id": "elfsight_id", "label": "Elfsight-App-ID", "default": "e64233ac-362d-4d8f-ae26-3ec4cc88789e" }
  ],
  "presets": [ { "name": "TP Kundenstimmen (Google)" } ]
}
{% endschema %}
