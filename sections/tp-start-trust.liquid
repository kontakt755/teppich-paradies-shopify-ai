{{ 'tp-start-trust.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  TP Trust-Streifen: links die Google-Bewertung (nur wenn ein echter Wert
  eingetragen ist), rechts bis zu vier belegbare Aussagen als Bloecke.
{%- endcomment -%}
{%- liquid
  # Google-Bewertung aus einer Quelle - siehe sections/tp-start-hero.liquid.
  assign tp_gb = shop.metafields.custom.google_bewertung.value
  assign tp_rating_wert = section.settings.rating_wert | strip | default: tp_gb.wert | default: settings.tp_google_wert
  assign tp_rating_link = section.settings.rating_link | default: settings.tp_google_link
  capture tp_rating_standard
    echo tp_gb.anzahl | default: settings.tp_google_anzahl
    echo ' Bewertungen · Google-Unternehmensprofil'
  endcapture
  assign tp_rating_text = section.settings.rating_text | strip | default: tp_rating_standard | strip
-%}

<div class="tp-trust" role="region" aria-label="Warum Teppich Paradies">
  <div class="tp-s-wrap tp-trust__wrap{% if tp_rating_wert == blank %} tp-trust__wrap--ohne-rating{% endif %}">
    {%- if tp_rating_wert != blank -%}
      <div class="tp-trust__beleg">
        <a class="tp-trust__rating" href="{{ tp_rating_link | default: '#' }}" rel="noopener" target="_blank">
          <span class="tp-trust__g" aria-hidden="true">G</span>
          <span><b>{{ tp_rating_wert | escape }} <span class="tp-trust__stars" aria-hidden="true">★★★★★</span></b><small>{{ tp_rating_text | escape }}</small></span>
        </a>
        {%- comment -%} § 5b Abs. 3 UWG: der Hinweis gehoert direkt zur Note {%- endcomment -%}
        {%- render 'tp-bewertungshinweis', kurz: true -%}
      </div>
    {%- endif -%}
    <ul class="tp-trust__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ block.settings.text | escape }}</li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "TP Trust-Streifen",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Google-Bewertung (leer = ausgeblendet)" },
    { "type": "text", "id": "rating_wert", "label": "Wert, z. B. 4,9" },
    { "type": "text", "id": "rating_text", "label": "Text darunter", "default": "Google-Bewertungen · Unternehmensprofil" },
    { "type": "url", "id": "rating_link", "label": "Link zum Google-Profil" }
  ],
  "blocks": [
    {
      "type": "aussage",
      "name": "Aussage",
      "limit": 4,
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Bis zu zwei Muster je Bestellung" } ]
    }
  ],
  "presets": [
    {
      "name": "TP Trust-Streifen",
      "blocks": [
        { "type": "aussage", "settings": { "text": "Deutschlandweiter Versand" } },
        { "type": "aussage", "settings": { "text": "Bis zu zwei Muster je Bestellung" } },
        { "type": "aussage", "settings": { "text": "Rollenware im Wunschmaß zugeschnitten" } },
        { "type": "aussage", "settings": { "text": "Eigener Verlegeservice bis 50 km" } }
      ]
    }
  ]
}
{% endschema %}
