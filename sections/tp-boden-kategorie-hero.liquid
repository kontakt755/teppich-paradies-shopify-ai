{{ 'tp-boden-kategorie.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tp_bk_image = section.settings.image | default: collection.image | default: collection.featured_image
  assign tp_bk_image_alt = section.settings.image_alt | default: tp_bk_image.alt | default: collection.title
-%}

<section class="tp-bk-hero" aria-labelledby="tp-bk-title-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="tp-bk-hero__inner">
    <div class="tp-bk-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tp-bk-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="tp-bk-title-{{ section.id }}">{{ section.settings.heading | default: collection.title | escape }}</h1>
      {%- if section.settings.lead != blank -%}
        <div class="tp-bk-hero__lead rte">{{ section.settings.lead }}</div>
      {%- endif -%}
      <div class="tp-bk-hero__actions">
        <a class="tp-bk-button tp-bk-button--primary" href="{{ section.settings.primary_link | default: '#ResultsList' | escape }}">{{ section.settings.primary_label | escape }}</a>
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="tp-bk-button tp-bk-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="tp-bk-hero__points" aria-label="Orientierung">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span aria-hidden="true"></span>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if tp_bk_image != blank -%}
      <figure class="tp-bk-hero__visual{% if section.settings.image_crop == 'structure' %} tp-bk-hero__visual--structure{% endif %}">
        {{ tp_bk_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(max-width: 749px) calc(100vw - 32px), 45vw', loading: 'eager', fetchpriority: 'high', alt: tp_bk_image_alt }}
        {%- if section.settings.image_caption != blank -%}
          <figcaption>{{ section.settings.image_caption | escape }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Boden Kategorie Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild (sonst Kollektionsbild)" },
    { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
    { "type": "select", "id": "image_crop", "label": "Bildausschnitt", "options": [{ "value": "room", "label": "Raumbild" }, { "value": "structure", "label": "Materialstruktur" }], "default": "room" },
    { "type": "text", "id": "primary_link", "label": "Sprungziel des Produkt-Buttons", "default": "#ResultsList" },
    { "type": "text", "id": "eyebrow", "label": "Oberzeile", "default": "Bodenbeläge entdecken" },
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "richtext", "id": "lead", "label": "Einleitung" },
    { "type": "text", "id": "primary_label", "label": "Produkt-Button", "default": "Produkte entdecken" },
    { "type": "text", "id": "secondary_label", "label": "Zweiter Button", "default": "Beratung anfragen" },
    { "type": "url", "id": "secondary_link", "label": "Link zum zweiten Button" },
    { "type": "text", "id": "image_caption", "label": "Bildunterschrift" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Orientierungspunkt",
      "limit": 3,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [{ "name": "Boden Kategorie Hero" }]
}
{% endschema %}
