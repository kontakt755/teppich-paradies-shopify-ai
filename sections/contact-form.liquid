<style>
  .kontakt-section {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
  }
  .kontakt-info, .kontakt-formular {
    flex: 1;
    min-width: 300px;
  }
  .kontakt-info h2 {
    font-size: 28px;
    margin-bottom: 20px;
    color: #333;
  }
  .kontakt-info p {
    font-size: 16px;
    margin: 6px 0;
    color: #555;
  }
  .kontakt-formular form {
    display: flex;
    flex-direction: column;
  }
  .kontakt-formular label {
    margin-top: 15px;
    font-weight: 600;
    color: #333;
  }
  .kontakt-formular input,
  .kontakt-formular textarea {
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #ccc;
    border-radius: 6px;
    /* 16px: darunter zoomt iOS Safari beim Antippen in das Feld */
    font-size: 16px;
  }
  .kontakt-formular button {
    margin-top: 20px;
    padding: 12px;
    background-color: #222;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
  }
  .kontakt-formular button:hover {
    background-color: #444;
  }
  .whatsapp-link {
    /* #25D366 auf Weiss hatte 2:1; #0e7a5f wie die WhatsApp-Buttons, 5,3:1 */
    color: #0e7a5f;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .whatsapp-icon {
    width: 18px;
    height: 18px;
  }

  /* Musterbestellung: eigener, kompakter Zustand oberhalb des Formulars.
     Standardmaessig ausgeblendet - wird nur per JS sichtbar gemacht, wenn
     ?thema=muster in der URL erkannt wird (siehe assets/tp-sample-request.js).
     Ohne diesen Parameter bleibt die Kontaktseite unveraendert. */
  .tp-sample-intro {
    display: none;
    margin-bottom: 8px;
  }

  /* Anfrage von der Produktseite (#163): Thema und Produkt sichtbar machen,
     damit der Kunde sieht, worauf sich seine Nachricht bezieht. */
  .tp-anfrage-hinweis {
    margin: 0 0 12px;
    font-size: 17px;
    font-weight: 600;
    color: #222;
  }

  .tp-anfrage-hinweis[hidden] {
    display: none;
  }

  [data-tp-sample-request][data-mode="sample"] .tp-sample-intro {
    display: block;
  }

  .tp-sample-intro__heading {
    font-size: 22px;
    margin: 0 0 8px;
    color: #222;
  }

  .tp-sample-intro__product {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .tp-sample-intro__image {
    display: none;
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
    flex: 0 0 auto;
  }

  .tp-sample-intro__product-name {
    font-weight: 700;
    font-size: 15px;
  }

  .tp-sample-intro__text {
    margin: 0;
    color: #555;
    font-size: 15px;
  }

  [data-sample-field] {
    display: none;
  }

  [data-tp-sample-request][data-mode="sample"] [data-sample-field] {
    display: block;
  }

  .tp-form-success,
  .tp-form-error {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 8px;
    margin-bottom: 12px;
    font-size: 14.5px;
  }

  .tp-form-success {
    background: rgb(0 138 46 / 0.1);
    color: #00641f;
  }

  .tp-form-error {
    background: rgb(176 0 32 / 0.08);
    color: #b00020;
  }

  .tp-form-success svg,
  .tp-form-error svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .tp-success--sample {
    display: none;
  }

  [data-tp-sample-request][data-mode="sample"] .tp-success--generic {
    display: none;
  }

  [data-tp-sample-request][data-mode="sample"] .tp-success--sample {
    display: flex;
  }

  @media screen and (max-width: 749px) {
    .kontakt-section {
      margin: 32px auto;
      gap: 28px;
    }
  }
</style>

{% stylesheet %}
  .tp-contact-service-links {
    margin: 0 0 18px;
    color: #333;
    font-size: 16px;
  }
  .tp-contact-service-links p { margin: 0 0 4px; }
  .tp-contact-service-links ul { margin: 0; padding-left: 20px; }
  .tp-contact-service-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
  }
  [data-tp-sample-request][data-mode="sample"] .tp-contact-service-links {
    display: none;
  }

  /* Google-Maps-Karte erst nach Klick (Zwei-Klick-Loesung, Datenschutz) */
  .tp-karte {
    max-width: 1200px;
    margin: 0 auto 40px;
    padding: 0 20px;
  }
  .tp-karte__flaeche {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 28px 20px;
    border: 1px solid var(--tp-line, #e6e0d8);
    border-radius: 8px;
    background: var(--tp-bg-2, #f6f2ec);
    color: #333;
    text-align: center;
  }
  .tp-karte__inhalt {
    max-width: 520px;
  }
  .tp-karte__pin {
    width: 32px;
    height: 32px;
    margin: 0 auto 10px;
    color: var(--tp-red, #b0303f);
  }
  .tp-karte__adresse {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.5;
  }
  .tp-karte__aktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 20px;
  }
  .tp-karte__laden {
    min-height: 44px;
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    background-color: #222;
    color: #fff;
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .tp-karte__laden:hover {
    background-color: #444;
  }
  .tp-karte__laden:focus-visible,
  .tp-karte__extern:focus-visible,
  .tp-karte__hinweis a:focus-visible {
    outline: 2px solid #222;
    outline-offset: 3px;
  }
  .tp-karte__extern {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #222;
    font-weight: 600;
    text-decoration: underline;
  }
  .tp-karte__hinweis {
    margin: 14px 0 0;
    color: #555;
    font-size: 14px;
    line-height: 1.5;
  }
  .tp-karte__hinweis a {
    color: inherit;
    text-decoration: underline;
  }
  .tp-karte.is-geladen .tp-karte__flaeche {
    display: block;
    min-height: 0;
    padding: 0;
    border: none;
    background: none;
  }
  .tp-karte__frame {
    display: block;
    width: 100%;
    height: 300px;
    border: none;
    border-radius: 8px;
  }
  @media screen and (max-width: 749px) {
    .tp-karte__aktionen {
      flex-direction: column;
    }
    .tp-karte__laden {
      width: 100%;
    }
  }
{% endstylesheet %}

<section class="kontakt-section">
  <div class="kontakt-info">
    <h2>Kontaktieren Sie uns</h2>
    <p><strong>Adresse:</strong> Saarlandstraße 73-81, 16515 Oranienburg</p>
    <p><strong>Telefon:</strong> <a href="tel:+4933015733720">03301 573 37 20</a></p>
    <p><strong>E-Mail:</strong> <a href="mailto:kontakt@teppich-paradies.net">kontakt@teppich-paradies.net</a></p>
    <p><strong>WhatsApp:</strong>
      <a href="https://wa.me/491792612211" target="_blank" class="whatsapp-link">
        {%- comment -%} Eigenes Icon statt upload.wikimedia.org: kein Drittanbieter-Request (Audit B-23) {%- endcomment -%}
        <svg class="whatsapp-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2z"/></svg>
        0179 2612211
      </a>
    </p>
    <p><strong>Öffnungszeiten:</strong><br>Mo–Fr: 8:30–18:00 Uhr<br>Sa: 8:30–14:30 Uhr</p>
  </div>

  <div class="kontakt-formular" data-tp-sample-request>
    <div class="tp-contact-service-links">
      <p>Für Serviceanfragen direkt zum passenden Formular:</p>
      <ul>
        <li><a href="/pages/liefer-verlegeservice#tp-anfrage">Liefer- &amp; Verlegeservice anfragen</a></li>
        <li><a href="/pages/teppichreinigung#tp-anfrage">Teppichreinigung anfragen</a></li>
      </ul>
    </div>
    <div class="tp-sample-intro">
      <h3 class="tp-sample-intro__heading">Kostenloses Muster bestellen</h3>
      <div class="tp-sample-intro__product">
        <img class="tp-sample-intro__image" data-tp-product-image alt="" width="56" height="56">
        <span class="tp-sample-intro__product-name" data-tp-product-name></span>
      </div>
      <p class="tp-sample-intro__text" data-tp-intro>Wir senden Ihnen gerne ein kostenloses Muster zu.</p>
    </div>

    <p class="tp-anfrage-hinweis" data-tp-anfrage-hinweis hidden></p>

    {%- form 'contact', id: 'ContactForm-sample', class: 'contact-form' -%}
      <input type="hidden" name="contact[id]" value="ContactForm-sample">
      <input type="hidden" name="contact[Betreff]" value="" data-tp-hidden-field="Betreff">
      <input type="hidden" name="contact[Produkt]" value="" data-tp-hidden-field="Produkt">
      <input type="hidden" name="contact[Produkt-Handle]" value="" data-tp-hidden-field="Produkt-Handle">
      <input type="hidden" name="contact[Produkt-Link]" value="" data-tp-hidden-field="Produkt-Link">

      {%- if form.posted_successfully? -%}
        <div class="tp-form-success tp-success--generic" role="status" tabindex="-1" data-tp-lead-success data-tp-mixed-contact-success>
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          <span>Vielen Dank für Ihre Nachricht! Wir melden uns schnellstmöglich bei Ihnen.</span>
        </div>
        <div class="tp-form-success tp-success--sample" role="status" tabindex="-1">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          <span>Vielen Dank! Ihre Musteranfrage ist bei uns eingegangen – wir senden Ihnen das Muster schnellstmöglich zu.</span>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="tp-form-error" role="alert" tabindex="-1">
          {{- 'icon-error.svg' | inline_asset_content -}}
          {%- if form.errors.messages.email != blank -%}
            <span>{{ form.errors.translated_fields.email | default: 'E-Mail' | capitalize }} {{ form.errors.messages.email }}</span>
          {%- else -%}
            <span>Bitte prüfen Sie Ihre Angaben und versuchen Sie es erneut.</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <label for="ContactFormName">Name</label>
      <input type="text" id="ContactFormName" name="contact[name]" value="{{ form.name }}" required>

      <label for="ContactFormEmail">E-Mail</label>
      <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" required>

      <div data-sample-field>
        <label for="ContactFormStreet">Straße und Hausnummer</label>
        <input type="text" id="ContactFormStreet" name="contact[Straße und Hausnummer]" autocomplete="street-address">
      </div>

      <div data-sample-field>
        <label for="ContactFormZip">PLZ</label>
        <input type="text" id="ContactFormZip" name="contact[PLZ]" autocomplete="postal-code" inputmode="numeric">
      </div>

      <div data-sample-field>
        <label for="ContactFormCity">Ort</label>
        <input type="text" id="ContactFormCity" name="contact[Ort]" autocomplete="address-level2">
      </div>

      <div data-sample-field>
        <label for="ContactFormPhone">Telefon (optional)</label>
        <input type="tel" id="ContactFormPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      </div>

      <label for="ContactFormMessage" data-message-label>Nachricht</label>
      <textarea id="ContactFormMessage" name="contact[body]" rows="5" data-message-field required>{{ form.body }}</textarea>

      <button type="submit">Nachricht senden</button>
    {%- endform -%}
  </div>
</section>

{%- comment -%}
  Google-Maps-Karte als Zwei-Klick-Loesung: Ohne Klick oder ausdrueckliche
  Marketing-Einwilligung (Shopify Customer Privacy API) geht keine Anfrage an
  Google. Die Embed-Adresse steht nur im data-Attribut; das iframe setzt erst
  das Script unten ein. Der Link "In Google Maps oeffnen" ist ein normaler
  Link und laedt nichts vorab.
{%- endcomment -%}
{%- liquid
  assign tp_karte_id = 'tp-karte-' | append: section.id
  assign tp_karte_embed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2415.89022847034!2d13.242245077649626!3d52.73417322034972!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a900b2dd3a3391%3A0xaec22baa10182b4!2sTeppich%20Paradies%20Oranienburg%20GmbH!5e0!3m2!1sde!2sde!4v1778188111105!5m2!1sde!2sde'
  assign tp_karte_link = settings.tp_google_profil | default: 'https://maps.google.com/?cid=787042219843486388'
-%}
<div
  class="tp-karte"
  id="{{ tp_karte_id }}"
  data-tp-karte
  data-tp-karte-src="{{ tp_karte_embed | escape }}"
  data-tp-karte-titel="Karte: Teppich Paradies Oranienburg, Saarlandstraße 73-81, 16515 Oranienburg"
>
  <div class="tp-karte__flaeche" data-tp-karte-flaeche>
    <div class="tp-karte__inhalt">
      <svg class="tp-karte__pin" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      <p class="tp-karte__adresse">
        <strong>Teppich Paradies Oranienburg</strong><br>
        Saarlandstraße 73-81, 16515&nbsp;Oranienburg
      </p>
      <div class="tp-karte__aktionen">
        <button type="button" class="tp-karte__laden" data-tp-karte-laden aria-describedby="{{ tp_karte_id }}-hinweis">
          Karte von Google Maps laden
        </button>
        <a class="tp-karte__extern" href="{{ tp_karte_link | escape }}" target="_blank" rel="noopener">
          In Google Maps öffnen<span class="visually-hidden"> (öffnet in neuem Tab)</span>
        </a>
      </div>
      <p class="tp-karte__hinweis" id="{{ tp_karte_id }}-hinweis">
        Dabei werden Daten an Google übertragen. Mehr in der
        <a href="/pages/datenschutzerklarung">Datenschutzerklärung</a>.
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    var box = document.getElementById({{ tp_karte_id | json }});
    if (!box || box.hasAttribute('data-tp-karte-bereit')) return;
    box.setAttribute('data-tp-karte-bereit', '');
    var geladen = false;

    function laden(perKlick) {
      // isConnected: nach einem Section-Reload im Theme-Editor haengt der alte Listener noch
      if (geladen || !box.isConnected) return;
      geladen = true;
      var frame = document.createElement('iframe');
      frame.className = 'tp-karte__frame';
      frame.title = box.getAttribute('data-tp-karte-titel');
      frame.width = '1200';
      frame.height = '300';
      frame.setAttribute('allowfullscreen', '');
      frame.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      // Bei Einwilligung erst laden, wenn die Karte in Sichtweite kommt
      if (!perKlick) frame.setAttribute('loading', 'lazy');
      frame.src = box.getAttribute('data-tp-karte-src');
      var flaeche = box.querySelector('[data-tp-karte-flaeche]');
      flaeche.replaceChildren(frame);
      box.classList.add('is-geladen');
      if (perKlick) frame.focus();
    }

    var knopf = box.querySelector('[data-tp-karte-laden]');
    if (knopf) {
      knopf.addEventListener('click', function () {
        laden(true);
      });
    }

    // Direkt laden nur bei ausdruecklichem Ja zu Marketing. marketingAllowed()
    // allein reicht nicht: es ist auch ohne Banner bzw. ohne Einwilligungspflicht true.
    function marketingJa() {
      try {
        var privacy = window.Shopify && window.Shopify.customerPrivacy;
        var consent = privacy && typeof privacy.currentVisitorConsent === 'function' && privacy.currentVisitorConsent();
        return !!consent && consent.marketing === 'yes';
      } catch (e) {
        return false;
      }
    }
    function einwilligungPruefen() {
      if (geladen) return;
      if (marketingJa()) {
        laden(false);
        return;
      }
      document.addEventListener('visitorConsentCollected', function () {
        if (marketingJa()) laden(false);
      });
    }
    if (window.Shopify && window.Shopify.customerPrivacy) {
      einwilligungPruefen();
    } else if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
      window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (error) {
        if (!error) einwilligungPruefen();
      });
    }
  })();
</script>

<script src="{{ 'tp-sample-request.js' | asset_url }}" defer="defer"></script>

