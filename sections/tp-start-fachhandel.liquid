{%- comment -%}
  TP Warum Teppich Paradies: echtes Foto links, Text und vier Fakten rechts.
  Fakten sind Bloecke - nur Belegbares eintragen.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

<section class="tp-s-sec tp-s-sec--band tp-fh" id="tp-fachhandel" aria-labelledby="tp-fh-h2">
  <div class="tp-s-wrap tp-fh__wrap">
    <div class="tp-fh__media">
      {%- if section.settings.bild != blank -%}
        {%- assign fh_alt = section.settings.bild.alt | default: section.settings.heading -%}
        {{ section.settings.bild | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(max-width: 1023px) 100vw, 50vw', alt: fh_alt, class: 'tp-fh__img' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'tp-fh__img' }}
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="tp-s-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 id="tp-fh-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="tp-fh__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="tp-fh__facts">
          {%- for block in section.blocks -%}
            <div class="tp-fh__fact" {{ block.shopify_attributes }}><b>{{ block.settings.wert | escape }}</b><span>{{ block.settings.label | escape }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="tp-fh__ctas">
        {%- if section.settings.cta1_label != blank -%}<a class="tp-s-btn tp-s-btn--dark" href="{{ section.settings.cta1_link | default: '/pages/kontakt' }}">{{ section.settings.cta1_label | escape }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="tp-s-btn tp-s-btn--ghost" href="{{ section.settings.cta2_link | default: '/pages/kontakt' }}">{{ section.settings.cta2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .tp-fh__wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .tp-fh__media { border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; box-shadow: 0 10px 30px rgba(29, 26, 23, 0.1); background: #ede7de; }
  .tp-fh__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tp-fh__text { color: #4a443f; max-width: 56ch; margin-top: 10px; }
  .tp-fh__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; margin: 24px 0; }
  .tp-fh__fact b { display: block; font-size: 22px; font-weight: 700; line-height: 1.1; color: #1d1a17; }
  .tp-fh__fact span { font-size: 14px; color: #655e57; }
  .tp-fh__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 1023px) { .tp-fh__wrap { grid-template-columns: 1fr; gap: 28px; } }
  @media (max-width: 767px) { .tp-fh__facts { gap: 14px; } .tp-fh__fact b { font-size: 19px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Warum Teppich Paradies",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "bild", "label": "Echtes Foto (Zuschnitt, Laden, Team)" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Warum Teppich Paradies" },
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Ein echtes Fachgeschäft – kein anonymer Online-Shop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wir beraten in der Saarlandstraße in Oranienburg. Wer online bestellt, spricht mit denselben Menschen, die hier täglich Böden zuschneiden und verlegen.</p>" },
    { "type": "text", "id": "cta1_label", "label": "Button 1", "default": "Beratung vereinbaren" },
    { "type": "url", "id": "cta1_link", "label": "Button 1 Ziel" },
    { "type": "text", "id": "cta2_label", "label": "Button 2", "default": "Fachgeschäft & Anfahrt" },
    { "type": "url", "id": "cta2_link", "label": "Button 2 Ziel" }
  ],
  "blocks": [
    {
      "type": "fakt",
      "name": "Fakt",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "wert", "label": "Wert", "default": "Mo–Sa" },
        { "type": "text", "id": "label", "label": "Beschreibung", "default": "Geöffnet, Beratung vor Ort" }
      ]
    }
  ],
  "presets": [ { "name": "TP Warum Teppich Paradies" } ]
}
{% endschema %}
