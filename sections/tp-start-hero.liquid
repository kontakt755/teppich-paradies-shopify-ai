{{ 'tp-start-abschnitte.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  TP Start-Hero (Konzept C): Text links, helles Wohnraumbild rechts, ein
  Hauptknopf, der zweite Weg (Verlegung) als Textlink daneben, Telefon und
  WhatsApp als Textlinks. Kein Overlay auf dem Bild. Shopvergleich 2026-10-15
  (w-096): ein Ziel je Bildschirm, Rot nur fuer Preis, Rabatt und Hauptknopf -
  deshalb ist <em> in der Ueberschrift nicht mehr rot.
  Aufbau "kompakt" (Startseiten-Umbau C, w-096): ohne Bild, Ueberschrift ueber
  die volle Breite, Unterzeile, Textlink und Bewertung in einer Zeile - damit
  die Kategorien mit grossen Bildern in den ersten Bildschirm ruecken. Das Bild
  wird dann gar nicht ausgegeben, LCP ist die erste Kategoriekarte.
  Das Bild ist das LCP-Element und laedt deshalb eager mit hoher Prioritaet.
  Die Google-Bewertung wird nur angezeigt, wenn ein Wert eingetragen ist - und dann
  als Zahl aus dem Unternehmensprofil, die der Betreiber selbst pflegt.
{%- endcomment -%}
{%- liquid
  assign tel_raw = section.settings.telefon | remove: ' ' | remove: '/'
  # Das Richtext-Feld liefert den Text in <p>...</p>. In einem h1 ist ein p nicht
  # zulaessig, deshalb die Absatzhuelle entfernen - <em> und die uebrige Auszeichnung
  # bleiben erhalten. Mehrere Absaetze wuerden dabei zu einer Zeile verschmelzen;
  # fuer eine Ueberschrift ist das richtig.
  assign h1_text = section.settings.headline | replace: '<p>', '' | replace: '</p>', ''
  assign hero_kompakt = false
  if section.settings.layout == 'kompakt'
    assign hero_kompakt = true
  endif

  # Google-Bewertung aus einer Quelle. Steht am Abschnitt selbst nichts, gilt
  # das Shop-Metafeld (monatlich: scripts/google-bewertung.mjs), ohne Metafeld die
  # Theme-Einstellung (TP Google-Bewertung). Bis 2026-09-16 wurde der Wert an zehn
  # Stellen einzeln gepflegt und war auseinandergelaufen.
  assign tp_gb = shop.metafields.custom.google_bewertung.value
  assign tp_rating_wert = section.settings.rating_wert | strip | default: tp_gb.wert | default: settings.tp_google_wert
  assign tp_rating_link = section.settings.rating_link | default: settings.tp_google_link
  capture tp_rating_standard
    echo tp_gb.anzahl | default: settings.tp_google_anzahl
    echo ' Google-Bewertungen'
  endcapture
  assign tp_rating_text = section.settings.rating_text | strip | default: tp_rating_standard | strip
-%}

<section class="tp-hero{% if hero_kompakt %} tp-hero--kompakt{% endif %}" aria-labelledby="tp-hero-h1">
  <div class="tp-s-wrap tp-hero__wrap">
    <div class="tp-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tp-s-eyebrow tp-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 id="tp-hero-h1" class="tp-hero__h1">{{ h1_text }}</h1>
      {%- if section.settings.subline != blank -%}
        {%- comment -%}
          div statt p: Das Richtext-Feld bringt eigene <p> mit. Ein p im p schliesst
          der Parser sofort - die Klasse blieb dann auf einem leeren Element und der
          sichtbare Text stand ohne Typografie da (14 statt 18 px, live belegt).
        {%- endcomment -%}
        <div class="tp-hero__sub">{{ section.settings.subline }}</div>
      {%- endif -%}
      <div class="tp-hero__ctas">
        {%- if section.settings.cta1_label != blank -%}
          <a class="tp-s-btn tp-s-btn--primary" href="{{ section.settings.cta1_link | default: '/collections/all' }}">{{ section.settings.cta1_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="tp-hero__textlink" href="{{ section.settings.cta2_link | default: '/pages/teppichboden-verlegen-lassen' }}">{{ section.settings.cta2_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="tp-hero__meta">
        {%- if section.settings.telefon != blank -%}
          <a href="tel:{{ tel_raw }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>{{ section.settings.telefon | escape }}</a>
        {%- endif -%}
        {%- if section.settings.whatsapp != blank -%}
          <a href="{{ section.settings.whatsapp }}" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2z"/></svg>WhatsApp</a>
        {%- endif -%}
        {%- if tp_rating_wert != blank -%}
          <a class="tp-hero__rating" href="{{ tp_rating_link | default: '#' }}" rel="noopener" target="_blank" title="Google-Bewertungen">
            <span class="tp-hero__stars" aria-hidden="true">★★★★★</span><b>{{ tp_rating_wert | escape }}</b><small>· {{ tp_rating_text | escape }}</small>
          </a>
          {%- comment -%} § 5b Abs. 3 UWG: der Hinweis gehoert direkt zur Note {%- endcomment -%}
          {%- render 'tp-bewertungshinweis', kurz: true -%}
        {%- endif -%}
      </div>
    </div>
    {%- unless hero_kompakt -%}
    <div class="tp-hero__media">
      {%- if section.settings.bild != blank -%}
        {%- comment -%}
          alt zuerst zuweisen: eine Filterkette im alt-Argument verschluckt alle
          folgenden Argumente von image_tag - class kam sonst nie am Bild an.
        {%- endcomment -%}
        {%- assign hero_alt = section.settings.bild.alt | default: section.settings.bild_alt | default: section.settings.bild_caption -%}
        {%- comment -%}
          sizes folgt dem Raster: mobil volle Breite minus 2x16px Rand, darueber
          die rechte Spalte (1fr von 2.05fr abzueglich Luecke), gedeckelt durch
          --tp-container (1240px, ab 1600px 1360px).

          Perf (#662): 700 ergaenzt, weil das die naechste Kandidatengroesse
          nach dem gemessenen Bedarf ist - mobil 380 CSS-px x 1,75 DPR (Lighthouse-
          Emulation) ergeben rund 665px Bedarf; ohne 700 in der Liste sprang der
          Browser auf 800 (132 KB), mit 700 auf rund 102 KB (-23%). Breitere
          Bildschirme/hoehere DPR erreichen weiter 1000-1600, das aendert sich
          nicht - die Liste bekommt nur eine feinere Stufe im mobilen Bereich.
        {%- endcomment -%}
        {{ section.settings.bild | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', preload: true, widths: '400, 600, 700, 800, 1000, 1200, 1600', sizes: '(max-width: 767px) calc(100vw - 32px), (max-width: 1239px) calc(48vw - 37px), (min-width: 1600px) 620px, 560px', alt: hero_alt, class: 'tp-hero__img' }}
      {%- else -%}
        <div class="tp-hero__platzhalter">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if section.settings.bild_caption != blank -%}
        <span class="tp-hero__cap">{{ section.settings.bild_caption | escape }}</span>
      {%- endif -%}
    </div>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "TP Start-Hero",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Aufbau", "options": [ { "value": "bild", "label": "Text und Bild" }, { "value": "kompakt", "label": "Kompakt ohne Bild" } ], "default": "bild", "info": "Kompakt: Kategorien mit grossen Bildern direkt darunter im ersten Bildschirm." },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile darueber", "default": "Fachhandel in Oranienburg" },
    { "type": "richtext", "id": "headline", "label": "Ueberschrift (H1)", "info": "Hoechstens zwei Zeilen. Keine farbige Hervorhebung: Rot bleibt Preis, Rabatt und Hauptknopf vorbehalten.", "default": "<p>Teppichboden und Vinyl nach Maß, vom Fachgeschäft in Oranienburg.</p>" },
    { "type": "richtext", "id": "subline", "label": "Unterzeile", "default": "<p>Böden zugeschnitten, geliefert und auf Wunsch verlegt.</p>" },
    { "type": "text", "id": "cta1_label", "label": "Hauptknopf", "default": "Boden aussuchen" },
    { "type": "url", "id": "cta1_link", "label": "Hauptknopf Ziel" },
    { "type": "text", "id": "cta2_label", "label": "Textlink daneben", "default": "Verlegung anfragen (bis 50 km)" },
    { "type": "url", "id": "cta2_link", "label": "Textlink Ziel" },
    { "type": "text", "id": "telefon", "label": "Telefon", "default": "03301 573 37 20" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp-Link (wa.me/…)" },
    { "type": "header", "content": "Google-Bewertung (leer = ausgeblendet)" },
    { "type": "text", "id": "rating_wert", "label": "Wert, z. B. 4,9", "info": "Aus dem Google-Unternehmensprofil abschreiben, nicht schaetzen." },
    { "type": "text", "id": "rating_text", "label": "Text daneben", "default": "Google-Bewertungen" },
    { "type": "url", "id": "rating_link", "label": "Link zum Google-Profil" },
    { "type": "header", "content": "Bild" },
    { "type": "image_picker", "id": "bild", "label": "Helles Wohnraumbild (Boden im Vordergrund)" },
    { "type": "text", "id": "bild_alt", "label": "Bildbeschreibung (Alt-Text)", "info": "Gilt, wenn das Bild in Shopify keinen Alt-Text hat." },
    { "type": "text", "id": "bild_caption", "label": "Bildunterschrift", "info": "\"Echtes Projekt\" nur bei eigenen Projektfotos." }
  ],
  "presets": [ { "name": "TP Start-Hero" } ]
}
{% endschema %}
