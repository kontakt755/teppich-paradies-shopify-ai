{% comment %}
  Zuletzt angesehen (Werkbank w-025): ruhige Karten-Reihe mit den Produkten, die
  der Besucher zuvor angesehen hat - auf Produkt- und Kollektionsseiten, ohne das
  aktuelle Produkt. Bodenbelag wird ueber mehrere Besuche entschieden; die Reihe
  hilft beim Wiederfinden.

  Speicher: nur lesen, nichts doppelt ablegen. Das Theme merkt sich angesehene
  Produkte bereits (assets/recently-viewed-products.js, localStorage-Schluessel
  "viewedProducts", Produkt-IDs, neueste zuerst, hoechstens 4 inklusive des
  aktuellen Produkts). Predictive Search liest dieselbe Liste.

  Zwei Betriebsarten aus einer Datei - die Section steht in der Section-Gruppe
  sections/tp-zuletzt-group.json, die layout/theme.liquid zwischen Inhalt und
  Footer einbindet. Eine Gruppe statt Eintraegen in rund 40 Templates, weil die
  Produktkarte (statischer _product-card-Block) je Section-Instanz in der JSON
  definiert sein muss und so nur einmal gepflegt wird.

  1. Huelle (Produkt- und Kollektionsseite): Ueberschrift und leere Liste in
     einem versteckten Element. Das Skript liest die IDs, holt die Karten und
     blendet die Huelle erst ein, wenn mindestens eine Karte da ist. Ohne
     Verlauf bleibt sie versteckt: kein Leerraum, kein Sprung.
  2. Karten (Aufruf ueber die Section Rendering API mit einer Suche
     id:123 OR id:456): die Karten dieser Produkte, gerendert mit dem
     statischen Kartenblock dieser Section. Titelkuerzung, EUR/m2 bei
     Paketware sowie Muster und Vergleich kommen damit aus denselben Bloecken
     wie in jedem Raster; es gibt keine eigene Kartenlogik.
     Auf der echten Suchseite bleibt die Liste versteckt (hidden), sie wird nur
     vom Skript gelesen.
{% endcomment %}

{%- liquid
  assign tp_za_seite = request.page_type
  assign tp_za_ueberschrift = section.settings.heading | default: 'Zuletzt angesehen'
  assign tp_za_karten_modus = false
  if tp_za_seite == 'search' and search.performed and search.terms contains 'id:'
    assign tp_za_karten_modus = true
  endif
-%}

{%- if tp_za_seite == 'product' or tp_za_seite == 'collection' -%}
  <script
    src="{{ 'tp-zuletzt-angesehen.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  <tp-zuletzt-angesehen
    class="tp-za"
    data-section-id="{{ section.id }}"
    data-search-url="{{ routes.search_url }}"
    data-current-product-id="{{ product.id }}"
    data-max="{{ section.settings.max_products }}"
    hidden
    {{ section.shopify_attributes }}
  >
    <div class="section-background color-{{ section.settings.color_scheme }}"></div>
    <div
      class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
      style="{% render 'spacing-style', settings: section.settings %}"
      role="region"
      aria-labelledby="tp-za-titel-{{ section.id }}"
    >
      <h2
        class="tp-za__titel h4"
        id="tp-za-titel-{{ section.id }}"
      >
        {{- tp_za_ueberschrift | escape -}}
      </h2>
      <ul class="tp-za__liste"></ul>
    </div>
  </tp-zuletzt-angesehen>
{%- elsif tp_za_karten_modus -%}
  {%- assign tp_za_produkte = search.results | where: 'object_type', 'product' -%}
  <ul
    data-tp-za-karten
    hidden
  >
    {%- for tp_za_produkt in tp_za_produkte limit: 4 -%}
      <li data-product-id="{{ tp_za_produkt.id }}">
        {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: tp_za_produkt %}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  /* Section-CSS gilt seitenweit: alles haengt am Element oder an .tp-za. */
  tp-zuletzt-angesehen {
    display: block;
  }

  /* Das hidden-Attribut verliert sonst gegen display: block. */
  tp-zuletzt-angesehen[hidden] {
    display: none;
  }

  /* Grid-Kinder duerfen schmaler als ihr Inhalt werden - sonst weitet die
     wischbare Reihe die Seite statt in sich zu scrollen. */
  .tp-za .section > * {
    min-width: 0;
  }

  .tp-za__titel {
    margin: 0 0 var(--padding-lg, 20px);
  }

  /* Desktop: eine Reihe mit bis zu vier Karten, gleich breit wie "Empfohlene Artikel". */
  .tp-za__liste {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tp-za__liste > li {
    min-width: 0;
  }

  /* Mobil: wischbare Reihe. Die naechste Karte ragt an, damit sichtbar bleibt,
     dass es weitergeht. Das Wischen bleibt in der Liste - die Seite selbst
     scrollt nie seitlich. */
  @media screen and (max-width: 749px) {
    .tp-za__liste {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(62%, 260px);
      gap: 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      padding-block-end: 4px;
    }

    .tp-za__liste::-webkit-scrollbar {
      display: none;
    }

    .tp-za__liste > li {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Zuletzt angesehen",
  "tag": "section",
  "class": "tp-za-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Zeigt die zuvor angesehenen Produkte des Besuchers (ohne das aktuelle). Ohne Verlauf bleibt der Abschnitt unsichtbar. Gedacht für die Section-Gruppe unter dem Seiteninhalt; die Produktkarte wird dort einmal eingestellt."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Zuletzt angesehen"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Anzahl Produkte",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "info": "Das Theme merkt sich höchstens 4 Produkte, auf der Produktseite zählt das aktuelle mit."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Abstand unten",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "TP Zuletzt angesehen"
    }
  ]
}
{% endschema %}
