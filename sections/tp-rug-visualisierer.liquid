{%- comment -%}
  Raum-Visualisierer (Prototyp): Raumfoto lokal laden, Teppich als Overlay
  platzieren. Das Modul assets/tp-rug-visualizer.js laedt erst auf Klick.
  Keine KI, keine Speicherung - das Foto bleibt im Browser.
{%- endcomment -%}
{%- capture tp_rug_on -%}{%- render 'tp-rug-gate' -%}{%- endcapture -%}
{%- if tp_rug_on == '1' -%}
  {%- capture tp_rv_cat -%}{%- render 'tp-rug-katalog', mode: 'json' -%}{%- endcapture -%}
  <section class="tp-rug tp-rug-sec tp-rug-sec--tight" aria-labelledby="tp-rv-{{ section.id }}">
    <div class="tp-rug-wrap">
      <nav class="tp-rug-crumbs" aria-label="Brotkrumen">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">Startseite</a></li>
          <li><a href="{% render 'tp-rug-url', key: 'start' %}">Teppiche</a></li>
          <li><span aria-current="page">Raum-Visualisierer</span></li>
        </ol>
      </nav>
      <div class="tp-rug-head">
        <div class="tp-rug-head__text">
          <p class="tp-rug-kicker">Raum-Visualisierer</p>
          <h1 class="tp-rug-h1" id="tp-rv-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
          <p class="tp-rug-lead">{{ section.settings.text | escape }}</p>
        </div>
      </div>
      <tp-rug-vis-launch class="tp-rug-card-box tp-rug-vislaunch" data-module="{{ 'tp-rug-visualizer.js' | asset_url }}" data-catalog="{{ tp_rv_cat | strip | escape }}">
        <div class="tp-rug-vislaunch__bar">
          <div class="tp-rug-field" style="margin:0">
            <label for="tp-rv-p-{{ section.id }}">Teppich</label>
            <select id="tp-rv-p-{{ section.id }}" data-product>
              <option value="tp-rug-test-teppich-nach-mass">TEST Teppich nach Maß</option>
              <option value="tp-rug-test-wohnzimmer">TEST Wohnzimmer</option>
              <option value="tp-rug-test-esszimmer">TEST Esszimmer</option>
              <option value="tp-rug-test-schlafzimmer">TEST Schlafzimmer</option>
              <option value="tp-rug-test-flur-laeufer">TEST Flur / Läufer</option>
              <option value="tp-rug-test-kinderzimmer">TEST Kinderzimmer</option>
              <option value="tp-rug-test-baumwolleinfassung">TEST Baumwolleinfassung</option>
              <option value="tp-rug-test-paspelteppich">TEST Paspelteppich</option>
              <option value="tp-rug-test-kettelteppich">TEST Kettelteppich</option>
              <option value="tp-rug-test-cover-kippkante">TEST Cover / Kippkante</option>
            </select>
          </div>
          <button type="button" class="tp-rug-btn tp-rug-btn--primary" data-start>{% render 'tp-rug-icon', name: 'auge', size: 20 %}Visualisierer starten</button>
        </div>
        <ol class="tp-rug-vislaunch__steps" role="list" data-intro>
          <li><span>1</span>Raumfoto wählen – oder den Beispielraum nutzen.</li>
          <li><span>2</span>Teppich, Form und Farbe wählen.</li>
          <li><span>3</span>Teppich verschieben, drehen und in der Größe anpassen.</li>
          <li><span>4</span>Mit Vorher/Nachher vergleichen.</li>
        </ol>
        <div data-mount></div>
      </tp-rug-vis-launch>
      <p class="tp-rug-small" style="margin-top:12px">Unverbindliche Vorschau – Darstellung kann vom Original abweichen. Ihr Foto bleibt auf Ihrem Gerät. Eine echte Raumerkennung kann später angebunden werden.</p>
    </div>
  </section>
  <script type="module" src="{{ 'tp-rug-tools.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "TP Raum-Visualisierer",
  "tag": "div",
  "class": "tp-rug-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Teppich in meinem Raum ansehen" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Laden Sie ein Foto Ihres Raums und legen Sie den Teppich probeweise hinein – verschieben, drehen, vergrößern, vergleichen." }
  ],
  "presets": [{ "name": "TP Raum-Visualisierer" }]
}
{% endschema %}
