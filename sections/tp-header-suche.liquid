{%- comment -%}
  TP Suche + Kategorie-Leiste unter dem Header.
  Desktop: ein breites Suchfeld (GET /search, funktioniert ohne JS). Mit JS
  wird es zur Schnellsuche: ab zwei Zeichen zeigt assets/tp-suche.js ein
  Dropdown mit Vorschlaegen, Produkten und Kategorien (Shopify Predictive
  Search, Markup aus snippets/tp-suche-ergebnisse.liquid); bei leerem Feld die
  beliebten Bereiche und Suchbegriffe aus den Einstellungen.
  Telefon: Suchfeld in voller Breite, darunter eine scrollbare Kategorie-Leiste,
  damit das Sortiment ohne Oeffnen des Menues sichtbar ist. Die Leiste scrollt
  mit dem Inhalt weg, der klebende Header bleibt schlank. Das Feld oeffnet dort
  das Horizon-Suchfenster (dieselben Ergebnisse, dieselbe Optik).
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tp-suche.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div class="tp-hs">
  <div class="tp-s-wrap">
    <tp-suche-leiste class="tp-hs__leiste">
      <form class="tp-hs__form" role="search" action="{{ routes.search_url }}" method="get">
        <input type="hidden" name="type" value="product,collection,page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="tp-hs__lupe"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="visually-hidden" for="tp-hs-q">Produkte suchen</label>
        <input
          id="tp-hs-q"
          class="tp-hs__input"
          type="search"
          name="q"
          placeholder="{{ section.settings.platzhalter | escape }}"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          role="combobox"
          aria-expanded="false"
          aria-controls="tp-hs-panel"
          aria-autocomplete="list"
          aria-haspopup="listbox"
        >
        <button class="tp-hs__btn" type="submit" aria-label="Suchen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
      </form>

      {%- comment -%}
        Das Dropdown liegt ueber dem Seiteninhalt (absolut), damit sich beim
        Oeffnen nichts verschiebt. hidden bis JS es fuellt.
      {%- endcomment -%}
      <div class="tp-hs__panel" id="tp-hs-panel" hidden>
        <div class="tp-hs__laden" aria-hidden="true"></div>
        <div class="tp-hs__meinten" data-tp-meinten hidden></div>
        <div class="tp-hs__leer" data-tp-leer role="listbox" aria-label="Beliebte Bereiche und Suchbegriffe">
          {%- if section.blocks.size > 0 -%}
            <h3 class="tp-se__h">Beliebte Bereiche</h3>
            <ul class="tp-se__liste tp-se__liste--chips" role="presentation">
              {%- for block in section.blocks -%}
                {%- if block.settings.link == blank or block.settings.label == blank -%}{%- continue -%}{%- endif -%}
                <li class="tp-se__item" role="presentation"><a role="option" class="tp-se__chip" data-tp-typ="bereich" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- assign tp_hs_beliebt = section.settings.beliebte_suchen | split: ',' -%}
          {%- assign tp_hs_beliebt_anzahl = 0 -%}
          {%- capture tp_hs_beliebt_liste -%}
            {%- for tp_hs_b in tp_hs_beliebt -%}
              {%- assign tp_hs_bt = tp_hs_b | strip -%}
              {%- if tp_hs_bt == blank -%}{%- continue -%}{%- endif -%}
              {%- assign tp_hs_beliebt_anzahl = tp_hs_beliebt_anzahl | plus: 1 -%}
              <li class="tp-se__item" role="presentation"><a role="option" class="tp-se__chip" data-tp-typ="beliebt" href="{{ routes.search_url }}?q={{ tp_hs_bt | url_encode }}&amp;type=product,collection,page">{{ tp_hs_bt | escape }}</a></li>
            {%- endfor -%}
          {%- endcapture -%}
          {%- if tp_hs_beliebt_anzahl > 0 -%}
            <h3 class="tp-se__h">Häufig gesucht</h3>
            <ul class="tp-se__liste tp-se__liste--chips" role="presentation">{{ tp_hs_beliebt_liste }}</ul>
          {%- endif -%}
        </div>
        <div class="tp-hs__ergebnisse" data-tp-ergebnisse></div>
      </div>
      {%- if section.settings.synonyme != blank -%}
        <script type="application/json" data-tp-synonyme>{{ section.settings.synonyme | json }}</script>
      {%- endif -%}
    </tp-suche-leiste>
  </div>
  {%- comment -%}
    Auf Produktseite und Warenkorb keine Kategorie-Leiste: dort zaehlt der
    Artikel, die Leiste schob ihn am Telefon 56 px nach unten. Brotkrumen
    und Menue fuehren von dort weiter.
  {%- endcomment -%}
  {%- assign tp_hs_ohne_leiste = false -%}
  {%- if template.name == 'product' or template.name == 'cart' -%}
    {%- assign tp_hs_ohne_leiste = true -%}
  {%- endif -%}
  {%- comment -%}
    Auch nicht auf den Kategorieseiten mit eigener Unterkategorie-Leiste
    (Teppichboden, Vinylboden und ihre Unterkategorien, siehe
    snippets/tp-unterkategorien-leiste.liquid): Dort standen am Telefon zwei
    Knopfreihen fast uebereinander, "Klickvinyl" doppelt, rund 50 px. Die
    Leiste unter der H1 ist dort die genauere Navigation, das Menue die
    uebergreifende.
  {%- endcomment -%}
  {%- if template.name == 'collection' -%}
    {%- assign tp_hs_suffix = template.suffix | default: '' -%}
    {%- if tp_hs_suffix == 'teppichboden' or tp_hs_suffix == 'vinylboden' or tp_hs_suffix contains 'teppichboden-' or tp_hs_suffix contains 'vinylboden-' -%}
      {%- assign tp_hs_ohne_leiste = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if section.blocks.size > 0 and tp_hs_ohne_leiste == false -%}
    <nav class="tp-hs__chips" aria-label="Kategorien">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="tp-hs__chip{% if block.settings.hervorheben %} tp-hs__chip--rot{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
</div>

{% stylesheet %}
  .tp-hs { background: #fff; border-bottom: 1px solid var(--tp-line, #e6e0d8); }
  .tp-hs__leiste { display: block; position: relative; max-width: 720px; margin: 0 auto; }
  .tp-hs__form { display: flex; align-items: center; height: 50px; margin: 10px 0; border: 1.5px solid var(--tp-line-2, #d5cec4); border-radius: 999px; background: var(--tp-bg-2, #f6f2ec); padding: 0 6px 0 18px; transition: border-color 0.15s, background 0.15s, box-shadow 0.15s; }
  .tp-hs__form:focus-within { border-color: var(--tp-ink, #1d1a17); background: #fff; }
  .tp-hs__leiste--offen .tp-hs__form { box-shadow: 0 6px 24px rgba(29, 26, 23, 0.08); }
  .tp-hs__lupe { width: 18px; height: 18px; color: var(--tp-muted, #655e57); margin-right: 8px; flex: none; }
  .tp-hs__input { flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 16px; color: var(--tp-ink, #1d1a17); outline: none; }
  .tp-hs__input::placeholder { color: var(--tp-muted, #655e57); }
  .tp-hs__input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .tp-hs__btn { width: 42px; height: 42px; border-radius: 50%; background: var(--tp-ink, #1d1a17); color: #fff; display: grid; place-items: center; border: 0; cursor: pointer; flex: none; }
  .tp-hs__btn svg { width: 17px; height: 17px; }

  /* Dropdown: breiter als das Feld, zentriert darunter, ueber dem Inhalt.
     Hoehe begrenzt und innen scrollbar, damit es nie aus dem Viewport laeuft. */
  .tp-hs__panel {
    position: absolute;
    top: calc(100% - 2px);
    left: 50%;
    transform: translateX(-50%);
    width: min(960px, calc(100vw - 32px));
    max-height: min(72vh, 760px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 20px 24px 18px;
    background: #fff;
    border: 1px solid var(--tp-line, #e6e0d8);
    border-radius: 18px;
    box-shadow: 0 18px 48px rgba(29, 26, 23, 0.16);
    z-index: 60;
    text-align: left;
  }
  .tp-hs__panel[hidden] { display: none; }
  .tp-hs__laden { position: sticky; top: -20px; height: 2px; margin: -20px -24px 18px; background: transparent; overflow: hidden; }
  .tp-hs__laden::after { content: ''; display: block; height: 100%; width: 40%; background: var(--tp-red, #b73740); opacity: 0; transform: translateX(-100%); }
  .tp-hs__panel--laedt .tp-hs__laden::after { opacity: 1; animation: tp-hs-laden 1s linear infinite; }
  @keyframes tp-hs-laden { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
  @media (prefers-reduced-motion: reduce) { .tp-hs__panel--laedt .tp-hs__laden::after { animation: none; transform: none; width: 100%; } }
  .tp-hs__meinten { margin-bottom: 18px; }
  .tp-hs__meinten[hidden], .tp-hs__leer[hidden] { display: none; }
  .tp-hs__leer .tp-se__h + .tp-se__liste { margin-bottom: 18px; }
  .tp-hs__leer .tp-se__liste:last-child { margin-bottom: 0; }
  .tp-hs__hinweis { margin: 0; font-size: 14px; color: var(--tp-muted, #655e57); }

  .tp-hs__chips { display: none; }
  @media (max-width: 767px) {
    /* Kompakter Kopfbereich am Telefon: Feld 44 px, Leiste 36 px hoch
       (vorher 50 + 40 px, zusammen 219 px bis zum Inhalt). Eingabe bleibt
       16 px, sonst zoomt iOS. */
    .tp-hs__leiste { max-width: none; }
    .tp-hs__form { height: 44px; margin: 6px 0; padding: 0 4px 0 16px; }
    .tp-hs__btn { width: 36px; height: 36px; }
    .tp-hs__panel { display: none; }
    .tp-hs__chips { display: flex; gap: 8px; overflow-x: auto; padding: 0 var(--tp-pad) 8px; scrollbar-width: none; scroll-snap-type: x proximity; }
    .tp-hs__chips::-webkit-scrollbar { display: none; }
    .tp-hs__chip { flex: none; scroll-snap-align: start; min-height: 44px; display: inline-flex; align-items: center; padding: 0 14px; border-radius: 999px; background: var(--tp-bg-2, #f6f2ec); border: 1px solid var(--tp-line, #e6e0d8); font-weight: 500; font-size: 14.5px; color: var(--tp-ink, #1d1a17); text-decoration: none; }
    .tp-hs__chip--rot { background: var(--tp-red-soft, #fbeeef); color: var(--tp-red, #b73740); border-color: transparent; font-weight: 600; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Suche + Kategorien",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "platzhalter", "label": "Platzhalter im Suchfeld", "default": "Suchen: grauer Teppichboden, Vinyl Eiche, Sockelleiste weiß …" },
    { "type": "header", "content": "Schnellsuche (Desktop)" },
    { "type": "text", "id": "beliebte_suchen", "label": "Häufig gesucht (bei leerem Feld, mit Komma trennen)", "default": "Klickvinyl, Teppichboden grau, Vinyl Eiche, Sockelleiste weiß, Linoleum" },
    { "type": "textarea", "id": "synonyme", "label": "Meinten Sie (Kundenbegriff: Shop-Begriff)", "info": "Eine Zeile je Regel: links die Kundenwörter (mit Komma), rechts nach dem Doppelpunkt die Suchbegriffe des Shops. Fachlich falsche Gleichsetzungen vermeiden.", "default": "fußleiste, fussleiste, bodenleiste: Sockelleiste\npvc, cv-belag, cv belag: Vinyl von der Rolle\nauslegware, auslegeware: Teppichboden\ndesignboden, designbelag: Klickvinyl, Klebevinyl\nlaminat: Klickvinyl\nteppichleiste: Sockelleiste" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Kategorie",
      "limit": 12,
      "settings": [
        { "type": "paragraph", "content": "Am Telefon als Leiste unter dem Suchfeld, am Desktop als „Beliebte Bereiche“ im leeren Suchfeld." },
        { "type": "text", "id": "label", "label": "Bezeichnung", "default": "Teppichboden" },
        { "type": "url", "id": "link", "label": "Ziel" },
        { "type": "checkbox", "id": "hervorheben", "label": "Rot hervorheben (Service)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP Suche + Kategorien",
      "blocks": [
        { "type": "chip", "settings": { "label": "Teppichboden", "link": "shopify://collections/teppichboden" } },
        { "type": "chip", "settings": { "label": "Teppiche", "link": "shopify://collections/teppiche" } },
        { "type": "chip", "settings": { "label": "Teppichfliesen", "link": "shopify://collections/teppichfliesen" } },
        { "type": "chip", "settings": { "label": "Vinylboden", "link": "shopify://collections/vinylboden-1" } },
        { "type": "chip", "settings": { "label": "Klickvinyl", "link": "shopify://collections/vinylboden-klickvinyl" } },
        { "type": "chip", "settings": { "label": "Linoleum", "link": "shopify://collections/linoleumboden-1" } },
        { "type": "chip", "settings": { "label": "Bodenleisten", "link": "shopify://collections/bodenleisten" } },
        { "type": "chip", "settings": { "label": "Zubehör", "link": "shopify://collections/zubehoer" } },
        { "type": "chip", "settings": { "label": "Verlegung", "link": "shopify://pages/teppichboden-verlegen-lassen", "hervorheben": true } },
        { "type": "chip", "settings": { "label": "Muster", "link": "shopify://pages/muster" } }
      ]
    }
  ]
}
{% endschema %}
