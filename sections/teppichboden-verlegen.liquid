{% comment %}
  Einstieg und Konditionen der Seite "Teppichboden verlegen lassen".

  Die Konditionen kommen seit 2026-09-11 aus dem Snippet
  tp-verlegeservice-stufen und damit aus den Theme-Einstellungen
  (TP Verlegeservice). Vorher standen sie hier von Hand und widersprachen der
  Serviceregel an zwei Stellen: "ab 649 EUR ... im Umkreis von 15 km" (richtig
  ist ab 649 EUR bis 50 km) und "Diese Kosten gelten unabhaengig vom
  Warenwert" (die guenstigen Klebepreise gelten erst ab 649 EUR).
{% endcomment %}

{%- assign vs_seite = pages['liefer-verlegeservice'].url | default: '/pages/liefer-verlegeservice' -%}

<style>
  .verlege-hero-section {
    max-width: 1300px;
    margin: 80px auto 60px;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 60px;
  }

  .verlege-hero-text {
    flex: 1 1 520px;
  }

  .verlege-hero-title {
    font-size: clamp(2.5rem, 5vw, 3.4rem);
    font-weight: 700;
    margin-bottom: 28px;
    color: #2a2a2a;
  }

  .verlege-hero-sub {
    font-size: 18px;
    color: #555;
    line-height: 1.6;
  }

  .verlege-hero-img {
    flex: 1 1 520px;
    border-radius: 18px;
    overflow: hidden;
  }

  .verlege-hero-img img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .verlegepreise-bereich {
    max-width: 1200px;
    margin: 80px auto;
    padding: 0 20px;
  }

  .verlegepreise-bereich h2 {
    font-size: 32px;
    text-align: center;
    margin-bottom: 30px;
    color: #2a2a2a;
    position: relative;
  }

  .verlegepreise-bereich h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: #b4976c;
  }

  .verlegepreise-stufen {
    margin-top: 48px;
  }

  .verlegepreise-mehr {
    margin: 28px 0 0;
    font-size: 17px;
    line-height: 1.5;
    text-align: center;
  }

  .verlegepreise-mehr a {
    color: inherit;
    font-weight: 700;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .verlege-hero-section {
      flex-direction: column;
      gap: 40px;
    }

    .verlegepreise-bereich h2 {
      font-size: 26px;
    }
  }
</style>

<section class="verlege-hero-section">
  <div class="verlege-hero-text">
    <h1 class="verlege-hero-title">Ihr Teppichboden. Fachgerecht verlegt. Persönlich beraten.</h1>
    <p class="verlege-hero-sub">Wir liefern Ihren Teppichboden und verlegen ihn bei Ihnen zu Hause – rund um unseren Showroom in Oranienburg. Persönlich. Fair. Transparent.</p>
  </div>
  <div class="verlege-hero-img">
    {%- assign hero_ratio = section.settings.image.aspect_ratio | default: 1.5 -%}
    <img
      src="{{ section.settings.image | image_url: width: 900 }}"
      alt="{{ section.settings.image.alt | escape }}"
      width="900"
      height="{{ 900 | divided_by: hero_ratio | round }}"
      loading="eager"
      fetchpriority="high"
    >
  </div>
</section>

<section class="verlegepreise-bereich">
  <h2>Lieferung &amp; Verlegung: Ihre Konditionen</h2>

  <div class="verlegepreise-stufen">
    {%- render 'tp-verlegeservice-stufen' -%}
  </div>

  <p class="verlegepreise-mehr">
    <a href="{{ vs_seite }}">Alle Details zum Verlegeservice: lose Verlegung, Klebearten und Liefergebiet</a>
  </p>
</section>

{% schema %}
{
  "name": "Tebo Verlegen Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild für Hero-Bereich"
    }
  ],
  "presets": [
    {
      "name": "Teppich Verlegen Hero",
      "category": "Custom"
    }
  ]
}
{% endschema %}
