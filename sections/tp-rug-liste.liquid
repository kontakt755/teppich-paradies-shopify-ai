{%- comment -%}
  Teppich-Liste mit Filtern (Raum, Form, Einfassung, Material, Flor, Faser,
  Eigenschaften, Antirutsch). Filter entstehen aus den Daten der Karten -
  es erscheinen nur Werte, die mindestens ein Teppich traegt (keine leeren
  Filter). Adresse merkt sich die Auswahl (?raum=wohnzimmer&form=rund,oval).

  Datenquelle:
  - Kollektion (collection.tp-teppiche): Produkte mit Metafeld tp_rug.config.
    Produkte ohne dieses Metafeld erscheinen nicht (fail closed).
  - sonst (Entwurf): Demo-Katalog aus snippets/tp-rug-katalog.liquid.
  Keine Preise.
{%- endcomment -%}
{%- capture tp_rug_on -%}{%- render 'tp-rug-gate' -%}{%- endcapture -%}
{%- if tp_rug_on == '1' -%}
  <section class="tp-rug tp-rug-sec tp-rug-sec--tight" aria-labelledby="tp-rl-{{ section.id }}">
    <div class="tp-rug-wrap">
      <nav class="tp-rug-crumbs" aria-label="Brotkrumen">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">Startseite</a></li>
          <li><a href="{% render 'tp-rug-url', key: 'start' %}">Teppiche</a></li>
          <li><span aria-current="page" data-crumb>{{ section.settings.heading | escape }}</span></li>
        </ol>
      </nav>
      <tp-rug-list class="tp-rug-list" data-base-title="{{ section.settings.heading | escape }}">
        <div class="tp-rug-head">
          <div class="tp-rug-head__text">
            <h1 class="tp-rug-h1" id="tp-rl-{{ section.id }}" data-list-title>{{ section.settings.heading | escape }}</h1>
            <p class="tp-rug-lead" data-list-intro>{{ section.settings.intro | escape }}</p>
          </div>
          <a class="tp-rug-btn tp-rug-btn--ghost" href="{% render 'tp-rug-url', key: 'berater', anchor: 'finder' %}">{% render 'tp-rug-icon', name: 'kompass', size: 20 %}Welcher Teppich passt?</a>
        </div>

        <div class="tp-rug-filter" data-filter data-collapsed="true" aria-label="Filter">
          <div class="tp-rug-list__bar" style="margin:0">
            <button type="button" class="tp-rug-btn tp-rug-btn--ghost tp-rug-btn--small tp-rug-filter__toggle" data-filter-toggle aria-expanded="false">Filter</button>
            <p class="tp-rug-list__count" data-count aria-live="polite"></p>
            <button type="button" class="tp-rug-textbtn" data-filter-reset hidden>Alle Filter löschen</button>
          </div>
          <div data-filter-groups></div>
        </div>

        {%- liquid
          assign tp_rl_real = 0
          if collection != blank and template.name == 'collection'
            for p in collection.products
              if p.metafields.tp_rug.config.value != blank
                assign tp_rl_real = tp_rl_real | plus: 1
              endif
            endfor
          endif
        -%}
        <ul class="tp-rug-grid" role="list" data-list>
          {%- if tp_rl_real > 0 -%}
            {%- for p in collection.products -%}
              {%- assign cfg = p.metafields.tp_rug.config.value -%}
              {%- if cfg == blank -%}{%- continue -%}{%- endif -%}
              {%- capture cols -%}{%- for c in cfg.colors -%}{{ c.name }}:{{ c.hex }}{% unless forloop.last %}|{% endunless %}{%- endfor -%}{%- endcapture -%}
              {%- capture flg -%}{% if cfg.camper_suitable %}camper_suitable,{% endif %}{% if cfg.outdoor_suitable %}outdoor_suitable,{% endif %}{% if cfg.object_suitable %}object_suitable{% endif %}{%- endcapture -%}
              {%- render 'tp-rug-card',
                handle: p.handle, title: p.title, subtitle: cfg.subtitle, image_obj: p.featured_image, url: p.url,
                rooms: cfg.rooms | join: ',', shapes: cfg.shapes | join: ',', edges: cfg.edges | join: ',', colors: cols,
                antislip: cfg.antislip, flags: flg, material_key: cfg.material_key, pile: cfg.pile, fiber: cfg.fiber
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- render 'tp-rug-katalog', mode: 'cards', loading: 'lazy' -%}
          {%- endif -%}
        </ul>
        <div class="tp-rug-empty" data-empty hidden>
          <p class="tp-rug-h3">Zu dieser Auswahl gibt es noch keinen Teppich.</p>
          <p class="tp-rug-muted">Lockern Sie einen Filter – oder fragen Sie Ihre Wunschausführung einfach an.</p>
          <div class="tp-rug-actions">
            <button type="button" class="tp-rug-btn tp-rug-btn--primary tp-rug-btn--small" data-filter-reset>Filter löschen</button>
            <a class="tp-rug-btn tp-rug-btn--ghost tp-rug-btn--small" href="{% render 'tp-rug-url', key: 'sonderform' %}">Sonderwunsch anfragen</a>
          </div>
        </div>
        {%- comment -%} Symbole fuer die Filterknoepfe (assets/tp-rug-tools.js liest sie hier ab) {%- endcomment -%}
        {%- assign tp_rl_icons = 'form-rechteck,form-quadrat,form-rund,form-oval,form-ellipse,form-laeufer,form-halbkreis,form-viertelkreis,form-dreieck,form-vieleck,form-organisch,kante-kettel,kante-paspel,kante-baumwolle,kante-cover' | split: ',' -%}
        {%- for ic in tp_rl_icons -%}<template data-tp-rug-icon="{{ ic }}">{% render 'tp-rug-icon', name: ic, size: 18 %}</template>{%- endfor -%}
      </tp-rug-list>
    </div>
  </section>
  <script type="module" src="{{ 'tp-rug-tools.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "TP Teppich-Liste",
  "tag": "div",
  "class": "tp-rug-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Alle Teppiche" },
    { "type": "textarea", "id": "intro", "label": "Einleitung", "default": "Jeder Teppich lässt sich in Maß, Form und Einfassung konfigurieren. Filtern Sie nach Raum, Form oder Material." }
  ],
  "presets": [{ "name": "TP Teppich-Liste" }]
}
{% endschema %}
