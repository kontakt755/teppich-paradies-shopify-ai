{% doc %}
  @prompt
    Konfigurierbares Kachel-Karussell mit Bild, Titel und Link pro Kachel.
    Mobile Anzahl sichtbarer Kacheln ist einstellbar.
    Navigation per Buttons und Wischgesten.
{% enddoc %}

{% assign carousel_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .card-carousel-{{ carousel_id }} {
    --carousel-gap: 16px;
    --carousel-mobile-columns: {{ section.settings.mobile_columns }};
    --carousel-desktop-columns: {{ section.settings.desktop_columns }};
    --carousel-card-radius: {{ section.settings.card_radius }}px;
    --carousel-card-background: {{ section.settings.card_background }};
    --carousel-text-color: {{ section.settings.text_color }};
    --carousel-button-background: {{ section.settings.button_background }};
    --carousel-button-color: {{ section.settings.button_color }};
    --carousel-button-size: 52px;
    position: relative;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: var(--carousel-text-color);
  }

  .card-carousel__inner-{{ carousel_id }} {
    position: relative;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .card-carousel__header-{{ carousel_id }} {
    margin-bottom: 18px;
  }

  .card-carousel__title-{{ carousel_id }} {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
  }

  .card-carousel__viewport-{{ carousel_id }} {
    overflow: hidden;
  }

  .card-carousel__track-{{ carousel_id }} {
    display: flex;
    gap: var(--carousel-gap);
    transition: transform 240ms ease;
    will-change: transform;
    touch-action: pan-y;
  }

  .card-carousel__slide-{{ carousel_id }} {
    flex: 0 0 calc((100% - (var(--carousel-gap) * (var(--carousel-mobile-columns) - 1))) / var(--carousel-mobile-columns));
    min-width: 0;
  }

  .card-carousel__card-{{ carousel_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--carousel-card-background);
    border-radius: var(--carousel-card-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .card-carousel__media-{{ carousel_id }} {
    aspect-ratio: 1 / 1;
    background: rgba(0, 0, 0, 0.03);
  }

  .card-carousel__media-{{ carousel_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-carousel__body-{{ carousel_id }} {
    padding: 14px 12px 16px;
  }

  .card-carousel__label-{{ carousel_id }} {
    margin: 0;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.25;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-carousel__controls-{{ carousel_id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .card-carousel__button-{{ carousel_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--carousel-button-size);
    height: var(--carousel-button-size);
    border: 0;
    border-radius: 999px;
    background: var(--carousel-button-background);
    color: var(--carousel-button-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    z-index: 2;
    transition: opacity 180ms ease, transform 180ms ease;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
  }

  .card-carousel__button-{{ carousel_id }}[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .card-carousel__button-{{ carousel_id }}:not([disabled]):hover {
    transform: translateY(-50%) scale(1.03);
  }

  .card-carousel__button--prev-{{ carousel_id }} {
    left: 6px;
  }

  .card-carousel__button--next-{{ carousel_id }} {
    right: 6px;
  }

  .card-carousel__button-icon-{{ carousel_id }} {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (min-width: 750px) {
    .card-carousel__slide-{{ carousel_id }} {
      flex-basis: calc((100% - (var(--carousel-gap) * (var(--carousel-desktop-columns) - 1))) / var(--carousel-desktop-columns));
    }

    .card-carousel__button--prev-{{ carousel_id }} {
      left: -12px;
    }

    .card-carousel__button--next-{{ carousel_id }} {
      right: -12px;
    }
  }
{% endstyle %}

<card-carousel-{{ carousel_id }}
  class="card-carousel-{{ carousel_id }}"
  data-mobile-columns="{{ section.settings.mobile_columns }}"
  data-desktop-columns="{{ section.settings.desktop_columns }}"
  {{ section.shopify_attributes }}
>
  <div class="card-carousel__inner-{{ carousel_id }}">
    {% if section.settings.heading != blank %}
      <div class="card-carousel__header-{{ carousel_id }}">
        <h2 class="card-carousel__title-{{ carousel_id }}">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="card-carousel__viewport-{{ carousel_id }}" data-carousel-viewport>
      <div class="card-carousel__track-{{ carousel_id }}" data-carousel-track>
        {% for block in section.blocks %}
          {% assign card_link = block.settings.link | default: '#' %}
          <div class="card-carousel__slide-{{ carousel_id }}" {{ block.shopify_attributes }}>
            <a class="card-carousel__card-{{ carousel_id }}" href="{{ card_link }}">
              <div class="card-carousel__media-{{ carousel_id }}">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 480, 600',
                      alt: block.settings.title,
                      class: ''
                  }}
                {% endif %}
              </div>

              <div class="card-carousel__body-{{ carousel_id }}">
                <p class="card-carousel__label-{{ carousel_id }}">
                  {{ block.settings.title }}
                </p>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="card-carousel__controls-{{ carousel_id }}">
      <button
        class="card-carousel__button-{{ carousel_id }} card-carousel__button--prev-{{ carousel_id }}"
        type="button"
        aria-label="Vorherige Kacheln"
        data-carousel-prev
      >
        <svg class="card-carousel__button-icon-{{ carousel_id }}" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18 9 12l6-6"></path>
        </svg>
      </button>

      <button
        class="card-carousel__button-{{ carousel_id }} card-carousel__button--next-{{ carousel_id }}"
        type="button"
        aria-label="Nächste Kacheln"
        data-carousel-next
      >
        <svg class="card-carousel__button-icon-{{ carousel_id }}" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</card-carousel-{{ carousel_id }}>

<script>
  (function() {
    const root = document.querySelector('card-carousel-{{ carousel_id }}');
    if (!root) return;

    const viewport = root.querySelector('[data-carousel-viewport]');
    const track = root.querySelector('[data-carousel-track]');
    const slides = Array.from(track.children);
    const prevButton = root.querySelector('[data-carousel-prev]');
    const nextButton = root.querySelector('[data-carousel-next]');

    if (!viewport || !track || slides.length === 0) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchCurrentX = 0;
    let isDragging = false;

    function getVisibleCount() {
      if (window.innerWidth < 750) {
        return Math.max(1, parseInt(root.dataset.mobileColumns || '2', 10));
      }

      return Math.max(1, parseInt(root.dataset.desktopColumns || '3', 10));
    }

    function getMaxIndex() {
      return Math.max(0, slides.length - getVisibleCount());
    }

    function getStepWidth() {
      if (slides.length < 2) {
        return slides[0].getBoundingClientRect().width;
      }

      const firstRect = slides[0].getBoundingClientRect();
      const secondRect = slides[1].getBoundingClientRect();
      return secondRect.left - firstRect.left;
    }

    function updateButtons() {
      const maxIndex = getMaxIndex();

      if (prevButton) prevButton.disabled = currentIndex <= 0;
      if (nextButton) nextButton.disabled = currentIndex >= maxIndex;
    }

    function render() {
      const stepWidth = getStepWidth();
      track.style.transform = 'translate3d(' + (-currentIndex * stepWidth) + 'px, 0, 0)';
      updateButtons();
    }

    function goTo(index) {
      currentIndex = Math.max(0, Math.min(index, getMaxIndex()));
      render();
    }

    function onTouchStart(event) {
      if (event.touches.length !== 1) return;
      touchStartX = event.touches[0].clientX;
      touchCurrentX = touchStartX;
      isDragging = true;
    }

    function onTouchMove(event) {
      if (!isDragging) return;
      touchCurrentX = event.touches[0].clientX;
    }

    function onTouchEnd() {
      if (!isDragging) return;

      const deltaX = touchCurrentX - touchStartX;
      isDragging = false;

      if (Math.abs(deltaX) < 40) return;

      if (deltaX < 0) {
        goTo(currentIndex + 1);
      } else {
        goTo(currentIndex - 1);
      }
    }

    if (prevButton) {
      prevButton.addEventListener('click', function() {
        goTo(currentIndex - 1);
      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', function() {
        goTo(currentIndex + 1);
      });
    }

    viewport.addEventListener('touchstart', onTouchStart, { passive: true });
    viewport.addEventListener('touchmove', onTouchMove, { passive: true });
    viewport.addEventListener('touchend', onTouchEnd);
    window.addEventListener('resize', render);

    render();
  })();
</script>

{% schema %}
{
  "name": "Kachel-Karussell",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Beliebte Kategorien"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Sichtbare Kacheln auf Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Sichtbare Kacheln auf Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Inhaltsbreite",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "min": 18,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Textgröße",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Kachel Radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Kachel Hintergrund",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Hintergrund",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Farbe",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Kachel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Kategorie"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kachel-Karussell",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
