{{ 'tp-start-abschnitte.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  TP Start-Kategorien: Karten mit echtem Bild, Titel, Untertitel und
  Produktzahl aus der Kollektion. Bis sieben Karten: eine Reihe 4:5. Bei neun
  Karten ab 992 px ein Raster mit fuenf Spalten, die erste Karte ueber zwei
  Zeilen. Telefon horizontaler Slider mit grossen Karten und Punkten. Ohne Bild
  im Block: Kollektionsbild, sonst Platzhalter.
  "Erste zwei Karten gross" (Startseiten-Umbau C, w-096): ab 768 px vier
  Spalten, die ersten beiden Karten ueber je zwei Spalten. Sie stehen im
  ersten Bildschirm und laden deshalb sofort mit hoher Prioritaet (LCP), die
  uebrigen weiter lazy. Das Telefon behaelt den Slider.
{%- endcomment -%}

<section class="tp-s-sec tp-s-sec--tight tp-kat{% if section.settings.gross_vorne %} tp-kat--gross{% endif %}" id="tp-kategorien" aria-labelledby="tp-kat-h2">
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head">
      <div>
        <h2 id="tp-kat-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="tp-s-link" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="tp-kat__list{% if section.settings.gross_vorne %} tp-kat__list--gross{% endif %}" id="tp-kat-list" data-anzahl="{{ section.blocks.size }}">
      {%- liquid
        assign kat_sizes = '(max-width: 389px) 76vw, (max-width: 767px) 68vw, (max-width: 991px) 33vw, (max-width: 1279px) 25vw, 14vw'
        if section.blocks.size >= 9
          assign kat_sizes = '(max-width: 389px) 76vw, (max-width: 767px) 68vw, (max-width: 991px) 33vw, 20vw'
        endif
        if section.settings.gross_vorne
          assign kat_sizes = '(max-width: 389px) 76vw, (max-width: 767px) 68vw, (min-width: 1280px) 300px, 24vw'
        endif
        assign kat_sizes_gross = '(max-width: 389px) 76vw, (max-width: 767px) 68vw, (min-width: 1280px) 610px, 48vw'
      -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign img = block.settings.bild
          if img == blank and col != blank
            assign img = col.image
          endif
          assign titel = block.settings.titel
          if titel == blank and col != blank
            assign titel = col.title
          endif
          assign ziel = block.settings.link
          if ziel == blank and col != blank
            assign ziel = col.url
          endif
        -%}
        {%- comment -%}
          Der Alt-Text kommt aus der Bilddatei, wenn dort einer gepflegt ist.
          Vorher stand hier hart alt: '' - fuer die Barrierefreiheit richtig,
          weil der Link seinen Namen schon aus dem Titel daneben bezieht, aber
          fuer die Bildersuche eine verschenkte Angabe. Ein leerer Wert bleibt
          der Rueckfall, damit nichts erfunden wird: Ist in Shopify kein
          Alt-Text hinterlegt, bleibt das Bild wie bisher dekorativ.

          Die Zuweisung steht bewusst vor dem Tag. Eine Filterkette direkt
          hinter alt: (alt: img.alt | default: '') verschluckt alle folgenden
          Parameter - das Bild verloere sein class und damit object-fit.
        {%- endcomment -%}
        {%- liquid
          assign kat_alt = img.alt | default: ''
          assign kat_gross = false
          if section.settings.gross_vorne and forloop.index <= 2
            assign kat_gross = true
          endif
        -%}
        <a class="tp-kat__card{% if kat_gross %} tp-kat__card--gross{% endif %}" href="{{ ziel | default: '#' }}" {{ block.shopify_attributes }}>
          {%- comment -%} Hohe Prioritaet nur fuer die erste Kachel (mobil das LCP-Bild):
            zwei Bilder mit "high" teilen sich die Bandbreite (Analyse 25.10.). Die zweite
            Kachel bekommt "low", sonst hebt Chrome sie auf "High" (Lighthouse 09.11.).
            Zwischenbreiten 500/700: mobil braucht die Kachel rund 490 px, ohne 500
            lud der Browser 600 px (107 statt 74 KB, Theme-Audit 09.11.). {%- endcomment -%}
          {%- if img != blank and kat_gross and forloop.first -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 500, 600, 700, 800, 1000, 1200', sizes: kat_sizes_gross, alt: kat_alt, class: 'tp-kat__img' }}
          {%- elsif img != blank and kat_gross -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'low', widths: '400, 500, 600, 700, 800, 1000, 1200', sizes: kat_sizes_gross, alt: kat_alt, class: 'tp-kat__img' }}
          {%- elsif img != blank -%}
            {{ img | image_url: width: 800 | image_tag: loading: 'lazy', fetchpriority: 'low', widths: '300, 400, 500, 600, 800', sizes: kat_sizes, alt: kat_alt, class: 'tp-kat__img' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'tp-kat__img' }}
          {%- endif -%}
          {%- if block.settings.zahl_zeigen and col != blank -%}
            <span class="tp-kat__n">{{ col.products_count }} {{ block.settings.zahl_wort | default: 'Produkte' | escape }}</span>
          {%- endif -%}
          <span class="tp-kat__t"><strong>{{ titel | escape }}</strong>{%- if block.settings.untertitel != blank -%}<small>{{ block.settings.untertitel | escape }}</small>{%- endif -%}</span>
        </a>
      {%- endfor -%}
    </div>
    <div class="tp-kat__dots" id="tp-kat-dots" aria-hidden="true">
      {%- for block in section.blocks -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}
    </div>
  </div>
</section>

{% javascript %}
  (function () {
    var list = document.getElementById('tp-kat-list');
    var dots = document.querySelectorAll('#tp-kat-dots i');
    if (!list || !dots.length) return;
    // Der automatische Fokusscroll kann zwischen zwei Snap-Punkten enden.
    // Die aktive Karte soll samt Titel und Unterzeile voll sichtbar sein.
    list.addEventListener('focusin', function (event) {
      var card = event.target.closest('.tp-kat__card');
      if (!card || list.scrollWidth <= list.clientWidth) return;
      requestAnimationFrame(function () {
        if (document.activeElement === card) {
          card.scrollIntoView({ block: 'nearest', inline: 'start', behavior: 'auto' });
        }
      });
    });
    list.addEventListener('scroll', function () {
      var first = list.firstElementChild;
      if (!first) return;
      var w = first.offsetWidth + 12;
      var i = Math.round(list.scrollLeft / w);
      dots.forEach(function (d, j) { d.classList.toggle('on', j === i); });
    }, { passive: true });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "TP Start-Kategorien",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Womit möchten Sie starten?" },
    { "type": "text", "id": "text", "label": "Unterzeile", "default": "Kategorien direkt zur Auswahl. Preise und Verkaufseinheiten stehen am Produkt. Muster bestellbar." },
    { "type": "text", "id": "link_label", "label": "Link rechts", "default": "Alle Produkte ansehen" },
    { "type": "url", "id": "link", "label": "Link-Ziel" },
    { "type": "checkbox", "id": "gross_vorne", "label": "Erste zwei Karten gross", "info": "Ab Tablet vier Spalten, die ersten beiden Karten doppelt breit. Fuer den ersten Bildschirm der Startseite.", "default": false }
  ],
  "blocks": [
    {
      "type": "kategorie",
      "name": "Kategorie",
      "limit": 10,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "image_picker", "id": "bild", "label": "Bild (leer = Kollektionsbild)" },
        { "type": "text", "id": "titel", "label": "Titel (leer = Kollektionstitel)" },
        { "type": "text", "id": "untertitel", "label": "Untertitel", "default": "Velours, Schlinge, Hochflor, Wolle" },
        { "type": "url", "id": "link", "label": "Ziel (leer = Kollektion)" },
        { "type": "checkbox", "id": "zahl_zeigen", "label": "Produktzahl anzeigen", "default": true },
        { "type": "text", "id": "zahl_wort", "label": "Wort hinter der Zahl", "default": "Qualitäten" }
      ]
    }
  ],
  "presets": [ { "name": "TP Start-Kategorien" } ]
}
{% endschema %}
