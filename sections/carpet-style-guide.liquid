{% comment %}
  Carpet Style Guide Section
  Display carpet style consultation and guidance information
{% endcomment %}

<style>
  .carpet-style-guide {
    background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    padding: 3rem 2rem;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .carpet-style-guide h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: #333;
  }

  .carpet-style-guide p {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .style-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .style-card {
    background: white;
    padding: 1.5rem;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .style-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: #333;
  }

  .style-card p {
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  .consultation-cta {
    background: #333;
    color: white;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    margin-top: 1.5rem;
    transition: background 0.3s ease;
  }

  .consultation-cta:hover {
    background: #555;
  }

  @media (max-width: 640px) {
    .carpet-style-guide {
      padding: 2rem 1rem;
    }

    .carpet-style-guide h2 {
      font-size: 1.5rem;
    }

    .style-cards {
      grid-template-columns: 1fr;
    }

    .consultation-cta {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="carpet-style-guide">
  <h2>🎨 Stilberatung für Ihren Teppich</h2>
  <p>
    Entdecken Sie verschiedene Teppichstile und finden Sie den perfekten Stil
    für Ihre Räume. Unsere Experten helfen Ihnen bei der Auswahl.
  </p>

  <div class="style-cards">
    <div class="style-card">
      <h3>🏢 Modern</h3>
      <p>
        Klare Linien und zeitgenössische Designs für moderne Wohnräume.
        Perfekt für minimalistisch eingerichtete Räume.
      </p>
    </div>

    <div class="style-card">
      <h3>👑 Klassisch</h3>
      <p>
        Elegante Muster und zeitlose Designs. Passt zu traditionellen
        und eleganten Einrichtungsstilen.
      </p>
    </div>

    <div class="style-card">
      <h3>🌍 Orient</h3>
      <p>
        Wertvolle Orientteppiche mit charakteristischen Mustern und Farben.
        Ein Stück Kunsthandwerk.
      </p>
    </div>

    <div class="style-card">
      <h3>👨‍👩‍👧‍👦 Familienstyle</h3>
      <p>
        Robuste und pflegeleichte Teppiche für belebte Wohnräume.
        Langlebig und praktisch.
      </p>
    </div>
  </div>

  <a href="/pages/stilberatung-teppich" class="consultation-cta">
    → Kostenlose Stilberatung anfragen
  </a>
</div>

{% schema %}
{
  "name": "Carpet Style Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "🎨 Stilberatung für Ihren Teppich"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschreibung",
      "default": "Entdecken Sie verschiedene Teppichstile und finden Sie den perfekten Stil für Ihre Räume."
    },
    {
      "type": "url",
      "id": "consultation_link",
      "label": "Stilberatungs-Link"
    },
    {
      "type": "text",
      "id": "consultation_text",
      "label": "Link Text",
      "default": "Kostenlose Stilberatung anfragen"
    }
  ]
}
{% endschema %}
