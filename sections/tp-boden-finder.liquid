{%- comment -%}
  TP Boden-Finder: gefuehrte Beratung in hoechstens vier Fragen (Bodenart,
  Farbe, Optik mit optionalem Raum, Raumgroesse und Preisrahmen) bis zu drei
  Vorschlaegen. Farbe und Optik sind Mehrfachauswahl mit "Weiter".

  Auf der Seite steht nur der kompakte Einstieg. Der Dialog mit den Fragen
  und dem Anfrageformular liegt geschlossen im HTML. Das Formular ist das
  Shopify-Kontaktformular, damit die Anfrage als E-Mail beim Shop ankommt.
  Skript und Dialog-CSS laedt erst der Klick auf den Einstieg
  (assets/tp-boden-finder.js, assets/tp-boden-finder.css) - die Seite wird
  dadurch nicht langsamer.

  Daten: Filterwerte, Trefferzahlen und Produktkarten kommen aus der
  Kollektion der gewaehlten Bodenart ueber die Ansichten ?view=boden-finder
  und ?view=boden-finder-treffer (sections/tp-boden-finder-daten.liquid).
  Angeboten werden nur Werte mit Treffern, auch bei den Preisstufen. Der
  ca.-Preis fuer den Raum (genau zugeschnitten und von der Rolle) rechnet mit
  den Regeln des Rollenware-Rechners (assets/tp-rollware-art.js).

  Bodenarten sind Bloecke: Status "aktiv" fragt weiter, "bald" fuehrt zur
  Kategorie. Neue Bodenarten (Vinyl, Teppich nach Mass ...) brauchen eine
  Kollektion mit passenden Filtern und eigene Optik-Namen, keinen Code.
  Auf der Kategorieseite einer aktiven Bodenart entfaellt die erste Frage.

  Kontaktwege (WhatsApp, Telefon) kommen aus den Theme-Einstellungen
  tp_vs_whatsapp / tp_vs_telefon - dieselbe Nummer wie die Kontaktleiste.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign bf_root_id = 'tp-bf-' | append: section.id
  assign bf_form_id = 'tp-bf-anfrage-' | append: section.id
  assign bf_wa = settings.tp_vs_whatsapp | strip
  assign bf_tel = settings.tp_vs_telefon | strip
  assign bf_tel_href = bf_tel | remove: ' ' | remove: '/' | remove: '-'
  if bf_tel_href.first == '0'
    assign bf_tel_href = bf_tel_href | slice: 1, 30 | prepend: '+49'
  endif
  assign bf_datenschutz = pages['datenschutzerklarung'].url | default: '/pages/datenschutzerklarung'

  # Kategorieseite einer aktiven Bodenart: erste Frage entfaellt.
  assign bf_vorwahl = ''
  if request.page_type == 'collection'
    for block in section.blocks
      if block.settings.status == 'aktiv' and block.settings.kollektion != blank and block.settings.kollektion.handle == collection.handle
        assign bf_vorwahl = collection.handle
        break
      endif
    endfor
  endif
  assign bf_fragen = 4
  if bf_vorwahl != blank
    assign bf_fragen = 3
  endif
-%}
<section
  class="tp-bf{% if section.settings.kompakt %} tp-bf--kompakt{% endif %}"
  id="{{ bf_root_id }}"
  data-bf-root
  aria-labelledby="tp-bf-h-{{ section.id }}"
  style="--tp-bf-pt: {{ section.settings.abstand_oben }}px; --tp-bf-pb: {{ section.settings.abstand_unten }}px;"
>
  <div class="tp-s-wrap">
    <div class="tp-bf__band">
      <div class="tp-bf__muster" aria-hidden="true">
        <span style="--f: #c9b9a3"></span><span style="--f: #8c8b88"></span><span style="--f: #4a4744"></span>
      </div>
      <div class="tp-bf__text">
        <span class="tp-bf__kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="tp-bf__h" id="tp-bf-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="tp-bf__p">{{ section.settings.text | escape }}</p>{%- endif -%}
        <ol class="tp-bf__schritte" aria-label="Die Fragen">
          {%- if bf_vorwahl == blank -%}<li>Bodenart</li>{%- endif -%}
          <li>Farbe</li><li>Optik</li><li>Raum &amp; Preis</li>
        </ol>
      </div>
      <div class="tp-bf__aktionen">
        <button class="tp-s-btn {% if section.settings.kompakt %}tp-s-btn--dark{% else %}tp-s-btn--primary{% endif %} tp-bf__start" type="button" data-bf-open="start" aria-haspopup="dialog" aria-controls="tp-bf-dlg-{{ section.id }}">
          {{- section.settings.button | escape -}}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
        <button class="tp-bf__bequem-link" type="button" data-bf-open="anfrage" aria-haspopup="dialog" aria-controls="tp-bf-dlg-{{ section.id }}">
          {{- section.settings.bequem_link | escape -}}
        </button>
      </div>
      <p class="tp-bf__ok" data-bf-ok role="status" hidden>
        <b>Danke, Ihre Anfrage ist angekommen.</b> Wir melden uns persönlich bei Ihnen.
      </p>
    </div>
  </div>

  <dialog class="tp-bf-dlg" id="tp-bf-dlg-{{ section.id }}" aria-labelledby="tp-bf-dlg-t-{{ section.id }}" data-bf-dialog>
    <div class="tp-bf-dlg__kopf">
      <button class="tp-bf-dlg__zurueck" type="button" data-bf-zurueck hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>Zurück
      </button>
      <p class="tp-bf-dlg__titel" id="tp-bf-dlg-t-{{ section.id }}">
        Boden-Finder<span class="tp-bf-dlg__fortschritt" data-bf-fortschritt></span>
      </p>
      <button class="tp-bf-dlg__zu" type="button" data-bf-zu aria-label="Boden-Finder schließen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="tp-bf-dlg__balken" aria-hidden="true"><span data-bf-balken></span></div>

    <div class="tp-bf-dlg__inhalt" data-bf-inhalt>
      {%- comment -%} Frage 1: Bodenart (entfaellt auf der Kategorieseite) {%- endcomment -%}
      <div class="tp-bf-schritt" data-bf-schritt="art" hidden>
        <h2 class="tp-bf-frage" tabindex="-1">Was suchen Sie?</h2>
        <div class="tp-bf-arten">
          {%- for block in section.blocks -%}
            {%- liquid
              assign bf_k = block.settings.kollektion
              assign bf_bild = block.settings.bild
              # featured_image: Kollektionsbild, sonst Bild des ersten Produkts.
              if bf_bild == blank and bf_k != blank
                assign bf_bild = bf_k.featured_image
              endif
              assign bf_titel = block.settings.titel | default: bf_k.title
            -%}
            {%- if block.settings.status == 'aktiv' and bf_k != blank -%}
              <button class="tp-bf-art" type="button" data-bf-art="{{ bf_k.handle | escape }}" {{ block.shopify_attributes }}>
            {%- else -%}
              <a class="tp-bf-art tp-bf-art--bald" href="{{ bf_k.url | default: block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            {%- endif -%}
              <span class="tp-bf-art__bild">
                {%- if bf_bild != blank -%}
                  {{ bf_bild | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(max-width: 749px) 30vw, 180px', alt: '' }}
                {%- endif -%}
              </span>
              <span class="tp-bf-art__text">
                <span class="tp-bf-art__titel">{{ bf_titel | escape }}</span>
                {%- if block.settings.status == 'aktiv' -%}
                  {%- if block.settings.untertitel != blank -%}<span class="tp-bf-art__zeile">{{ block.settings.untertitel | escape }}</span>{%- endif -%}
                {%- else -%}
                  <span class="tp-bf-art__zeile">Finder folgt – zur Kategorie</span>
                {%- endif -%}
              </span>
            {%- if block.settings.status == 'aktiv' and bf_k != blank -%}
              </button>
            {%- else -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Frage 2: Farbe (Werte aus dem Farbfilter der Kollektion, mehrere moeglich) {%- endcomment -%}
      <div class="tp-bf-schritt" data-bf-schritt="farbe" hidden>
        <h2 class="tp-bf-frage" tabindex="-1">Welche Farbe soll es sein?</h2>
        <p class="tp-bf-hinweis">Gern auch mehrere. Es stehen nur Farben zur Wahl, die es bei uns gibt – in Klammern die Anzahl.</p>
        <div class="tp-bf-farben" data-bf-farben aria-busy="true"></div>
        <p class="tp-bf-zaehler" data-bf-zaehler aria-live="polite"></p>
        <div class="tp-bf-fuss">
          <button class="tp-s-btn tp-s-btn--primary" type="button" data-bf-weiter="farbe" disabled>Weiter</button>
          <button class="tp-bf-egal" type="button" data-bf-egal="farbe">Farbe ist mir noch egal</button>
        </div>
      </div>

      {%- comment -%} Frage 3: Optik (z. B. Florhoehe, mehrere moeglich) und optional Raum {%- endcomment -%}
      <div class="tp-bf-schritt" data-bf-schritt="optik" hidden>
        <h2 class="tp-bf-frage" tabindex="-1" data-bf-optik-frage>Welche Optik soll es sein?</h2>
        <p class="tp-bf-hinweis">Gern auch mehrere.</p>
        <div class="tp-bf-optiken" data-bf-optiken aria-busy="true"></div>
        <fieldset class="tp-bf-zimmer" data-bf-zimmer-box hidden>
          <legend>Für welchen Raum? <span>(optional)</span></legend>
          <div class="tp-bf-chips" data-bf-zimmer></div>
        </fieldset>
        <p class="tp-bf-zaehler" data-bf-zaehler aria-live="polite"></p>
        <div class="tp-bf-fuss">
          <button class="tp-s-btn tp-s-btn--primary" type="button" data-bf-weiter="optik" disabled>Weiter</button>
          <button class="tp-bf-egal" type="button" data-bf-egal="optik">Weiß ich noch nicht</button>
        </div>
      </div>

      {%- comment -%}
        Frage 4: Raumgroesse (Laenge x Breite in m oder cm, oder nur die
        Flaeche) und Preisrahmen je m² - beides freiwillig.
      {%- endcomment -%}
      <div class="tp-bf-schritt" data-bf-schritt="budget" hidden>
        <h2 class="tp-bf-frage" tabindex="-1">Raum und Preis</h2>
        <p class="tp-bf-hinweis">Beides ist freiwillig. Mit der Raumgröße rechnen wir Ihnen bei jedem Vorschlag den Preis für Ihren Raum aus.</p>
        <fieldset class="tp-bf-gruppe">
          <legend>Wie groß ist der Raum?</legend>
          <div class="tp-bf-masse" data-bf-feld="lb">
            <label class="tp-bf-feld"><span>Länge</span><span class="tp-bf-eingabe"><input type="text" inputmode="decimal" autocomplete="off" data-bf-laenge placeholder="z. B. 4,5"><span data-bf-einheit="laenge">m</span></span></label>
            <span class="tp-bf-mal" aria-hidden="true">×</span>
            <label class="tp-bf-feld"><span>Breite</span><span class="tp-bf-eingabe"><input type="text" inputmode="decimal" autocomplete="off" data-bf-breite placeholder="z. B. 3,8"><span data-bf-einheit="breite">m</span></span></label>
          </div>
          <div class="tp-bf-masse tp-bf-masse--qm" data-bf-feld="qm" hidden>
            <label class="tp-bf-feld"><span>Fläche</span><span class="tp-bf-eingabe"><input type="text" inputmode="decimal" autocomplete="off" data-bf-flaeche placeholder="z. B. 18"><span>m²</span></span></label>
          </div>
          <p class="tp-bf-umrechnung" data-bf-umrechnung aria-live="polite"></p>
          <p class="tp-bf-hinweis tp-bf-hinweis--klein"><span data-bf-feld="lb">In Metern oder Zentimetern, z. B. 4,5 oder 450.</span>
            <button class="tp-bf-link" type="button" data-bf-massmodus>Nur die Fläche bekannt? In m² angeben</button>
          </p>
        </fieldset>
        <fieldset class="tp-bf-gruppe">
          <legend>Welcher Preis pro m² passt?</legend>
          <div class="tp-bf-preise" data-bf-preise aria-busy="true"></div>
          <p class="tp-bf-hinweis tp-bf-hinweis--klein">Kleineres Budget? Im Laden haben wir Reste und Sonderposten.
            <button class="tp-bf-link" type="button" data-bf-zur-anfrage="sonder">Fotos und Preise anfragen</button>
          </p>
        </fieldset>
        <div class="tp-bf-fuss">
          <button class="tp-s-btn tp-s-btn--primary" type="button" data-bf-zeigen>Vorschläge zeigen</button>
        </div>
      </div>

      {%- comment -%} Ergebnis {%- endcomment -%}
      <div class="tp-bf-schritt" data-bf-schritt="ergebnis" hidden>
        <h2 class="tp-bf-frage" tabindex="-1" data-bf-ergebnis-titel>Unsere Vorschläge für Sie</h2>
        <ul class="tp-bf-auswahl" data-bf-auswahl aria-label="Ihre Angaben"></ul>
        <p class="tp-bf-status" data-bf-status aria-live="polite"></p>
        <div class="tp-bf-treffer" data-bf-treffer></div>
        <p class="tp-bf-alle-zeile"><a class="tp-s-btn tp-s-btn--ghost tp-bf-alle" data-bf-alle href="#" hidden></a></p>
        <div class="tp-bf-sonder" data-bf-sonder hidden>
          <h3>Reste und Sonderposten im Laden</h3>
          <p>Im Laden in Oranienburg haben wir Reste und Sonderposten, die noch nicht online stehen. Wir schauen gern für Sie nach und schicken Ihnen Fotos und Preise.</p>
          <div class="tp-bf-wege">
            <button class="tp-s-btn tp-s-btn--dark tp-s-btn--sm" type="button" data-bf-zur-anfrage="sonder">Fotos und Preise anfragen</button>
            {%- if bf_wa != blank -%}<a class="tp-s-btn tp-s-btn--wa tp-s-btn--sm" data-bf-wa="sonder" href="https://wa.me/{{ bf_wa }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2z"/></svg>WhatsApp</a>{%- endif -%}
          </div>
        </div>
        <div class="tp-bf-bequem">
          <h3>Lieber persönliche Vorschläge?</h3>
          <p>Wir suchen Ihnen 3 passende Angebote heraus und melden uns persönlich bei Ihnen – per Anruf, E-Mail oder WhatsApp.</p>
          <div class="tp-bf-wege">
            <button class="tp-s-btn tp-s-btn--primary tp-s-btn--sm" type="button" data-bf-zur-anfrage="bequem">Vorschläge anfordern</button>
            {%- if bf_wa != blank -%}<a class="tp-s-btn tp-s-btn--wa tp-s-btn--sm" data-bf-wa="bequem" href="https://wa.me/{{ bf_wa }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2z"/></svg>WhatsApp</a>{%- endif -%}
            {%- if bf_tel != blank -%}<a class="tp-s-btn tp-s-btn--ghost tp-s-btn--sm" href="tel:{{ bf_tel_href }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Anrufen</a>{%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} Persoenliche Vorschlaege: Shopify-Kontaktformular {%- endcomment -%}
      <div class="tp-bf-schritt" data-bf-schritt="anfrage" hidden>
        <h2 class="tp-bf-frage" tabindex="-1">Persönliche Vorschläge anfordern</h2>
        <p class="tp-bf-hinweis" data-bf-anfrage-text>Wir suchen Ihnen 3 passende Angebote heraus – auch aus Resten und Sonderposten im Laden – und melden uns persönlich bei Ihnen.</p>
        {%- form 'contact', id: bf_form_id, class: 'tp-bf-form' -%}
          {%- comment -%}
            Erfolg und Fehler gelten nur, wenn genau dieses Formular abgeschickt
            wurde (Merker im sessionStorage, siehe Lader unten) - auf der
            Startseite steht ein zweites Kontaktformular.
          {%- endcomment -%}
          {%- if form.posted_successfully? -%}
            <span data-tp-lead-success data-bf-gesendet hidden></span>
          {%- elsif form.errors -%}
            <p class="tp-bf-fehler" role="alert" data-bf-fehler hidden>Bitte prüfen Sie Ihre Angaben – vor allem die E-Mail-Adresse.</p>
          {%- endif -%}
          <input type="hidden" name="contact[Betreff]" value="Boden-Finder: persönliche Vorschläge" data-bf-betreff>
          <input type="hidden" name="contact[Boden-Finder]" value="" data-bf-zusammenfassung>
          <input type="hidden" name="contact[Seite]" value="{{ request.path | escape }}">
          <label class="tp-bf-feld tp-bf-feld--voll">
            <span>Name</span>
            <input type="text" name="contact[name]" autocomplete="name" required value="{{ form.name | escape }}">
          </label>
          <fieldset class="tp-bf-feld tp-bf-feld--voll tp-bf-kontaktweg">
            <legend>Wie dürfen wir uns melden?</legend>
            <div class="tp-bf-chips">
              <label><input type="radio" name="contact[Kontaktweg]" value="Anruf" required data-bf-weg><span>Anruf</span></label>
              <label><input type="radio" name="contact[Kontaktweg]" value="E-Mail" data-bf-weg><span>E-Mail</span></label>
              {%- if bf_wa != blank -%}<label><input type="radio" name="contact[Kontaktweg]" value="WhatsApp" data-bf-weg><span>WhatsApp</span></label>{%- endif -%}
            </div>
          </fieldset>
          <label class="tp-bf-feld">
            <span>Telefon / Handy <em data-bf-tel-optional>(optional)</em></span>
            <input type="tel" name="contact[Telefon]" autocomplete="tel" inputmode="tel" pattern="[0-9 +()/.\-]{6,}" data-bf-tel>
          </label>
          <label class="tp-bf-feld">
            <span>E-Mail</span>
            <input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}">
          </label>
          <label class="tp-bf-feld tp-bf-feld--voll">
            <span>Raummaße <em>(optional)</em></span>
            <input type="text" name="contact[Masse]" autocomplete="off" placeholder="z. B. 4 × 5 m" data-bf-masse>
          </label>
          <label class="tp-bf-feld tp-bf-feld--voll">
            <span>Nachricht <em>(optional)</em></span>
            <textarea name="contact[body]" rows="3" maxlength="1500" placeholder="z. B. Raum, Untergrund, Wunschtermin">{{ form.body | escape }}</textarea>
          </label>
          <p class="tp-bf-uebernahme tp-bf-feld--voll" data-bf-uebernahme hidden></p>
          <p class="tp-bf-datenschutz tp-bf-feld--voll">
            Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Angaben zur Bearbeitung der Anfrage zu. Mehr dazu in unserer
            <a href="{{ bf_datenschutz }}" target="_blank" rel="noopener">Datenschutzerklärung</a>.
          </p>
          <div class="tp-bf-fuss tp-bf-feld--voll">
            <button class="tp-s-btn tp-s-btn--primary" type="submit">Vorschläge anfordern</button>
          </div>
        {%- endform -%}
        {%- if bf_wa != blank or bf_tel != blank -%}
          <div class="tp-bf-schneller">
            <p>Schneller geht es direkt:</p>
            <div class="tp-bf-wege">
              {%- if bf_wa != blank -%}<a class="tp-s-btn tp-s-btn--wa tp-s-btn--sm" data-bf-wa href="https://wa.me/{{ bf_wa }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2z"/></svg>WhatsApp</a>{%- endif -%}
              {%- if bf_tel != blank -%}<a class="tp-s-btn tp-s-btn--ghost tp-s-btn--sm" href="tel:{{ bf_tel_href }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>{{ bf_tel | escape }}</a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </dialog>

  <script type="application/json" data-bf-config>
    {
      "vorwahl": {{ bf_vorwahl | json }},
      "fragen": {{ bf_fragen }},
      "wa": {{ bf_wa | json }},
      "arten": [
        {%- for block in section.blocks -%}
          {%- if block.settings.status == 'aktiv' and block.settings.kollektion != blank -%}
            {
              "handle": {{ block.settings.kollektion.handle | json }},
              "url": {{ block.settings.kollektion.url | json }},
              "titel": {{ block.settings.titel | default: block.settings.kollektion.title | json }},
              "wort": {{ block.settings.produktwort | json }},
              "optik_filter": {{ block.settings.optik_filter | strip | json }},
              "optik_frage": {{ block.settings.optik_frage | json }},
              "optik_namen": {{ block.settings.optik_namen | json }},
              "raum_filter": {{ block.settings.raum_filter | strip | json }},
              "preis_stufen": {{ block.settings.preis_stufen | json }},
              "rolle": {{ block.settings.rollenware | json }}
            },
          {%- endif -%}
        {%- endfor -%}
        null
      ]
    }
  </script>
  <script>
    (function () {
      var root = document.getElementById({{ bf_root_id | json }});
      if (!root) return;
      var dateien = {
        css: {{ 'tp-boden-finder.css' | asset_url | json }},
        art: {{ 'tp-rollware-art.js' | asset_url | json }},
        js: {{ 'tp-boden-finder.js' | asset_url | json }}
      };
      function skript(src) {
        return new Promise(function (ok, fehler) {
          var s = document.createElement('script');
          s.src = src; s.onload = ok; s.onerror = fehler;
          document.head.appendChild(s);
        });
      }
      function laden() {
        if (window.tpBfLaden) return window.tpBfLaden;
        var css = new Promise(function (ok) {
          var l = document.createElement('link');
          l.rel = 'stylesheet'; l.href = dateien.css; l.onload = ok; l.onerror = ok;
          document.head.appendChild(l);
        });
        var js = (window.TPRollwareArt ? Promise.resolve() : skript(dateien.art)).then(function () { return skript(dateien.js); });
        window.tpBfLaden = Promise.all([css, js]);
        window.tpBfLaden.catch(function () { window.tpBfLaden = null; });
        return window.tpBfLaden;
      }
      function oeffnen(modus, knopf) {
        if (knopf) knopf.setAttribute('aria-busy', 'true');
        laden().then(function () {
          window.TPBodenFinder.oeffnen(root, modus);
        }, function () {
          window.location.href = {{ section.blocks.first.settings.kollektion.url | default: '/collections/all' | json }};
        }).then(function () {
          if (knopf) knopf.removeAttribute('aria-busy');
        });
      }
      root.addEventListener('click', function (e) {
        var knopf = e.target.closest('[data-bf-open]');
        if (!knopf || !root.contains(knopf) || knopf.closest('dialog')) return;
        e.preventDefault();
        oeffnen(knopf.getAttribute('data-bf-open'), knopf);
      });
      // Rueckkehr nach dem Absenden: nur fuer genau dieses Formular.
      try {
        var merker = sessionStorage.getItem('tp_bf_gesendet');
        if (merker === root.id) {
          sessionStorage.removeItem('tp_bf_gesendet');
          if (root.querySelector('[data-bf-gesendet]')) {
            root.querySelector('[data-bf-ok]').hidden = false;
            root.scrollIntoView({ block: 'center' });
          } else if (root.querySelector('[data-bf-fehler]')) {
            root.querySelector('[data-bf-fehler]').hidden = false;
            oeffnen('anfrage');
          }
        }
      } catch (e) {}
    })();
  </script>
</section>

{% stylesheet %}
  /* Einstieg. Der Dialog hat eigenes CSS (assets/tp-boden-finder.css), das erst mit dem Klick laedt. */
  .tp-bf { padding: var(--tp-bf-pt, 8px) 0 var(--tp-bf-pb, 40px); }
  .tp-bf__band {
    position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 28px;
    background: var(--tp-bg-2, #f6f2ec); border: 1px solid var(--tp-line, #e6e0d8); border-radius: 16px; padding: 24px 28px;
  }
  .tp-bf__muster { position: relative; width: 112px; height: 92px; flex: none; }
  .tp-bf__muster span {
    position: absolute; top: 6px; width: 62px; height: 80px; border-radius: 8px; background: var(--f);
    box-shadow: 0 6px 16px rgba(29, 26, 23, 0.16); border: 3px solid #fff;
  }
  .tp-bf__muster span:nth-child(1) { left: 0; transform: rotate(-9deg); }
  .tp-bf__muster span:nth-child(2) { left: 24px; transform: rotate(-1deg); }
  .tp-bf__muster span:nth-child(3) { left: 48px; transform: rotate(8deg); }
  .tp-bf__kicker { display: block; font-size: var(--font-size--2xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tp-green, #2f7a4c); margin-bottom: 6px; }
  .tp-bf__h { font-size: clamp(var(--font-size--xl), 2vw, var(--font-size--2xl)); font-weight: 700; line-height: 1.15; margin: 0; color: var(--tp-ink, #1d1a17); text-wrap: balance; }
  .tp-bf__p { margin: 6px 0 0; color: var(--tp-ink-2, #4a443f); max-width: 60ch; }
  .tp-bf__schritte { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 12px 0 0; padding: 0; counter-reset: tpbf; }
  .tp-bf__schritte li {
    counter-increment: tpbf; display: inline-flex; align-items: center; gap: 6px; font-size: var(--font-size--xs); color: var(--tp-ink-2, #4a443f);
    background: #fff; border: 1px solid var(--tp-line, #e6e0d8); border-radius: 999px; padding: 3px 10px 3px 4px;
  }
  .tp-bf__schritte li::before {
    content: counter(tpbf); display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%;
    background: var(--tp-ink, #1d1a17); color: #fff; font-size: var(--font-size--2xs); font-weight: 700;
  }
  .tp-bf__aktionen { display: flex; flex-direction: column; align-items: stretch; gap: 10px; min-width: 240px; }
  .tp-bf__start[aria-busy='true'] { opacity: 0.75; cursor: progress; }
  .tp-bf__bequem-link {
    background: none; border: 0; padding: 4px; font: inherit; font-size: var(--font-size--sm); color: var(--tp-ink, #1d1a17);
    text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 44px;
  }
  .tp-bf__ok { grid-column: 1 / -1; margin: 0; padding: 12px 14px; border-radius: 10px; background: var(--tp-green-soft, #e7f3ea); color: var(--tp-green, #2f7a4c); }
  .tp-bf__ok[hidden] { display: none; }
  .tp-bf--kompakt .tp-bf__band { padding: 18px 22px; }
  .tp-bf--kompakt .tp-bf__muster { width: 92px; height: 74px; }
  .tp-bf--kompakt .tp-bf__muster span { width: 50px; height: 64px; }
  .tp-bf--kompakt .tp-bf__muster span:nth-child(2) { left: 20px; }
  .tp-bf--kompakt .tp-bf__muster span:nth-child(3) { left: 40px; }
  .tp-bf-dlg:not([open]) { display: none; }
  @media (max-width: 899px) {
    .tp-bf__band { grid-template-columns: 1fr; gap: 16px; padding: 20px 18px; }
    .tp-bf__muster { position: absolute; top: 14px; right: 14px; width: 74px; height: 60px; }
    .tp-bf__muster span, .tp-bf--kompakt .tp-bf__muster span { width: 40px; height: 52px; border-width: 2px; }
    .tp-bf__muster span:nth-child(2), .tp-bf--kompakt .tp-bf__muster span:nth-child(2) { left: 16px; }
    .tp-bf__muster span:nth-child(3), .tp-bf--kompakt .tp-bf__muster span:nth-child(3) { left: 32px; }
    .tp-bf__text { padding-right: 80px; }
    .tp-bf__aktionen { min-width: 0; }
    /* Kategorieseite: flach halten, damit die Produkte nah bleiben. */
    .tp-bf--kompakt .tp-bf__band { gap: 12px; padding: 16px; }
    .tp-bf--kompakt .tp-bf__p, .tp-bf--kompakt .tp-bf__schritte { display: none; }
    .tp-bf--kompakt .tp-bf__h { font-size: var(--font-size--xl); }
    .tp-bf--kompakt .tp-bf__muster { top: 12px; right: 12px; transform: scale(0.8); transform-origin: top right; }
    .tp-bf--kompakt .tp-bf__aktionen { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 4px 14px; }
    .tp-bf--kompakt .tp-bf__start { flex: 1 1 100%; min-height: 46px; }
    .tp-bf--kompakt .tp-bf__bequem-link { margin: 0 auto; font-size: var(--font-size--sm); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Boden-Finder",
  "tag": "div",
  "class": "tp-bf-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Boden-Finder" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Welcher Teppichboden passt zu Ihnen?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ein paar kurze Fragen zu Farbe, Optik, Raum und Preis – dann zeigen wir Ihnen passende Vorschläge." },
    { "type": "text", "id": "button", "label": "Knopf", "default": "Boden-Finder starten" },
    { "type": "text", "id": "bequem_link", "label": "Link für persönliche Vorschläge", "default": "Oder: Vorschläge von uns anfordern" },
    { "type": "checkbox", "id": "kompakt", "label": "Kompakte Darstellung", "default": false },
    { "type": "range", "id": "abstand_oben", "label": "Abstand oben", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "abstand_unten", "label": "Abstand unten", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "art",
      "name": "Bodenart",
      "settings": [
        { "type": "text", "id": "titel", "label": "Titel" },
        { "type": "collection", "id": "kollektion", "label": "Kollektion" },
        { "type": "image_picker", "id": "bild", "label": "Bild", "info": "Ohne Bild: Bild der Kollektion oder ihres ersten Produkts." },
        {
          "type": "select", "id": "status", "label": "Status",
          "options": [
            { "value": "aktiv", "label": "Finder fragt weiter" },
            { "value": "bald", "label": "Finder folgt (Link zur Kategorie)" }
          ],
          "default": "aktiv"
        },
        { "type": "text", "id": "untertitel", "label": "Zeile unter dem Titel" },
        { "type": "text", "id": "produktwort", "label": "Wort für die Trefferzahl", "default": "Teppichböden" },
        { "type": "checkbox", "id": "rollenware", "label": "Rollenware (Budget für den Raum mit Rollenbreite rechnen)", "default": true },
        { "type": "text", "id": "optik_frage", "label": "Frage 3", "default": "Welche Optik soll es sein?" },
        { "type": "text", "id": "optik_filter", "label": "Filter für Frage 3", "default": "filter.p.m.custom.florhoehe_mm", "info": "Parametername des Kollektionsfilters." },
        {
          "type": "textarea", "id": "optik_namen", "label": "Namen für Frage 3",
          "default": "Bis 5 mm = Kurzflor | flach und ruhig\nÜber 5 bis unter 10 mm = Mittelflor | spürbar weicher\nAb 10 mm = Hochflor | besonders weich und flauschig",
          "info": "Je Zeile: Filterwert = Name | kurze Beschreibung. Reihenfolge = Bildchen von niedrig bis hoch."
        },
        { "type": "text", "id": "raum_filter", "label": "Filter für den Raum (optional)", "default": "filter.p.m.custom.zimmer" },
        { "type": "text", "id": "preis_stufen", "label": "Preisstufen je m² (Frage 4)", "default": "20, 30, 45, 70", "info": "Mit Komma und Leerzeichen getrennt. Angeboten werden nur Stufen mit Treffern." }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP Boden-Finder",
      "blocks": [
        { "type": "art", "settings": { "titel": "Teppichboden", "untertitel": "Meterware von der Rolle", "status": "aktiv" } },
        { "type": "art", "settings": { "titel": "Vinylboden", "status": "bald" } },
        { "type": "art", "settings": { "titel": "Teppich nach Maß", "status": "bald" } }
      ]
    }
  ]
}
{% endschema %}
