{{ 'tp-leisten-einstiege.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tp-leisten-filter.js' | asset_url }}" defer></script>
{%- liquid
  assign height_filter = blank
  assign has_material = false
  assign selection_active = false
  if current_tags != blank
    assign selection_active = true
  endif
  for tag in collection.all_tags
    assign prefix = tag | downcase | split: ':' | first | strip
    assign key = tag | downcase | split: ':' | last | strip
    if prefix == 'material' and key != 'pvc'
      assign has_material = true
    endif
  endfor
  for filter in collection.filters
    if filter.param_name == 'filter.p.m.custom.leistenhoehe'
      assign height_filter = filter
    endif
    if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
      assign selection_active = true
    endif
  endfor
-%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="tp-le section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-tp-leisten
  data-section-id="{{ section.id }}"
  data-collection-url="{{ collection.url }}"
  data-testid="tp-leisten-einstiege-{{ section.id }}"
>
  <script type="application/json" data-tp-leisten-tags>{{ collection.all_tags | json }}</script>
  {%- if section.settings.heading != blank or section.settings.intro != blank -%}
    <header class="tp-le__head">
      {%- if section.settings.heading != blank -%}<h2 class="tp-le__heading h3">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="tp-le__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </header>
  {%- endif -%}
  {%- if section.settings.show_material and has_material -%}
    <div class="tp-le__group" role="group" aria-labelledby="tp-le-material-{{ section.id }}">
      <p class="tp-le__label" id="tp-le-material-{{ section.id }}">Nach Material</p>
      <ul class="tp-le__tiles" role="list">
        {%- for tag in collection.all_tags -%}
          {%- liquid
            assign prefix = tag | downcase | split: ':' | first | strip
            assign key = tag | downcase | split: ':' | last | strip
            unless prefix == 'material'
              continue
            endunless
            if key == 'pvc'
              continue
            endif
            assign label = key | capitalize
            assign text = ''
            case key
              when 'kunststoff'
                assign label = 'Kunststoff'
                assign text = section.settings.text_kunststoff
              when 'mdf'
                assign label = 'MDF Holzdekor'
                assign text = section.settings.text_mdf
              when 'hartschaum'
                assign label = 'Hartschaum'
                assign text = section.settings.text_hartschaum
              when 'hdf'
                assign label = 'HDF'
            endcase
            assign sample_image = blank
            for p in collection.products
              if p.tags contains tag and p.featured_image != blank
                assign sample_image = p.featured_image
                break
              endif
            endfor
            capture material_url
              render 'tp-leisten-filter-url', collection: collection, tag: tag
            endcapture
          -%}
          <li class="tp-le__tile-item">
            <a class="tp-le__tile" href="{{ material_url | strip | escape }}#bodenleisten-produkte"
              {% if current_tags contains tag %}aria-current="true"{% endif %}>
              {%- if sample_image != blank -%}
                <span class="tp-le__tile-media">{{ sample_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '96px', alt: '' }}</span>
              {%- endif -%}
              <span class="tp-le__tile-body">
                <span class="tp-le__tile-title">{{ label | escape }}</span>
                {%- if text != blank -%}<span class="tp-le__tile-text">{{ text | escape }}</span>{%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
  {%- if section.settings.show_hoehe and height_filter != blank -%}
    <div class="tp-le__group" role="group" aria-labelledby="tp-le-hoehe-{{ section.id }}">
      <p class="tp-le__label" id="tp-le-hoehe-{{ section.id }}">Nach Höhe</p>
      <ul class="tp-le__chips" role="list">
        {%- for value in height_filter.values -%}
          <li>
            {%- if value.count > 0 or value.active -%}
              <a class="tp-le__chip" href="{% if value.active %}{{ value.url_to_remove | escape }}{% else %}{{ value.url_to_add | escape }}{% endif %}#bodenleisten-produkte"
                {% if value.active %}aria-current="true"{% endif %}>
                {{ value.label | escape }}<span class="tp-le__chip-count">{{ value.count }}</span>
              </a>
            {%- else -%}
              <span class="tp-le__chip" aria-disabled="true">{{ value.label | escape }}<span class="tp-le__chip-count">0</span></span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
  <div class="tp-le__status-row">
    <p class="tp-le__status" role="status" aria-live="polite">{{ collection.products_count }} {% if collection.products_count == 1 %}Leiste{% else %}Leisten{% endif %}</p>
    {%- if selection_active -%}<a class="tp-le__reset" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by | url_encode }}#bodenleisten-produkte">Auswahl zurücksetzen</a>{%- endif -%}
  </div>
  {%- if collection.products_count == 0 -%}<p class="tp-le__empty">Keine Leiste passt zu dieser Kombination. Bitte eine Auswahl abwählen oder die Auswahl zurücksetzen.</p>{%- endif -%}
  <div id="bodenleisten-produkte" class="tp-le__anchor" aria-hidden="true"></div>
</div>
{% schema %}
{
  "name": "TP Leisten-Einstiege",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Ueberschrift",
      "default": "Schnell zur passenden Leiste"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Einleitung",
      "default": "Wählen Sie nach Material oder Höhe – die Auswahl unten passt sich sofort an."
    },
    {
      "type": "checkbox",
      "id": "show_material",
      "label": "Einstiege nach Material anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hoehe",
      "label": "Einstiege nach Höhe anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Kurztexte je Material"
    },
    {
      "type": "text",
      "id": "text_kunststoff",
      "label": "Kunststoff",
      "default": "Mit flexibler Weichlippe, in vielen Höhen"
    },
    {
      "type": "text",
      "id": "text_mdf",
      "label": "MDF Holzdekor",
      "default": "Holzoptik mit Clipsystem"
    },
    {
      "type": "text",
      "id": "text_hartschaum",
      "label": "Hartschaum",
      "default": "Leicht zuzuschneiden, Unifarben"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "TP Leisten-Einstiege"
    }
  ]
}
{% endschema %}
