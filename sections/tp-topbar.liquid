{%- comment -%}
  TP Top-Leiste: bis zu drei feste Aussagen und die Telefonnummer mit Zeiten.
  Ersetzt die rotierende Ankuendigungsleiste - alle Aussagen stehen gleichzeitig,
  auf dem Telefon nur die erste. Keine Versandkosten-Zusage: die Regel ist offen.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

<div class="tp-tb" role="region" aria-label="Vorteile">
  <div class="tp-s-wrap tp-tb__wrap">
    <ul class="tp-tb__list">
      {%- for block in section.blocks -%}
        <li class="tp-tb__item" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.telefon != blank -%}
      <a class="tp-tb__tel" href="tel:{{ section.settings.telefon | remove: ' ' | remove: '/' }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
        {{ section.settings.telefon_anzeige | default: section.settings.telefon | escape }}
        {%- if section.settings.zeiten != blank -%}<span class="tp-tb__zeiten">· {{ section.settings.zeiten | escape }}</span>{%- endif -%}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .tp-tb { background: #1d1a17; color: #fff; font-size: 13.5px; }
  .tp-tb__wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 36px; }
  .tp-tb__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 28px; }
  .tp-tb__item { display: flex; align-items: center; gap: 7px; white-space: nowrap; }
  .tp-tb__item svg { width: 15px; height: 15px; color: #e9c8a1; flex: none; }
  .tp-tb__item a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .tp-tb__tel { display: flex; align-items: center; gap: 7px; font-weight: 600; color: #fff; text-decoration: none; white-space: nowrap; flex: none; }
  .tp-tb__tel svg { width: 15px; height: 15px; color: #e9c8a1; }
  .tp-tb__zeiten { color: #c9c2b8; font-weight: 400; }
  @media (max-width: 1599px) { .tp-tb__zeiten { display: none; } }
  @media (max-width: 1279px) { .tp-tb__item:nth-child(3) { display: none; } }
  @media (max-width: 767px) {
    .tp-tb { font-size: 13px; }
    .tp-tb__wrap { justify-content: center; }
    .tp-tb__item:not(:first-child), .tp-tb__tel { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Top-Leiste",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "telefon", "label": "Telefon (fuer tel:-Link)", "default": "03301 573 37 20" },
    { "type": "text", "id": "telefon_anzeige", "label": "Telefon, wie angezeigt", "default": "03301 573 37 20" },
    { "type": "text", "id": "zeiten", "label": "Oeffnungszeiten (nur ab 1600 px)", "default": "Mo–Fr 8:30–18 · Sa 8:30–14:30" }
  ],
  "blocks": [
    {
      "type": "aussage",
      "name": "Aussage",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Deutschlandweiter Versand · Rollenware per Spedition" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP Top-Leiste",
      "blocks": [
        { "type": "aussage", "settings": { "text": "Deutschlandweiter Versand · Rollenware per Spedition" } },
        { "type": "aussage", "settings": { "text": "Bis zu 3 Muster kostenlos", "link": "shopify://pages/muster" } },
        { "type": "aussage", "settings": { "text": "Fachgeschäft in Oranienburg · Verlegeservice bis 50 km" } }
      ]
    }
  ]
}
{% endschema %}
