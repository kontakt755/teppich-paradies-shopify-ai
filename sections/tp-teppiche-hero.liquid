{%- comment -%}
  Einstieg der Kollektion Teppiche: Botschaft, zwei Handlungen, Vorteile, Bild.
  Uebernommen aus dem Entwurf (sections/tp-rug-hero.liquid) und auf das echte
  Angebot gesetzt: Teppich nach Mass, gekettelt, Preis sofort. Ohne die
  Veroeffentlichungssperre des Entwurfs - dieser Baustein ist fuer den Live-Shop.

  Bild: Foto aus dem Editor; sonst das Bild des ersten Produkts der Kollektion
  (die gerenderten Teppichbilder). Kein Platzhalter, keine Illustration.
{%- endcomment -%}
{{ 'tp-teppiche.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign tp_th_bild = s.image
  if tp_th_bild == blank and collection != blank
    assign tp_th_bild = collection.products.first.featured_image
  endif
  assign tp_th_ziel1 = s.btn1_url
  if tp_th_ziel1 == blank and collection != blank
    assign tp_th_ziel1 = collection.products.first.url
  endif
-%}
<section class="tp-tep tp-tep-hero" aria-labelledby="tp-th-{{ section.id }}">
  <div class="tp-tep-wrap tp-tep-hero__grid">
    <div class="tp-tep-hero__text">
      {%- if s.kicker != blank -%}<p class="tp-tep-kicker">{{ s.kicker | escape }}</p>{%- endif -%}
      <h1 class="tp-tep-h1" id="tp-th-{{ section.id }}">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<p class="tp-tep-lead">{{ s.text | escape }}</p>{%- endif -%}
      <div class="tp-tep-actions">
        {%- if s.btn1_label != blank and tp_th_ziel1 != blank -%}<a class="tp-tep-btn tp-tep-btn--primary" href="{{ tp_th_ziel1 }}">{{ s.btn1_label | escape }}</a>{%- endif -%}
        {%- if s.btn2_label != blank and s.btn2_url != blank -%}<a class="tp-tep-btn tp-tep-btn--ghost" href="{{ s.btn2_url }}">{{ s.btn2_label | escape }}</a>{%- endif -%}
      </div>
      {%- if s.usps != blank -%}
        {%- assign tp_th_usps = s.usps | newline_to_br | split: '<br />' -%}
        <ul class="tp-tep-usps" role="list">
          {%- for u in tp_th_usps -%}
            {%- assign ut = u | strip -%}
            {%- if ut != blank -%}<li>{% render 'tp-teppiche-icon', name: 'check', size: 18 %}{{ ut | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if tp_th_bild != blank -%}
      <div class="tp-tep-hero__media">
        {{ tp_th_bild | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 46vw, 100vw', alt: tp_th_bild.alt }}
        {%- if s.card_title != blank -%}
          <div class="tp-tep-hero__card" aria-hidden="true">
            <strong>{{ s.card_title | escape }}</strong>
            {%- if s.card_text != blank -%}<span>{{ s.card_text | escape }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TP Teppiche Einstieg",
  "tag": "div",
  "class": "tp-tep-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Dachzeile", "default": "Teppiche nach Maß" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ihr Teppich, auf den Zentimeter" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Aus unserem Teppichboden zugeschnitten und rundum gekettelt. Breite und Länge bestimmen Sie – der Preis steht sofort." },
    { "type": "textarea", "id": "usps", "label": "Vorteile (je Zeile einer)", "default": "14 Farben\nBis 400 × 600 cm\nPreis sofort sichtbar" },
    { "type": "image_picker", "id": "image", "label": "Bild (sonst das erste Produkt der Kollektion)" },
    { "type": "text", "id": "card_title", "label": "Bildkarte, Titel", "default": "Rundum gekettelt" },
    { "type": "text", "id": "card_text", "label": "Bildkarte, Text", "default": "Kante mit Garn eingefasst, franst nicht aus" },
    { "type": "header", "content": "Knöpfe" },
    { "type": "text", "id": "btn1_label", "label": "Knopf 1", "default": "Jetzt konfigurieren" },
    { "type": "url", "id": "btn1_url", "label": "Ziel Knopf 1 (sonst das erste Produkt)" },
    { "type": "text", "id": "btn2_label", "label": "Knopf 2", "default": "So funktioniert es" },
    { "type": "url", "id": "btn2_url", "label": "Ziel Knopf 2" }
  ],
  "presets": [{ "name": "TP Teppiche Einstieg" }]
}
{% endschema %}
