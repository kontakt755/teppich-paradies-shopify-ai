{{ 'tp-newsletter-vorteil.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Newsletter-Anmeldung mit Anreiz auf der Startseite (Entwurf zur Ansicht).
  Warum es die Section gibt: Die Anmeldung stand nur im Footer und bot
  keinen Grund, sich einzutragen. Bodenbelag kauft man selten - ein
  Prozent-Rabatt jeden Monat verpufft. Der Inhaber will kleine feste
  Betraege statt Prozent, hoechstens 15 EUR (2026-09-25); das fruehere
  Muster-Extra ist seit 02.11.2026 entfallen. Vorteile, die ohne monatliche Handarbeit stimmen - keine
  "Aktion des Monats" (Inhaber 2026-09-25: keine wechselnden Codes).
  Betrag und Mindestbestellwert stehen als Einstellung hier, damit sie nicht
  in Texten verstreut hartkodiert sind. Der Rabattcode selbst liegt nur in
  Shopify (Repository ist oeffentlich) und wird erst mit der Freigabe
  angelegt - bis dahin ist das hier eine Ansicht, kein Versprechen.
  Gestaltung wie tp-start-muster: dieselben Linien, Schriftskala und
  Akzentfarbe, damit der Abschnitt zur Seite gehoert.
{%- endcomment -%}
{%- liquid
  assign tp_nv_betrag = section.settings.betrag | default: 15
  assign tp_nv_ab = section.settings.mindestwert | default: 100
  capture tp_nv_hinweis
    echo '<p>Mit der Anmeldung willigen Sie ein, unseren Newsletter per E-Mail zu erhalten. Abmeldung jederzeit über den Link in jeder E-Mail. Gutschein: einmal pro Kunde einlösbar, wenn nicht reduzierte Artikel zusammen mindestens '
    echo tp_nv_ab
    echo ' € kosten; nicht mit anderen Rabatten kombinierbar. Näheres in unserer <a href="/policies/privacy-policy">Datenschutzerklärung</a>.</p>'
  endcapture
-%}

<section class="tp-nv" role="region" aria-labelledby="tp-nv-titel-{{ section.id }}">
  <div class="tp-s-wrap tp-nv__wrap">
    <div class="tp-nv__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tp-nv__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="tp-nv__titel" id="tp-nv-titel-{{ section.id }}">
        {{- tp_nv_betrag }} € sparen und Angebote erhalten
      </h2>
      <ul class="tp-nv__vorteile">
        <li>
          <b>{{ tp_nv_betrag }} € Gutschein, einmal pro Kunde</b>
          <small>wenn nicht reduzierte Artikel zusammen mindestens {{ tp_nv_ab }} € kosten</small>
        </li>
        <li>
          <b>Aktuelle Angebote per E-Mail</b>
          <small>jederzeit über den Link in jeder E-Mail abbestellbar</small>
        </li>
      </ul>
    </div>
    <div class="tp-nv__form">
      {%- render 'tp-newsletter',
        ueberschrift: 'Gutschein sichern',
        text: 'E-Mail eintragen, bestätigen – der Code kommt sofort.',
        button: 'Gutschein sichern',
        hinweis: tp_nv_hinweis,
        quelle: 'startseite',
        instanz: section.id
      -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TP Newsletter-Gutschein",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Überzeile",
      "default": "Newsletter"
    },
    {
      "type": "number",
      "id": "betrag",
      "label": "Gutscheinbetrag in €",
      "default": 15,
      "info": "Muss zum Rabattcode in Shopify passen."
    },
    {
      "type": "number",
      "id": "mindestwert",
      "label": "Mindestbestellwert in €",
      "default": 100,
      "info": "Muss zum Rabattcode in Shopify passen."
    }
  ],
  "presets": [
    {
      "name": "TP Newsletter-Gutschein"
    }
  ]
}
{% endschema %}
