{% comment %}
  Kategorie-Kacheln fuer den Zubehoer-Bereich.

  Zwei Darstellungen aus einem Baustein:
  - "kacheln": grosse, einzeln anklickbare Karten (Uebersichtsseite Zubehoer,
    Unterkategorien von Profile).
  - "chips": kompakte Sprungleiste zu den Geschwister-Kategorien auf den
    Unterkategorie-Seiten; die aktuelle Kategorie ist hervorgehoben.

  Jede Kachel zeigt auf eine echte Kollektion. Titel und Erklaertext kommen
  aus der Kollektion (Titel, Beschreibung) und lassen sich je Kachel im Editor
  ueberschreiben. Das Bild wird in dieser Reihenfolge gesucht: eigenes Bild,
  Foto eines gewaehlten Produkts, Kollektionsbild, erstes Produktfoto der
  Kollektion. Produktfotos (Freisteller auf Weiss) werden eingepasst statt
  beschnitten. Erst ganz ohne Foto traegt ein Liniensymbol die Kachel.

  Farben, Schrift, Radien und Buttons kommen ausschliesslich aus den
  Theme-Variablen (color-scheme, --font-*, --style-border-radius-*).
{% endcomment %}

{%- liquid
  assign layout = section.settings.layout | default: 'kacheln'
  assign current_handle = collection.handle | default: ''
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="tp-zubehoer section section--page-width color-{{ section.settings.color_scheme }} spacing-style tp-zubehoer--{{ layout }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="tp-zubehoer-kacheln-{{ section.id }}"
>
  {%- if section.settings.heading != blank or section.settings.intro != blank -%}
    <header class="tp-zubehoer__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="tp-zubehoer__heading h3">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="tp-zubehoer__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if section.blocks.size == 0 -%}
    {%- comment -%} Nur Ueberschrift, z. B. als Zwischentitel vor dem Produktraster {%- endcomment -%}
  {%- elsif layout == 'chips' -%}
    <nav class="tp-zubehoer__chips" aria-label="Zubehör-Kategorien">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          if target == blank
            continue
          endif
          assign label = block.settings.title | default: target.title
          assign is_current = false
          if target.handle == current_handle
            assign is_current = true
          endif
        -%}
        <a
          class="tp-zubehoer__chip{% if is_current %} tp-zubehoer__chip--current{% endif %}"
          href="{{ target.url }}"
          {% if is_current %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          {{ label | escape }}
        </a>
      {%- endfor -%}
    </nav>
  {%- else -%}
    <ul class="tp-zubehoer__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          if target == blank
            continue
          endif
          assign label = block.settings.title | default: target.title
          assign benefit = block.settings.benefit
          assign text = block.settings.text | default: target.description | strip_html
          assign sub_1 = block.settings.sub_collection_1
          assign sub_2 = block.settings.sub_collection_2

          assign image = block.settings.image
          assign fit = 'cover'
          if image == blank and block.settings.product != blank
            assign image = block.settings.product.featured_image
            assign fit = 'contain'
          endif
          if image == blank and target.image != blank
            assign image = target.image
            assign fit = 'cover'
          endif
          if image == blank
            for p in target.products limit: 12
              if p.featured_image != blank
                assign image = p.featured_image
                assign fit = 'contain'
                break
              endif
            endfor
          endif
        -%}
        <li class="tp-zubehoer__item" {{ block.shopify_attributes }}>
          <article class="tp-zubehoer__card">
            <div class="tp-zubehoer__media tp-zubehoer__media--{{ fit }}">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 40vw', alt: label
                }}
              {%- else -%}
                <span class="tp-zubehoer__icon" aria-hidden="true">
                  {% render 'tp-zubehoer-icon', icon: block.settings.icon %}
                </span>
              {%- endif -%}
            </div>
            <div class="tp-zubehoer__body">
              <h3 class="tp-zubehoer__title">
                <a class="tp-zubehoer__link" href="{{ target.url }}">{{ label | escape }}</a>
              </h3>
              {%- if benefit != blank -%}
                <p class="tp-zubehoer__benefit">{{ benefit | escape }}</p>
              {%- endif -%}
              {%- if text != blank -%}
                <p class="tp-zubehoer__text">{{ text | escape }}</p>
              {%- endif -%}
              {%- if sub_1 != blank or sub_2 != blank -%}
                <ul class="tp-zubehoer__subs" role="list">
                  {%- if sub_1 != blank -%}
                    <li><a class="tp-zubehoer__sub" href="{{ sub_1.url }}">{{ sub_1.title | escape }}</a></li>
                  {%- endif -%}
                  {%- if sub_2 != blank -%}
                    <li><a class="tp-zubehoer__sub" href="{{ sub_2.url }}">{{ sub_2.title | escape }}</a></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
              <span class="tp-zubehoer__cta" aria-hidden="true">
                {{ block.settings.cta | default: 'Ansehen' | escape }}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .tp-zubehoer {
    scroll-margin-top: 96px;
  }

  .tp-zubehoer__head {
    max-width: 52rem;
    margin-block-end: 24px;
  }

  .tp-zubehoer__heading {
    margin: 0 0 6px;
  }

  .tp-zubehoer__intro {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Kacheln */
  .tp-zubehoer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 990px) {
    .tp-zubehoer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tp-zubehoer__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: var(--style-border-radius-md);
    transition:
      box-shadow var(--animation-speed, 0.2s) var(--animation-easing, ease),
      transform var(--animation-speed, 0.2s) var(--animation-easing, ease),
      border-color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .tp-zubehoer__card:hover,
  .tp-zubehoer__card:focus-within {
    border-color: rgb(var(--color-foreground-rgb) / 0.35);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.09);
    transform: translateY(-3px);
  }

  /* Die ganze Karte ist ueber den Titel-Link anklickbar; Unterlinks liegen
     darueber und bleiben eigenstaendig. So gibt es keine verschachtelten <a>. */
  .tp-zubehoer__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .tp-zubehoer__link {
    color: inherit;
    text-decoration: none;
  }

  .tp-zubehoer__link:focus-visible {
    outline: none;
  }

  .tp-zubehoer__card:has(.tp-zubehoer__link:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .tp-zubehoer__media {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .tp-zubehoer__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed, 0.3s) var(--animation-easing, ease);
  }

  .tp-zubehoer__media--contain {
    background: #fff;
  }

  .tp-zubehoer__media--contain img {
    padding: 9%;
    object-fit: contain;
  }

  .tp-zubehoer__card:hover .tp-zubehoer__media img,
  .tp-zubehoer__card:focus-within .tp-zubehoer__media img {
    transform: scale(1.04);
  }

  .tp-zubehoer__icon {
    display: block;
    width: clamp(3.5rem, 22%, 5rem);
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .tp-zubehoer__icon svg {
    width: 100%;
    height: auto;
  }

  .tp-zubehoer__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    padding: 18px 20px 20px;
  }

  .tp-zubehoer__title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .tp-zubehoer__benefit {
    margin: 0;
    color: var(--color-foreground);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .tp-zubehoer__text {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    font-size: 0.92rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .tp-zubehoer__subs {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .tp-zubehoer__sub {
    display: inline-block;
    padding: 6px 12px;
    color: var(--color-foreground);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: var(--style-border-radius-pills);
    background: var(--color-background);
  }

  .tp-zubehoer__sub:hover,
  .tp-zubehoer__sub:focus-visible {
    border-color: var(--color-foreground);
  }

  .tp-zubehoer__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: auto;
    padding-block-start: 10px;
    color: var(--color-foreground);
    font-size: 0.9rem;
    font-weight: 650;
  }

  .tp-zubehoer__cta svg {
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .tp-zubehoer__card:hover .tp-zubehoer__cta svg {
    transform: translateX(3px);
  }

  /* Chips */
  .tp-zubehoer__chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-block: 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tp-zubehoer__chips::-webkit-scrollbar {
    display: none;
  }

  .tp-zubehoer__chip {
    flex: 0 0 auto;
    padding: 9px 14px;
    color: var(--color-foreground);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: var(--style-border-radius-pills);
    background: var(--color-background);
  }

  .tp-zubehoer__chip:hover,
  .tp-zubehoer__chip:focus-visible {
    border-color: var(--color-foreground);
  }

  .tp-zubehoer__chip--current {
    color: var(--color-primary-button-text);
    background: var(--color-primary-button-background);
    border-color: var(--color-primary-button-background);
  }

  @media screen and (max-width: 749px) {
    .tp-zubehoer__head {
      margin-block-end: 18px;
    }

    /* Am Telefon eine kompakte Liste mit Vorschaubild: Titel und Nutzen
       reichen zur Wahl, die Karte ist als Ganzes der Link. Beschreibung,
       Unterlinks und "Ansehen" entfallen hier - die Kacheln standen sonst
       mit 150-260 px je Eintrag rund 1.500 px vor den Produkten. */
    .tp-zubehoer__grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .tp-zubehoer__card {
      flex-direction: row;
      align-items: center;
    }

    .tp-zubehoer__card:hover,
    .tp-zubehoer__card:focus-within {
      transform: none;
    }

    .tp-zubehoer__media {
      flex: 0 0 76px;
      align-self: stretch;
      aspect-ratio: 1;
      min-height: 76px;
      border-block-end: 0;
      border-inline-end: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    }

    .tp-zubehoer__media--contain img {
      padding: 10%;
    }

    .tp-zubehoer__icon {
      width: 2.25rem;
    }

    .tp-zubehoer__body {
      gap: 2px;
      padding: 10px 14px;
      justify-content: center;
    }

    .tp-zubehoer__title {
      font-size: 1.02rem;
    }

    .tp-zubehoer__benefit {
      font-size: 0.9rem;
      font-weight: 500;
      color: rgb(var(--color-foreground-rgb) / 0.78);
    }

    .tp-zubehoer__text,
    .tp-zubehoer__subs,
    .tp-zubehoer__cta {
      display: none;
    }

    .tp-zubehoer__intro {
      font-size: 0.95rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Zubehoer-Kacheln",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Darstellung",
      "options": [
        { "value": "kacheln", "label": "Grosse Kacheln" },
        { "value": "chips", "label": "Kompakte Sprungleiste" }
      ],
      "default": "kacheln"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Ueberschrift"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Einleitung"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Sprungmarke (z. B. bereiche, fuer Links mit #)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "kachel",
      "name": "Kachel",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel (leer = Kollektionstitel)"
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "Nutzenzeile"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Erklaerung (leer = Kollektionsbeschreibung)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild (leer = Produktfoto, Kollektionsbild oder Symbol)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produkt fuer das Foto (ohne eigenes Bild)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol ohne Bild",
          "options": [
            { "value": "profil", "label": "Profil" },
            { "value": "uebergang", "label": "Uebergangsprofil" },
            { "value": "abschluss", "label": "Abschlussprofil" },
            { "value": "kleber", "label": "Kleber" },
            { "value": "bauchemie", "label": "Bauchemie" },
            { "value": "unterlage", "label": "Unterlage" },
            { "value": "reinigung", "label": "Reinigung" },
            { "value": "band", "label": "Verlegeband" },
            { "value": "matte", "label": "Sauberlauf" }
          ],
          "default": "profil"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Linktext",
          "default": "Ansehen"
        },
        {
          "type": "collection",
          "id": "sub_collection_1",
          "label": "Unterkategorie 1 (optional)"
        },
        {
          "type": "collection",
          "id": "sub_collection_2",
          "label": "Unterkategorie 2 (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "TP Zubehoer-Kacheln",
      "blocks": [
        { "type": "kachel" },
        { "type": "kachel" },
        { "type": "kachel" }
      ]
    }
  ]
}
{% endschema %}
