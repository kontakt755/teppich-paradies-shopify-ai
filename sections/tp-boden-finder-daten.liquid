{%- comment -%}
  Datenschnittstelle des Boden-Finders (sections/tp-boden-finder.liquid).
  Steht nur in den Ansichten ohne Layout templates/collection.boden-finder.json
  (Zaehlungen), collection.boden-finder-treffer.json (Treffer mit Karten) und
  collection.boden-finder-preise.json (Preise je m2, siehe unten) und wird
  per fetch aufgerufen, z. B.
    /collections/teppichboden?view=boden-finder&filter.v.t.shopify.color-pattern=...

  Shopify wendet die Filter der Adresse auf collection.products an. Daraus
  kommen:
  - "anzahl": Produkte, die zu allen aktiven Filtern passen.
  - "filter": jeder Filter der Kollektion mit Werten und Trefferzahl. Der
    Finder bietet nur Werte mit Treffern an; so stehen nur Farben und
    Florhoehen zur Wahl, die es in der Kollektion wirklich gibt.
  - nur in der Treffer-Ansicht: die ersten Produkte in Shop-Reihenfolge mit
    den Varianten der gezeigten Farbe (Optionen, Preis, verfuegbar,
    Wunschmass erlaubt) und die Produktkarte aus dem statischen Kartenblock.
    Die Karte ist dieselbe wie im Kategorie-Raster; bei aktivem Farbfilter
    zeigt sie die passende Farbe (snippets/tp-suchfarbe-variante.liquid).

  Den ca.-Preis fuer ein Raummass rechnet assets/tp-boden-finder.js mit den
  Funktionen des Rollenware-Rechners (assets/tp-rollware-art.js) bzw. bei
  Paketware mit den Regeln des Paketrechners aus genau diesen Preisen.

  Paketware (Klick-, Klebevinyl): Der Variantenpreis ist der Paketpreis, der
  Preisfilter der Kategorie deshalb ausgeblendet (blocks/filters.liquid). Fuer
  ein Budget je m2 liefert die dritte Ansicht ?view=boden-finder-preise
  (collection.boden-finder-preise.json) je Produkt den Preis je m2 - genau
  wie die Produktkarte: Paketpreis / custom.qm_pro_paket, gerundet auf Cent
  (snippets/price.liquid). Der Finder filtert damit im Browser; Shopify
  filtert hier nur nach Farbe und Optik. Bis 250 Produkte je Seite
  (Plattformgrenze), Reihenfolge wie im Raster, damit der Finder die
  Kartenseite eines Treffers kennt. Je Produkt:
    [Handle, Preis je m2 in Cent, m2 je Paket (0 = keine Paketware),
     kleinster Variantenpreis in Cent, Auslauf 1/0]
{%- endcomment -%}
{%- liquid
  assign bf_treffer = section.settings.treffer
  assign bf_preise = section.settings.preise
  assign bf_max = section.settings.anzahl_karten
-%}
<script type="application/json" data-bf-daten>
{
  "anzahl": {{ collection.products_count | json }},
  {%- if bf_preise -%}
  {%- paginate collection.products by 250 -%}
  "pro_seite": {{ paginate.page_size | json }},
  "preise": [
      {%- for product in collection.products -%}
        {%- liquid
          # Varianten wie in der Treffer-Ansicht: bei aktivem Farbfilter nur
          # die passende Farbe, nie OPC-Konfiguratorvarianten.
          assign bf_qm = product.metafields.custom.qm_pro_paket.value | times: 1.0
          capture bf_sf
            render 'tp-suchfarbe-variante', product: product
          endcapture
          assign bf_sf = bf_sf | strip
          assign bf_fi = -1
          assign bf_farbe = ''
          if bf_sf != blank
            assign bf_pos = bf_sf | split: '|' | first | plus: 0
            assign bf_fi = bf_sf | split: '|' | last | plus: 0
            assign bf_farbe = product.variants[bf_pos].options[bf_fi]
          endif
          assign bf_min = 0
          for bf_var in product.variants
            assign bf_var_titel = bf_var.title | downcase
            if bf_var_titel contains 'opc-' or bf_var.available == false
              continue
            endif
            if bf_fi >= 0 and bf_var.options[bf_fi] != bf_farbe
              continue
            endif
            if bf_min == 0 or bf_var.price < bf_min
              assign bf_min = bf_var.price
            endif
          endfor
          # Preis je m2 in Cent, wie die Karte ihn zeigt.
          assign bf_qmp = bf_min
          if bf_qm > 0
            assign bf_qmp = bf_min | times: 1.0 | divided_by: bf_qm | round
          elsif product.metafields.custom.preis_pro_001_qm.value == true
            assign bf_qmp = bf_min | times: 100
          endif
        -%}
        [{{ product.handle | json }}, {{ bf_qmp | json }}, {{ bf_qm | json }}, {{ bf_min | json }}, {% if product.tags contains 'auslauf' %}1{% else %}0{% endif %}]{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
  ]
  {%- endpaginate -%}
  {%- else -%}
  "filter": {
    {%- for bf_filter in collection.filters -%}
      {{ bf_filter.param_name | json }}: {
        "label": {{ bf_filter.label | json }},
        "typ": {{ bf_filter.type | json }},
        {%- if bf_filter.type == 'price_range' -%}
          "max": {{ bf_filter.range_max | divided_by: 100.0 | json }},
        {%- endif -%}
        "werte": [
          {%- if bf_filter.type == 'list' or bf_filter.type == 'boolean' -%}
            {%- for bf_wert in bf_filter.values -%}
              {
                "label": {{ bf_wert.label | json }},
                "value": {{ bf_wert.value | json }},
                "count": {{ bf_wert.count | default: 0 | json }},
                "aktiv": {{ bf_wert.active | json }}
                {%- if bf_wert.swatch.color -%}, "farbe": {{ bf_wert.swatch.color.rgb | prepend: 'rgb(' | append: ')' | json }}{%- endif -%}
                {%- if bf_wert.swatch.image -%}, "bild": {{ bf_wert.swatch.image | image_url: width: 120 | json }}{%- endif -%}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
  {%- if bf_treffer -%},
  "pro_seite": {{ bf_max | json }},
  "produkte": [
    {%- paginate collection.products by bf_max -%}
      {%- for product in collection.products limit: bf_max -%}
        {%- liquid
          # Die Variante, die auch die Karte zeigt: bei aktivem Farbfilter die
          # passende Farbe, sonst die erste verfuegbare.
          assign bf_v = product.selected_or_first_available_variant
          capture bf_sf
            render 'tp-suchfarbe-variante', product: product
          endcapture
          assign bf_sf = bf_sf | strip
          if bf_sf != blank
            assign bf_pos = bf_sf | split: '|' | first | plus: 0
            assign bf_v = product.variants[bf_pos]
          endif
          assign bf_fi = -1
          for bf_opt in product.options_with_values
            assign bf_opt_name = bf_opt.name | downcase
            if bf_opt_name == 'farbe' or bf_opt_name == 'color' or bf_opt_name == 'dekor'
              assign bf_fi = bf_opt.position | minus: 1
              break
            endif
          endfor
          assign bf_farbe = ''
          if bf_fi >= 0
            assign bf_farbe = bf_v.options[bf_fi]
          endif
          # Wie im Rechner: Tag "ohne-raummass" = nur Meterware.
          assign bf_ohne_raum = false
          if product.tags contains 'ohne-raummass'
            assign bf_ohne_raum = true
          endif
          assign bf_min_cm = product.metafields.custom.mindestlaenge_lfm.value | times: 100 | round
        -%}
        {
          "handle": {{ product.handle | json }},
          "titel": {{ product.title | json }},
          "url": {{ bf_v.url | json }},
          "farbe": {{ bf_farbe | json }},
          "auslauf": {% if product.tags contains 'auslauf' %}true{% else %}false{% endif %},
          "cm_exact": {% if product.metafields.custom.preis_pro_001_qm.value == true %}true{% else %}false{% endif %},
          "min_cm": {{ bf_min_cm | json }},
          "qm_paket": {{ product.metafields.custom.qm_pro_paket.value | times: 1.0 | json }},
          "options": [
            {%- for bf_opt in product.options_with_values -%}
              { "name": {{ bf_opt.name | json }}, "values": {{ bf_opt.values | json }} }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "variants": [
            {%- for bf_var in product.variants -%}
              {%- liquid
                assign bf_var_titel = bf_var.title | downcase
                assign bf_var_aus = false
                if bf_var_titel contains 'opc-'
                  assign bf_var_aus = true
                endif
                if bf_fi >= 0 and bf_var.options[bf_fi] != bf_farbe
                  assign bf_var_aus = true
                endif
                if bf_ohne_raum
                  if bf_var.options contains 'Wunschmaß' or bf_var.options contains 'Wunschmass'
                    assign bf_var_aus = true
                  endif
                endif
              -%}
              {%- unless bf_var_aus -%}
                { "options": {{ bf_var.options | json }}, "price": {{ bf_var.price | json }}, "available": {{ bf_var.available | json }}, "wunschmass": {% if bf_var.metafields.lieferant.wunschmass.value == false %}false{% else %}true{% endif %} },
              {%- endunless -%}
            {%- endfor -%}
            null
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endpaginate -%}
  ]
  {%- endif -%}
  {%- endif -%}
}
</script>
{%- if bf_treffer -%}
  <div data-bf-karten>
    {%- paginate collection.products by bf_max -%}
      {%- for product in collection.products limit: bf_max -%}
        <div class="tp-bf-karte" data-handle="{{ product.handle | escape }}">
          {% # theme-check-disable UniqueStaticBlockId %}
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product, card_index: forloop.index0 %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "TP Boden-Finder Daten",
  "tag": "div",
  "class": "tp-bf-daten",
  "settings": [
    {
      "type": "paragraph",
      "content": "Nur für die Ansichten boden-finder, boden-finder-treffer und boden-finder-preise. Liefert dem Boden-Finder Filterwerte, Trefferzahl, Produktkarten und Preise je m²."
    },
    {
      "type": "checkbox",
      "id": "treffer",
      "label": "Treffer mit Karten ausgeben",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "preise",
      "label": "Preise je m² aller Produkte ausgeben (statt Filter und Treffer)",
      "default": false
    },
    {
      "type": "range",
      "id": "anzahl_karten",
      "label": "Anzahl Treffer",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
