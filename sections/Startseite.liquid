<!-- START Custom Startseite mit Premium Hero + Übergang + Kategorien -->

<style>
/* ============================= */
/* HERO SECTION */
/* ============================= */

.hero {
  position: relative;
  background: url('https://cdn.shopify.com/s/files/1/0875/4852/6926/files/ChatGPT_Image_12._Feb._2026_09_31_42.png?v=1770885222') center/cover no-repeat;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
  z-index: 1;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.45);
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 1;
  background: rgba(255,255,255,0.92);
  padding: 28px 28px;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  max-width: 640px;
  width: 100%;
}

.hero-text {
  margin-bottom: 16px;
}

.hero h1 {
  font-size: clamp(26px, 4.2vw, 44px);
  line-height: 1.15;
  margin: 0 0 10px;
  color: #222;
}

.hero p {
  font-size: clamp(15px, 2.2vw, 18px);
  line-height: 1.5;
  margin: 0;
  color: #555;
}

.hero-actions{
  display:flex;
  gap:12px;
  justify-content:center;
  flex-wrap:wrap;
  margin-top:18px;
}

.btn-primary, .btn-secondary{
  padding:12px 18px;
  border-radius:10px;
  text-decoration:none;
  font-weight:700;
  font-size:15px;
  transition: all .2s ease;
}

.btn-primary{ background:#222; color:#fff; }
.btn-secondary{ background:transparent; color:#222; border:1px solid #ddd; }

.btn-primary:hover,
.btn-secondary:hover{ transform: translateY(-2px); }

.hero-contact{
  margin-top:14px;
  font-size:13.5px;
  color:#666;
  display:flex;
  gap:8px;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
}

.hero-contact a{
  color:inherit;
  text-decoration:underline;
  text-underline-offset:2px;
}

/* MOBILE */
@media (max-width: 768px){
  .hero{
    min-height: 460px;
    padding: 30px 18px;
    align-items: flex-end;
    background-position: center;
  }

  .hero::before{
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.68) 0%,
      rgba(0,0,0,0.50) 45%,
      rgba(0,0,0,0.22) 75%,
      rgba(0,0,0,0.10) 100%
    );
  }

  .hero-content{
    background: transparent;
    box-shadow: none;
    padding: 0;
    max-width: 100%;
  }

  .hero-text{
    display: inline-block;
    padding: 14px 14px;
    border-radius: 14px;
    background: rgba(0,0,0,0.28);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    margin-bottom: 14px;
  }

  .hero h1{
    color:#fff;
    font-size: clamp(24px, 6vw, 34px);
    text-shadow: 0 2px 14px rgba(0,0,0,0.55);
  }

  .hero p{
    color: rgba(255,255,255,0.92);
    text-shadow: 0 2px 14px rgba(0,0,0,0.50);
  }

  .hero-contact{
    color:#fff;
    text-shadow: 0 2px 12px rgba(0,0,0,0.45);
  }

  .btn-secondary{ border:1px solid rgba(255,255,255,0.6); color:#fff; }
  .btn-primary{ background:#fff; color:#000; }

  .btn-primary,
  .btn-secondary{ width:100%; max-width:340px; }
}

@media (max-width: 420px){
  .hero{ min-height: 430px; padding: 26px 14px; }
  .hero-text{ padding: 12px 12px; }
}

/* ============================= */
/* TRUST-LEISTE */
/* ============================= */

.trust-bar{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap: 10px 28px;
  max-width: 1000px;
  margin: 28px auto 0;
  padding: 0 20px;
}

.trust-bar span{
  display:flex;
  align-items:center;
  gap:7px;
  font-size: 13.5px;
  color:#444;
  font-weight: 600;
}

.trust-bar svg{
  width:16px;
  height:16px;
  flex-shrink:0;
  color:#b4976c;
}

/* ============================= */
/* KATEGORIEN */
/* ============================= */

.section-intro{
  max-width: 1000px;
  margin: 56px auto 4px;
  padding: 0 20px;
  text-align: center;
}

.section-intro h2{
  font-size: 26px;
  margin: 0 0 6px;
  color:#1a1a1a;
  letter-spacing: -0.01em;
}

.section-intro p{
  margin: 0;
  color: #666;
  font-size: 15px;
}

.categories {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 28px;
  max-width: 1200px;
  margin: 32px auto 72px;
  padding: 0 20px;
  box-sizing: border-box;
}

/* Desktop: 3 Spalten für 3 Kategorien */
@media (min-width: 900px) {
  .categories {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Tablet: 2 Spalten */
@media (min-width: 641px) and (max-width: 899px) {
  .categories {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile: 1 Spalte */
@media (max-width: 640px) {
  .categories {
    grid-template-columns: 1fr;
  }
}

.category-box {
  position: relative;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  text-align: left;
  box-shadow: 0 2px 8px rgba(20,20,20,0.06);
  transition: box-shadow .25s ease, transform .25s ease;
}

.category-box:hover{
  box-shadow: 0 16px 32px rgba(20,20,20,0.14);
  transform: translateY(-4px);
}

.category-box .category-media{
  display: block;
  position: relative;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  width: 100%;
}

.category-box .category-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.category-box:hover .category-media img{
  transform: scale(1.06);
}

.category-box .category-badge{
  position: absolute;
  top: 14px;
  left: 14px;
  background: rgba(255,255,255,0.95);
  color:#1a1a1a;
  font-size: 12px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 999px;
  letter-spacing: 0.02em;
}

.category-box .category-body{
  padding: 20px 20px 22px;
}

.category-box h3 {
  margin: 0 0 8px;
  font-size: 21px;
  color:#1a1a1a;
}

.category-box p {
  margin: 0 0 18px;
  font-size: 14px;
  line-height: 1.5;
  color: #666;
  min-height: 42px;
}

.category-box a.category-cta {
  display: inline-flex;
  align-items:center;
  gap:8px;
  padding: 11px 20px;
  background: #1a1a1a;
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  transition: background .2s ease, gap .2s ease;
}

.category-box a.category-cta:hover {
  background: #b4976c;
  gap: 12px;
}

.category-box a.category-cta svg{
  width:14px;
  height:14px;
  transition: transform .2s ease;
}

.category-box a.category-cta:hover svg{
  transform: translateX(2px);
}
</style>

