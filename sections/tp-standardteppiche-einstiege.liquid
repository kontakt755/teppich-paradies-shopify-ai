{%- liquid
  assign tp_st_arten = nil
  assign tp_st_material = nil
  assign tp_st_material_available = false
  for tp_st_filter in collection.filters
    if tp_st_filter.param_name == 'filter.p.m.custom.arten'
      assign tp_st_arten = tp_st_filter
    elsif tp_st_filter.param_name == 'filter.p.m.custom.fasermaterial'
      assign tp_st_material = tp_st_filter
    endif
  endfor
  for tp_st_value in tp_st_material.values
    if tp_st_value.count > 0 or tp_st_value.active
      assign tp_st_material_available = true
      break
    endif
  endfor
-%}
<section class="tp-standardteppiche section section--page-width" data-tp-standardteppiche aria-labelledby="tp-st-heading-{{ section.id }}">
  <h2 id="tp-st-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <p class="tp-st__intro">{{ section.settings.text | escape }}</p>
  {%- if tp_st_arten != nil -%}
    <nav aria-label="{{ section.settings.heading | escape }}">
      {%- if tp_st_arten.active_values.size > 0 -%}
        <a class="tp-st__reset" href="{{ tp_st_arten.url_to_remove | escape }}">Alle Teppicharten anzeigen</a>
      {%- endif -%}
      <ul class="tp-st__cards" role="list">
        {%- for block in section.blocks -%}
          {%- for tp_st_value in tp_st_arten.values -%}
            {%- if tp_st_value.label != block.settings.filter_label -%}{%- continue -%}{%- endif -%}
            {%- if tp_st_value.count == 0 and tp_st_value.active == false -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign tp_st_url = tp_st_value.url_to_add
              if tp_st_value.active
                assign tp_st_url = tp_st_value.url_to_remove
              endif
              assign tp_st_product = block.settings.product
              assign tp_st_credit = tp_st_product.metafields.custom.bildnachweis.value
            -%}
            <li {{ block.shopify_attributes }}>
              <a class="tp-st__card{% if tp_st_value.active %} tp-st__card--active{% endif %}" href="{{ tp_st_url | escape }}"{% if tp_st_value.active %} aria-current="true"{% endif %}>
                {%- if tp_st_product.featured_image != blank -%}
                  <span class="tp-st__media" aria-hidden="true">
                    {{ tp_st_product.featured_image | image_url: width: 320 | image_tag: widths: '120, 180, 240, 320', sizes: '96px', loading: 'lazy', alt: '', class: 'tp-st__image' }}
                  </span>
                  {%- if tp_st_credit != blank -%}<small class="tp-st__credit">{{ tp_st_credit | escape }}</small>{%- endif -%}
                {%- endif -%}
                <strong>{{ block.settings.label | default: tp_st_value.label | escape }}</strong>
                <span class="tp-st__count">{{ tp_st_value.count }} {% if tp_st_value.count == 1 %}Produkt{% else %}Produkte{% endif %}</span>
                <small class="tp-st__description">{{ block.settings.description | escape }}</small>
                {%- if tp_st_value.active -%}<span class="tp-st__selected">Ausgewählt · entfernen</span>{%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
  {%- if tp_st_material_available -%}
    <nav class="tp-st__materials" aria-label="Material auswählen">
      <span>Material:</span>
      {%- for tp_st_value in tp_st_material.values -%}
        {%- if tp_st_value.count == 0 and tp_st_value.active == false -%}{%- continue -%}{%- endif -%}
        {%- assign tp_st_url = tp_st_value.url_to_add -%}
        {%- if tp_st_value.active -%}{%- assign tp_st_url = tp_st_value.url_to_remove -%}{%- endif -%}
        <a class="tp-st__material{% if tp_st_value.active %} tp-st__material--active{% endif %}" href="{{ tp_st_url | escape }}"{% if tp_st_value.active %} aria-current="true"{% endif %}>{{ tp_st_value.label | escape }} ({{ tp_st_value.count }}){% if tp_st_value.active %}<span class="visually-hidden"> · Auswahl entfernen</span>{% endif %}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
</section>

{% stylesheet %}
  .tp-standardteppiche { padding-block: 4px 24px; }
  .tp-standardteppiche > nav { min-width: 0; max-width: 100%; }
  .tp-standardteppiche h2 { margin: 0; font-size: clamp(20px, 2vw, 26px); }
  .tp-st__intro { margin: 8px 0 16px; line-height: 1.45; }
  .tp-st__cards { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x proximity; margin: 0; padding: 4px 3px 8px; list-style: none; }
  .tp-st__cards > li { flex: 0 0 144px; scroll-snap-align: start; }
  .tp-st__card { display: flex; flex-direction: column; height: 100%; padding: 10px; gap: 5px; border: 1px solid var(--tp-line, #e6e0d8); border-radius: 12px; color: var(--tp-ink, #1d1a17); background: var(--tp-bg-2, #f6f2ec); text-decoration: none; }
  .tp-st__card--active { border-color: currentColor; box-shadow: inset 0 0 0 1px currentColor; }
  .tp-st__card:focus-visible, .tp-st__material:focus-visible, .tp-st__reset:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .tp-st__media { display: block; width: 96px; height: 64px; align-self: center; }
  .tp-st__image { display: block; width: 100%; height: 100%; object-fit: contain; }
  .tp-st__credit { font-size: 9px; line-height: 1.3; overflow-wrap: anywhere; }
  .tp-st__card strong { font-size: 15px; line-height: 1.25; }
  .tp-st__count, .tp-st__description, .tp-st__selected { font-size: 12px; line-height: 1.35; }
  .tp-st__selected { font-weight: 600; }
  .tp-st__reset { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 8px; color: inherit; }
  .tp-st__materials { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; }
  .tp-st__material { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 12px; border: 1px solid var(--tp-line, #e6e0d8); border-radius: 999px; color: inherit; text-decoration: none; }
  .tp-st__material--active { border-color: currentColor; font-weight: 600; }
  body:has([data-tp-standardteppiche]) .product-grid-container .card-gallery .product-media__image { object-fit: contain; }
  body:has([data-tp-standardteppiche]) .product-grid-container .product-card__content { min-height: 0; }
  @media screen and (max-width: 749px) {
    body:has([data-tp-standardteppiche]) .product-grid-container .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('filter:update', async () => {
    const navigation = document.querySelector('[data-tp-standardteppiche]');
    const wrapper = navigation?.closest('.shopify-section');
    if (!wrapper) return;
    try {
      const { sectionRenderer } = await import('@theme/section-renderer');
      await sectionRenderer.renderSection(wrapper.id.replace('shopify-section-', ''));
    } catch {
      window.location.reload();
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "TP Teppicharten-Auswahl",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Teppiche nach Art auswählen" },
    { "type": "text", "id": "text", "label": "Kurztext", "default": "Wählen Sie eine Teppichart. Farbe und Preis lassen sich anschließend im Filter eingrenzen." }
  ],
  "blocks": [
    {
      "type": "art",
      "name": "Teppichart",
      "settings": [
        { "type": "text", "id": "filter_label", "label": "Vorhandener Filterwert (exakte Bezeichnung)" },
        { "type": "text", "id": "label", "label": "Sichtbarer Titel" },
        { "type": "text", "id": "description", "label": "Kurze Erklärung" },
        { "type": "product", "id": "product", "label": "Beispielprodukt für das Bild" }
      ]
    }
  ],
  "presets": [{ "name": "TP Teppicharten-Auswahl" }]
}
{% endschema %}
