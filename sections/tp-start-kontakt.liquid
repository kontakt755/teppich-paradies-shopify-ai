{%- comment -%}
  TP Kontakt: drei Wege - Anrufen, WhatsApp, Anfrage per Shopify-Kontaktformular.
  Das Formular ist kurz (Name, PLZ, Telefon/E-Mail, Anliegen, Nachricht).
  Auf dem Telefon ist es eingeklappt, bis "Anfrage schreiben" getippt wird.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}
{%- assign tel_raw = section.settings.telefon | remove: ' ' | remove: '/' -%}

<section class="tp-s-sec tp-s-sec--band tp-kon" id="tp-kontakt" aria-labelledby="tp-kon-h2">
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head">
      <div>
        <h2 id="tp-kon-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tp-kon__grid">
      <div class="tp-kon__card">
        <div class="tp-kon__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></div>
        <h3 class="tp-s-h3">Anrufen</h3>
        <p>{{ section.settings.zeiten | escape }} Sie sprechen direkt mit dem Fachgeschäft.</p>
        <a class="tp-s-btn tp-s-btn--dark" href="tel:{{ tel_raw }}">{{ section.settings.telefon | escape }}</a>
      </div>
      <div class="tp-kon__card">
        <div class="tp-kon__ico tp-kon__ico--wa"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2z"/></svg></div>
        <h3 class="tp-s-h3">WhatsApp</h3>
        <p>Foto vom Raum schicken, Frage stellen – wir antworten in den Öffnungszeiten.</p>
        <a class="tp-s-btn tp-s-btn--wa" href="{{ section.settings.whatsapp }}" rel="noopener" target="_blank">WhatsApp schreiben</a>
      </div>
      <div class="tp-kon__card tp-kon__card--form" id="tp-anfrage">
        <h3 class="tp-s-h3">Anfrage senden</h3>
        <p>Für Aufmaß, Verlegung oder ein Angebot. Wir melden uns am nächsten Werktag.</p>
        <button class="tp-s-btn tp-s-btn--primary tp-kon__toggle" type="button" aria-expanded="false" data-tp-kon-toggle>Anfrage schreiben</button>
        {%- form 'contact', id: 'tp-start-anfrage', class: 'tp-kon__form' -%}
          <input type="hidden" name="contact[Betreff]" value="Anfrage von der Startseite">
          {%- if form.posted_successfully? -%}
            <p class="tp-kon__ok" role="status"><b>Danke, Ihre Anfrage ist angekommen.</b> Wir melden uns am nächsten Werktag.</p>
          {%- elsif form.errors -%}
            <p class="tp-kon__err" role="alert">Bitte prüfen Sie Name und E-Mail-Adresse.</p>
          {%- endif -%}
          <label>Name<input type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></label>
          <label>PLZ<input type="text" name="contact[PLZ]" inputmode="numeric" maxlength="5" autocomplete="postal-code"></label>
          <label>E-Mail<input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
          <label>Telefon (optional)<input type="tel" name="contact[Telefon]" autocomplete="tel"></label>
          <label class="tp-kon__full">Ich möchte<select name="contact[Anliegen]"><option>Boden verlegen lassen</option><option>Aufmaß und Angebot</option><option>Beratung zum Produkt</option><option>Muster bestellen</option><option>Rückruf</option></select></label>
          <label class="tp-kon__full">Nachricht (Raum, Fläche, Wunschboden)<textarea name="contact[body]" rows="3">{{ form.body }}</textarea></label>
          <p class="tp-s-note tp-kon__full">Fotos oder Grundrisse schicken Sie uns am einfachsten per WhatsApp. Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Angaben zur Bearbeitung der Anfrage zu.</p>
          <button class="tp-s-btn tp-s-btn--primary tp-kon__full" type="submit">Anfrage senden</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .tp-kon__grid { display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 20px; }
  .tp-kon__card { border: 1px solid #e6e0d8; border-radius: 14px; padding: 24px; background: #fff; display: flex; flex-direction: column; gap: 10px; }
  .tp-kon__card p { color: #4a443f; font-size: 15px; margin: 0; }
  .tp-kon__card > .tp-s-btn { margin-top: auto; align-self: flex-start; }
  .tp-kon__ico { width: 44px; height: 44px; border-radius: 12px; background: #fbeeef; color: #b73740; display: grid; place-items: center; }
  .tp-kon__ico svg { width: 22px; height: 22px; }
  .tp-kon__ico--wa { background: #e6f6ec; color: #1f9d55; }
  .tp-kon__toggle { display: none; }
  .tp-kon__form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tp-kon__form label { display: grid; gap: 5px; font-size: 13.5px; font-weight: 500; color: #4a443f; }
  .tp-kon__form input, .tp-kon__form select, .tp-kon__form textarea { height: 46px; border: 1.5px solid #d5cec4; border-radius: 8px; padding: 0 12px; font: inherit; font-size: 15px; background: #fff; color: #1d1a17; }
  .tp-kon__form textarea { height: auto; min-height: 80px; padding: 10px 12px; resize: vertical; }
  .tp-kon__form input:focus, .tp-kon__form select:focus, .tp-kon__form textarea:focus { border-color: #1d1a17; outline: none; }
  .tp-kon__full { grid-column: 1 / -1; }
  .tp-kon__ok { grid-column: 1 / -1; background: #e7f3ea; color: #1f5a36; padding: 10px 12px; border-radius: 8px; }
  .tp-kon__err { grid-column: 1 / -1; background: #fff6e5; color: #7a4b00; padding: 10px 12px; border-radius: 8px; }
  @media (max-width: 1023px) { .tp-kon__grid { grid-template-columns: 1fr 1fr; } .tp-kon__card--form { grid-column: 1 / -1; } }
  @media (max-width: 767px) {
    .tp-kon__grid { grid-template-columns: 1fr; }
    .tp-kon__form { grid-template-columns: 1fr; }
    .tp-kon__full { grid-column: auto; }
    .tp-kon__toggle { display: inline-flex; }
    .tp-kon__card--form .tp-kon__form { display: none; }
    .tp-kon__card--form.tp-kon__card--offen .tp-kon__form { display: grid; }
    .tp-kon__card--form.tp-kon__card--offen .tp-kon__toggle { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var t = document.querySelector('[data-tp-kon-toggle]');
    if (!t) return;
    var card = t.closest('.tp-kon__card--form');
    if (card && card.querySelector('.tp-kon__ok, .tp-kon__err')) card.classList.add('tp-kon__card--offen');
    t.addEventListener('click', function () {
      card.classList.add('tp-kon__card--offen');
      t.setAttribute('aria-expanded', 'true');
      var first = card.querySelector('input[type=text]');
      if (first) first.focus();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "TP Kontakt (3 Wege)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Eine Frage? Wir antworten persönlich." },
    { "type": "text", "id": "text", "label": "Unterzeile", "default": "Welcher Boden passt, wie viel Sie brauchen, ob wir bei Ihnen verlegen – fragen Sie einfach." },
    { "type": "text", "id": "telefon", "label": "Telefon", "default": "03301 573 37 20" },
    { "type": "text", "id": "zeiten", "label": "Zeiten", "default": "Mo–Fr 8:30–18:00, Sa 8:30–14:30 Uhr." },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp-Link (wa.me/…)" }
  ],
  "presets": [ { "name": "TP Kontakt (3 Wege)" } ]
}
{% endschema %}
