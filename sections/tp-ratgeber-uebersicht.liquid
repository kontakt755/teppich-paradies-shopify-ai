{% doc %}
  Hub-Seite des Ratgeber-/Wissensbereichs. Cluster-Bloecke (Titel, Kurztext,
  Linkliste per Menue-Handle) und Einstiegskacheln zu Muster, Verlegeservice
  und Aufmass. Belag-Umschalter nur, wenn mehr als ein Belag als Textliste
  gesetzt ist - Filterung selbst passiert clientseitig per data-Attribut,
  ohne dass ein leerer Umschalter irritiert, solange nur ein Belag existiert.
{% enddoc %}

{%- liquid
  assign tp_ru_belaege = section.settings.belaege | split: ','
  assign tp_ru_belaege_size = tp_ru_belaege.size
-%}

<div class="tp-ratgeber-uebersicht color-{{ section.settings.color_scheme }}">
  <div class="tp-ratgeber-uebersicht__rahmen page-width">

    <header class="tp-ratgeber-uebersicht__kopf">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tp-ratgeber-uebersicht__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="tp-ratgeber-uebersicht__titel">{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="tp-ratgeber-uebersicht__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- if tp_ru_belaege_size > 1 -%}
      <div class="tp-ratgeber-uebersicht__umschalter" role="tablist" aria-label="Belag waehlen" data-tp-ratgeber-belag-umschalter>
        <button type="button" class="tp-ratgeber-uebersicht__umschalter-punkt is-aktiv" role="tab" aria-selected="true" data-tp-ratgeber-belag="alle">
          Alle
        </button>
        {%- for tp_ru_belag in tp_ru_belaege -%}
          {%- assign tp_ru_belag = tp_ru_belag | strip -%}
          {%- if tp_ru_belag != blank -%}
            <button type="button" class="tp-ratgeber-uebersicht__umschalter-punkt" role="tab" aria-selected="false" data-tp-ratgeber-belag="{{ tp_ru_belag | handleize }}">
              {{ tp_ru_belag | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tp-ratgeber-uebersicht__cluster">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'cluster' -%}
              {%- assign tp_ru_menu = linklists[block.settings.menu] -%}
              <section class="tp-ratgeber-uebersicht__cluster-karte" {{ block.shopify_attributes }}>
                {%- if block.settings.titel != blank -%}
                  <h2 class="tp-ratgeber-uebersicht__cluster-titel">{{ block.settings.titel | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="tp-ratgeber-uebersicht__cluster-text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if tp_ru_menu.links.size > 0 -%}
                  <ul class="tp-ratgeber-uebersicht__cluster-liste">
                    {%- for tp_ru_link in tp_ru_menu.links -%}
                      <li><a href="{{ tp_ru_link.url }}">{{ tp_ru_link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </section>

            {%- when 'einstieg' -%}
              <a class="tp-ratgeber-uebersicht__einstieg" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
                <span class="tp-ratgeber-uebersicht__einstieg-titel">{{ block.settings.titel | escape }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="tp-ratgeber-uebersicht__einstieg-text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </a>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    'use strict';
    // Belag-Umschalter: filtert Cluster-Karten per data-tp-ratgeber-belag-tags.
    // Ohne passendes Attribut an den Karten bleibt "Alle" die einzige Wirkung -
    // gewollt, solange die Karten den Belag noch nicht als Tag tragen.
    var umschalter = document.querySelectorAll('[data-tp-ratgeber-belag-umschalter] [data-tp-ratgeber-belag]');
    if (!umschalter.length) { return; }

    umschalter.forEach(function (knopf) {
      knopf.addEventListener('click', function () {
        umschalter.forEach(function (anderer) {
          anderer.classList.remove('is-aktiv');
          anderer.setAttribute('aria-selected', 'false');
        });
        knopf.classList.add('is-aktiv');
        knopf.setAttribute('aria-selected', 'true');

        var gewaehlt = knopf.getAttribute('data-tp-ratgeber-belag');
        document.querySelectorAll('.tp-ratgeber-uebersicht__cluster-karte').forEach(function (karte) {
          var tags = karte.getAttribute('data-tp-ratgeber-belag-tags');
          var zeigen = gewaehlt === 'alle' || !tags || tags.split(',').indexOf(gewaehlt) !== -1;
          karte.hidden = !zeigen;
        });
      });
    });
  })();
</script>

{% stylesheet %}
  .tp-ratgeber-uebersicht {
    padding-block: 32px 56px;
  }

  .tp-ratgeber-uebersicht__rahmen {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .tp-ratgeber-uebersicht__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-60, currentColor);
  }

  .tp-ratgeber-uebersicht__titel {
    margin: 4px 0 0;
  }

  .tp-ratgeber-uebersicht__intro {
    max-width: 70ch;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .tp-ratgeber-uebersicht__umschalter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tp-ratgeber-uebersicht__umschalter-punkt {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-border, currentColor);
    background: transparent;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .tp-ratgeber-uebersicht__umschalter-punkt.is-aktiv {
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
  }

  .tp-ratgeber-uebersicht__cluster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .tp-ratgeber-uebersicht__cluster-karte {
    border: 1px solid var(--color-border, currentColor);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tp-ratgeber-uebersicht__cluster-titel {
    margin: 0;
    font-size: 1.1rem;
  }

  .tp-ratgeber-uebersicht__cluster-text {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .tp-ratgeber-uebersicht__cluster-liste {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.9rem;
  }

  .tp-ratgeber-uebersicht__einstieg {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    border: 1px dashed var(--color-border, currentColor);
    border-radius: 10px;
    padding: 16px 20px;
  }

  .tp-ratgeber-uebersicht__einstieg-titel {
    font-weight: 600;
  }

  .tp-ratgeber-uebersicht__einstieg-text {
    font-size: 0.85rem;
    opacity: 0.85;
  }

  @media screen and (min-width: 750px) {
    .tp-ratgeber-uebersicht__einstieg {
      grid-column: span 1;
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
