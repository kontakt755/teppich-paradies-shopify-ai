  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ratgeber"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Ueberschrift",
      "info": "Leer lassen nutzt den Seitentitel."
