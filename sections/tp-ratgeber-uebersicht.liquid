    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "cluster",
      "name": "Cluster",
      "settings": [
        {
          "type": "text",
          "id": "titel",
          "label": "Titel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Kurztext"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menue mit Artikel-Links"
        }
      ]
    },
    {
      "type": "einstieg",
      "name": "Einstiegskachel",
      "settings": [
        {
          "type": "text",
          "id": "titel",
          "label": "Titel"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Kurztext"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Ziel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP Ratgeber-Uebersicht",
      "blocks": [
        { "type": "cluster" },
        { "type": "cluster" },
        { "type": "einstieg", "settings": { "titel": "Musterbestellung", "link": "/pages/muster" } },
        { "type": "einstieg", "settings": { "titel": "Liefer- & Verlegeservice", "link": "/pages/liefer-verlegeservice" } }
      ]
    }
  ]
}
{% endschema %}
