{% comment %}
Final CTA Block – wiederverwendbare Section (für Theme Editor)
{% endcomment %}

<style>
  /* ============================= */
  /* ABSCHLUSS CTA */
  /* ============================= */

  .final-cta {
    background: #222;
    color: #fff;
    padding: 40px 20px;
    text-align: center;
  }

  .final-cta-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .final-cta h2 {
    font-size: 28px;
    margin: 0 0 12px;
    color: #fff;
  }

  .final-cta p {
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 28px;
    color: rgba(255,255,255,0.85);
  }

  .final-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .final-btn-primary,
  .final-btn-secondary,
  .final-btn-whatsapp {
    padding: 14px 24px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 16px;
    transition: all .2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .final-btn-primary {
    background: #fff;
    color: #000;
  }

  .final-btn-secondary {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.55);
  }

  .final-btn-whatsapp {
    background: #25D366;
    color: #fff;
    border: none;
  }

  .final-btn-primary:hover,
  .final-btn-secondary:hover,
  .final-btn-whatsapp:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .final-cta-phone {
    font-size: 15px;
    color: rgba(255,255,255,0.8);
  }

  .final-cta-phone a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .final-cta {
      padding: 30px 16px;
    }

    .final-cta h2 {
      font-size: 24px;
    }

    .final-cta p {
      font-size: 16px;
    }

    .final-cta-buttons a {
      width: 100%;
      max-width: 340px;
    }
  }
</style>

<section class="final-cta">
  <div class="final-cta-container">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>

    <div class="final-cta-buttons">
      <a href="{{ section.settings.primary_link }}" class="final-btn-primary">
        {{ section.settings.primary_label }}
      </a>

      <a href="tel:{{ section.settings.phone_number }}" class="final-btn-secondary">
        {{ section.settings.call_label }}
      </a>

      <a href="{{ section.settings.whatsapp_link }}" class="final-btn-whatsapp" target="_blank" rel="noopener">
        {{ section.settings.whatsapp_label }}
      </a>
    </div>

    <div class="final-cta-phone">
      {{ section.settings.phone_text }}
      <a href="tel:{{ section.settings.phone_number }}">{{ section.settings.phone_display }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Beratung gewünscht?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Wir begleiten Ihr Projekt von der Auswahl bis zur fachgerechten Ausführung – zuverlässig, termintreu und persönlich."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Button 1 Text",
      "default": "Angebot anfragen"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Telefon Button Text",
      "default": "Direkt anrufen"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp Button Text",
      "default": "WhatsApp schreiben"
    },
    {
      "type": "text",
      "id": "whatsapp_link",
      "label": "WhatsApp Link",
      "default": "https://wa.me/491792612211"
    },
    {
      "type": "text",
      "id": "phone_text",
      "label": "Text vor Telefonnummer",
      "default": "Oder telefonisch unter"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Telefonnummer (für tel:, ohne Leerzeichen)",
      "default": "+4933015733720"
    },
    {
      "type": "text",
      "id": "phone_display",
      "label": "Telefonnummer (Anzeige)",
      "default": "03301 / 573 37 20"
    }
  ],
  "presets": [
    {
      "name": "Final CTA",
      "category": "Custom"
    }
  ]
}
{% endschema %}
