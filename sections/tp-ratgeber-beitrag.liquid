{%- comment -%}
  TP Ratgeber-Artikel (Template article.ratgeber).

  Eine ruhige Lesespalte: Breadcrumb, Art-Label + H1, Kurzantwort, Fakten,
  Bild, Inhaltsverzeichnis, Text, Video (erst nach Klick geladen), danach -
  bewusst zurueckhaltend und nie im Einstieg - die Verkaufslinks.

  Alle Metafelder (Namespace ratgeber) sind optional. Ist eines leer, entfaellt
  der zugehoerige Baustein ersatzlos - es wird nichts erfunden.

  Preise werden hier NICHT gezeigt: die Preislogik des Shops (Euro je m2,
  Paketpreise, Sale-Regeln) lebt an der Produktkarte und wird nicht nachgebaut.

  Kommentare sind bewusst nicht eingebaut - ein Ratgeber ist kein Blog mit
  Diskussion; Fragen laufen ueber Kontakt und Beratung.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rg_mf = article.metafields.ratgeber
  assign rg_art = rg_mf.art.value | strip
  assign rg_kurz = rg_mf.kurzantwort.value | strip
  assign rg_dauer = rg_mf.dauer.value | strip
  assign rg_schwierigkeit = rg_mf.schwierigkeit.value | strip
  assign rg_personen = rg_mf.personen.value | strip
  assign rg_material = rg_mf.material.value
  assign rg_geprueft = rg_mf.geprueft_von.value | strip
  assign rg_stand = rg_mf.stand.value
  assign rg_produkte = rg_mf.produkte.value
  assign rg_cta = rg_mf.cta.value
  assign rg_kollektion = rg_mf.kollektion.value
  assign rg_zubehoer = rg_mf.zubehoer_kollektion.value
  assign rg_verwandte_kuratiert = rg_mf.verwandte.value
  assign rg_naechster_handle = rg_mf.naechster_schritt.value | strip

  # Aktualisiert nur zeigen, wenn es ein spaeterer TAG ist als die Veroeffentlichung
  assign rg_tag_pub = article.published_at | date: '%Y%m%d' | plus: 0
  assign rg_tag_upd = article.updated_at | date: '%Y%m%d' | plus: 0
  assign rg_aktualisiert = false
  if rg_tag_upd > rg_tag_pub
    assign rg_aktualisiert = true
  endif

  # Video: Art der Quelle bestimmen. Vor dem Klick geht KEINE Anfrage an den Anbieter.
  assign rg_video_url = rg_mf.video_url.value | strip
  assign rg_video_embed = ''
  assign rg_video_start = ''
  assign rg_video_datei = ''
  assign rg_video_anbieter = ''
  if rg_video_url != blank
    assign rg_video_pfad = rg_video_url | split: '?' | first | downcase
    assign rg_video_endung4 = rg_video_pfad | slice: -4, 4
    assign rg_video_endung5 = rg_video_pfad | slice: -5, 5
    assign rg_video_id = ''
    if rg_video_endung4 == '.mp4' or rg_video_endung5 == '.webm'
      assign rg_video_datei = rg_video_url
    elsif rg_video_url contains 'youtube.com/watch'
      assign rg_video_id = rg_video_url | split: 'v=' | last | split: '&' | first | split: '#' | first
      assign rg_video_anbieter = 'YouTube'
    elsif rg_video_url contains 'youtu.be/'
      assign rg_video_id = rg_video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first | split: '/' | first
      assign rg_video_anbieter = 'YouTube'
    elsif rg_video_url contains 'youtube.com/shorts/'
      assign rg_video_id = rg_video_url | split: 'shorts/' | last | split: '?' | first | split: '/' | first
      assign rg_video_anbieter = 'YouTube'
    elsif rg_video_url contains '/embed/'
      if rg_video_url contains 'youtube.com' or rg_video_url contains 'youtube-nocookie.com'
        assign rg_video_id = rg_video_url | split: '/embed/' | last | split: '?' | first | split: '/' | first
        assign rg_video_anbieter = 'YouTube'
      endif
    elsif rg_video_url contains 'vimeo.com/'
      assign rg_video_id = rg_video_url | split: 'vimeo.com/' | last | remove_first: 'video/' | split: '?' | first | split: '/' | first
      assign rg_video_anbieter = 'Vimeo'
    endif
    if rg_video_id != blank
      if rg_video_anbieter == 'YouTube'
        assign rg_video_embed = 'https://www.youtube-nocookie.com/embed/' | append: rg_video_id
        assign rg_video_start = rg_video_embed | append: '?autoplay=1&rel=0'
      else
        assign rg_video_embed = 'https://player.vimeo.com/video/' | append: rg_video_id
        assign rg_video_start = rg_video_embed | append: '?autoplay=1&dnt=1'
      endif
    endif
  endif
  assign rg_video_titel = rg_mf.video_titel.value | strip | default: article.title
  assign rg_video_text = rg_mf.video_beschreibung.value | strip
  assign rg_video_bild = rg_mf.video_vorschaubild.value
  assign rg_transkript = rg_mf.transkript.value | strip
-%}

{%- comment -%} Inhaltsverzeichnis und Text mit Sprungankern in einem Durchlauf (siehe Snippet) {%- endcomment -%}
{%- capture rg_roh -%}
  {%- render 'tp-ratgeber-inhalt', inhalt: article.content, ueberschrift: section.settings.inhalt_heading -%}
{%- endcapture -%}
{%- liquid
  assign rg_roh_teile = rg_roh | split: '<!--tp-rg-trenner-->'
  assign rg_toc = rg_roh_teile | first | strip
  assign rg_text = rg_roh_teile | last
  if rg_roh_teile.size < 2
    assign rg_toc = ''
    assign rg_text = article.content
  endif
-%}

{%- capture rg_material_html -%}
  {%- if rg_material != blank -%}
    <section class="tp-rg-material" aria-labelledby="tp-rg-material-titel">
      <h2 class="tp-rg-material__titel" id="tp-rg-material-titel">Material &amp; Werkzeug</h2>
      <ul class="tp-rg-material__liste">
        {%- for rg_posten in rg_material -%}
          {%- if rg_posten != blank -%}<li>{{ rg_posten | escape }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
{%- endcapture -%}

<article class="tp-rg-artikel">
  <div class="tp-s-wrap">
    <div class="tp-rg-spalte">
      {%- render 'tp-ratgeber-breadcrumb', blog: blog, artikel: article, modus: 'sichtbar' -%}

      <header class="tp-rg-kopf">
        {%- if rg_art != blank -%}
          <p class="tp-rg-kopf__art">{{ rg_art | escape }}</p>
        {%- endif -%}
        <h1 class="tp-rg-kopf__h1">{{ article.title | escape }}</h1>
        <p class="tp-rg-kopf__meta">
          <span>Veröffentlicht {{ article.published_at | time_tag: '%d.%m.%Y' }}</span>
          {%- if rg_aktualisiert -%}
            <span>Aktualisiert {{ article.updated_at | time_tag: '%d.%m.%Y' }}</span>
          {%- endif -%}
        </p>
        {%- if rg_geprueft != blank or rg_stand != blank -%}
          <p class="tp-rg-kopf__meta tp-rg-kopf__meta--pruefung">
            {%- if rg_geprueft != blank -%}<span>Fachlich geprüft von {{ rg_geprueft | escape }}</span>{%- endif -%}
            {%- if rg_stand != blank -%}<span>Stand {{ rg_stand | date: '%d.%m.%Y' }}</span>{%- endif -%}
          </p>
        {%- endif -%}
      </header>

      {%- if rg_kurz != blank -%}
        <div class="tp-rg-kurz" role="note" aria-labelledby="tp-rg-kurz-label">
          <p class="tp-rg-kurz__label" id="tp-rg-kurz-label">{{ section.settings.kurz_label | default: 'Kurz beantwortet' | escape }}</p>
          <p class="tp-rg-kurz__text">{{ rg_kurz | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}

      {%- if rg_dauer != blank or rg_schwierigkeit != blank or rg_personen != blank -%}
        <dl class="tp-rg-fakten">
          {%- if rg_dauer != blank -%}
            <div class="tp-rg-fakten__punkt"><dt>Dauer</dt><dd>{{ rg_dauer | escape }}</dd></div>
          {%- endif -%}
          {%- if rg_schwierigkeit != blank -%}
            <div class="tp-rg-fakten__punkt"><dt>Schwierigkeit</dt><dd>{{ rg_schwierigkeit | escape }}</dd></div>
          {%- endif -%}
          {%- if rg_personen != blank -%}
            <div class="tp-rg-fakten__punkt"><dt>Personen</dt><dd>{{ rg_personen | escape }}</dd></div>
          {%- endif -%}
        </dl>
      {%- endif -%}

      {%- comment -%} Material steht bei Anleitungen direkt vor dem Text, sonst gleich nach den Fakten {%- endcomment -%}
      {%- if rg_art != 'Anleitung' -%}{{ rg_material_html }}{%- endif -%}

      {%- if article.image -%}
        {%- assign rg_bild_alt = article.image.alt | default: article.title -%}
        <figure class="tp-rg-bild">
          {{-
            article.image
            | image_url: width: 1520
            | image_tag:
              alt: rg_bild_alt,
              class: 'tp-rg-bild__img',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 760, 1080, 1520',
              sizes: '(min-width: 808px) 760px, 100vw'
          -}}
        </figure>
      {%- endif -%}

      {{ rg_toc }}

      {%- if rg_art == 'Anleitung' -%}{{ rg_material_html }}{%- endif -%}

      <div class="tp-rg-body">
        {{ rg_text }}
      </div>

      {%- if rg_video_datei != blank or rg_video_embed != blank -%}
        <section class="tp-rg-video" aria-labelledby="tp-rg-video-titel">
          <h2 class="tp-rg-video__titel" id="tp-rg-video-titel">{{ rg_video_titel | escape }}</h2>
          {%- if rg_video_text != blank -%}
            <p class="tp-rg-video__text">{{ rg_video_text | escape | newline_to_br }}</p>
          {%- endif -%}

          {%- if rg_video_datei != blank -%}
            <video
              class="tp-rg-video__player"
              controls
              playsinline
              preload="none"
              {% if rg_video_bild != blank %}poster="{{ rg_video_bild | image_url: width: 1520 }}"{% endif %}
            >
              <source src="{{ rg_video_datei }}">
              <a href="{{ rg_video_datei }}">Video ansehen</a>
            </video>
          {%- else -%}
            {%- comment -%}
              Fassade: eigenes Vorschaubild + Link. Ohne JavaScript oeffnet der Link das
              Video beim Anbieter; mit JavaScript ersetzt der Klick die Fassade durch den
              Player. Erst dann entsteht eine Verbindung zum Anbieter.
            {%- endcomment -%}
            <div class="tp-rg-video__rahmen">
              <a
                class="tp-rg-video__start"
                href="{{ rg_video_url }}"
                target="_blank"
                rel="noopener"
                data-tp-rg-video-src="{{ rg_video_start }}"
                data-tp-rg-video-titel="{{ rg_video_titel | escape }}"
                aria-label="Video abspielen: {{ rg_video_titel | escape }}"
              >
                {%- if rg_video_bild != blank -%}
                  {%- assign rg_video_alt = rg_video_bild.alt | default: rg_video_titel -%}
                  {{-
                    rg_video_bild
                    | image_url: width: 1520
                    | image_tag:
                      alt: rg_video_alt,
                      class: 'tp-rg-video__bild',
                      loading: 'lazy',
                      widths: '480, 760, 1080, 1520',
                      sizes: '(min-width: 808px) 760px, 100vw'
                  -}}
                {%- endif -%}
                <span class="tp-rg-video__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
                </span>
              </a>
            </div>
            <p class="tp-rg-video__hinweis">
              Das Video wird erst nach Ihrem Klick von {{ rg_video_anbieter }} geladen. Dabei werden Daten an {{ rg_video_anbieter }} übertragen.
            </p>
          {%- endif -%}

          {%- if rg_transkript != blank -%}
            <details class="tp-rg-video__transkript">
              <summary>Transkript anzeigen</summary>
              <div class="tp-rg-video__transkript-text">{{ rg_transkript | escape | newline_to_br }}</div>
            </details>
          {%- endif -%}
        </section>
      {%- elsif rg_video_url != blank -%}
        {%- comment -%} Unbekannte Videoquelle: nichts einbetten, nur verlinken {%- endcomment -%}
        <p class="tp-rg-video__text"><a href="{{ rg_video_url }}" target="_blank" rel="noopener">{{ rg_video_titel | escape }} (Video, öffnet in neuem Tab)</a></p>
      {%- endif -%}
    </div>

    {%- comment -%}
      Passend dazu: je Wert in ratgeber.cta eine kompakte Karte, danach bis zu
      vier Produkte. data-tp-rg-cta ist der Haken fuer die Klickmessung.
    {%- endcomment -%}
    {%- capture rg_cta_html -%}
      {%- for rg_cta_wert in rg_cta -%}
        {%- liquid
          assign rg_cta_typ = rg_cta_wert | strip | downcase
          assign rg_cta_titel = ''
          assign rg_cta_text = ''
          assign rg_cta_link = ''
          case rg_cta_typ
            when 'rechner'
              assign rg_cta_titel = section.settings.rechner_titel
              assign rg_cta_text = section.settings.rechner_text
              assign rg_cta_link = rg_kollektion.url | default: section.settings.rechner_link | default: '/collections/teppichboden'
            when 'muster'
              assign rg_cta_titel = section.settings.muster_titel
              assign rg_cta_text = section.settings.muster_text
              assign rg_cta_link = section.settings.muster_link | default: '/pages/muster'
            when 'verlegeservice'
              assign rg_cta_titel = section.settings.verlege_titel
              assign rg_cta_text = section.settings.verlege_text
              assign rg_cta_link = section.settings.verlege_link | default: '/pages/liefer-verlegeservice'
            when 'zubehoer'
              assign rg_cta_titel = section.settings.zubehoer_titel
              assign rg_cta_text = section.settings.zubehoer_text
              assign rg_cta_link = rg_zubehoer.url | default: section.settings.zubehoer_link | default: '/collections/zubehoer'
          endcase
        -%}
        {%- if rg_cta_titel != blank and rg_cta_link != blank -%}
          <li class="tp-rg-cta" data-tp-rg-cta="{{ rg_cta_typ }}">
            <a class="tp-rg-cta__link" href="{{ rg_cta_link }}">
              <span class="tp-rg-cta__titel">{{ rg_cta_titel | escape }}</span>
              {%- if rg_cta_text != blank -%}
                <span class="tp-rg-cta__text">{{ rg_cta_text | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture rg_produkte_html -%}
      {%- for rg_produkt in rg_produkte limit: 4 -%}
        {%- if rg_produkt == blank or rg_produkt.url == blank -%}{%- continue -%}{%- endif -%}
        <li class="tp-rg-produkt" data-tp-rg-cta="produkt">
          <a class="tp-rg-produkt__link" href="{{ rg_produkt.url }}">
            <span class="tp-rg-produkt__bild">
              {%- if rg_produkt.featured_image -%}
                {%- assign rg_produkt_alt = rg_produkt.featured_image.alt | default: rg_produkt.title -%}
                {{-
                  rg_produkt.featured_image
                  | image_url: width: 600
                  | image_tag:
                    alt: rg_produkt_alt,
                    class: 'tp-rg-produkt__img',
                    loading: 'lazy',
                    widths: '200, 300, 450, 600',
                    sizes: '(min-width: 768px) 240px, 44vw'
                -}}
              {%- endif -%}
            </span>
            <span class="tp-rg-produkt__titel">{{ rg_produkt.title | escape }}</span>
            <span class="tp-rg-produkt__mehr">Zum Produkt</span>
          </a>
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- liquid
      assign rg_cta_html = rg_cta_html | strip
      assign rg_produkte_html = rg_produkte_html | strip
    -%}
    {%- if rg_cta_html != blank or rg_produkte_html != blank -%}
      <section class="tp-rg-passend tp-rg-breit" aria-labelledby="tp-rg-passend-titel">
        <h2 class="tp-rg-abschnitt__titel" id="tp-rg-passend-titel">{{ section.settings.passend_heading | default: 'Passend dazu' | escape }}</h2>
        {%- if rg_cta_html != blank -%}
          <ul class="tp-rg-passend__cta">{{ rg_cta_html }}</ul>
        {%- endif -%}
        {%- if rg_produkte_html != blank -%}
          <ul class="tp-rg-passend__produkte">{{ rg_produkte_html }}</ul>
        {%- endif -%}
      </section>
    {%- endif -%}

    {%- comment -%}
      Naechster Schritt: kuratierter, hervorgehobener Verweis vor den verwandten
      Beitraegen. Erscheint nur, wenn ratgeber.naechster_schritt auf einen Artikel
      desselben Blogs aufloest - unabhaengig davon, ob die Liste darunter an ist.
    {%- endcomment -%}
    {%- liquid
      assign rg_naechster_artikel = blank
      if rg_naechster_handle != blank
        for rg_naechster_kandidat in blog.articles
          # article.handle ist "<blog>/<artikel>" - siehe sections/tp-bodenprobleme.liquid
          assign rg_naechster_kandidat_handle = rg_naechster_kandidat.handle | split: '/' | last
          if rg_naechster_kandidat_handle == rg_naechster_handle and rg_naechster_kandidat.id != article.id
            assign rg_naechster_artikel = rg_naechster_kandidat
            break
          endif
        endfor
      endif
    -%}
    {%- if rg_naechster_artikel != blank -%}
      <section class="tp-rg-naechster tp-rg-breit" aria-labelledby="tp-rg-naechster-titel">
        <h2 class="tp-rg-abschnitt__titel" id="tp-rg-naechster-titel">{{ section.settings.naechster_heading | default: 'Als Nächstes' | escape }}</h2>
        <a class="tp-rg-naechster__karte" href="{{ rg_naechster_artikel.url }}">
          <span class="tp-rg-naechster__titel">{{ rg_naechster_artikel.title | escape }}</span>
          {%- assign rg_naechster_auszug = rg_naechster_artikel.excerpt | strip_html | strip -%}
          {%- if rg_naechster_auszug != blank -%}
            <span class="tp-rg-naechster__text">{{ rg_naechster_auszug | truncate: 140 }}</span>
          {%- endif -%}
          <span class="tp-rg-naechster__pfeil" aria-hidden="true">&#8594;</span>
        </a>
      </section>
    {%- endif -%}

    {%- comment -%}
      Verwandte Beitraege: die kuratierte Liste (ratgeber.verwandte) hat Vorrang,
      in genau der hinterlegten Reihenfolge, aufgeloest ueber die Artikel
      desselben Blogs. Handles ohne Treffer werden still uebersprungen, der
      Naechster-Schritt-Artikel taucht hier nicht noch einmal auf. Ist das
      Metafeld leer oder ergibt es keinen Treffer, greift die bisherige
      Tag-Ableitung: zuerst Artikel desselben Blogs mit gemeinsamem Tag, dann mit
      den neuesten auffuellen. Betrachtet werden die 50 neuesten Artikel des
      Blogs - das reicht fuer drei Empfehlungen.
    {%- endcomment -%}
    {%- if section.settings.verwandte_anzeigen -%}
      {%- liquid
        assign rg_v_ids = ','
        assign rg_v_zahl = 0
      -%}
      {%- capture rg_v_html -%}
        {%- for rg_v_handle in rg_verwandte_kuratiert -%}
          {%- if rg_v_zahl >= 3 -%}{%- break -%}{%- endif -%}
          {%- assign rg_v_handle = rg_v_handle | strip -%}
          {%- if rg_v_handle == blank -%}{%- continue -%}{%- endif -%}
          {%- assign rg_v_kandidat = blank -%}
          {%- for rg_v_probe_artikel in blog.articles -%}
            {%- assign rg_v_probe_handle = rg_v_probe_artikel.handle | split: '/' | last -%}
            {%- if rg_v_probe_handle == rg_v_handle -%}
              {%- assign rg_v_kandidat = rg_v_probe_artikel -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if rg_v_kandidat == blank or rg_v_kandidat.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if rg_naechster_artikel != blank and rg_v_kandidat.id == rg_naechster_artikel.id -%}{%- continue -%}{%- endif -%}
          {%- assign rg_v_probe = ',' | append: rg_v_kandidat.id | append: ',' -%}
          {%- if rg_v_ids contains rg_v_probe -%}{%- continue -%}{%- endif -%}
          {%- assign rg_v_ids = rg_v_ids | append: rg_v_kandidat.id | append: ',' -%}
          {%- assign rg_v_zahl = rg_v_zahl | plus: 1 -%}
          <li>{%- render 'tp-ratgeber-karte', artikel: rg_v_kandidat -%}</li>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if rg_v_zahl == 0 -%}
        {%- comment -%} Rueckfall: bisherige Tag-Ableitung, Logik unveraendert. {%- endcomment -%}
        {%- liquid
          assign rg_v_ids = ','
          assign rg_v_zahl = 0
        -%}
        {%- capture rg_v_html -%}
          {%- for rg_kandidat in blog.articles -%}
            {%- if rg_v_zahl >= 3 -%}{%- break -%}{%- endif -%}
            {%- if rg_kandidat.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- if rg_naechster_artikel != blank and rg_kandidat.id == rg_naechster_artikel.id -%}{%- continue -%}{%- endif -%}
            {%- assign rg_v_treffer = false -%}
            {%- for rg_v_tag in article.tags -%}
              {%- if rg_kandidat.tags contains rg_v_tag -%}
                {%- assign rg_v_treffer = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if rg_v_treffer -%}
              {%- assign rg_v_ids = rg_v_ids | append: rg_kandidat.id | append: ',' -%}
              {%- assign rg_v_zahl = rg_v_zahl | plus: 1 -%}
              <li>{%- render 'tp-ratgeber-karte', artikel: rg_kandidat -%}</li>
            {%- endif -%}
          {%- endfor -%}
          {%- if rg_v_zahl < 3 -%}
            {%- for rg_kandidat in blog.articles -%}
              {%- if rg_v_zahl >= 3 -%}{%- break -%}{%- endif -%}
              {%- if rg_kandidat.id == article.id -%}{%- continue -%}{%- endif -%}
              {%- if rg_naechster_artikel != blank and rg_kandidat.id == rg_naechster_artikel.id -%}{%- continue -%}{%- endif -%}
              {%- assign rg_v_probe = ',' | append: rg_kandidat.id | append: ',' -%}
              {%- if rg_v_ids contains rg_v_probe -%}{%- continue -%}{%- endif -%}
              {%- assign rg_v_zahl = rg_v_zahl | plus: 1 -%}
              <li>{%- render 'tp-ratgeber-karte', artikel: rg_kandidat -%}</li>
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}
      {%- endif -%}

      {%- if rg_v_zahl > 0 -%}
        <section class="tp-rg-verwandt tp-rg-breit" aria-labelledby="tp-rg-verwandt-titel">
          <div class="tp-rg-verwandt__kopf">
            <h2 class="tp-rg-abschnitt__titel" id="tp-rg-verwandt-titel">{{ section.settings.verwandte_heading | default: 'Weitere Beiträge' | escape }}</h2>
            <a class="tp-s-link" href="{{ blog.url }}">Alle Beiträge: {{ blog.title | escape }}</a>
          </div>
          <ul class="tp-rg-verwandt__raster">{{ rg_v_html }}</ul>
        </section>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.firma_anzeigen -%}
      {%- liquid
        assign rg_firma_link = section.settings.firma_link | default: pages['uber-uns'].url
      -%}
      <aside class="tp-rg-firma tp-rg-spalte" aria-labelledby="tp-rg-firma-titel">
        {%- if section.settings.firma_bild != blank -%}
          {%- assign rg_firma_alt = section.settings.firma_bild.alt | default: section.settings.firma_heading -%}
          {{-
            section.settings.firma_bild
            | image_url: width: 320
            | image_tag:
              alt: rg_firma_alt,
              class: 'tp-rg-firma__bild',
              loading: 'lazy',
              widths: '160, 320',
              sizes: '96px'
          -}}
        {%- endif -%}
        <div class="tp-rg-firma__text">
          <h2 class="tp-rg-firma__titel" id="tp-rg-firma-titel">{{ section.settings.firma_heading | escape }}</h2>
          <div class="tp-rg-firma__rte">{{ section.settings.firma_text }}</div>
          {%- if rg_firma_link != blank and section.settings.firma_link_text != blank -%}
            <a class="tp-s-link" href="{{ rg_firma_link }}">{{ section.settings.firma_link_text | escape }}</a>
          {%- endif -%}
        </div>
      </aside>
    {%- endif -%}

    {%- if section.settings.newsletter_anzeigen -%}
      <div class="tp-rg-newsletter tp-rg-spalte">
        {%- render 'tp-newsletter', quelle: 'ratgeber', text: '15 € Rabatt auf Ihre erste Bestellung ab 100 € – dazu 4 statt 3 Muster gratis.', button: 'Gutschein sichern' -%}
      </div>
    {%- endif -%}
  </div>
</article>

{%- render 'tp-ratgeber-structured-data', artikel: article, blog: blog, video_embed: rg_video_embed, video_datei: rg_video_datei -%}

{%- if rg_video_embed != blank -%}
  <script>
    (function () {
      if (window.tpRgVideoBereit) return;
      window.tpRgVideoBereit = true;
      document.addEventListener('click', function (ereignis) {
        var start = ereignis.target.closest('[data-tp-rg-video-src]');
        if (!start) return;
        ereignis.preventDefault();
        var rahmen = document.createElement('iframe');
        rahmen.src = start.getAttribute('data-tp-rg-video-src');
        rahmen.title = start.getAttribute('data-tp-rg-video-titel') || 'Video';
        rahmen.className = 'tp-rg-video__iframe';
        rahmen.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
        rahmen.setAttribute('allowfullscreen', '');
        start.parentNode.replaceChild(rahmen, start);
        rahmen.focus();
      });
    })();
  </script>
{%- endif -%}

