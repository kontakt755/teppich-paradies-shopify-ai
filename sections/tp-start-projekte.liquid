{{ 'tp-start-abschnitte.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  TP Echte Arbeiten: ein grosses Bild plus vier kleine aus echten Projektfotos,
  jedes mit Bildunterschrift (Objekt, Belag). Keine Stockfotos.
{%- endcomment -%}

<section class="tp-s-sec tp-proj" id="tp-arbeiten" aria-labelledby="tp-proj-h2">
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="tp-s-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 id="tp-proj-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tp-proj__grid">
      {%- for block in section.blocks limit: 5 -%}
        <a class="tp-proj__item" href="{{ block.settings.link | default: section.settings.link | default: '/pages/unsere-arbeit' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.bild != blank -%}
            {%- assign proj_alt = block.settings.bild.alt | default: block.settings.objekt -%}
          {%- if forloop.first -%}
              {{ block.settings.bild | image_url: width: 1400 | image_tag: loading: 'lazy', fetchpriority: 'low', widths: '600, 900, 1400', sizes: '(max-width: 767px) 100vw, 50vw', alt: proj_alt, class: 'tp-proj__img' }}
            {%- else -%}
              {{ block.settings.bild | image_url: width: 800 | image_tag: loading: 'lazy', fetchpriority: 'low', widths: '400, 600, 800', sizes: '(max-width: 767px) 50vw, 25vw', alt: proj_alt, class: 'tp-proj__img' }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'tp-proj__img' }}
          {%- endif -%}
          {%- if block.settings.objekt != blank -%}
            <span class="tp-proj__cap"><b>{{ block.settings.objekt | escape }}</b>{% if block.settings.belag != blank %} · {{ block.settings.belag | escape }}{% endif %}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <div class="tp-proj__ctas">
      {%- if section.settings.link_label != blank -%}<a class="tp-s-btn tp-s-btn--dark" href="{{ section.settings.link | default: '/pages/unsere-arbeit' }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
      {%- if section.settings.treppen_label != blank -%}<a class="tp-s-btn tp-s-btn--ghost" href="{{ section.settings.treppen_link | default: '/pages/unsere-arbeit?kategorie=treppen' }}">{{ section.settings.treppen_label | escape }}</a>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="tp-s-btn tp-s-btn--ghost" href="{{ section.settings.cta_link | default: '/pages/kontakt' }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TP Echte Arbeiten",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Von uns verlegt" },
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Echte Arbeiten aus Oranienburg, Berlin und Brandenburg" },
    { "type": "text", "id": "text", "label": "Unterzeile", "default": "Treppen, Wohnräume, Gastronomie, Läden und Kirchen – alles echte Baustellen unseres Teams, keine Stockfotos." },
    { "type": "text", "id": "link_label", "label": "Link zur Galerie", "default": "Mehr Arbeiten ansehen" },
    { "type": "url", "id": "link", "label": "Galerie-Seite" },
    { "type": "text", "id": "treppen_label", "label": "Zweiter Link (Treppen)", "default": "Unsere Treppenarbeiten ansehen" },
    { "type": "url", "id": "treppen_link", "label": "Ziel Treppen", "info": "Leer lassen fuer die Galerie mit dem Filter Treppen." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Verlegung anfragen" },
    { "type": "url", "id": "cta_link", "label": "Button-Ziel" }
  ],
  "blocks": [
    {
      "type": "projekt",
      "name": "Projektfoto",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Foto" },
        { "type": "text", "id": "objekt", "label": "Objekt", "default": "Treppe" },
        { "type": "text", "id": "belag", "label": "Belag", "default": "Teppichboden" },
        { "type": "url", "id": "link", "label": "Ziel (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "TP Echte Arbeiten" } ]
}
{% endschema %}
