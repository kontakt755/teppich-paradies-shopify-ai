{%- comment -%}
  TP So geht's (Startseiten-Umbau C, Shopvergleich 2026-10-15, w-096): drei
  Schritte mit je einem vorhandenen Bild - Muster, Mass, Lieferung oder
  Verlegung. Ersetzt auf der Startseite "Zwei Wege" (tp-zwei-wege) und den
  Musterservice (tp-start-muster), damit jede Botschaft nur einmal steht.
  Darunter optional die PLZ-Pruefung fuers Verlegegebiet - dieselbe Logik wie
  in tp-zwei-wege (assets/tp-verlegegebiet.js liest data-radius und data-orte
  vom naechsten Vorfahren mit data-radius).
  [versandfrei] im Schritttext wird durch die Theme-Einstellung ersetzt.
  Nummern dunkel: Rot bleibt Preis, Rabatt und Hauptknopf vorbehalten.
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

<section class="tp-s-sec tp-sg" id="tp-so-gehts" aria-labelledby="tp-sg-h2">
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head">
      <div>
        <h2 id="tp-sg-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <ol class="tp-sg__liste">
      {%- for block in section.blocks limit: 4 -%}
        {%- assign sg_alt = block.settings.bild.alt | default: block.settings.bild_alt -%}
        <li class="tp-sg__schritt" {{ block.shopify_attributes }}>
          <div class="tp-sg__bild">
            {%- if block.settings.bild != blank -%}
              {{ block.settings.bild | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(max-width: 767px) 36vw, (max-width: 991px) 38vw, (min-width: 1280px) 400px, 32vw', alt: sg_alt, class: 'tp-sg__img', style: block.settings.fokus }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'tp-sg__img' }}
            {%- endif -%}
          </div>
          <div class="tp-sg__text">
            <div class="tp-sg__kopf">
              <span class="tp-sg__nr" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="tp-sg__titel">{{ block.settings.titel | escape }}</h3>
            </div>
            {%- if block.settings.text != blank -%}
              <div class="tp-sg__beschreibung">{{ block.settings.text | replace: '[versandfrei]', settings.tp_versand_frei_ab }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="tp-sg__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.plz_pruefung -%}
      {{ 'tp-verlegegebiet.css' | asset_url | stylesheet_tag }}
      <div
        class="tp-sg__plz"
        data-radius="{{ settings.tp_vs_radius_premium | default: 50 }}"
        data-versand-frei-ab="{{ settings.tp_versand_frei_ab }}"
        data-orte="{{ 'tp-verlegegebiet-orte.json' | asset_url }}"
      >
        <form
          class="tp-vg__check"
          data-tp-verlegegebiet-form
          data-cta-url="{{ section.settings.service_link | default: '/pages/liefer-verlegeservice' }}"
          data-cta-text="{{ section.settings.service_cta | escape }}"
          data-versand-url="/collections/all"
          data-versand-text="Online bestellen – Versand deutschlandweit"
          hidden
        >
          <label class="tp-vg__sub" for="tp-sg-plz-{{ section.id }}">Liegt Ihr Wohnort in unserem Verlegegebiet?</label>
          <div class="tp-vg__check-zeile">
            <input id="tp-sg-plz-{{ section.id }}" class="tp-vg__input" type="text" name="ort" inputmode="text" autocomplete="postal-code" maxlength="40" placeholder="PLZ oder Ort" data-tp-verlegegebiet-input>
            <button class="tp-vg__btn tp-vg__btn--check" type="submit">Prüfen</button>
          </div>
          <div class="tp-vg__ergebnis-box" role="status" aria-live="polite">
            <p class="tp-vg__ergebnis" data-tp-verlegegebiet-result></p>
            <p class="tp-vg__ergebnis-weg" data-tp-verlegegebiet-cta hidden></p>
          </div>
        </form>
      </div>
      <script src="{{ 'tp-verlegegebiet.js' | asset_url }}" defer></script>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .tp-sg__liste { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .tp-sg__schritt { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--tp-line, #e6e0d8); border-radius: 14px; background: #fff; }
  /* Bild absolut: sonst setzt ein Hochformatfoto als Flex-Kind seine eigene
     Hoehe durch (min-height: auto) und die Karte wird doppelt so hoch. */
  .tp-sg__bild { position: relative; min-height: 0; overflow: hidden; aspect-ratio: 4 / 3; background: #ede7de; }
  .tp-sg__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tp-sg__text { display: flex; flex: 1; flex-direction: column; gap: 8px; padding: 18px 20px 14px; }
  .tp-sg__kopf { display: flex; align-items: center; gap: 10px; }
  .tp-sg__nr { display: inline-flex; flex: 0 0 28px; align-items: center; justify-content: center; height: 28px; border-radius: 50%; background: var(--tp-ink, #1d1a17); color: #fff; font-size: 14px; font-weight: 700; }
  .tp-sg__titel { margin: 0; font-size: 19px; font-weight: 700; line-height: 1.2; color: var(--tp-ink, #1d1a17); }
  .tp-sg__beschreibung { font-size: 15.5px; line-height: 1.5; color: var(--tp-ink-2, #4a443f); }
  .tp-sg__beschreibung p { margin: 0; }
  .tp-sg__link { display: inline-flex; align-items: center; align-self: flex-start; min-height: 44px; margin-top: auto; font-weight: 600; color: var(--tp-ink, #1d1a17); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
  .tp-sg__plz { margin-top: 20px; }
  .tp-sg__plz .tp-vg__check { max-width: 560px; }
  /* Unter 992 px: Bild links, Text rechts - drei flache Karten statt drei hoher. */
  @media (max-width: 991px) {
    .tp-sg__liste { grid-template-columns: 1fr; gap: 12px; }
    .tp-sg__schritt { flex-direction: row; }
    .tp-sg__bild { flex: 0 0 38%; aspect-ratio: auto; min-height: 150px; }
  }
  @media (max-width: 767px) {
    .tp-sg__bild { flex-basis: 36%; min-height: 0; }
    .tp-sg__text { gap: 6px; padding: 12px 14px 6px; }
    .tp-sg__kopf { gap: 8px; }
    .tp-sg__nr { flex-basis: 24px; height: 24px; font-size: 13px; }
    .tp-sg__titel { font-size: 16.5px; }
    .tp-sg__beschreibung { font-size: 14.5px; line-height: 1.45; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP So geht's",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "So geht's" },
    { "type": "text", "id": "text", "label": "Unterzeile" },
    { "type": "checkbox", "id": "plz_pruefung", "label": "PLZ-Pruefung Verlegegebiet darunter", "default": true },
    { "type": "url", "id": "service_link", "label": "Ziel nach erfolgreicher PLZ-Pruefung" },
    { "type": "text", "id": "service_cta", "label": "Linktext nach erfolgreicher PLZ-Pruefung", "default": "Verlegung anfragen" }
  ],
  "blocks": [
    {
      "type": "schritt",
      "name": "Schritt",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Bild (vorhandenes Foto)" },
        { "type": "text", "id": "bild_alt", "label": "Bildbeschreibung (Alt-Text)", "info": "Gilt, wenn das Bild in Shopify keinen Alt-Text hat." },
        {
          "type": "select",
          "id": "fokus",
          "label": "Bildausschnitt",
          "options": [
            { "value": "object-position: 50% 50%", "label": "Mitte" },
            { "value": "object-position: 50% 20%", "label": "Oben" },
            { "value": "object-position: 50% 80%", "label": "Unten" }
          ],
          "default": "object-position: 50% 50%"
        },
        { "type": "text", "id": "titel", "label": "Titel", "default": "Muster bestellen" },
        { "type": "richtext", "id": "text", "label": "Text", "info": "[versandfrei] wird durch den Wert aus den Theme-Einstellungen ersetzt." },
        { "type": "text", "id": "link_label", "label": "Linktext" },
        { "type": "url", "id": "link", "label": "Link-Ziel" }
      ]
    }
  ],
  "presets": [ { "name": "TP So geht's" } ]
}
{% endschema %}
