{{ 'tp-boden-kategorie.css' | asset_url | stylesheet_tag }}

<section class="tp-bk-guide" aria-labelledby="tp-bk-guide-title-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="tp-bk-guide__inner">
    <div class="tp-bk-guide__header">
      <p class="tp-bk-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="tp-bk-guide-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}
        <div class="tp-bk-guide__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <div class="tp-bk-guide__cards">
      {%- assign tp_bk_card_number = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tip' -%}
          {%- assign tp_bk_card_number = tp_bk_card_number | plus: 1 -%}
          <article class="tp-bk-guide__card" {{ block.shopify_attributes }}>
            <span class="tp-bk-guide__number" aria-hidden="true">0{{ tp_bk_card_number }}</span>
            <h3>{{ block.settings.heading | escape }}</h3>
            <div class="rte">{{ block.settings.body }}</div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign tp_bk_faq_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}{%- assign tp_bk_faq_count = tp_bk_faq_count | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if tp_bk_faq_count > 0 -%}
      <div class="tp-bk-guide__faq">
        <h3>{{ section.settings.faq_heading | escape }}</h3>
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}</summary>
              <div class="tp-bk-guide__answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.contact_text != blank and section.settings.contact_link != blank -%}
      <div class="tp-bk-guide__contact">
        <p>{{ section.settings.contact_text | escape }}</p>
        <a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }} <span aria-hidden="true">→</span></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Boden Kategorie Ratgeber",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Oberzeile", "default": "Gut zu wissen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Den passenden Boden finden" },
    { "type": "richtext", "id": "intro", "label": "Einleitung" },
    { "type": "text", "id": "faq_heading", "label": "FAQ Überschrift", "default": "Häufige Fragen" },
    { "type": "text", "id": "contact_text", "label": "Kontakttext", "default": "Noch unsicher, welcher Boden passt?" },
    { "type": "text", "id": "contact_label", "label": "Kontakt-Button", "default": "Persönlich beraten lassen" },
    { "type": "url", "id": "contact_link", "label": "Kontaktlink" }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Auswahlhilfe",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel" },
        { "type": "richtext", "id": "body", "label": "Text" }
      ]
    },
    {
      "type": "faq",
      "name": "Frage",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "question", "label": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort" }
      ]
    }
  ],
  "presets": [{ "name": "Boden Kategorie Ratgeber" }]
}
{% endschema %}
