{% assign hero_id = section.id | replace: '_', '' | downcase %}
{% assign hero_image_class = 'hero-feature-split__image-' | append: hero_id %}

{% liquid
  # Only treat this hero as above the fold when it's actually near the top
  # of the page. Later hero_split instances fall back to lazy/auto so they
  # don't compete with the real LCP image for bandwidth and priority.
  assign hero_fetch_priority = 'auto'
  assign hero_loading = 'lazy'
  if section.index == 1
    assign hero_fetch_priority = 'high'
  endif
  if section.index <= 2
    assign hero_loading = 'eager'
  endif
%}

{% style %}
  .hero-feature-split-{{ hero_id }} {
    --hero-content-width: {{ section.settings.content_width }}px;
    --hero-gap: {{ section.settings.column_gap }}px;
    --hero-radius: {{ section.settings.image_radius }}px;
    --hero-accent: {{ section.settings.accent_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-muted: {{ section.settings.muted_color }};
    --hero-background: {{ section.settings.background_color }};
    background: var(--hero-background);
    color: var(--hero-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .hero-feature-split__inner-{{ hero_id }} {
    max-width: var(--hero-content-width);
    margin: 0 auto;
    padding: 0 auto;
  }

  .hero-feature-split__grid-{{ hero_id }} {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .hero-feature-split__media-{{ hero_id }} {
    order: 1;
  }

  .hero-feature-split__image-wrap-{{ hero_id }} {
    overflow: hidden;
    /* border-radius: var(--hero-radius); */
    background: transparent;
  }

  .hero-feature-split__image-{{ hero_id }} {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-feature-split__content-{{ hero_id }} {
    order: 2;
    max-width: 520px;
  }

  .hero-feature-split__heading-{{ hero_id }} {
    margin: 0 0 14px;
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 0.96;
    letter-spacing: 0;
    font-weight: 700;
  }

  .hero-feature-split__subheading-{{ hero_id }} {
    margin: 0 0 18px;
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--hero-accent);
  }

  .hero-feature-split__body-{{ hero_id }} {
    margin: 0;
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.52;
    color: var(--hero-text);
  }

  .hero-feature-split__features-{{ hero_id }} {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .hero-feature-split__feature-{{ hero_id }} {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  .hero-feature-split__marker-{{ hero_id }} {
    width: 32px;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hero-accent);
    flex-shrink: 0;
  }

  .hero-feature-split__emoji-{{ hero_id }} {
    font-size: 28px;
    line-height: 1;
  }

  .hero-feature-split__dot-{{ hero_id }} {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: currentColor;
  }

  .hero-feature-split__feature-text-{{ hero_id }} {
    margin: 0;
    font-size: {{ section.settings.feature_size }}px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--hero-text);
  }

  .hero-feature-split__placeholder-{{ hero_id }} {
    aspect-ratio: 1.3 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hero-muted);
    background: rgba(0, 0, 0, 0.04);
  }

  @media screen and (min-width: 450px) {
    .hero-feature-split__inner-{{ hero_id }} {
      padding: 0 24px;
    }
    .hero-feature-split__grid-{{ hero_id }} {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.28fr);
      gap: var(--hero-gap);
    }

    .hero-feature-split__content-{{ hero_id }} {
      order: 1;
    }

    .hero-feature-split__media-{{ hero_id }} {
      order: 2;
    }

    .hero-feature-split__heading-{{ hero_id }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }
{% endstyle %}

<section class="hero-feature-split-{{ hero_id }}" {{ section.shopify_attributes }}>
  <div class="hero-feature-split__inner-{{ hero_id }}">
    <div class="hero-feature-split__grid-{{ hero_id }}">
      <div class="hero-feature-split__media-{{ hero_id }}">
        <div class="hero-feature-split__image-wrap-{{ hero_id }}">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag:
                class: hero_image_class,
                widths: '600, 900, 1200, 1500, 1800',
                loading: hero_loading,
                fetchpriority: hero_fetch_priority,
                alt: section.settings.heading
            }}
          {% else %}
            <div class="hero-feature-split__placeholder-{{ hero_id }}">
              Bild
            </div>
          {% endif %}
        </div>
      </div>

      <div class="hero-feature-split__content-{{ hero_id }}">
        {% if section.settings.heading != blank %}
          <h1 class="hero-feature-split__heading-{{ hero_id }}">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="hero-feature-split__subheading-{{ hero_id }}">{{ section.settings.subheading }}</p>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="hero-feature-split__body-{{ hero_id }}">{{ section.settings.body }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="hero-feature-split__features-{{ hero_id }}">
            {% for block in section.blocks %}
              <li class="hero-feature-split__feature-{{ hero_id }}" {{ block.shopify_attributes }}>
                <span class="hero-feature-split__marker-{{ hero_id }}">
                  {% if block.settings.marker_type == 'emoji' and block.settings.emoji != blank %}
                    <span class="hero-feature-split__emoji-{{ hero_id }}">{{ block.settings.emoji }}</span>
                  {% else %}
                    <span class="hero-feature-split__dot-{{ hero_id }}"></span>
                  {% endif %}
                </span>
                <p class="hero-feature-split__feature-text-{{ hero_id }}">{{ block.settings.text }}</p>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Split Features",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Velours Teppichboden"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterzeile",
      "default": "Velours Teppichböden in allen Qualitäten und Farben"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Veloursteppichboden wird ähnlich wie Schlingenteppichboden hergestellt, allerdings werden die Schlingen danach aufgeschnitten, um eine samtartige Oberflächenstruktur zu erzeugen.</p>"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Inhaltsbreite",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Spaltenabstand Desktop",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Bildradius",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Überschrift Desktop",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Überschrift Mobile",
      "min": 28,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Unterzeile Größe",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Textgröße",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "feature_size",
      "label": "Feature Textgröße",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzentfarbe",
      "default": "#7d9480"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Placeholder Farbe",
      "default": "#8d8d8d"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "marker_type",
          "label": "Marker",
          "default": "emoji",
          "options": [
            {
              "value": "emoji",
              "label": "Emoji"
            },
            {
              "value": "dot",
              "label": "Stichpunkt"
            }
          ]
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "☺"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Im Raummaß konfigurierbar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Split Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "emoji": "☺",
            "text": "Im Raummaß konfigurierbar"
          }
        },
        {
          "type": "feature",
          "settings": {
            "emoji": "☆",
            "text": "Bewertet von echten Kunden bei Google"
          }
        },
        {
          "type": "feature",
          "settings": {
            "emoji": "⌁",
            "text": "Musterservice für alle Produkte"
          }
        }
      ]
    }
  ]
}
{% endschema %}
