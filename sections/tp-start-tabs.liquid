{%- comment -%}
  TP Produkt-Tabs: Ueberschrift plus Reiter, die die nachfolgenden Produktlisten
  (Sections vom Typ product-list) ein- und ausblenden. Die Produktlisten selbst
  bleiben unangetastet - Karten, Preise, Muster-Buttons kommen aus den bestehenden
  Bloecken. Ohne JavaScript bleiben alle Listen sichtbar.
  Jeder Reiter nennt die Section-ID aus templates/index.json (z. B. product_list_fa6P9H).
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

<div class="tp-tabs" id="tp-tabs-{{ section.id }}" data-tp-tabs>
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head tp-tabs__head">
      <div>
        <h2 class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tp-tabs__list" role="tablist" aria-label="Produktbereich">
      {%- for block in section.blocks -%}
        <button class="tp-tabs__tab" role="tab" type="button" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tp-target="{{ block.settings.section_id | strip }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  Die Produktlisten sind Horizon-Sections mit page-width und standen deshalb
  84 px weiter links als Reiter und Ueberschrift. Genau die Listen dieser Reiter
  bekommen die Inhaltsbreite der TP-Sections (Audit B-16). Die Section-IDs sind
  dynamisch, deshalb hier ein style-Tag statt stylesheet.
{%- endcomment -%}
{%- assign tp_tabs_prefix = section.id | split: '__' | first -%}
<style>
  {%- for block in section.blocks -%}
    {%- assign tp_tabs_key = block.settings.section_id | strip -%}
    {%- if tp_tabs_key != blank -%}
      #shopify-section-{{ tp_tabs_prefix }}__{{ tp_tabs_key }} .section { --page-content-width: calc(var(--tp-container) - 2 * var(--tp-pad)); --page-width: calc(var(--page-content-width) + var(--page-margin) * 2); }
    {%- endif -%}
  {%- endfor -%}
</style>

{% stylesheet %}
  .tp-tabs { padding-top: var(--tp-sec); }
  .tp-tabs__head { margin-bottom: 18px; }
  .tp-tabs__list { display: flex; gap: 6px; flex-wrap: wrap; }
  .tp-tabs__tab { padding: 9px 16px; border-radius: 999px; border: 1.5px solid #d5cec4; background: #fff; font: inherit; font-weight: 500; font-size: 15px; min-height: 42px; cursor: pointer; color: #1d1a17; }
  .tp-tabs__tab[aria-selected="true"] { background: #1d1a17; color: #fff; border-color: #1d1a17; }
  @media (max-width: 767px) {
    .tp-tabs__list { overflow-x: auto; flex-wrap: nowrap; margin: 0 calc(-1 * var(--tp-pad)); padding: 0 var(--tp-pad) 2px; scrollbar-width: none; }
    .tp-tabs__list::-webkit-scrollbar { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('[data-tp-tabs]').forEach(function (root) {
      var tabs = root.querySelectorAll('.tp-tabs__tab');
      if (!tabs.length) return;
      function show(active) {
        tabs.forEach(function (t) {
          var on = t === active;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          var key = t.getAttribute('data-tp-target');
          var sec = document.querySelector('.shopify-section[id$="__' + key + '"]') || document.getElementById('shopify-section-' + key);
          if (sec) sec.hidden = !on;
        });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { show(t); }); });
      show(tabs[0]);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "TP Produkt-Tabs",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Beliebte Bodenbeläge" },
    { "type": "text", "id": "text", "label": "Unterzeile", "default": "Meterware wird nach Ihrem Maß zugeschnitten, Paketware nach Fläche berechnet. Der Preis pro m² ist immer die Leitgröße." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Reiter",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "Teppichboden" },
        { "type": "text", "id": "section_id", "label": "Section-ID der Produktliste", "info": "Schluessel aus templates/index.json, z. B. product_list_fa6P9H" }
      ]
    }
  ],
  "presets": [ { "name": "TP Produkt-Tabs" } ]
}
{% endschema %}
