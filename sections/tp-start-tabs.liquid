{%- comment -%}
  TP Produkt-Tabs: Ueberschrift plus Reiter, die die nachfolgenden Produktlisten
  (Sections vom Typ product-list) ein- und ausblenden. Die Produktlisten selbst
  bleiben unangetastet - Karten, Preise, Muster-Buttons kommen aus den bestehenden
  Bloecken. Ohne JavaScript bleiben alle Listen sichtbar.
  Jeder Reiter nennt die Section-ID aus templates/index.json (z. B. product_list_fa6P9H).
{%- endcomment -%}
{{ 'tp-startseite.css' | asset_url | stylesheet_tag }}

<div class="tp-tabs" id="tp-tabs-{{ section.id }}" data-tp-tabs>
  <div class="tp-s-wrap">
    <div class="tp-s-sec-head tp-tabs__head">
      <div>
        <h2 class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tp-tabs__list" role="tablist" aria-label="Produktbereich">
      {%- for block in section.blocks -%}
        <button class="tp-tabs__tab" role="tab" type="button" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tp-target="{{ block.settings.section_id | strip }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  Die Produktlisten sind Horizon-Sections mit page-width und standen deshalb
  84 px weiter links als Reiter und Ueberschrift. Genau die Listen dieser Reiter
  bekommen die Inhaltsbreite der TP-Sections (Audit B-16). Die Section-IDs sind
  dynamisch, deshalb hier ein style-Tag statt stylesheet.

  Ausblenden ab dem ersten Bild: Bisher versteckte erst das Skript unten die
  Listen der uebrigen Reiter - zu spaet, der Browser hatte deren Kartenbilder
  beim ersten Layout schon angefragt (Desktop: Produktfotos in 1.440 px, rund
  1,4 MB fuer zwei unsichtbare Listen). Jetzt blendet CSS sie von Anfang an aus.
  Die Regel greift nur mit der Klasse tp-js, die das Einzeiler-Skript setzt:
  ohne JavaScript bleibt es bei "alle Listen sichtbar". Im Theme-Editor bleibt
  alles sichtbar, damit die Sections auswaehlbar sind.

  Leere Listen (Rundgang 2026-10-26, #69): Zeigt eine Liste keine Karte,
  steht dort statt der Liste nur die Marke data-tp-liste-leer
  (sections/product-list, "Ohne Produkte ausblenden"). Dann verschwindet ihr
  Reiter, und sind alle Listen leer, der ganze Abschnitt - per CSS :has()
  schon beim Aufbau der Seite, ohne Springen. Das Skript unten prueft
  dasselbe noch einmal an den Karten selbst (auch fuer Browser ohne :has()).
{%- endcomment -%}
{%- assign tp_tabs_prefix = section.id | split: '__' | first -%}
{%- assign tp_tabs_alle_leer = '' -%}
<script>document.documentElement.classList.add('tp-js');</script>
<style>
  {%- for block in section.blocks -%}
    {%- assign tp_tabs_key = block.settings.section_id | strip -%}
    {%- if tp_tabs_key != blank -%}
      #shopify-section-{{ tp_tabs_prefix }}__{{ tp_tabs_key }} .section { --page-content-width: calc(var(--tp-container) - 2 * var(--tp-pad)); --page-width: calc(var(--page-content-width) + var(--page-margin) * 2); }
      {%- unless forloop.first or request.design_mode -%}
        .tp-js #shopify-section-{{ tp_tabs_prefix }}__{{ tp_tabs_key }}:not([data-tp-tab-aktiv]) { display: none; }
      {%- endunless -%}
      {%- unless request.design_mode -%}
        {%- capture tp_tabs_leer -%}:has(#shopify-section-{{ tp_tabs_prefix }}__{{ tp_tabs_key }} [data-tp-liste-leer]){%- endcapture -%}
        html{{ tp_tabs_leer }} #tp-tabs-{{ section.id }} [data-tp-target="{{ tp_tabs_key }}"] { display: none; }
        {%- assign tp_tabs_alle_leer = tp_tabs_alle_leer | append: tp_tabs_leer -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if tp_tabs_alle_leer != blank -%}
    html{{ tp_tabs_alle_leer }} #shopify-section-{{ section.id }} { display: none; }
  {%- endif -%}
</style>

{% stylesheet %}
  .tp-tabs { padding-top: var(--tp-sec); }
  .tp-tabs__head { margin-bottom: 18px; }
  .tp-tabs__list { display: flex; gap: 6px; flex-wrap: wrap; }
  .tp-tabs__tab { padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--tp-line-2, #d5cec4); background: #fff; font: inherit; font-weight: 500; font-size: var(--tp-fs-md); min-height: 42px; cursor: pointer; color: var(--tp-ink, #1d1a17); }
  .tp-tabs__tab[aria-selected="true"] { background: var(--tp-ink, #1d1a17); color: #fff; border-color: var(--tp-ink, #1d1a17); }
  @media (max-width: 767px) {
    .tp-tabs__list { overflow-x: auto; flex-wrap: nowrap; margin: 0 calc(-1 * var(--tp-pad)); padding: 0 var(--tp-pad) 2px; scrollbar-width: none; }
    .tp-tabs__list::-webkit-scrollbar { display: none; }
    /* Reiter scrollen statt schrumpfen: sonst brach "Leisten & Zubehoer" auf
       drei Zeilen um, und alle Reiter wurden 92 px hoch. */
    .tp-tabs__tab { flex-shrink: 0; white-space: nowrap; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function liste(t) {
      var key = t.getAttribute('data-tp-target');
      if (!key) return null;
      return document.querySelector('.shopify-section[id$="__' + key + '"]') || document.getElementById('shopify-section-' + key);
    }
    document.querySelectorAll('[data-tp-tabs]').forEach(function (root) {
      var alle = Array.prototype.slice.call(root.querySelectorAll('.tp-tabs__tab'));
      if (!alle.length) return;
      // Nur Reiter, deren Liste wirklich Karten zeigt (#69). Im Theme-Editor
      // bleiben alle stehen, damit jede Liste auswaehlbar bleibt.
      var editor = !!(window.Shopify && window.Shopify.designMode);
      var tabs = alle.filter(function (t) {
        var sec = liste(t);
        var voll = !!(sec && sec.querySelector('.resource-list__item'));
        if (!voll && !editor) {
          t.hidden = true;
          if (sec) sec.hidden = true;
        }
        return voll || editor;
      });
      if (!tabs.length) {
        var abschnitt = root.closest('.shopify-section') || root;
        abschnitt.hidden = true;
        abschnitt.style.display = 'none';
        return;
      }
      function show(active) {
        tabs.forEach(function (t) {
          var on = t === active;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.setAttribute('tabindex', on ? '0' : '-1');
          var sec = liste(t);
          if (!sec) return;
          sec.hidden = !on;
          // Die CSS-Regel oben blendet die Listen der uebrigen Reiter aus, bis sie aktiv sind
          if (on) sec.setAttribute('data-tp-tab-aktiv', '');
          else sec.removeAttribute('data-tp-tab-aktiv');
        });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { show(t); }); });
      // Pfeiltasten, Pos1 und Ende wie bei role=tablist ueblich (Audit B-47)
      tabs.forEach(function (t, i) {
        t.addEventListener('keydown', function (e) {
          var next = null;
          if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
          else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
          else if (e.key === 'Home') next = tabs[0];
          else if (e.key === 'End') next = tabs[tabs.length - 1];
          if (!next) return;
          e.preventDefault();
          show(next);
          next.focus();
        });
      });
      show(tabs[0]);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "TP Produkt-Tabs",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Beliebte Bodenbeläge" },
    { "type": "text", "id": "text", "label": "Unterzeile", "default": "Meterware wird nach Ihrem Maß zugeschnitten, Paketware nach Fläche berechnet. Der Preis pro m² ist immer die Leitgröße." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Reiter",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "Teppichboden" },
        { "type": "text", "id": "section_id", "label": "Section-ID der Produktliste", "info": "Schluessel aus templates/index.json, z. B. product_list_fa6P9H" }
      ]
    }
  ],
  "presets": [ { "name": "TP Produkt-Tabs" } ]
}
{% endschema %}
