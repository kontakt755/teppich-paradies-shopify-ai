}
.vinyl-arten-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 32px;
}
.vinyl-art-box {
  background: #fafafa;
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 4px 14px rgba(0,0,0,0.06);
}
.vinyl-art-box h3 {
  font-size: 22px;
  color: #2a2a2a;
  margin-bottom: 18px;
}
.vinyl-art-box ul {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
}
.vinyl-art-box ul li {
  font-size: 16px;
