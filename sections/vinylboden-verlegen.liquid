}
</style>


{% stylesheet %}
  .vinyl-hero-bild {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  @media screen and (max-width: 899px) {
    .vinyl-hero-bild {
      aspect-ratio: 16 / 10;
    }
  }

  .vinyl-hero-bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vinyl-hero-fakten {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vinyl-hero-fakten li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--tp-fs-md);
    line-height: 1.4;
  }

  .vinyl-hero-fakten li::before {
    content: '\2713';
    color: #008a2e;
    font-weight: 700;
    flex: 0 0 auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tebo Verlegen Hero",
  "presets": [
    {
      "name": "Vinyl Verlegen Hero",
      "category": "Custom"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_bild",
      "label": "Bild",
      "info": "Ein echtes Projektfoto, kein Stockfoto."
    },
    {
      "type": "text",
      "id": "hero_bild_alt",
      "label": "Bildbeschreibung (Alt-Text)",
      "default": "Von uns verlegter Vinylboden"
    },
    {
      "type": "text",
      "id": "hero_titel",
      "label": "Überschrift",
      "default": "Vinylboden fachgerecht verlegen lassen"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Text",
      "default": "Wir prüfen den Untergrund, beraten zu Klick-, Klebe- oder Rollenvinyl und verlegen fachgerecht."
    },
    {
      "type": "text",
      "id": "hero_fakten",
      "label": "Punkte (mit Komma trennen)",
      "default": "Kostenloses Aufmaß vor Ort, Oranienburg und 50 km Umkreis – weiter auf Anfrage, Untergrundprüfung inklusive, Verlegung durch unser eigenes Team"
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Button",
      "default": "Verlegung anfragen"
    },
    {
      "type": "url",
      "id": "hero_cta_ziel",
      "label": "Ziel des Buttons"
    },
    {
      "type": "text",
      "id": "telefon",
      "label": "Telefonnummer für den Anruf-Link",
      "info": "Leer lassen blendet die Zeile aus.",
      "default": "+4933015733720"
    },
    {
      "type": "text",
      "id": "telefon_label",
      "label": "Beschriftung der Telefonzeile",
      "default": "oder anrufen: 03301 573 37 20"
    }
  ]
}
{% endschema %}