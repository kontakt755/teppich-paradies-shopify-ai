{% stylesheet %}
  .vinyl-hero-bild {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .vinyl-hero-bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Der alte Hero zentriert alles. Eine Haekchenliste zentriert zu lesen ist
     muehsam - jede Zeile faengt woanders an. Deshalb bleibt der Block mittig,
     der Text darin aber linksbuendig. */
  .vinyl-hero-fakten {
    margin: 0 auto 20px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
    width: fit-content;
  }

  .vinyl-hero-fakten li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 16px;
    line-height: 1.4;
  }

  .vinyl-hero-fakten li::before {
    content: '\2713';
    color: #008a2e;
    font-weight: 700;
    flex: 0 0 auto;
  }

  .vinyl-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
  }

  /* Wie auf der Treppenseite: der Button erbt eine grosse Schriftgroesse aus
     dem alten Seiten-CSS und braucht eine feste Hoehe, sonst wird er auf dem
     Handy zum Banner. */
  .vinyl-hero-actions .vinyl-hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    font-size: 17px;
    line-height: 1.2;
  }

  .vinyl-hero-tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tebo Verlegen Hero",
  "presets": [
    {
      "name": "Vinyl Verlegen Hero",
      "category": "Custom"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_bild",
      "label": "Bild",
      "info": "Ein echtes Projektfoto, kein Stockfoto."
    },
    {
      "type": "text",
      "id": "hero_bild_alt",
      "label": "Bildbeschreibung (Alt-Text)",
      "default": "Von uns verlegter Vinylboden"
    },
    {
      "type": "text",
      "id": "hero_titel",
      "label": "Überschrift",
      "default": "Vinylboden fachgerecht verlegen lassen"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Text",
      "default": "Wir prüfen den Untergrund, beraten zu Klick-, Klebe- oder Rollenvinyl und verlegen fachgerecht."
    },
    {
      "type": "text",
      "id": "hero_fakten",
      "label": "Punkte (mit Komma trennen)",
      "default": "Kostenloses Aufmaß vor Ort, Oranienburg und 50 km Umkreis – weiter auf Anfrage, Untergrundprüfung inklusive, Verlegung durch unser eigenes Team"
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Button",
      "default": "Aufmaß-Termin anfragen"
    },
    {
      "type": "url",
      "id": "hero_cta_ziel",
      "label": "Ziel des Buttons"
    },
    {
      "type": "text",
      "id": "telefon",
      "label": "Telefonnummer für den Anruf-Link",
      "info": "Leer lassen blendet die Zeile aus.",
      "default": "+4933015733720"
    },
    {
      "type": "text",
      "id": "telefon_label",
      "label": "Beschriftung der Telefonzeile",
      "default": "oder anrufen: 03301 5733720"
    }
  ]
}
{% endschema %}