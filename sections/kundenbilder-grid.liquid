<!-- Abschnitt: Kundenbilder / Referenzen -->
<section class="kundenbilder-section">
  <div class="kundenbilder-wrapper">
    <h2 class="kundenbilder-title">Echte Kunden. Echte Ergebnisse.</h2>
    <div class="kundenbilder-grid">
      {% for block in section.blocks %}
        {% if block.type == 'kundenbild' %}
        <div class="kundenbild">
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="800" height="280">
          <p>{{ block.settings.caption }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
.kundenbilder-section {
  max-width: 1200px;
  margin: 80px auto;
  padding: 0 20px;
}
.kundenbilder-title {
  text-align: center;
  font-size: 30px;
  margin-bottom: 40px;
  color: #2a2a2a;
}
.kundenbilder-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}
.kundenbild img {
  width: 100%;
  height: 280px; /* Einheitliche Höhe */
  object-fit: cover; /* Kein Verzerren, sauberer Zuschnitt */
  border-radius: 12px;
  box-shadow: 0 6px 12px rgba(0,0,0,0.1);
}
.kundenbild p {
  margin-top: 10px;
  font-size: 16px;
  color: #555;
  text-align: center;
}

@media (max-width: 768px) {
  .kundenbild img {
    height: 200px;
  }
}
</style>

{% schema %}
{
  "name": "Kundenbilder",
  "settings": [],
  "blocks": [
    {
      "type": "kundenbild",
      "name": "Kundenbild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild hochladen"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Bildunterschrift"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alternativtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kundenbilder Grid",
      "category": "Custom",
      "blocks": []
    }
  ]
}
{% endschema %}
