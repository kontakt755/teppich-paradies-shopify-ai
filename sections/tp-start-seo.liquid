{{ 'tp-start-abschnitte.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  TP SEO-Absatz mit internen Links: links zwei Absaetze, rechts bis zu vier Linklisten
  aus Menues (Ratgeber, Service in der Region). Keine Ortslisten, kein Keyword-Stuffing.
{%- endcomment -%}

<section class="tp-s-sec tp-s-sec--band tp-seo" id="tp-ratgeber" aria-labelledby="tp-seo-h2">
  <div class="tp-s-wrap tp-seo__wrap">
    <div>
      <h2 id="tp-seo-h2" class="tp-s-h2">{{ section.settings.heading | escape }}</h2>
      <div class="tp-seo__text">{{ section.settings.text }}</div>
    </div>
    <div class="tp-seo__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3 class="tp-seo__h4">{{ block.settings.titel | default: block.settings.menu.title | escape }}</h3>
          <ul>
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}{%- capture tp_mls -%}{%- render 'tp-menu-link-sichtbar', link: link -%}{%- endcapture -%}{%- if tp_mls contains 'nein' -%}{%- continue -%}{%- endif -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
            {%- elsif block.settings.links != blank -%}
              {%- assign zeilen = block.settings.links | newline_to_br | split: '<br />' -%}
              {%- for zeile in zeilen -%}
                {%- assign teile = zeile | strip | split: '|' -%}
                {%- if teile.size == 2 -%}<li><a href="{{ teile[1] | strip }}">{{ teile[0] | strip | escape }}</a></li>{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TP SEO-Absatz + Links",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Teppichboden, Vinyl und Linoleum vom Fachhandel in Oranienburg" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Teppich Paradies ist Fachhändler für Bodenbeläge in Oranienburg bei Berlin. Im Online-Shop finden Sie Teppichboden als Meterware, Klick- und Klebevinyl, Vinyl von der Rolle, Linoleum, Sockelleisten und Verlegezubehör – mit Preis pro Quadratmeter, Musterbestellung und Rollenware im Wunschmaß.</p><p>Für Kunden in Oranienburg, Oberhavel und im Norden Berlins übernimmt unser Team Aufmaß, Lieferung, Untergrundvorbereitung und die fachgerechte Verlegung – auch auf Treppen sowie in Praxen, Büros und Gastronomie.</p>" }
  ],
  "blocks": [
    {
      "type": "liste",
      "name": "Linkliste",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "titel", "label": "Titel (leer = Menuename)" },
        { "type": "link_list", "id": "menu", "label": "Menue (optional)" },
        { "type": "textarea", "id": "links", "label": "Oder Links: Titel|URL je Zeile", "info": "Wird nur genutzt, wenn kein Menue gewaehlt ist." }
      ]
    }
  ],
  "presets": [ { "name": "TP SEO-Absatz + Links" } ]
}
{% endschema %}
