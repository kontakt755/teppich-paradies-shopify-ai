

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<results-list
  class="section product-grid-container spacing-style color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style"
  >
    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate search.results by products_per_page %}
      {%- liquid
        # TP Aufgabe #505 (Luecke L1): search.results mischt alle im Parameter
        # "type" angefragten Objekttypen. Jeder Typ bekommt seinen eigenen
        # Bereich: sonst meldet Shopify Treffer, die hier unsichtbar bleiben,
        # und Nicht-Produkte laufen durch die Produktkarten-Logik.
        assign tp_sr_produkte = search.results | where: 'object_type', 'product'
        assign tp_sr_artikel = search.results | where: 'object_type', 'article'
        assign tp_sr_seiten = search.results | where: 'object_type', 'page'
        assign tp_sr_kategorien = search.results | where: 'object_type', 'collection'
      -%}
      {%- liquid
        # Shopifys semantische Suche liefert fuer jeden Begriff Produkte, auch
        # fuer "Fahrrad" oder "xyzqwert" rund 1.000 (gemessen 2026-10-24).
        # Traegt auf Seite 1 kein Treffer einen der Suchbegriffe in Titel,
        # Produkttyp, Tags oder Artikelnummer, sagt ein Hinweis das ehrlich.
        # Umlaute werden beidseitig vereinfacht, lange Begriffe verlieren zwei
        # Endbuchstaben ("teppichboeden" findet "Teppichboden").
        assign tp_sr_unsicher = false
        if paginate.current_page == 1 and tp_sr_produkte.size > 0 and search.terms != blank
          assign tp_sr_stopp = 'und,oder,mit,fur,der,die,das,von,aus,ein,eine' | split: ','
          assign tp_sr_roh = search.terms | downcase | replace: 'ä', 'a' | replace: 'ö', 'o' | replace: 'ü', 'u' | replace: 'ß', 'ss' | remove: '&quot;' | remove: '"' | replace: '-', ' ' | replace: ',', ' ' | split: ' '
          assign tp_sr_begriffe = ''
          for tp_sr_b in tp_sr_roh
            if tp_sr_b.size < 3 or tp_sr_stopp contains tp_sr_b
              continue
            endif
            # Eigener Name: assign auf die Schleifenvariable wirkt in Liquid
            # nicht innerhalb derselben Schleife
            assign tp_sr_stamm = tp_sr_b
            if tp_sr_b.size >= 6
              assign tp_sr_laenge = tp_sr_b.size | minus: 2
              assign tp_sr_stamm = tp_sr_b | slice: 0, tp_sr_laenge
            endif
            assign tp_sr_begriffe = tp_sr_begriffe | append: tp_sr_stamm | append: '|'
          endfor
          assign tp_sr_begriffe = tp_sr_begriffe | split: '|'

          if tp_sr_begriffe.size > 0
            assign tp_sr_unsicher = true
            for tp_sr_p in tp_sr_produkte
              assign tp_sr_tags = tp_sr_p.tags | join: ' '
              assign tp_sr_text = tp_sr_p.title | append: ' ' | append: tp_sr_p.type | append: ' ' | append: tp_sr_tags
              for tp_sr_v in tp_sr_p.variants limit: 20
                assign tp_sr_text = tp_sr_text | append: ' ' | append: tp_sr_v.sku
              endfor
              assign tp_sr_text = tp_sr_text | downcase | replace: 'ä', 'a' | replace: 'ö', 'o' | replace: 'ü', 'u' | replace: 'ß', 'ss'
              for tp_sr_s in tp_sr_begriffe
                if tp_sr_text contains tp_sr_s
                  assign tp_sr_unsicher = false
                  break
                endif
              endfor
              unless tp_sr_unsicher
                break
              endunless
            endfor
          endif
        endif
      -%}
      {%- liquid
        # Feste Service-Seiten wie in der Schnellsuche (snippets/tp-suche-service-ziele):
        # "Oeffnungszeiten" fuehrt zur Kontaktseite, auch wenn Shopify sie nicht findet.
        # Gibt es eine, steht der Abschnitt "Seiten & Service" ganz oben, vor dem
        # Hinweis und den Produkten - sonst wie bisher nach dem Filter.
        assign tp_sr_fest = '|'
        if paginate.current_page == 1 and search.terms != blank
          capture tp_sr_fest_handles
            render 'tp-suche-service-ziele', begriff: search.terms
          endcapture
          assign tp_sr_fest_handles = tp_sr_fest_handles | strip | split: ','
          for tp_sr_fh in tp_sr_fest_handles
            # "refund-policy" ist die Widerrufsbelehrung (Richtlinie, keine Seite).
            if tp_sr_fh == 'refund-policy'
              if shop.refund_policy != blank
                assign tp_sr_fest = tp_sr_fest | append: tp_sr_fh | append: '|'
              endif
            elsif tp_sr_fh != blank and pages[tp_sr_fh] != blank
              assign tp_sr_fest = tp_sr_fest | append: tp_sr_fh | append: '|'
            endif
          endfor
        endif
        assign tp_sr_fest_liste = tp_sr_fest | remove_first: '|' | split: '|'
      -%}
      {%- capture tp_sr_seiten_html -%}
        {% if tp_sr_seiten.size > 0 or tp_sr_fest_liste.size > 0 %}
          <section class="tp-sr-ziele" aria-labelledby="tp-sr-seiten-titel">
            <h2 class="tp-sr-ziele__titel" id="tp-sr-seiten-titel">Seiten &amp; Service</h2>
            <ul class="tp-sr-ziele__liste">
              {% for tp_sr_fh in tp_sr_fest_liste %}
                {%- if tp_sr_fh == 'refund-policy' -%}
                  {%- assign tp_sr_fs = shop.refund_policy -%}
                {%- else -%}
                  {%- assign tp_sr_fs = pages[tp_sr_fh] -%}
                {%- endif -%}
                <li><a href="{{ tp_sr_fs.url | escape }}">{{ tp_sr_fs.title | escape }}</a></li>
              {% endfor %}
              {% for tp_sr_s in tp_sr_seiten %}
                {%- assign tp_sr_skey = '|' | append: tp_sr_s.handle | append: '|' -%}
                {%- if tp_sr_fest contains tp_sr_skey -%}{%- continue -%}{%- endif -%}
                <li><a href="{{ tp_sr_s.url | escape }}">{{ tp_sr_s.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {%- endcapture -%}
      {%- if tp_sr_fest_liste.size > 0 -%}{{ tp_sr_seiten_html }}{%- endif -%}
      {% if search.results_count > 0 %}
        {% if tp_sr_unsicher %}
          {% render 'tp-suche-leer', begriff: search.terms %}
        {% endif %}
        {% if tp_sr_produkte.size > 0 %}
          {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: tp_sr_produkte.size, tp_unsicher: tp_sr_unsicher %}
        {% endif %}
        {% assign products = tp_sr_produkte %}
      {% else %}
        {% comment %}
          Kein Katalog-Dump mehr: Horizon zeigte hier settings.empty_state_collection
          oder alle Produkte. Stattdessen ein kurzer Leerzustand mit Kategorien
          und Kontakt (snippets/tp-suche-leer.liquid).
        {% endcomment %}
        {% render 'tp-suche-leer' %}
        {% assign products = blank %}
        {% assign title = blank %}
      {% endif %}

      {%- unless tp_sr_fest_liste.size > 0 -%}{{ tp_sr_seiten_html }}{%- endunless -%}

      {% if tp_sr_kategorien.size > 0 %}
        <section class="tp-sr-ziele" aria-labelledby="tp-sr-kategorien-titel">
          <h2 class="tp-sr-ziele__titel" id="tp-sr-kategorien-titel">Kategorien</h2>
          <ul class="tp-sr-ziele__liste">
            {% for tp_sr_k in tp_sr_kategorien %}
              <li><a href="{{ tp_sr_k.url | escape }}">{{ tp_sr_k.title | escape }}</a></li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if tp_sr_artikel.size > 0 %}
        {% comment %}
          Ratgeber-Treffer: eigener Abschnitt vor dem Produktraster, mit der
          bestehenden Artikelkarte (snippets/tp-ratgeber-karte.liquid) statt
          einer eigenen Kartenoptik. Keine Begrenzung auf 3 wie in der
          Schnellsuche - das hier ist bereits die vollstaendige, paginierte
          Ergebnisseite.
        {% endcomment %}
        <section class="tp-sr-ratgeber" aria-labelledby="tp-sr-ratgeber-titel">
          <h2 class="tp-sr-ratgeber__titel" id="tp-sr-ratgeber-titel">Ratgeber</h2>
          <ul class="tp-sr-ratgeber__raster">
            {% for tp_sr_a in tp_sr_artikel %}
              <li>{% render 'tp-ratgeber-karte', artikel: tp_sr_a %}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% capture children %}
        {% for product in products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product, card_index: forloop.index0 %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% if products.size > 0 %}
        {% render 'product-grid',
          section: section,
          children: children,
          products: products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll,
          title: title
        %}
      {% endif %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}
  .tp-sr-ziele {
    grid-column: 1 / -1;
    margin: 8px 0 24px;
  }

  /* Mobil reicht .collection-wrapper bis an den Rand (wie .tp-suche-leer--hinweis) */
  @media screen and (max-width: 749px) {
    .tp-sr-ziele {
      margin-inline: var(--page-margin, 16px);
    }
  }

  .tp-sr-ziele__titel {
    margin: 0 0 12px;
    font-size: var(--tp-fs-xl);
  }

  .tp-sr-ziele__liste {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tp-sr-ziele__liste a {
    display: inline-block;
    padding: 10px 14px;
    border: 1px solid currentColor;
    border-radius: 4px;
    text-decoration: none;
  }

  .tp-sr-ziele__liste a:hover,
  .tp-sr-ziele__liste a:focus-visible {
    text-decoration: underline;
  }

  /* TP Aufgabe #505: Ratgeber-Abschnitt ueber die volle Rasterbreite, wie
     snippets/tp-suche-leer.liquid es fuer den Leerzustand schon macht - sonst
     quetscht sich der Block in die 250-px-Filterspalte von .collection-wrapper. */
  .tp-sr-ratgeber {
    grid-column: 1 / -1;
    margin: 8px 0 32px;
  }

  .tp-sr-ratgeber__titel {
    margin: 0 0 16px;
    font-size: var(--tp-fs-xl);
  }

  .tp-sr-ratgeber__raster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 639px) {
    .tp-sr-ratgeber__raster {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search_results",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_empty_state_collection_in_theme_settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
