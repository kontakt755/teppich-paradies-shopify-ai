{% comment %}
  Kontakt fuer alle, die weiter entfernt wohnen als das regulaere
  Liefergebiet reicht - und fuer jede andere Frage zum Verlegeservice.

  Weder Absage noch Zusage: wer ausserhalb wohnt, bekommt jeden Weg zu uns,
  und wir pruefen den Einzelfall. Dasselbe sagt das Ergebnis der
  Ortspruefung (assets/tp-verlegegebiet.js), damit Seite und Pruefung nicht
  zwei verschiedene Antworten geben.

  Telefon, WhatsApp, E-Mail und Adresse kommen aus den Theme-Einstellungen,
  Gruppe TP Verlegeservice. "[km]" in Ueberschrift und Text ersetzt die
  Sektion durch den Radius von dort - so steht keine zweite Zahl im Editor,
  die beim naechsten Aendern vergessen wird.
{% endcomment %}

{%- liquid
  assign vk_km = settings.tp_vs_radius_premium | append: ''
  assign vk_titel = section.settings.heading | replace: '[km]', vk_km
  assign vk_text = section.settings.text | replace: '[km]', vk_km

  # Anruf-Link aus der angezeigten Nummer: Trennzeichen raus, fuehrende 0 zu +49.
  assign vk_tel = settings.tp_vs_telefon | remove: ' ' | remove: '/' | remove: '-' | remove: '(' | remove: ')'
  assign vk_tel_erst = vk_tel | slice: 0
  if vk_tel_erst == '0'
    assign vk_tel = vk_tel | slice: 1, 30 | prepend: '+49'
  endif

  assign vk_wa = settings.tp_vs_whatsapp | remove: ' ' | remove: '+'
  assign vk_mail = settings.tp_vs_email | strip
  assign vk_adresse = settings.tp_vs_adresse | strip
  if vk_adresse != blank
    assign vk_ziel = vk_adresse | replace: '–', '-' | url_encode
    assign vk_route = 'https://www.google.com/maps/dir/?api=1&destination=' | append: vk_ziel
  endif

  assign vk_vertrauen = section.settings.vertrauen | split: '·'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="tp-vsk section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="tp-verlegeservice-kontakt-{{ section.id }}"
>
  <div class="tp-vsk__kasten">
    <div class="tp-vsk__text">
      <span class="tp-vsk__zeichen">{% render 'tp-vs-icon', name: 'pin' %}</span>
      {%- if vk_titel != blank -%}
        <h2 class="tp-vsk__titel">{{ vk_titel | escape }}</h2>
      {%- endif -%}
      {%- if vk_text != blank -%}
        <p class="tp-vsk__intro">{{ vk_text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.vertrauen != blank -%}
        <ul class="tp-vsk__vertrauen" role="list">
          {%- for vk_punkt in vk_vertrauen -%}
            {%- assign vk_punkt = vk_punkt | strip -%}
            {%- if vk_punkt != blank -%}
              <li>{% render 'tp-vs-icon', name: 'check' %}{{ vk_punkt | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.arbeiten_link != blank and section.settings.arbeiten_label != blank -%}
        <a class="tp-vsk__arbeiten" href="{{ section.settings.arbeiten_link }}">{{ section.settings.arbeiten_label | escape }}</a>
      {%- endif -%}
    </div>

    <ul class="tp-vsk__wege" role="list">
      {%- if vk_tel != blank -%}
        <li>
          <a class="tp-vsk__weg tp-vsk__weg--primaer" href="tel:{{ vk_tel }}">
            {%- render 'tp-vs-icon', name: 'phone' -%}
            <span class="tp-vsk__weg-text">
              <span>Jetzt anrufen</span>
              <small>{{ settings.tp_vs_telefon | escape }}</small>
            </span>
          </a>
        </li>
      {%- endif -%}
      {%- if vk_mail != blank -%}
        <li>
          <a class="tp-vsk__weg" href="mailto:{{ vk_mail }}">
            {%- render 'tp-vs-icon', name: 'mail' -%}
            <span class="tp-vsk__weg-text">
              <span>E-Mail schreiben</span>
              <small>{{ vk_mail | escape }}</small>
            </span>
          </a>
        </li>
      {%- endif -%}
      {%- if vk_wa != blank -%}
        <li>
          <a class="tp-vsk__weg tp-vsk__weg--wa" href="https://wa.me/{{ vk_wa }}" target="_blank" rel="noopener">
            {%- render 'tp-vs-icon', name: 'whatsapp' -%}
            <span class="tp-vsk__weg-text">
              <span>WhatsApp</span>
              <small>Nachricht schreiben<span class="visually-hidden"> (öffnet WhatsApp in einem neuen Tab)</span></small>
            </span>
          </a>
        </li>
      {%- endif -%}
      {%- if section.settings.kontakt_link != blank -%}
        <li>
          <a class="tp-vsk__weg" href="{{ section.settings.kontakt_link }}">
            {%- render 'tp-vs-icon', name: 'chat' -%}
            <span class="tp-vsk__weg-text">
              <span>Kontaktformular</span>
              <small>Anfrage online senden</small>
            </span>
          </a>
        </li>
      {%- endif -%}
      {%- if vk_route != blank -%}
        <li>
          <a class="tp-vsk__weg" href="{{ vk_route }}" target="_blank" rel="noopener nofollow">
            {%- render 'tp-vs-icon', name: 'pin' -%}
            <span class="tp-vsk__weg-text">
              <span>Im Geschäft beraten lassen</span>
              <small>{{ vk_adresse | escape }}<span class="visually-hidden"> (öffnet Google Maps in einem neuen Tab)</span></small>
            </span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .tp-vsk {
    --tp-vs-ton: 141 113 76;
    --tp-vs-leise: rgb(var(--color-foreground-rgb, 34 34 34) / 0.72);
  }

  .tp-vsk__kasten {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
    max-width: 1080px;
    margin-inline: auto;
    padding: clamp(22px, 4vw, 44px);
    border: 1px solid rgb(var(--tp-vs-ton) / 0.24);
    border-radius: 20px;
    background: rgb(var(--tp-vs-ton) / 0.07);
  }

  .tp-vsk__zeichen {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--color-background, #fff);
    color: #8d714c;
  }

  .tp-vsk__zeichen .tp-vs-icon {
    width: 24px;
    height: 24px;
  }

  .tp-vsk__titel {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .tp-vsk__intro {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.6;
  }

  .tp-vsk__vertrauen {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .tp-vsk__vertrauen li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .tp-vsk__vertrauen .tp-vs-icon {
    width: 18px;
    height: 18px;
    color: #1d6b47;
  }

  .tp-vsk__arbeiten {
    display: inline-block;
    margin-top: 18px;
    color: inherit;
    font-size: 16px;
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .tp-vsk__arbeiten::after {
    content: '\00a0\2192';
  }

  .tp-vsk__wege {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tp-vsk__weg {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 62px;
    padding: 12px 18px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.16);
    border-radius: 12px;
    background: var(--color-background, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .tp-vsk__weg:hover {
    border-color: rgb(var(--tp-vs-ton) / 0.8);
    box-shadow: 0 4px 14px rgb(28 25 23 / 0.06);
  }

  .tp-vsk__weg:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .tp-vsk__weg > .tp-vs-icon {
    width: 24px;
    height: 24px;
    color: #8d714c;
  }

  /* Pfeil am Ende: jede Zeile ist ein Weg, keine Beschriftung. */
  .tp-vsk__weg::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-left: auto;
    border-top: 2px solid currentcolor;
    border-right: 2px solid currentcolor;
    opacity: 0.45;
    transform: rotate(45deg);
  }

  .tp-vsk__weg-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tp-vsk__weg-text > span {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
  }

  .tp-vsk__weg-text small {
    color: var(--tp-vs-leise);
    font-size: 14px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .tp-vsk__weg--primaer {
    border-color: #1c1917;
    background: #1c1917;
    color: #fff;
  }

  .tp-vsk__weg--primaer > .tp-vs-icon,
  .tp-vsk__weg--primaer small {
    color: rgb(255 255 255 / 0.85);
  }

  .tp-vsk__weg--wa > .tp-vs-icon {
    color: #1f9e53;
  }

  @media screen and (max-width: 749px) {
    .tp-vsk__kasten {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-vsk__weg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Service-Kontakt",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Telefon, WhatsApp, E-Mail, Adresse und Radius kommen aus den Theme-Einstellungen unter „TP Verlegeservice“. [km] im Text wird durch den Radius ersetzt."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Weiter als [km] km entfernt? Kein Problem – sprechen Sie mit uns."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Unser regulärer Liefer- und Verlegeservice gilt bis [km] km. Liegt Ihre Adresse weiter entfernt, kontaktieren Sie uns bitte telefonisch, per E-Mail oder persönlich im Geschäft. Wir prüfen gerne individuell, welche Möglichkeiten wir Ihnen anbieten können."
    },
    {
      "type": "url",
      "id": "kontakt_link",
      "label": "Kontaktformular"
    },
    {
      "type": "text",
      "id": "vertrauen",
      "label": "Vertrauenszeile",
      "info": "Punkte mit · trennen. Nur Aussagen, die stimmen.",
      "default": "Persönliche Beratung im Geschäft · Aufmaß vor Ort · Eigenes Verlegeteam aus Oranienburg"
    },
    {
      "type": "url",
      "id": "arbeiten_link",
      "label": "Link zu Fotos unserer Arbeiten"
    },
    {
      "type": "text",
      "id": "arbeiten_label",
      "label": "Text dieses Links",
      "default": "Fotos unserer Verlegearbeiten ansehen"
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "TP Service-Kontakt"
    }
  ]
}
{% endschema %}
