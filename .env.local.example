# .env.local.example
# Kopiere diese Datei nach .env.local (wird nicht getrackt) und trage deinen Token ein
# Diese Datei ist nur für lokale Entwicklung nötig. GitHub Actions nutzt Secrets.

# Shopify Admin API Token für sync:grosshandel
# Zu finden in: Shopify Admin → Settings → Apps and Integrations → Sync-App → Configuration
# Token beginnt normalerweise mit "shpat_" — bitte mit echtem Token ersetzen
SHOPIFY_ADMIN_TOKEN=<your-shopify-admin-token-here>

# Control Center, Kachel „Laden“ auf „Heute“ (docs/control-center/ARCHITEKTUR.md, Abschnitt 9)
# Adresse der Auftrags-App (/exec, ohne Parameter) und derselbe Wert wie deren Script-Property
# LADEN_ZAHLEN_SCHLUESSEL. Fehlt einer der beiden Werte, zeigt die Kachel „Nicht eingerichtet“.
LADEN_ZAHLEN_URL=<https://script.google.com/macros/s/DEPLOYMENT-ID/exec>
LADEN_ZAHLEN_SCHLUESSEL=<schluessel-aus-der-script-property>
