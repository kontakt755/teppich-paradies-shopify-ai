# Claude API Configuration - Teppich Paradies
# Copy this file to .env.local and fill in your API key
# DO NOT commit .env.local (only .env.local.example goes to git)

# Your Claude API Key from https://console.anthropic.com/account/keys
# The key starts with "sk-ant-" followed by a long random string.
export ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Workspace ID - only needed for keys that span several workspaces.
# Such a key fails with "anthropic-workspace-id is required" until you set this.
# A key created for one specific workspace does not need it; leave it empty.
# You find the ID on the workspace page in the Claude Console.
# export ANTHROPIC_WORKSPACE_ID=

# Monthly budget limit for Claude API usage (in USD)
# Default: $50 (safe for ~560 requests/month at ~$5-7 actual cost)
# If reached: all API calls stop immediately (hard limit)
export CLAUDE_MONTHLY_HARD_LIMIT_USD=50

# Soft warning limit (optional)
# If set and reached: warning printed but calls continue
# Leave empty to disable
export CLAUDE_MONTHLY_WARNING_USD=30

# Max tokens per API response (default: 2048)
# Increase for longer responses, decrease to save costs
export CLAUDE_MAX_TOKENS=2048

# Max retry attempts for failed API calls (default: 2)
# Applies to transient errors (429, 5xx, timeouts)
export CLAUDE_MAX_ATTEMPTS=2

# Retry backoff in seconds (default: 0.5)
# Multiplied by 2^attempt for exponential backoff
export CLAUDE_RETRY_BACKOFF_SECONDS=0.5

# SQLite database path for usage tracking
export CLAUDE_USAGE_DB=.claude/api_usage.db

# OpenRouter: one key for the measured router bridge. Never put this in Git.
# Set exact model slugs; the router deliberately rejects auto/free sub-routers.
# export OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
# export OPENROUTER_USAGE_LEDGER=.router/openrouter-usage.jsonl

# Model selection (optional overrides)
# Leave blank for defaults: Haiku, Sonnet 5, Opus 5
# export CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
# export CLAUDE_SONNET_MODEL=claude-sonnet-5
# export CLAUDE_OPUS_MODEL=claude-opus-5
