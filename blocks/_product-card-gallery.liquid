

{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    <div
      class="product-badges product-badges--{{ settings.badge_position }}"
      style="
        --badge-border-radius: {{ settings.badge_corner_radius }}px;
        --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
      "
    >
      {%- comment -%} Streichpreis/Sale nur bei aktiver Aktion (snippets/tp-aktion-aktiv) - ein stehen gebliebener compare_at_price allein zeigt nichts (S-20, 2026-09-20). {%- endcomment -%}
      {%- capture tp_pcg_aktion -%}{% render 'tp-rabatt-sichtbar', product: product %}{%- endcapture -%}
      {%- assign tp_pcg_aktion = tp_pcg_aktion | strip -%}
      {%- assign tp_pcg_sale = false -%}
      {%- assign tp_pcg_v = product.selected_or_first_available_variant -%}
      {%- if tp_pcg_aktion == 'ja' and tp_pcg_v.compare_at_price > tp_pcg_v.price -%}
        {%- assign tp_pcg_sale = true -%}
        {%- assign tp_pcg_prozent = tp_pcg_v.compare_at_price | minus: tp_pcg_v.price | times: 100.0 | divided_by: tp_pcg_v.compare_at_price | round -%}
      {%- endif -%}
      {%- if tp_pcg_sale and product.available -%}
        {%- comment -%} Rabattbadge statt weissem "Angebot"-Kasten (2026-09-24), Prozent dynamisch {%- endcomment -%}
        <span class="tp-rabatt-badge tp-rabatt-badge--karte">−{{ tp_pcg_prozent }}&nbsp;%</span>
      {%- elsif product.available == false -%}
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-{{ settings.badge_sold_out_color_scheme }}{% elsif tp_pcg_sale %} color-{{ settings.badge_sale_color_scheme }}{% endif %}
          "
        >
          {{ 'content.product_badge_sold_out' | t }}
        </div>
      {%- endif -%}
    </div>
    {%  if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{%- liquid
  # Ohne closest.card_index (siehe blocks/_product-card.liquid) kommt die
  # Rasterposition hier nicht an. Ohne Position bleibt jede Karte lazy - auch
  # die erste, also das LCP-Element der Kategorieseite: der Browser fand sie
  # erst nach dem Layout (mobil gedrosselt ~1,4 s nach dem Dokument).
  # Auf Seite 1 einer Kategorie laesst sich die Position aus
  # collection.products ableiten (dieselbe Sortierung und dieselben Filter wie
  # das Raster). Gesucht werden nur die ersten vier - mehr laedt card-gallery
  # ohnehin nicht eager (eager_card_limit). Ueberall sonst (Suche, Startseite,
  # Empfehlungen, Folgeseiten per Endlos-Scrollen) bleibt card_index leer und
  # die Karte wie bisher lazy.
  assign tp_card_index = nil
  if request.page_type == 'collection' and current_page == 1 and product != blank
    for tp_listed in collection.products limit: 4
      if tp_listed.id == product.id
        assign tp_card_index = forloop.index0
        break
      endif
    endfor
  endif
-%}
{% render 'card-gallery', children: children, card_index: tp_card_index %}

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-badges-styles' %}

{% render 'tp-rabatt-badge-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
