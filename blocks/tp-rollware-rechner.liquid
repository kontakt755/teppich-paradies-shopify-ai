  }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-wunsch { margin: 0 0 16px; padding: 14px; border: 1px solid var(--tp-rwc-line); border-radius: 8px; }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-wunsch-preis { margin: 10px 0 0; font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-rolle { display: block; width: 100%; height: auto; max-height: 280px; color: var(--tp-rwc-ink); }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-calc-extras { display: grid; gap: 4px; font-size: .88rem; font-variant-numeric: tabular-nums; color: var(--tp-rwc-muted); }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-karte {
