{%- comment -%}
  defer statt script_tag: nicht parser-blockierend (Theme Check). Deshalb wartet
  die Initialisierung unten auf DOMContentLoaded, falls das Asset noch nicht da
  ist - deferred Skripte laufen garantiert davor.
{%- endcomment -%}
<script src="{{ 'tp-rollware-art.js' | asset_url }}" defer></script>
<script>
function tpRwcInit{{ tp_rc_id }}() {
  var pid = {{ product.id | json }};
  var root = document.getElementById('tp-rwc-{{ tp_rc_id }}');
  var dataEl = document.querySelector('[data-rwc-data-{{ tp_rc_id }}]');
  if (!root || !dataEl) return;

  var data;
  try {
    data = JSON.parse(dataEl.textContent);
  } catch (e) {
    return;
  }
  var options = data.options || [];
  var variants = (data.variants || []).filter(function (v) { return v !== null; });

  var ART = window.TPRollwareArt;
  if (!ART) return;
  var wIdx = ART.findWidthOption(options);
  if (!variants.length) return;

  var fallbackWidthCm = parseFloat(data.fallback_width_cm) || 0;
  // true = Variantenpreis ist der Preis pro 0,01 m², Menge in 0,01-m²-Einheiten
  var cmExact = data.cm_exact === true;
  if (wIdx === -1 && fallbackWidthCm <= 0) return;

  var widths;
  if (wIdx !== -1) {
    widths = ART.numericWidths(variants, wIdx);
    if (!widths.length) return;
  } else {
    // Kein separates Rollenbreite-Produktoption vorhanden (z.B. nur eine
    // Breite im Sortiment) - feste Breite aus dem rollenbreite-Metafeld
    // uebernehmen, kein Auswahlfeld noetig.
    widths = [fallbackWidthCm];
  }

  root.style.display = '';


  // Breiten-Chips einmal fuer alle Rollenbreiten anlegen. Welche davon die
  // gewaehlte Farbe wirklich hat, blendet syncArtUi() bei jedem Rechnen ein
  // oder aus - eine Farbe mit nur der 400er-Rolle darf keine 500 anbieten.
  // Auch eine einzige Breite bekommt ihren Chip: als kraeftige Angabe, ohne
  // Schrittnummer. Vorher stand sie als graue Textzeile da und ging unter.
  var seg = root.querySelector('[data-width-seg]');
  var chipByWidth = {};
  widths.forEach(function (w, i) {
    var id = 'tp-rwc-w-{{ tp_rc_id }}-' + w;
    var input = document.createElement('input');
    input.type = 'radio';
    input.name = 'tp-rwc-width-{{ tp_rc_id }}';
    input.id = id;
    input.value = w;
    if (i === 0) input.checked = true;
    var label = document.createElement('label');
    label.className = 'tp-rwc-opt';
    label.setAttribute('for', id);
    label.textContent = w + ' cm';
    seg.appendChild(input);
    seg.appendChild(label);
    chipByWidth[w] = { input: input, label: label };
  });

  var artField = root.querySelector('[data-art-field]');
  var artRaumCard = root.querySelector('[data-art-card-raum]');
  var artRadios = root.querySelectorAll('input[name="tp-rwc-art-{{ tp_rc_id }}"]');
  var artSubMeter = root.querySelector('[data-art-sub-meter]');
  var artSubRaum = root.querySelector('[data-art-sub-raum]');
  var widthField = root.querySelector('[data-width-field]');
  var widthStep = root.querySelector('[data-width-step]');
  var widthLabel = root.querySelector('[data-width-label]');
  var wunschBox = root.querySelector('[data-wunsch-box]');
  var wunschInput = root.querySelector('[data-wunsch-input]');
  var wunschHint = root.querySelector('[data-wunsch-hint]');
  var wunschError = root.querySelector('[data-wunsch-error]');
  var meterTipp = root.querySelector('[data-meter-tipp]');
  // Block-Einstellung meterware_tipp_anzeigen: nur ein ausdrueckliches true
  // zeigt den Hinweis. Fehlt die Einstellung (aelteres Template), bleibt er aus.
  var meterTippAn = data.meter_tipp === true;
  var lengthNumber = root.querySelector('[data-length-step] .tp-step-heading__number');
  var WUNSCH_MIN_CM = 50;
  // Breiten, die es fuer die gewaehlte Farbe gibt - gesetzt von syncArtUi().
  var farbBreiten = widths.slice();
  function maxFarbBreite() { return farbBreiten.length ? farbBreiten[farbBreiten.length - 1] : 0; }
  // Raummass endet 5 cm unter der groessten Rolle - siehe ZUGABE_CM im Asset.
  function maxRaumBreite() { return ART.maxRaumBreite(farbBreiten); }
  function selectedMeterWidth() {
    var c = root.querySelector('input[name="tp-rwc-width-{{ tp_rc_id }}"]:checked');
    return c && !c.disabled ? parseFloat(c.value) : (farbBreiten[0] || widths[0]);
  }

  function artMode() {
    var r = root.querySelector('input[name="tp-rwc-art-{{ tp_rc_id }}"]:checked');
    return r && r.value === 'raum' ? 'raum' : 'meter';
  }
  function setArt(mode) {
    artRadios.forEach(function (r) { r.checked = (r.value === mode); });
  }

  var lengthInput = root.querySelector('[data-length-input]');
  var lengthEcho = root.querySelector('[data-length-echo]');
  var wunschEcho = root.querySelector('[data-wunsch-echo]');
  var stueckBox = root.querySelector('[data-stueck]');
  var stueckMass = root.querySelector('[data-stueck-mass]');
  var stueckPreis = root.querySelector('[data-stueck-preis]');

  // Eingabe-Einheit der Massfelder. Gerechnet wird immer in ganzen cm - die
  // Einheit entscheidet nur, wie ART.parseMass eine Zahl ohne Einheit liest.
  var einheitAktiv = 'cm';
  function setzeEinheit(neu) {
    neu = neu === 'm' ? 'm' : 'cm';
    if (neu === einheitAktiv) return;
    var alt = einheitAktiv;
    // Sichtbaren Wert umschreiben (350 <-> 3,50), der cm-Wert bleibt gleich.
    // Eine nicht lesbare Eingabe bleibt stehen, damit der Kunde sie sieht.
    [lengthInput, wunschInput].forEach(function (inp) {
      if (!inp) return;
      var p = ART.parseMass(inp.value, alt);
      if (!p.fehler && p.cm > 0) inp.value = ART.massWert(p.cm, neu);
    });
    zeigeEinheit(neu);
  }
  function zeigeEinheit(neu) {
    einheitAktiv = neu;
    root.querySelectorAll('[data-mass-unit]').forEach(function (el) { el.textContent = neu; });
    if (lengthInput) lengthInput.placeholder = neu === 'm' ? 'z. B. 4,00' : 'z. B. 400';
    if (wunschInput) wunschInput.placeholder = neu === 'm' ? 'z. B. 2,50' : 'z. B. 250';
  }
  // Der Browser kann beim Zurueckblaettern Umschalter UND Feldwerte
  // wiederherstellen. Dann gilt die wiederhergestellte Einheit, ohne die
  // (bereits dazu passenden) Werte umzurechnen.
  var einheitStart = root.querySelector('input[name="tp-rwc-einheit-{{ tp_rc_id }}"]:checked');
  if (einheitStart && einheitStart.value === 'm') zeigeEinheit('m');
  function zeigeGegenprobe(el, wort, input) {
    if (!el) return;
    var p = ART.parseMass(input ? input.value : '', einheitAktiv);
    var ok = !p.fehler && p.cm > 0;
    // Tippt der Kunde die Einheit mit ("3,99 m"), zeigt das Feld genau diese
    // Einheit an - sonst stuende "3,99 m" neben einem "cm".
    var unitEl = input && input.parentNode ? input.parentNode.querySelector('[data-mass-unit]') : null;
    if (unitEl) unitEl.textContent = p.fehler ? einheitAktiv : p.einheit;
    el.textContent = ok ? wort + ' ' + ART.massGegenprobe(p.cm) : '';
    el.hidden = !ok;
  }
  var errMin = root.querySelector('[data-error-min]');
  var errMax = root.querySelector('[data-error-max]');
  var beispielNote = root.querySelector('[data-beispiel]');
  var errComma = root.querySelector('[data-error-comma]');
  // Wert aus Liquid (tp_rc_max_laenge_cm), damit der Hinweis in
  // snippets/tp-formular dieselbe Zahl nennt.
  var MAX_LENGTH_CM = {{ tp_rc_max_laenge_cm }};
  // Issue 162: Laenge des Preisbeispiels vor der ersten Eingabe.
  var BEISPIEL_LAENGE_CM = 500;
  var errStock = root.querySelector('[data-error-stock]');
  var piece = root.querySelector('[data-piece]');
  var tagW = root.querySelector('[data-tag-width]');
  var tagL = root.querySelector('[data-tag-length]');
  var calcBox = root.querySelector('[data-calc]');
  var drawFigure = root.querySelector('[data-draw]');
  var formulaArea = root.querySelector('[data-formula-area]');
  var formulaRound = root.querySelector('[data-formula-round]');
  var formulaPrice = root.querySelector('[data-formula-price]');
  var outTotal = root.querySelector('[data-total]');
  var cta = root.querySelector('[data-cta]');
  var ctaHint = root.querySelector('[data-cta-hint]');
  var messRaum = root.querySelector('[data-mess-raum]');
  var cartLink = root.querySelector('[data-cart-link]');
  var widthSeg = root.querySelector('[data-width-seg]');

  // Rot markiert wird erst, wenn der Kunde den Kauf versucht hat - nicht schon
  // beim Laden. Ein Formular, das sofort rot ist, bevor irgendetwas eingegeben
  // wurde, liest sich als Fehler des Shops.
  function markInvalid(el, on) {
    if (!el) return;
    el.classList.toggle('is-invalid', !!on);
    if (el.tagName === 'INPUT') {
      if (on) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    }
  }

  function clearInvalid() {
    markInvalid(lengthInput, false);
    markInvalid(wunschInput, false);
    markInvalid(widthSeg, false);
    if (ctaHint) { ctaHint.textContent = ''; ctaHint.hidden = true; }
  }

  // Welches Pflichtfeld fehlt? Reihenfolge wie im Formular, damit der Fokus
  // nach oben springt und nicht ueber ein noch leeres Feld hinweg.
  function fehlendesFeld() {
    var raum = artMode() === 'raum';
    if (raum) {
      var wRaw = wunschInput ? wunschInput.value.trim() : '';
      if (!wRaw || ART.pruefeBreite(selectedWidth(), WUNSCH_MIN_CM, maxRaumBreite())) {
        return { el: wunschInput, feld: 'breite' };
      }
    } else if (!selectedWidth()) {
      return { el: widthSeg, feld: 'breite' };
    }
    var len = getEffectiveLengthCm();
    if (!lengthInput.value.trim() || len === -1 || len < 100 || len > MAX_LENGTH_CM) {
      return { el: lengthInput, feld: 'laenge' };
    }
    return null;
  }

  var target = null;
  // Waehrend der Warenkorb-Aufruf laeuft, darf calculate() den Button nicht
  // wieder scharf machen - sonst legt ein zweiter Klick nach einer
  // Eingabeaenderung eine zweite Zeile in den Warenkorb.
  var inFlight = false;

  function norm(s) { return String(s).toLowerCase().replace(/\s/g, ''); }
  function fmt(n) { return n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  // Flaeche im Button: ganze Quadratmeter ohne Nachkommastellen ("7 m²"),
  // krumme mit zwei ("6,66 m²") - sonst stuende dort "7,00 m²".
  function fmtArea(n) { return Number.isInteger(n) ? String(n) : fmt(n); }

  // TP-004: kaufmaennische Hundertstel-Rundung direkt aus den ganzzahligen
  // cm-Massen statt ueber den Umweg (w*len/10000)*100. Dieser Umweg macht aus
  // exakten Halbwerten (z.B. 250x333 cm -> 832,5) durch zwei verkettete
  // Gleitkommaoperationen 832,4999999999999 und rundet dann faelschlich ab.
  // Eine einzelne Division zweier ganzer Zahlen ist an .5-Grenzwerten exakt
  // (dyadischer Bruch), weil IEEE754-Division auf den naechsten darstellbaren
  // Wert rundet - ist dieser Wert exakt darstellbar, ist das Ergebnis exakt.
  function roundedHundredthsQty(wCm, lenCm) {
    return Math.round((wCm * lenCm) / 100);
  }

  // Issue 162: Preisbeispiel vor der ersten Eingabe. Rechnet mit denselben
  // Ausdruecken wie calculate() (Flaeche, Menge, abgerechnete Flaeche, Satz),
  // aendert dort aber nichts. qa/tests/tp-rollware-preisbeispiel.test.mjs
  // haelt beide Wege zusammen.
  function preisBeispiel(wCm, lenCm, priceCents, exakt) {
    var area = (wCm * lenCm) / 10000;
    var rate = exakt ? parseFloat(priceCents) : parseFloat(priceCents) / 100;
    var qty = exakt ? roundedHundredthsQty(wCm, lenCm) : Math.ceil(area);
    var billedArea = exakt ? qty / 100 : qty;
    return { area: area, billedArea: billedArea, total: billedArea * rate };
  }

  // Im Raummass-Modus ist die Breite die eigene Eingabe, sonst die Rolle.
  function selectedWidth() {
    if (wIdx === -1) return widths[0];
    if (artMode() === 'raum') {
      // Ganze cm aus cm- oder m-Eingabe. Eine absurd grosse Zahl bleibt
      // "zu breit" (pruefeBreite meldet es), statt als leer zu gelten.
      var p = ART.parseMass(wunschInput && wunschInput.value, einheitAktiv);
      if (p.fehler === 'zu_gross') return 9999999;
      return p.cm > 0 ? p.cm : 0;
    }
    var c = root.querySelector('input[name="tp-rwc-width-{{ tp_rc_id }}"]:checked');
    return c ? parseFloat(c.value) : (farbBreiten[0] || widths[0]);
  }

  function baseOptions() {
    var f = document.querySelector('form[action*="/cart/add"] input[name="id"]') ||
            document.querySelector('form[action*="/cart/add"] select[name="id"]');
    if (f && f.value) {
      var cur = variants.filter(function (v) { return String(v.id) === String(f.value); })[0];
      if (cur) return cur.options.slice();
    }
    // Auf Rollenware-Seiten gibt es kein /cart/add-Formular. Die Farbauswahl
    // meldet ihre Wahl deshalb nur ueber ?variant= in der URL. Ohne diese
    // Abfrage blieb hier immer die beim Seitenaufruf gerenderte Variante
    // stehen - der Kunde konnte eine Farbe waehlen und bekam trotzdem die
    // zuerst geladene in den Warenkorb.
    var fromUrl = new URLSearchParams(window.location.search).get('variant');
    if (fromUrl) {
      var byUrl = variants.filter(function (v) { return String(v.id) === String(fromUrl); })[0];
      if (byUrl) return byUrl.options.slice();
    }
    if (data.selected_options && data.selected_options.length) {
      return data.selected_options.slice();
    }
    var first = variants.filter(function (v) { return v.available; })[0] || variants[0];
    return first.options.slice();
  }

  // Variante zur gewaehlten Farbe (alle Optionen ausser der Breite), deren
  // Breitenwert das Praedikat erfuellt - eine Zahl oder "Wunschmaß".
  function variantFor(t, pred) {
    return variants.filter(function (v) {
      if (v.options.length !== t.length) return false;
      for (var i = 0; i < v.options.length; i++) {
        if (i === wIdx) {
          if (!pred(v.options[i])) return false;
        } else if (norm(v.options[i]) !== norm(t[i])) {
          return false;
        }
      }
      return true;
    })[0];
  }
  function byWidth(w) {
    return function (val) { return ART.toCm(val) === w; };
  }
  function findVariant(w) {
    var t = baseOptions();
    if (wIdx !== -1 && artMode() === 'raum') return variantFor(t, ART.isWunsch);
    return variantFor(t, byWidth(w));
  }
  function raumVariant() {
    return wIdx === -1 ? null : variantFor(baseOptions(), ART.isWunsch);
  }
  // EUR je m² aus dem Variantenpreis - im cm-genauen Modus steht dort der
  // Preis je 0,01 m².
  function rateOf(v) {
    if (!v) return 0;
    return cmExact ? parseFloat(v.price) : parseFloat(v.price) / 100;
  }

  // Schritt 2 je Farbe neu entscheiden: welche Rollenbreiten es gibt, ob
  // Raummass angeboten wird, und wie die Schritte heissen und zaehlen.
  //   Raummass moeglich      -> Art-Karten als Schritt 2, Laenge ist 3
  //   nur Meterware, >1 Breite -> "Waehlen Sie Ihre Breite" als Schritt 2
  //   nur Meterware, 1 Breite  -> Chip mit Label "Rollenbreite", Laenge ist 2
  function syncArtUi() {
    if (wIdx === -1) {
      if (artField) artField.hidden = true;
      if (widthField) widthField.hidden = false;
      if (widthStep) widthStep.hidden = true;
      if (widthLabel) widthLabel.hidden = false;
      if (wunschBox) wunschBox.hidden = true;
      if (lengthNumber) lengthNumber.textContent = '2';
      return;
    }
    var t = baseOptions();
    farbBreiten = [];
    widths.forEach(function (w) {
      var has = !!variantFor(t, byWidth(w));
      var chip = chipByWidth[w];
      if (chip) { chip.input.hidden = !has; chip.label.hidden = !has; chip.input.disabled = !has; }
      if (has) farbBreiten.push(w);
    });
    var checked = root.querySelector('input[name="tp-rwc-width-{{ tp_rc_id }}"]:checked');
    if ((!checked || checked.disabled) && farbBreiten.length) {
      chipByWidth[farbBreiten[0]].input.checked = true;
    }

    var rv = raumVariant();
    var raumOk = ART.wunschOk(rv, wIdx);
    if (artRaumCard) artRaumCard.hidden = !raumOk;
    artRadios.forEach(function (r) { if (r.value === 'raum') r.disabled = !raumOk; });
    if (!raumOk && artMode() === 'raum') setArt('meter');
    var raum = artMode() === 'raum';

    // Preise auf den Karten kommen aus den echten Variantenpreisen - die
    // Meterware-Karte von der gewaehlten Rolle, nicht immer von der kleinsten.
    var meterV = variantFor(t, byWidth(selectedMeterWidth()));
    if (artSubMeter) artSubMeter.textContent = 'volle Rollenbreite' + (rateOf(meterV) > 0 ? ' · ' + fmt(rateOf(meterV)) + ' €/m²' : '');
    if (artSubRaum) artSubRaum.textContent = 'eigene Breite, zentimetergenau' + (raumOk ? ' · ' + fmt(rateOf(rv)) + ' €/m²' : '');

    var multi = farbBreiten.length > 1;
    if (artField) artField.hidden = !raumOk;
    if (widthField) widthField.hidden = raum;
    if (widthStep) widthStep.hidden = !(!raumOk && multi);
    if (widthLabel) widthLabel.hidden = (!raumOk && multi);
    if (lengthNumber) lengthNumber.textContent = (raumOk || multi) ? '3' : '2';
    if (wunschBox) wunschBox.hidden = !raum;
    if (raum && wunschHint) {
      var r = ART.rolleFuer(selectedWidth(), farbBreiten);
      wunschHint.textContent = r
        ? 'Wir schneiden Ihr Stück zentimetergenau aus der ' + r + '-cm-Rolle.'
        : 'Breite von ' + WUNSCH_MIN_CM + ' bis ' + maxRaumBreite() + ' cm – die volle Rollenbreite gibt es als Meterware.';
    }
  }

  // Im Raummass sagen, wenn dasselbe Stueck als Meterware der naechsten Rolle
  // weniger kostet - gerechnet aus beiden Variantenpreisen, mit Wechsel-Knopf.
  function updateMeterTipp(raum, w, len, rateRaum) {
    if (!meterTipp) return;
    if (!meterTippAn) { meterTipp.hidden = true; return; }
    if (!raum) { meterTipp.hidden = true; return; }
    var t = baseOptions();
    // TP-004: der Rundungs-Callback bekommt von ART.meterwareGuenstiger nur
    // die bereits ueber cm²/10000 gebildete Flaeche, nicht die rohen
    // cm-Masse - derselbe Gleitkomma-Umweg wie bei der Bestellmenge. Ohne
    // Zugriff auf die Ganzzahlmasse gleicht ein winziges Epsilon vor dem
    // Runden die dabei entstehende Unterschreitung exakter .5-Grenzwerte aus
    // (gleiches Muster wie die uebrigen "- 1e-9"-Stellen in dieser Datei),
    // statt ART.meterwareGuenstiger fuer diesen Preisvergleich umzubauen.
    var cmp = ART.meterwareGuenstiger(w, len, rateRaum, farbBreiten, function (rolle) {
      return rateOf(variantFor(t, byWidth(rolle)));
    }, cmExact ? function (a) { return Math.round(a * 100 + 1e-9) / 100; } : Math.ceil);
    if (!cmp || !cmp.guenstiger) { meterTipp.hidden = true; return; }
    while (meterTipp.firstChild) meterTipp.removeChild(meterTipp.firstChild);
    meterTipp.appendChild(document.createTextNode(
      'Günstiger als Meterware? Bei dieser Breite kostet die volle ' + cmp.rolle +
      '-cm-Rolle nur ' + fmt(cmp.totalMeter) + ' € statt ' + fmt(cmp.totalRaum) + ' €. '));
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'tp-rwc-linkbtn';
    btn.textContent = 'Zu Meterware wechseln';
    btn.addEventListener('click', function () {
      setArt('meter');
      var chip = chipByWidth[cmp.rolle];
      if (chip) chip.input.checked = true;
      calculate();
    });
    meterTipp.appendChild(btn);
    meterTipp.hidden = false;
  }

  // Groesster Rahmen der Skizze. Auf dem Handy kleiner: dort ist der Platz
  // knapper, und der Rahmen bestimmt zugleich die feste Hoehe der Buehne
  // (siehe draw()). Als Funktion, damit ein Drehen des Geraets den Wert neu
  // holt - der Resize-Zuhoerer weiter unten zeichnet ohnehin neu.
  function drawMaxPx() {
    return window.matchMedia('(max-width: 749px)').matches ? 190 : 280;
  }
  var DRAW_MIN_PX = 40;
  var maxKnownWidth = widths.length ? Math.max.apply(null, widths) : 0;
  // Fester Referenzwert statt "längste aktuell gewählte Seite": so bleibt
  // 1 cm immer dieselbe Pixelgröße, unabhängig davon, welcher Wert gerade
  // geändert wurde. Breite ändern darf die Länge nicht mitverschieben (und
  // umgekehrt) - genau das war der Fehler an der alten Normierung.
  var REFERENCE_CM = Math.max(maxKnownWidth, 600);

  var stage = root.querySelector('[data-stage]');
  var serviceHint = root.querySelector('[data-service-hint]');

  function stageWidthPx() {
    if (!stage) return 280;
    var cs = getComputedStyle(stage);
    var padLeft = parseFloat(cs.paddingLeft) || 0;
    var padRight = parseFloat(cs.paddingRight) || 0;
    var raw = stage.clientWidth - padLeft - padRight;
    return raw > 0 ? raw : 280;
  }

  function draw(w, len) {
    var rolleSvg = root.querySelector('[data-rolle-svg]');
    if (rolleSvg) {
      var mitRolle = artMode() === 'raum';
      // <svg> kennt die Eigenschaft hidden nicht - nur das Attribut wirkt.
      if (mitRolle) rolleSvg.removeAttribute('hidden');
      else rolleSvg.setAttribute('hidden', '');
      if (stage) stage.hidden = mitRolle;
      if (mitRolle) {
        drawRolle(rolleSvg, w, len);
        return;
      }
    }
    var maxPx = drawMaxPx();
    // Die Buehne behaelt immer die Hoehe, die das Stueck hoechstens erreichen
    // kann. Ohne das wuchs sie mit der eingegebenen Laenge mit und schob beim
    // Tippen alles darunter nach unten - auf dem Handy um bis zu 187 px.
    // Das Stueck selbst bleibt massstaeblich und sitzt am unteren Rand.
    if (stage) stage.style.minHeight = maxPx + 'px';
    var stageW = Math.min(maxPx, stageWidthPx());
    var pxPerCm = stageW / REFERENCE_CM;

    var widthPx = Math.max(DRAW_MIN_PX, Math.min(stageW, Math.round(w * pxPerCm)));
    piece.style.width = widthPx + 'px';
    tagW.textContent = 'Breite ' + w + ' cm';

    if (!len) {
      piece.style.height = '120px';
      tagL.textContent = 'Länge – cm';
      return;
    }

    tagL.textContent = 'Länge ' + len + ' cm';
    var heightPx = Math.max(DRAW_MIN_PX, Math.min(maxPx, Math.round(len * pxPerCm)));
    piece.style.height = heightPx + 'px';
  }

  function getEffectiveLengthCm() {
    // Nachkommastellen aufrunden statt abschneiden: 150.7 wurde vorher still
    // zu 150, das Stueck waere also kuerzer als gemessen geworden. Aufrunden
    // ist die fuer den Kunden sichere Richtung.
    // Seit der cm/m-Eingabe liest ART.parseMass das Feld und liefert bereits
    // ganze, aufgerundete cm. Eine absurd grosse Zahl laeuft in die
    // Obergrenze (Beratungshinweis) und gilt nicht als leer.
    var p = ART.parseMass(lengthInput.value, einheitAktiv);
    if (p.fehler === 'zu_gross') return MAX_LENGTH_CM + 1;
    return p.cm > 0 ? p.cm : 0;
  }

  var SVG_NS = 'http://www.w3.org/2000/svg';
  function svgEl(parent, name, attrs, text) {
    var el = document.createElementNS(SVG_NS, name);
    Object.keys(attrs).forEach(function (k) { el.setAttribute(k, attrs[k]); });
    if (text) el.textContent = text;
    parent.appendChild(el);
    return el;
  }

  // Rolle von oben: Ihr Stueck, Schnittkanten und der Rest, der bei uns bleibt.
  function drawRolle(svg, w, len) {
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    var R = (w > 0 && ART.rolleFuer(w, farbBreiten)) || maxFarbBreite();
    var L = len > 0 ? len : 400;
    var x0 = 46;
    var y0 = 46;
    var sx = Math.min(240 / (L * 1.25), 150 / R);
    var sy = Math.max(sx, 70 / R);
    var rollH = R * sy;
    var pieceW = L * sx;
    var totalW = pieceW * 1.25;
    var ink = '#1d6b47';
    var defs = svgEl(svg, 'defs', {});
    var pat = svgEl(defs, 'pattern', { id: 'rwc-rest-{{ tp_rc_id }}', width: 6, height: 6, patternUnits: 'userSpaceOnUse', patternTransform: 'rotate(45)' });
    svgEl(pat, 'line', { x1: 0, y1: 0, x2: 0, y2: 6, stroke: 'currentColor', 'stroke-opacity': '.28', 'stroke-width': 2 });

    svgEl(svg, 'rect', { x: x0, y: y0, width: totalW, height: rollH, fill: 'rgba(0,0,0,.05)', stroke: 'rgba(0,0,0,.28)', 'stroke-width': 1 });
    svgEl(svg, 'ellipse', { cx: x0 + totalW, cy: y0 + rollH / 2, rx: 9, ry: rollH / 2, fill: '#e9e5de', stroke: 'rgba(0,0,0,.28)', 'stroke-width': 1 });
    svgEl(svg, 'text', { x: x0 + totalW + 16, y: y0 + rollH / 2, 'font-size': 11, fill: 'currentColor', 'text-anchor': 'middle', transform: 'rotate(90 ' + (x0 + totalW + 16) + ' ' + (y0 + rollH / 2) + ')' }, 'Rolle ' + R + ' cm');

    if (!(w > 0) || w > maxFarbBreite()) {
      svgEl(svg, 'text', { x: x0 + totalW / 2, y: y0 + rollH / 2 + 4, 'font-size': 13, 'font-weight': 600, fill: 'currentColor', 'text-anchor': 'middle' }, 'Breite eingeben');
      return;
    }
    var ph = w * sy;
    if (R > w) {
      svgEl(svg, 'rect', { x: x0, y: y0 + ph, width: pieceW, height: rollH - ph, fill: 'url(#rwc-rest-{{ tp_rc_id }})' });
      if (rollH - ph >= 16) {
        svgEl(svg, 'text', { x: x0 + pieceW / 2, y: y0 + ph + (rollH - ph) / 2 + 4, 'font-size': 11, fill: 'currentColor', 'text-anchor': 'middle' }, 'Rest bleibt bei uns');
      }
      svgEl(svg, 'line', { x1: x0 - 6, y1: y0 + ph, x2: x0 + pieceW + 6, y2: y0 + ph, stroke: ink, 'stroke-width': 1.5, 'stroke-dasharray': '5 3' });
    }
    svgEl(svg, 'rect', { x: x0, y: y0, width: pieceW, height: ph, fill: 'rgba(29,107,71,.16)', stroke: ink, 'stroke-width': 2 });
    svgEl(svg, 'line', { x1: x0 + pieceW, y1: y0 - 6, x2: x0 + pieceW, y2: y0 + rollH + 6, stroke: ink, 'stroke-width': 1.5, 'stroke-dasharray': '5 3' });
    svgEl(svg, 'text', { x: x0 + pieceW / 2, y: y0 + ph / 2 + 4, 'font-size': 12, 'font-weight': 700, fill: ink, 'text-anchor': 'middle' }, 'Ihr Stück');
    // Nur Beschriftung: die waagerechte Kante des Stuecks ist die Laenge
    // (pieceW = L * sx, entlang der abgerollten Bahn), die senkrechte die
    // Breite (ph = w * sy, quer zur Rolle). Beide Kanten tragen Wort und Wert.
    // Ist das Stueck sehr kurz gezeichnet, beginnt die Laengenangabe an der
    // linken Kante statt mittig - sonst liefe sie in die gedrehte
    // Breitenangabe links daneben.
    var lenMitte = pieceW >= 90;
    svgEl(svg, 'text', { x: lenMitte ? x0 + pieceW / 2 : x0, y: y0 - 12, 'font-size': 12, 'font-weight': 600, fill: ink, 'text-anchor': lenMitte ? 'middle' : 'start' }, 'Länge ' + (len > 0 ? len + ' cm' : '–'));
    svgEl(svg, 'text', { x: x0 - 14, y: y0 + ph / 2, 'font-size': 12, 'font-weight': 600, fill: ink, 'text-anchor': 'middle', transform: 'rotate(-90 ' + (x0 - 14) + ' ' + (y0 + ph / 2) + ')' }, 'Breite ' + w + ' cm');
  }

  var leisteBox = root.querySelector('[data-extra="leiste"]');
  var haftBox = root.querySelector('[data-extra="haft"]');
  var formulaExtras = root.querySelector('[data-formula-extras]');
  var leisteVarianten = (data.leiste || []).filter(function (v) { return v && parseFloat(v.price) > 0; });
  // Breite der Haftunterlage steht im Variantentitel ("1 mm, 180 cm breit
  // (je lfm)"). Ohne erkennbare Breite faellt die Variante weg - lieber keine
  // Unterlage anbieten als eine geratene Menge berechnen.
  var haftVarianten = (data.haft || []).filter(Boolean).map(function (v) {
    var m = String(v.title || '').match(/(\d{2,3})\s*cm/);
    return m ? { id: v.id, title: v.title, price: parseFloat(v.price), breite: parseInt(m[1], 10) } : null;
  }).filter(function (v) { return v && v.breite > 0 && v.price > 0; });

  // Zusaetze nur fuer freigegebene Teppichboeden - dieselbe Freigabe wie
  // fuer das Einfassen, damit es genau eine Wahrheit gibt.
  function extrasAllowed() {
    return !!(target && target.einfassen === 'Verfügbar');
  }

  function farbeText() {
    if (!target) return '';
    var name = target.options.filter(function (_, i) { return i !== wIdx; }).join(' ');
    return target.farbnummer ? name + ' (' + target.farbnummer + ')' : name;
  }

  function updateExtras(w, len, area) {
    // leisteInvalid (TP-003): Kunde hat die Fußleiste ausdrücklich angehakt,
    // aber keine gültige Länge hinterlassen - unterscheidet sich von "gar
    // nicht gewählt" und darf die Bestellung nicht als reinen Teppichkauf
    // durchlassen. calculate() und der Klick-Handler sperren damit den
    // Warenkorb-Request, statt das Zubehör kommentarlos wegzulassen.
    var res = { items: [], sum: 0, lines: [], leisteInvalid: false };
    var allowed = extrasAllowed();
    if (leisteBox) {
      var showL = allowed && leisteVarianten.length > 0;
      leisteBox.hidden = !showL;
      var sel = leisteBox.querySelector('[data-leiste-hoehe]');
      if (showL && sel && !sel.options.length) {
        leisteVarianten.forEach(function (v) {
          var o = document.createElement('option');
          o.value = v.id;
          o.textContent = v.title;
          sel.appendChild(o);
        });
      }
      var an = showL && leisteBox.querySelector('[data-leiste-an]').checked;
      leisteBox.querySelector('[data-leiste-felder]').hidden = !an;
      var meterIn = leisteBox.querySelector('[data-leiste-meter]');
      // Vorschlag: Umfang des Stuecks, aufgerundet. Eigene Eingabe gewinnt.
      if (meterIn && !meterIn.getAttribute('data-touched') && w > 0 && len > 0) {
        meterIn.value = Math.ceil((2 * (w + len)) / 100);
      }
      // Eingabe mit Komma oder Punkt. Abgerechnet werden volle Meter - der
      // Preis gilt je laufendem Meter, eine halbe Leiste gibt es nicht.
      // Aufgerundet wird sichtbar, nicht still.
      var eingabe = parseFloat(String((meterIn && meterIn.value) || '').replace(',', '.')) || 0;
      var m = eingabe > 0 ? Math.ceil(eingabe - 1e-9) : 0;
      res.leisteInvalid = an && m <= 0;
      var lv = leisteVarianten.filter(function (v) { return sel && String(v.id) === String(sel.value); })[0];
      var lHint = leisteBox.querySelector('[data-leiste-hint]');
      var lPreisEl = leisteBox.querySelector('[data-leiste-preis]');
      if (lPreisEl && leisteVarianten.length) {
        lPreisEl.textContent = fmt(Math.min.apply(null, leisteVarianten.map(function (v) { return parseFloat(v.price); })) / 100) + ' € / m';
      }
      if (an && lv && m > 0) {
        var lPreis = parseFloat(lv.price) / 100;
        res.items.push({
          id: lv.id,
          quantity: m,
          properties: {
            'Zu Teppichboden': data.product_title,
            'Farbe wie Teppichboden': farbeText(),
            'Höhe': lv.title,
            'Länge': m + ' m'
          }
        });
        res.sum += m * lPreis;
        res.lines.push('+ Fußleiste ' + lv.title + ': ' + m + ' m × ' + fmt(lPreis) + ' € = ' + fmt(m * lPreis) + ' €');
        if (lHint) {
          lHint.textContent = (m !== eingabe ? fmt(eingabe) + ' m werden als ' + m + ' volle Meter berechnet. ' : '') +
            fmt(lPreis) + ' € je Meter, Farbe wie Ihr Teppichboden.';
        }
      } else if (lHint) {
        lHint.textContent = an ? 'Bitte Höhe und Länge angeben. Vorschlag ist der Umfang Ihres Stücks.' : '';
      }
    }
    if (haftBox) {
      var showH = allowed && haftVarianten.length > 0;
      haftBox.hidden = !showH;
      var hAn = showH && haftBox.querySelector('[data-haft-an]').checked;
      var hHint = haftBox.querySelector('[data-haft-hint]');
      var hPreisEl = haftBox.querySelector('[data-haft-preis]');
      if (hPreisEl && haftVarianten.length) {
        hPreisEl.textContent = 'ab ' + fmt(Math.min.apply(null, haftVarianten.map(function (v) { return v.price; })) / 100) + ' € / m';
      }
      // Bahnen nebeneinander, jede in voller Laenge; abgerechnet je laufendem
      // Meter. Von den vorhandenen Breiten gewinnt die guenstigste Variante.
      var beste = null;
      if (showH && w > 0 && len > 0) {
        haftVarianten.forEach(function (v) {
          var bahnen = Math.ceil(w / v.breite - 1e-9);
          var meter = bahnen * Math.ceil(len / 100 - 1e-9);
          var summe = meter * (v.price / 100);
          if (!beste || summe < beste.summe) beste = { v: v, bahnen: bahnen, meter: meter, summe: summe };
        });
      }
      if (hHint) {
        hHint.textContent = beste
          ? beste.v.breite + ' cm breit · ' + beste.bahnen + (beste.bahnen === 1 ? ' Bahn' : ' Bahnen') + ' = ' + beste.meter + ' lfm'
          : 'Von der Rolle, Preis je laufendem Meter';
      }
      if (hAn && beste) {
        res.items.push({
          id: beste.v.id,
          quantity: beste.meter,
          properties: {
            'Zu Teppichboden': data.product_title,
            'Ausführung': beste.v.title,
            'Bahnen': String(beste.bahnen)
          }
        });
        res.sum += beste.summe;
        res.lines.push('+ Haftunterlage: ' + beste.meter + ' m × ' + fmt(beste.v.price / 100) + ' € = ' + fmt(beste.summe) + ' €');
      }
    }
    if (formulaExtras) {
      while (formulaExtras.firstChild) formulaExtras.removeChild(formulaExtras.firstChild);
      res.lines.forEach(function (l) {
        var div = document.createElement('div');
        div.textContent = l;
        formulaExtras.appendChild(div);
      });
      formulaExtras.hidden = !res.lines.length;
    }
    return res;
  }

  var einfassBox = root.querySelector('[data-einfass-box]');
  function colorKey(v) {
    return v.options.filter(function (_, i) { return i !== wIdx; }).map(norm).join('|');
  }
  // Farbe per service.basisvariante: jede Variante derselben Farbe dieses
  // Produkts fuehrt zur passenden Variante des Einfassprodukts.
  function updateEinfassChips() {
    if (!einfassBox) return;
    var show = false;
    var key = target ? colorKey(target) : '';
    einfassBox.querySelectorAll('[data-einfass-ziel]').forEach(function (a) {
      var map = (data.einfass || {})[a.getAttribute('data-einfass-ziel')] || {};
      var ziel = null;
      if (extrasAllowed()) {
        Object.keys(map).forEach(function (basisId) {
          if (ziel || basisId === '_') return;
          var bv = variants.filter(function (v) { return String(v.id) === basisId; })[0];
          if (bv && colorKey(bv) === key) ziel = map[basisId];
        });
      }
      a.hidden = !ziel;
      if (ziel) {
        var u = new URL(a.getAttribute('href'), window.location.href);
        u.searchParams.set('variant', ziel);
        a.setAttribute('href', u.href);
        show = true;
      }
    });
    einfassBox.hidden = !show;
  }

  // Nummeriert die sichtbaren Schritte durch. Gezaehlt wird nur, was der Kunde
  // wirklich sieht: die Art-Karten sind Schritt 2, die Breitenwahl entfaellt im
  // Raummass, und die Zusaetze zaehlen weiter. Vorher blieb die Art
  // ungezaehlt - "Art" und "Laenge" trugen beide die 2.
  function renumberSteps() {
    // Vor dem Rechner steht die Farbwahl als eigener Block - die faellt weg,
    // wenn das Produkt keine Farboption hat. Feste 2 haette dann bei "2"
    // begonnen, ohne dass es je eine 1 gab. Gezaehlt wird deshalb hinter den
    // Schrittzeilen, die auf der Seite sichtbar vor dem Rechner stehen.
    var davor = 0;
    Array.prototype.forEach.call(document.querySelectorAll('.tp-step-heading'), function (el) {
      if (el.offsetParent === null || root.contains(el)) return;
      if (el.compareDocumentPosition(root) & Node.DOCUMENT_POSITION_FOLLOWING) davor++;
    });
    var n = davor + 1;
    function setNum(scope) {
      var el = scope && scope.querySelector('.tp-step-heading__number');
      if (el && el.offsetParent !== null) el.textContent = String(n++);
    }
    setNum(root.querySelector('[data-art-field]'));
    setNum(root.querySelector('[data-width-field]'));
    setNum(root.querySelector('[data-length-step]'));
    root.querySelectorAll('[data-extra]').forEach(function (x) { if (!x.hidden) setNum(x); });
  }

  function calculate() {
    syncArtUi();
    var w = selectedWidth();
    var raum = artMode() === 'raum';
    // Die Zugabe greift nur im Raummass - bei Meterware bekommt der Kunde die
    // volle Rollenbreite, ein Zugabe-Satz waere dort schlicht falsch.
    if (messRaum) messRaum.hidden = !raum;
    var wErr = raum ? ART.pruefeBreite(w, WUNSCH_MIN_CM, maxRaumBreite()) : '';
    // Nicht lesbare Breite ("abc", "2,5,0", "-250"): ohne diese Pruefung
    // bliebe sie still "leer", ohne Meldung. Dieselbe Meldung wie bei der
    // Laenge. Ein Komma ist seit der cm/m-Eingabe kein Fehler mehr.
    var wFehler = (raum && wunschInput) ? ART.parseMass(wunschInput.value, einheitAktiv).fehler : '';
    var wBad = wFehler === 'ungueltig' || wFehler === 'negativ';
    if (wBad) wErr = errComma ? errComma.textContent : 'Bitte nur eine Zahl eingeben – zum Beispiel 250 (cm) oder 2,50 m.';
    if (wunschError) {
      wunschError.textContent = (raum && wErr && wErr !== 'leer') ? wErr : '';
      wunschError.hidden = !wunschError.textContent;
    }
    var len = getEffectiveLengthCm();
    var blocked = (len === -1);
    var tooLong = len > MAX_LENGTH_CM;
    var valid = !blocked && !tooLong && len >= 100 && !wErr;

    // Nicht lesbare Laenge bekommt eine klare Meldung statt einer stillen
    // Umdeutung. "150,7" und "3,5 m" sind gueltig (siehe ART.parseMass).
    var lenFehler = ART.parseMass(lengthInput.value, einheitAktiv).fehler;
    var badInput = lenFehler === 'ungueltig' || lenFehler === 'negativ';
    if (errComma) errComma.hidden = !badInput;
    zeigeGegenprobe(lengthEcho, 'Länge', lengthInput);
    zeigeGegenprobe(wunschEcho, 'Breite', raum ? wunschInput : null);

    // "0" oder "-5" sind keine leere Eingabe: dann Mindestlaenge zeigen.
    var lenEingegeben = String(lengthInput.value || '').trim() !== '';
    errMin.hidden = badInput || blocked || tooLong || !((len > 0 && len < 100) || (lenEingegeben && len === 0));
    if (errMax) {
      errMax.textContent = 'Ab ' + (MAX_LENGTH_CM / 100) + ' m Länge beraten wir Sie lieber persönlich – bitte kurz anrufen, damit Zuschnitt und Lieferung passen.';
      errMax.hidden = !tooLong;
    }

    target = findVariant(w);
    var ok = !!(target && target.available) && (!raum || ART.wunschOk(target, wIdx));
    updateEinfassChips();

    if (blocked) {
      errStock.hidden = true;
    } else if (!target) {
      errStock.textContent = 'Diese Kombination ist nicht verfügbar.';
      errStock.hidden = false;
    } else if (!target.available) {
      errStock.textContent = 'Diese Breite ist derzeit nicht lieferbar.';
      errStock.hidden = false;
    } else {
      errStock.hidden = true;
    }

    draw(w, valid ? len : 0);

    // Vor der ersten Laengeneingabe zeigten Skizze und Rechenbox nur
    // Platzhalter ("L: - cm", "-"), was wie ein defekter Rechner aussah.
    // Beide bleiben deshalb verborgen, bis eine Laenge eingegeben ist -
    // dann erscheinen sie gemeinsam mit echten Werten.
    var hasLength = len > 0 && !wErr;
    calcBox.hidden = !hasLength;
    drawFigure.hidden = !hasLength;

    // Issue 162: Preisbeispiel nur, solange das Laengenfeld leer ist und
    // Breite samt Variante feststehen.
    if (beispielNote) {
      var zeigeBeispiel = !lenEingegeben && !badInput && !wErr && w > 0 && ok;
      if (zeigeBeispiel) {
        var bsp = preisBeispiel(w, BEISPIEL_LAENGE_CM, target.price, cmExact);
        // Wird aufgerundet, muss das dastehen - sonst geht die Gleichung
        // fuer den Kunden nicht auf (derselbe Grund wie beim Aufrundungshinweis).
        var gerundet = bsp.billedArea > bsp.area + 0.0001;
        // Masse in der Einheit, die der Kunde gerade gewaehlt hat (cm oder m).
        var bspMasse = einheitAktiv === 'm'
          ? fmt(w / 100) + ' × ' + fmt(BEISPIEL_LAENGE_CM / 100) + ' m'
          : w + ' × ' + BEISPIEL_LAENGE_CM + ' cm';
        beispielNote.textContent = 'Preisbeispiel: ' + bspMasse + ' = ' + fmtArea(bsp.area) + ' m²'
          + (gerundet ? ', berechnet ' + fmtArea(bsp.billedArea) + ' m²' : '') + ' = ' + fmt(bsp.total) + ' €';
      }
      beispielNote.hidden = !zeigeBeispiel;
    }

    var extras;
    if (valid && target && ok) {
      var area = (w * len) / 10000;
      // Im cm-genauen Modus ist target.price der Preis pro 0,01 m² in Cent,
      // sonst der Preis pro m² in Cent.
      var rate = cmExact ? parseFloat(target.price) : parseFloat(target.price) / 100;
      // Menge fuer den Warenkorb: 0,01-m²-Einheiten (exakt, da alle
      // Rollenbreiten volle Meter sind) oder volle Quadratmeter (aufgerundet).
      // TP-004: aus den ganzzahligen cm-Massen (roundedHundredthsQty), nicht
      // aus der bereits gerundeten "area" - siehe Kommentar dort.
      var qty = cmExact ? roundedHundredthsQty(w, len) : Math.ceil(area);
      var billedArea = cmExact ? qty / 100 : qty;
      var total = billedArea * rate;

      formulaArea.textContent = w + ' cm × ' + len + ' cm = ' + fmt(area) + ' m²';

      // Nur der aufrundende Modus braucht einen Hinweis - sonst stuende dort
      // eine Gleichung, die fuer den Kunden nicht aufgeht.
      if (formulaRound) {
        var isRounded = !cmExact && qty > area + 0.0001;
        if (isRounded) {
          formulaRound.textContent = 'Rollenware wird in vollen m² zugeschnitten und berechnet – aufgerundet auf ' + qty + ' m².';
        }
        formulaRound.hidden = !isRounded;
      }
      formulaPrice.textContent = fmt(billedArea) + ' m² × ' + fmt(rate) + ' €/m² = ' + fmt(total) + ' €';

      // Zusammenfassung ueber dem Preis - dieselben Werte und derselbe
      // Wortlaut wie die Rechenzeilen oben, nichts wird neu gerechnet.
      if (stueckBox) {
        var gerundet = !!(formulaRound && !formulaRound.hidden);
        if (stueckMass) stueckMass.textContent = 'Ihr Stück: Breite ' + w + ' cm' + (raum ? '' : ' (volle Rolle)') + ' × Länge ' + len + ' cm = ' + fmt(area) + ' m²';
        if (stueckPreis) stueckPreis.textContent = (gerundet ? formulaRound.textContent + ' ' : '') + formulaPrice.textContent;
        stueckBox.hidden = false;
      }

      extras = updateExtras(w, len, billedArea);
      // Eine Summe auf der Seite: Teppichboden plus gewaehlte Zusaetze. Die
      // Aufteilung in Zeilen sieht der Kunde im Warenkorb.
      outTotal.textContent = fmt(total + extras.sum) + ' €';
      if (!inFlight) {
        // TP-003: angehakte, aber unvollstaendige Fussleiste haelt den Kauf
        // an - der Button darf dann nicht so aussehen, als waere alles bereit.
        cta.textContent = extras.leisteInvalid
          ? 'Bitte Fußleisten-Länge angeben'
          : fmtArea(billedArea) + ' m² in den Warenkorb' + (extras.items.length ? ' (mit Zubehör)' : '');
      }
      updateMeterTipp(raum, w, len, rate);
    } else {
      extras = updateExtras(w, 0, 0);
      updateMeterTipp(false);
      formulaArea.textContent = '– cm × – cm = –';
      formulaPrice.textContent = '–';
      if (stueckBox) stueckBox.hidden = true;
      if (formulaRound) formulaRound.hidden = true;
      outTotal.textContent = '–';
      // Die Beschriftung nennt das naechste fehlende Feld statt pauschal
      // "Laenge eingeben" - im Raummass-Modus fehlt oft zuerst die Breite.
      // Waehrend eines laufenden Warenkorb-Aufrufs bleibt "Wird hinzugefuegt" stehen.
      if (inFlight) {
        // Beschriftung nicht anfassen.
      } else if (blocked || tooLong) {
        cta.textContent = 'Bitte beraten lassen';
      } else {
        var fehlt = fehlendesFeld();
        cta.textContent = (fehlt && fehlt.feld === 'breite') ? 'Breite eingeben' : 'Länge eingeben';
      }
    }

    renumberSteps();

    // Der Button bleibt stehen. Bereit oder nicht steckt in aria-disabled und
    // der Klasse - so bleibt er fokussierbar und sein Klick meldet, was fehlt.
    // Waehrend eines laufenden /cart/add.js setzt der Klick-Handler ein echtes
    // disabled; das darf calculate() nicht ueberschreiben.
    // TP-003: eine angehakte, aber unvollstaendige Fussleiste darf den
    // Hauptkauf nicht kaufbereit erscheinen lassen - sonst faellt das
    // ausdruecklich gewaehlte Zubehoer beim Absenden kommentarlos weg.
    var ctaReady = !!(valid && ok) && !(extras && extras.leisteInvalid);
    if (!cta.disabled) {
      cta.setAttribute('aria-disabled', ctaReady ? 'false' : 'true');
      cta.classList.toggle('is-incomplete', !ctaReady);
    }
    // Sobald die Eingabe stimmt, verschwindet die rote Markierung von selbst -
    // der Kunde soll nicht erst erneut klicken muessen, um sie loszuwerden.
    if (ctaReady) clearInvalid();


    applyServiceState();
  }

  // Zuschnitt und Kettelung haengen an der gewaehlten Farbe, nicht am Produkt:
  // dieselbe Qualitaet kann in einer Farbe nur noch ueber den Zweitlieferanten
  // laufen, der keinen Zuschnitt anbietet. Die Werte kommen aus dem
  // Datenblock oben, damit der Farbwechsel ohne Neuladen auskommt.
  function serviceFor(variant) {
    var v = variant || findVariant(selectedWidth());
    return {
      wunschmass: !v || v.wunschmass !== false,
      kettelung: !v || v.kettelung !== false
    };
  }

  function applyServiceState() {
    var svc = serviceFor(target);

    // Ausgeblendet wird ueber eine Klasse am Wurzelelement, nicht ueber
    // hidden an den einzelnen Teilen. Sonst muesste diese Funktion beim
    // Zurueckschalten entscheiden, welches Teil wieder sichtbar werden darf -
    // und wuerde dabei den Button zeigen, bevor eine Laenge eingegeben ist.
    // So bleibt die Sichtbarkeit im Normalfall allein Sache von calculate().
    root.classList.toggle('tp-rwc-no-service', !svc.wunschmass);

    if (!serviceHint) return;
    if (svc.wunschmass) {
      serviceHint.hidden = true;
      return;
    }
    serviceHint.textContent = svc.kettelung
      ? 'Diese Farbe gibt es derzeit nur als ganze Rolle, nicht im Zuschnitt nach Wunschmaß. Rufen Sie uns an – wir prüfen, was für Ihren Raum möglich ist.'
      : 'Diese Farbe gibt es derzeit nur als ganze Rolle. Zuschnitt nach Wunschmaß und Kettelservice sind dafür nicht verfügbar. Rufen Sie uns an – wir prüfen, was für Ihren Raum möglich ist.';
    serviceHint.hidden = false;
  }

  root.addEventListener('change', function (e) {
    var el = e.target;
    if (el.name === 'tp-rwc-width-{{ tp_rc_id }}') calculate();
    if (el.name === 'tp-rwc-art-{{ tp_rc_id }}') calculate();
    if (el.name === 'tp-rwc-einheit-{{ tp_rc_id }}') { setzeEinheit(el.value); calculate(); }
    if (el.hasAttribute && (el.hasAttribute('data-leiste-an') || el.hasAttribute('data-haft-an') || el.hasAttribute('data-leiste-hoehe'))) calculate();
  });
  if (wunschInput) wunschInput.addEventListener('input', calculate);
  lengthInput.addEventListener('input', calculate);
  var leisteMeterInput = root.querySelector('[data-leiste-meter]');
  if (leisteMeterInput) {
    leisteMeterInput.addEventListener('input', function () {
      leisteMeterInput.setAttribute('data-touched', '1');
      calculate();
    });
  }

  window.addEventListener('resize', function () {
    var w = selectedWidth();
    var len = getEffectiveLengthCm();
    draw(w, len >= 100 ? len : 0);
  });

  document.addEventListener('change', function (e) {
    var form = e.target.closest && e.target.closest('form[action*="/cart/add"]');
    if (form) setTimeout(calculate, 100);

    // Farbwechsel: die Swatch-Auswahl schreibt ihre Variante in die URL, das
    // laeuft ohne Neuladen. Ohne dieses Nachrechnen bliebe der Rechner auf der
    // vorherigen Variante stehen - inklusive deren Preis.
    var swatch = e.target;
    if (swatch && swatch.name && swatch.name.indexOf('color-swatch') === 0) {
      setTimeout(calculate, 120);
    }
  });

  cta.addEventListener('click', function () {
    // Echtes disabled gibt es nur waehrend eines laufenden Warenkorb-Aufrufs.
    if (inFlight || cta.disabled) return;

    // Jeder Abbruchgrund bekommt eine sichtbare Antwort. Vorher kehrten alle
    // vier Pruefungen stumm zurueck - ein Klick tat dann schlicht nichts.
    var fehlt = fehlendesFeld();
    if (fehlt) {
      clearInvalid();
      markInvalid(fehlt.el, true);
      if (ctaHint) {
        var lenRaw = lengthInput.value.trim();
        var breiteFehlt = fehlt.feld === 'breite';
        // Sind beide Felder leer, nennt die Meldung auch beide - sonst tippt
        // der Kunde die Breite ein und stoesst sofort auf die naechste Huerde.
        ctaHint.textContent = (breiteFehlt && !lenRaw)
          ? 'Bitte Breite und Länge eingeben.'
          : (breiteFehlt ? 'Bitte Breite eingeben.' : 'Bitte Länge eingeben.');
        ctaHint.hidden = false;
      }
      if (fehlt.el && typeof fehlt.el.focus === 'function') {
        fehlt.el.focus({ preventScroll: false });
      }
      return;
    }

    var w = selectedWidth();
    var len = getEffectiveLengthCm();
    var raumOrder = artMode() === 'raum';

    // Letzte Sperre vor dem Warenkorb: Verfuegbarkeit haengt an der Variante,
    // nicht an der Eingabe, und fehlendesFeld() prueft sie deshalb nicht mit.
    if (!target || !target.available) {
      if (ctaHint) {
        ctaHint.textContent = target
          ? 'Diese Breite ist derzeit nicht lieferbar. Bitte eine andere Breite wählen.'
          : 'Diese Kombination ist nicht verfügbar. Bitte Farbe oder Breite ändern.';
        ctaHint.hidden = false;
      }
      markInvalid(raumOrder ? wunschInput : widthSeg, true);
      return;
    }
    if (raumOrder && !ART.wunschOk(target, wIdx)) {
      if (ctaHint) {
        ctaHint.textContent = 'Für diese Breite ist kein Zuschnitt nach Raummaß möglich. Bitte rufen Sie uns kurz an.';
        ctaHint.hidden = false;
      }
      markInvalid(wunschInput, true);
      return;
    }
    clearInvalid();

    var area = (w * len) / 10000;
    // TP-004: siehe roundedHundredthsQty()-Kommentar weiter oben - derselbe
    // Wert wie in calculate(), damit Anzeige und tatsaechlicher Request nie
    // auseinanderlaufen.
    var qty = cmExact ? roundedHundredthsQty(w, len) : Math.ceil(area);
    var billedArea = cmExact ? qty / 100 : qty;

    // Im cm-genauen Modus steht im Shopify-Admin eine ungewohnt hohe Menge
    // (z.B. 666 statt 6,66 m²) mit sehr kleinem Stueckpreis. Die Flaeche
    // gehoert deshalb lesbar in die Zeileneigenschaften.
    // "Art" zuerst, damit Admin und Kunde sofort sehen, ob aus der vollen
    // Rolle oder zentimetergenau geschnitten wird - und aus welcher Rolle.
    var properties = raumOrder
      ? { 'Art': 'Raummaß', 'Ihre Breite': w + ' cm', 'Aus Rolle': ART.rolleFuer(w, farbBreiten) + ' cm', 'Gewünschte Länge': len + ' cm' }
      : { 'Art': 'Meterware', 'Rollenbreite': w + ' cm', 'Gewünschte Länge': len + ' cm' };
    properties[cmExact ? 'Fläche' : 'Fläche (aufgerundet)'] = fmt(billedArea) + ' m²';
    // Farbnummer (intern) mitgeben - siehe domains/shopify/farbverwaltung.md.
    // Unterstrich-Property sieht nur der Admin, "Farbnummer" auch der Kunde im Warenkorb.
    if (target.farbnummer) properties['Farbnummer'] = target.farbnummer;
    if (target.farbe_intern) properties['_Farbe intern'] = target.farbe_intern;

    // Zusaetze gehen im selben Aufruf mit und tragen dieselbe _Gruppe wie der
    // Teppichboden. Ohne Zusaetze bleibt der Aufruf exakt wie bisher.
    var extras = updateExtras(w, len, billedArea);

    // TP-003: letzte Sperre direkt vor dem Request. Eine angehakte, aber
    // unvollstaendige Fussleiste darf nie kommentarlos entfallen - lHint
    // traegt bereits den passenden Hinweistext aus updateExtras().
    if (extras.leisteInvalid) {
      var meterIn = leisteBox.querySelector('[data-leiste-meter]');
      if (meterIn && typeof meterIn.focus === 'function') meterIn.focus({ preventScroll: false });
      return;
    }

    var payload = { id: target.id, quantity: qty, properties: properties };
    if (extras.items.length) {
      var gruppe = 'T' + Date.now().toString(36);
      properties['_Gruppe'] = gruppe;
      extras.items.forEach(function (it) { it.properties['_Gruppe'] = gruppe; });
      payload = { items: [{ id: target.id, quantity: qty, properties: properties }].concat(extras.items) };
    }
    var addedCount = qty + extras.items.reduce(function (sum, it) { return sum + it.quantity; }, 0);

    inFlight = true;
    cta.disabled = true;
    cta.textContent = 'Wird hinzugefügt …';
    cartLink.hidden = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (r) {
        if (!r.ok) throw new Error('add failed');
        return r.json();
      })
      .then(function (addedItem) {
        inFlight = false;
        // billedArea statt qty: im cm-genauen Modus ist qty die Menge in
        // 0,01-m2-Einheiten und wuerde "666 m2" statt "6,66 m2" melden.
        cta.textContent = fmtArea(billedArea) + ' m² hinzugefügt';
        cta.classList.add('is-done');
        cartLink.hidden = false;

        // Der native Cart-Update-Event fehlt bei diesem eigenen fetch-Aufruf
        // (kein product-form-component) - ohne ihn bleibt die Warenkorb-Bubble
        // im Header bis zum naechsten Seitenwechsel auf dem alten Stand.
        //
        // itemCount muss die tatsaechlich hinzugefuegte Menge sein: cart-icon.js
        // rechnet bei source 'product-form-component' currentCartCount + itemCount
        // und legt das Ergebnis in sessionStorage ab. Mit der frueher fest
        // verdrahteten 1 zaehlte der Header pro Kauf nur um eins hoch, waehrend
        // der Warenkorb um qty Quadratmeter wuchs - nach 8 m² stand dort 9 statt
        // 8, und der Wert driftete mit jedem weiteren Kauf weiter auseinander.
        // Die Theme-eigene product-form.js uebergibt hier ebenfalls die Menge.
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            resource: addedItem,
            sourceId: 'tp-rwc-{{ tp_rc_id }}',
            data: { itemCount: addedCount, source: 'product-form-component' }
          }
        }));

        var tpRwcDrawer = document.querySelector('cart-drawer-component');
        if (tpRwcDrawer && typeof tpRwcDrawer.open === 'function') tpRwcDrawer.open();

        // Neu rechnen statt alten Text zuruecksetzen: hat der Kunde inzwischen
        // die Laenge geaendert, stuende sonst 3 s lang die alte Flaeche im Button.
        setTimeout(function () {
          cta.classList.remove('is-done');
          cta.disabled = false;
          // Nach dem echten disabled den Zustand neu bestimmen, sonst bliebe
          // aria-disabled auf dem Stand von vor dem Warenkorb-Aufruf stehen.
          calculate();
        }, 3000);
      })
      .catch(function () {
        inFlight = false;
        cta.textContent = 'Nicht hinzugefügt – erneut versuchen';
        cta.classList.add('is-error');
        setTimeout(function () {
          cta.classList.remove('is-error');
          cta.disabled = false;
          calculate();
        }, 3000);
      });
  });

  calculate();
}
if (window.TPRollwareArt) { tpRwcInit{{ tp_rc_id }}(); }
else { document.addEventListener('DOMContentLoaded', tpRwcInit{{ tp_rc_id }}); }
</script>

