  .tp-rwc-{{ tp_rc_id }} .tp-rwc-cta.is-done { background: #145c38; }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-cta.is-error { background: #a62020; }

  .tp-rwc-{{ tp_rc_id }} .tp-rwc-cart-link { display: block; margin-top: 10px; text-align: center; font-size: .85rem; text-decoration: underline; text-underline-offset: 3px; }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-cart-link[hidden] { display: none; }

  /* Die Leiste liegt ausserhalb des Rechners im Bildschirm, deshalb ein
