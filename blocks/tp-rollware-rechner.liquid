  .tp-rwc-{{ tp_rc_id }} .tp-rwc-einfass { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--tp-rwc-line); }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-einfass-titel { margin: 0 0 8px; font-size: .9rem; font-weight: 700; }
