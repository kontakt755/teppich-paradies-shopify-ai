  }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-einfass-chip:hover { border-color: #1d6b47; color: #1d6b47; }

  @media screen and (max-width: 749px) {
    .tp-rwc-{{ tp_rc_id }} .tp-rwc-opt { flex: 1; min-width: 0; min-height: 52px; font-size: 1.05rem; }
    .tp-rwc-{{ tp_rc_id }} .tp-rwc-input { min-height: 52px; padding: 14px 46px 14px 14px; font-size: 1.05rem; }
    .tp-rwc-{{ tp_rc_id }} .tp-rwc-input--length { font-size: 1.05rem; }
