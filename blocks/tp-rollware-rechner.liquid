  .tp-rwc-{{ tp_rc_id }} .tp-rwc-check { display: flex; gap: 10px; align-items: flex-start; font-size: .92rem; cursor: pointer; }
  .tp-rwc-{{ tp_rc_id }} .tp-rwc-check input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: #1d6b47; }
