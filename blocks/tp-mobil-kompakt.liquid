{%- comment -%}
  Kopfbereich der Kategorie am Handy kompakter (Werkbank w-375): Einleitung auf zwei
  Zeilen mit "mehr", der Sprunglink "Direkt zu den Produkten" entfaellt (das Raster
  beginnt jetzt direkt darunter), die Abstaende der Sektion schrumpfen. Steht hinter
  dem Beschreibungstext in der Kopf-Sektion; der Block gibt nur auf den Kategorien aus
  snippets/tp-mobil-kompakt.liquid etwas aus, ueberall sonst nichts. Desktop bleibt
  unveraendert (alle Regeln nur bis 749 px).
{%- endcomment -%}
{%- capture tp_mk -%}{%- render 'tp-mobil-kompakt' -%}{%- endcapture -%}
{%- if tp_mk contains 'ja' -%}
  <button type="button" class="tp-mk-mehr" aria-expanded="false" data-tp-mk-mehr {{ block.shopify_attributes }}>mehr</button>
{%- endif -%}

{% stylesheet %}
  .tp-mk-mehr {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .tp-mk-mehr {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      min-height: 32px;
      margin: -6px 0 0;
      padding: 0;
      border: 0;
      background: none;
      color: var(--tp-ink, #1d1a17);
      font: inherit;
      font-size: var(--tp-fs-sm);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .tp-mk-mehr:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    /* Die Einleitung ist der zweite Textblock der Sektion (der erste ist die H1). */
    .shopify-section:has(.tp-mk-mehr[aria-expanded='false']) rte-formatter.text-block {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .shopify-section:has(.tp-mk-mehr) .tp-kategorie-produktsprung {
      display: none;
    }

    /* Kopf-Sektion: weniger Luft ueber und unter dem Text. */
    .shopify-section:has(.tp-mk-mehr) .layout-panel-flex {
      padding-block: 12px 4px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const knopf = event.target.closest('[data-tp-mk-mehr]');
    if (!knopf) return;
    const offen = knopf.getAttribute('aria-expanded') !== 'true';
    knopf.setAttribute('aria-expanded', String(offen));
    knopf.textContent = offen ? 'weniger' : 'mehr';
  });
{% endjavascript %}

{% schema %}
{
  "name": "TP Handy kompakt",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Nur Handy: kuerzt die Einleitung auf zwei Zeilen mit mehr-Knopf. Wirkt nur auf Kategorien aus snippets/tp-mobil-kompakt.liquid."
    }
  ],
  "presets": [{ "name": "TP Handy kompakt" }]
}
{% endschema %}
