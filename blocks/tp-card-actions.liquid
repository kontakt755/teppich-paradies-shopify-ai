{% doc %}
  Produktkarten mit Muster-Link und Konfigurator fuer Teppiche nach Mass.
{% enddoc %}

{%- assign tp_ca_product = closest.product -%}
{%- if tp_ca_product != blank -%}
  {%- liquid
    assign tp_ca_url = tp_ca_product.url
    assign tp_ca_teppich = false
    if tp_ca_product.metafields.custom.preis_pro_001_qm.value == true and tp_ca_product.metafields.service.einfassung.value != blank
      assign tp_ca_teppich = true
    endif

    # Farbwort im Suchbegriff (snippets/tp-suchfarbe-variante): Konfigurator-
    # und Musterlink fuehren zur selben Farbe wie Bild und Titel der Karte.
    capture tp_ca_suchfarbe
      render 'tp-suchfarbe-variante', product: tp_ca_product
    endcapture
    assign tp_ca_suchteile = tp_ca_suchfarbe | strip | split: '|'
    assign tp_ca_farbwert = ''
    if tp_ca_suchteile.size == 2
      assign tp_ca_such_pos = tp_ca_suchteile | first | plus: 0
      assign tp_ca_farbindex = tp_ca_suchteile | last | plus: 0
      assign tp_ca_suchvariante = tp_ca_product.variants[tp_ca_such_pos]
      if tp_ca_suchvariante != blank
        assign tp_ca_url = tp_ca_suchvariante.url
        assign tp_ca_farbwert = tp_ca_suchvariante.options[tp_ca_farbindex]
      endif
    endif
  -%}
  {%- capture tp_ca_sample_url -%}{%- render 'tp-musteroption', product: tp_ca_product -%}{%- endcapture -%}
  {%- assign tp_ca_sample_url = tp_ca_sample_url | strip -%}
  {%- comment -%} Wie der Musterlink der Produktseite (blocks/tp-rollware-rechner): Farbe vorauswaehlen. {%- endcomment -%}
  {%- if tp_ca_farbwert != '' and tp_ca_sample_url contains '?produkt=' -%}
    {%- assign tp_ca_farbe_url = tp_ca_farbwert | url_encode -%}
    {%- assign tp_ca_sample_url = tp_ca_sample_url | append: '&farbe=' | append: tp_ca_farbe_url -%}
  {%- endif -%}
  {%- if tp_ca_teppich or tp_ca_sample_url != blank -%}
  <div class="tp-card-actions{% if tp_ca_teppich %} tp-card-actions--teppich{% endif %}" {{ block.shopify_attributes }}>
    {%- if tp_ca_teppich -%}
      {%- comment -%}
        Groesste Masse: Breite vom Teppichboden (snippets/tp-teppich-max-breite), Laenge aus
        service.max_laenge_cm. Ohne belegte Masse bleibt es bei "Wunschmass verfuegbar".
      {%- endcomment -%}
      {%- capture tp_ca_max_b -%}{% render 'tp-teppich-max-breite', product: tp_ca_product %}{%- endcapture -%}
      {%- assign tp_ca_max_b = tp_ca_max_b | strip | times: 1 -%}
      {%- assign tp_ca_max_l = tp_ca_product.metafields.service.max_laenge_cm.value | times: 1 -%}
      <p class="tp-card-actions__hinweis">
        <svg class="tp-card-actions__hinweis-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10 8v4M13.5 8v3M17 8v4"/></svg>
        {%- if tp_ca_max_b > 0 and tp_ca_max_l > 0 -%}
          Wunschmaß bis {{ tp_ca_max_b }}&nbsp;×&nbsp;{{ tp_ca_max_l }}&nbsp;cm
        {%- else -%}
          Wunschmaß verfügbar
        {%- endif -%}
      </p>
      <a class="tp-card-actions__konfig" href="{{ tp_ca_url }}">Jetzt konfigurieren</a>
    {%- endif -%}
    {%- if tp_ca_sample_url != blank -%}
      <a
        class="tp-card-actions__sample"
        href="{{ tp_ca_sample_url }}"
      >
        {%- comment -%}
          Am Telefon stehen zwei Karten nebeneinander, die Zeile ist dann rund
          170 px breit. Dort bleibt "Muster"; erst ab 480 px kommt das Verb
          dazu. Ein Wort per CSS auszublenden ist hier richtig, weil beide
          Fassungen denselben Link meinen - Screenreader lesen die lange.
        {%- endcomment -%}
        Muster<span class="tp-card-actions__sample-verb">&nbsp;anfordern</span>
      </a>
    {%- endif -%}
  </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* Feste Klassen statt Block-ID: die Regeln stehen einmal pro Seite, nicht einmal pro Karte (Audit 2026-09-08). */
  .tp-card-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }

  /* V2 (Design-Runde 3): Muster ist eine Nebenaktion - Schwarz-Outline statt
     brauner Flaeche. Rot bleibt der Hauptaktion und dem Rabatt-Badge. */
  .tp-card-actions__sample {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 44px;
    padding: 8px 10px;
    background: transparent;
    border: 1.5px solid var(--color-foreground, #000);
    border-radius: 6px;
    color: var(--color-foreground, #000);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tp-card-actions__sample:hover {
    background: rgb(0 0 0 / 0.05);
  }

  @media screen and (max-width: 479px) {
    .tp-card-actions {
      gap: 4px;
    }

    .tp-card-actions__sample-verb {
      display: none;
    }


    .tp-card-actions__sample {
      padding-inline: 8px;
      font-size: 12.5px;
    }
  }

  /* Teppich nach Mass: Hinweis, Hauptknopf, darunter ein ruhiger Muster-Link. */
  .tp-card-actions--teppich { flex-wrap: wrap; gap: 6px 14px; }
  .tp-card-actions__hinweis { flex: 0 1 auto; display: inline-flex; align-items: center; gap: 6px; margin: 0 auto 2px 0; padding: 5px 10px; border-radius: 6px; background: rgb(0 0 0 / 0.05); color: var(--color-foreground, #000); font-size: 13px; font-weight: 600; line-height: 1.3; }
  .tp-card-actions__hinweis-icon { flex: none; }
  .tp-card-actions__konfig {
    flex: 1 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1.5px solid var(--color-foreground, #000);
    background: transparent;
    color: var(--color-foreground, #000);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
  }
  .tp-card-actions__konfig:hover { background: rgb(0 0 0 / 0.05); }
  .tp-card-actions__konfig:focus-visible { outline: 2px solid var(--color-foreground); outline-offset: 2px; }
  .tp-card-actions--teppich .tp-card-actions__sample {
    flex: 0 0 auto;
    width: auto;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.78);
    font-size: 13px;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Card-Aktionen",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "TP Card-Aktionen"
    }
  ]
}
{% endschema %}
