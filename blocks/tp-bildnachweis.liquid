{% doc %}
  Urhebervermerk fuer Herstellerbilder. Manche Bildgeber verlangen in ihren
  Nutzungsbedingungen einen Copyright-Vermerk, der sich den Aufnahmen
  zuordnen laesst. Der Wortlaut steht im Produkt-Metafeld custom.bildnachweis
  und wird unveraendert ausgegeben - so bleibt der Bildgeber aus dem Theme
  heraus, und jedes Produkt traegt genau den Vermerk seiner Bilder.
  Ohne Metafeld rendert der Block nichts.
{% enddoc %}
{%- liquid
  assign tp_bn_product = closest.product | default: product
  assign tp_bn_text = tp_bn_product.metafields.custom.bildnachweis.value | strip
-%}
{%- if tp_bn_text != blank -%}
  <p class="tp-bn" {{ block.shopify_attributes }}>
    {%- if block.settings.label != blank -%}
      {{ block.settings.label | escape }}&nbsp;
    {%- endif -%}
    {{- tp_bn_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .tp-bn {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
    color: #595959;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Bildnachweis",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Vorsatz",
      "default": "Produktbilder:"
    }
  ],
  "presets": [
    {
      "name": "TP Bildnachweis"
    }
  ]
}
{% endschema %}
