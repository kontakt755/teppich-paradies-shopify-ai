{% doc %}
  Bildbasierte Farbwahl fuer Leisten-Produktseiten. Statt bis zu 62 Textknoepfen
  zeigt der Block je Farbwert das Variantenbild als Kachel. Die Auswahl laeuft
  weiter ueber den Horizon-Variantenwaehler: ein Klick auf eine Kachel setzt
  den zugehoerigen Radio-Button (assets/tp-leisten-farbwahl.js). Warenkorb,
  Preis, Galerie und Farbanzeige reagieren also wie bisher.

  Zwei Regeln halten Bild und Bezeichnung ehrlich:

  1. Eine Bildkachel entsteht nur, wenn das Variantenbild genau zu dieser
     einen Farbe gehoert. Teilen sich mehrere Farben dasselbe Bild, ist das
     ein generisches Produktfoto und kein Farbmuster - diese Farben landen in
     der Textliste "Weitere Farben". Ein geteiltes Foto als Farbkachel zu
     zeigen behauptet eine Zuordnung, die die Daten nicht hergeben.
  2. Die sichtbare Bezeichnung kommt aus 'tp-farbe-daten' (feld: 'name'), also
     der einen Stelle, die interne Farbnummern vom Kundennamen trennt. Der
     Wert im data-Attribut bleibt der rohe Optionswert - nur so trifft der
     Klick weiterhin exakt den richtigen Radio-Button.

  Ohne JavaScript bleibt der Block verborgen und der normale Variantenwaehler
  sichtbar; mit JavaScript wird der Variantenwaehler nur visuell versteckt,
  bleibt aber im DOM und fuer Screenreader erreichbar.

  Hinweis fuer Produkte mit mehreren Optionen (Farbe + Breite): dort teilen
  sich Varianten derselben Farbe legitim ein Bild und rutschen in die
  Textliste. Das ist die sichere Richtung - lieber kein Bild als ein falsches.
{% enddoc %}

{%- liquid
  assign tp_fw_product = closest.product | default: product
  assign tp_fw_position = 0
  for tp_fw_option in tp_fw_product.options_with_values
    assign tp_fw_name = tp_fw_option.name | downcase
    if tp_fw_name contains 'farbe' or tp_fw_name contains 'dekor' or tp_fw_name contains 'color'
      assign tp_fw_position = tp_fw_option.position
      assign tp_fw_values = tp_fw_option.values
      assign tp_fw_label = tp_fw_option.name
      assign tp_fw_selected = tp_fw_option.selected_value
      break
    endif
  endfor
-%}

{%- if tp_fw_position > 0 and tp_fw_values.size > 1 -%}
  {%- assign tp_fw_index = tp_fw_position | minus: 1 -%}

  {%- comment -%}
    Ein Durchlauf ueber die Varianten sammelt alle Bild-IDs. Kommt eine ID
    mehrfach vor, ist das Bild nicht farbspezifisch.
  {%- endcomment -%}
  {%- capture tp_fw_media_ids -%}
    {%- for tp_fw_v in tp_fw_product.variants -%}
      {%- if tp_fw_v.featured_media != blank -%}[{{ tp_fw_v.featured_media.id }}]{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  <script src="{{ 'tp-leisten-farbwahl.js' | asset_url }}" defer></script>
  <div
    class="tp-lfw"
    data-tp-farbwahl
    data-tp-farbwahl-option="{{ tp_fw_label | escape }}"
    hidden
    {{ block.shopify_attributes }}
  >
    <p class="tp-lfw__label">
      {{ tp_fw_label | escape }}:
      <span class="tp-lfw__current" data-tp-farbwahl-current>{{ tp_fw_selected | escape }}</span>
      <span class="tp-lfw__count">{{ tp_fw_values.size }} zur Auswahl</span>
    </p>

    {%- capture tp_fw_bildkacheln -%}
      {%- for tp_fw_value in tp_fw_values -%}
        {%- render 'tp-leisten-farbkachel',
          value: tp_fw_value,
          product: tp_fw_product,
          index: tp_fw_index,
          selected: tp_fw_selected,
          media_ids: tp_fw_media_ids,
          modus: 'bild'
        -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture tp_fw_textkacheln -%}
      {%- for tp_fw_value in tp_fw_values -%}
        {%- render 'tp-leisten-farbkachel',
          value: tp_fw_value,
          product: tp_fw_product,
          index: tp_fw_index,
          selected: tp_fw_selected,
          media_ids: tp_fw_media_ids,
          modus: 'text'
        -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign tp_fw_hat_bilder = tp_fw_bildkacheln | strip -%}
    {%- assign tp_fw_hat_texte = tp_fw_textkacheln | strip -%}

    {%- if tp_fw_hat_bilder != blank -%}
      <div class="tp-lfw__grid" role="group" aria-label="{{ tp_fw_label | escape }} nach Musterbild wählen">
        {{ tp_fw_bildkacheln }}
      </div>
    {%- endif -%}

    {%- if tp_fw_hat_texte != blank -%}
      {%- if tp_fw_hat_bilder != blank -%}
        <p class="tp-lfw__hinweis">
          Für die folgenden Farben liegt uns noch kein Musterbild vor. Ein
          kostenloses Muster können Sie unten anfragen.
        </p>
      {%- endif -%}
      <div class="tp-lfw__liste" role="group" aria-label="Weitere {{ tp_fw_label | escape }}n wählen">
        {{ tp_fw_textkacheln }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-lfw {
    display: grid;
    gap: 10px;
    width: 100%;
  }

  .tp-lfw__label {
    margin: 0;
    font-size: 0.9375rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .tp-lfw__current {
    font-weight: 650;
    color: var(--color-foreground);
  }

  .tp-lfw__count {
    margin-inline-start: 8px;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .tp-lfw__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tp-lfw__tile {
    position: relative;
    display: block;
    width: 52px;
    height: 52px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color var(--animation-speed, 0.15s) var(--animation-easing, ease);
  }

  .tp-lfw__tile:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  .tp-lfw__tile:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .tp-lfw__tile[aria-pressed='true'] {
    border-color: var(--color-foreground);
    box-shadow: inset 0 0 0 2px #fff, inset 0 0 0 3px var(--color-foreground);
  }

  .tp-lfw__liste {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tp-lfw__hinweis {
    margin: 4px 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  /* Farben ohne eigenes Musterbild: der Name traegt die Kachel */
  .tp-lfw__tile--text {
    display: inline-flex;
    align-items: center;
    width: auto;
    height: auto;
    min-height: 44px;
    padding: 8px 12px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .tp-lfw__text {
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-foreground);
    text-align: start;
  }

  .tp-lfw__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tp-lfw__tile--text {
    display: inline-flex;
    align-items: center;
    width: auto;
    height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .tp-lfw__name {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-foreground);
  }

  /* Horizon-Variantenwaehler nur visuell verstecken, sobald die Kacheln aktiv sind */
  .tp-lfw-picker-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
  }

  @media screen and (max-width: 749px) {
    .tp-lfw__grid {
      gap: 6px;
    }

    .tp-lfw__tile {
      width: 46px;
      height: 46px;
    }

    .tp-lfw__tile--text {
      width: auto;
      height: 44px;
    }
  }
{% endstylesheet %}

