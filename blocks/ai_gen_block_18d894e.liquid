{% doc %}
  @prompt
    Grid Layout, wo man bestimmen kann wie viele Kacheln pro Reihe sind. Eine Kachel soll aus Bild, Titel, Button bestehen, Die Kacheln sollen voneinander mit einem border getrennt sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tile-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-tile-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-tile-grid__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.tile_background_color }};
    border-radius: {{ block.settings.tile_border_radius }}px;
    border: {{ block.settings.tile_border_width }}px {{ block.settings.tile_border_style }} {{ block.settings.tile_border_color }};
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-tile-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-tile-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-tile-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-tile-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tile-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-tile-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.tile_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .ai-tile-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-tile-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-align: center;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-tile-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-tile-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-tile-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tile-grid__container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign tile_enabled_key = 'tile_' | append: i | append: '_enabled'
        assign tile_image_key = 'tile_' | append: i | append: '_image'
        assign tile_title_key = 'tile_' | append: i | append: '_title'
        assign tile_button_text_key = 'tile_' | append: i | append: '_button_text'
        assign tile_button_link_key = 'tile_' | append: i | append: '_button_link'

        assign tile_enabled = block.settings[tile_enabled_key]
        assign tile_image = block.settings[tile_image_key]
        assign tile_title = block.settings[tile_title_key]
        assign tile_button_text = block.settings[tile_button_text_key]
        assign tile_button_link = block.settings[tile_button_link_key]
      %}

      {% if tile_enabled %}
        <div class="ai-tile-grid__item-{{ ai_gen_id }}">
          <div class="ai-tile-grid__image-wrapper-{{ ai_gen_id }}">
            {% if tile_image %}
              <img
                src="{{ tile_image | image_url: width: 800 }}"
                alt="{{ tile_image.alt | escape }}"
                loading="lazy"
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
                class="ai-tile-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-tile-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-tile-grid__content-{{ ai_gen_id }}">
            {% if tile_title != blank %}
              <h3 class="ai-tile-grid__title-{{ ai_gen_id }}">{{ tile_title }}</h3>
            {% endif %}

            {% if tile_button_text != blank %}
              <a
                href="{{ tile_button_link }}"
                class="ai-tile-grid__button-{{ ai_gen_id }}"
              >
                {{ tile_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

