{% doc %}
  Farbvarianten als kleine Vorschaubilder auf der Produktkarte.

  Zeigt pro Farbwert genau EIN Thumbnail (nicht pro Variante) - bei
  Teppichboden hat dieselbe Farbe oft mehrere Breiten-/Laengenvarianten,
  die sonst alle dasselbe Bild doppelt anzeigen wuerden.

  Hat eine Farbe kein Variantenbild, greift der Swatch aus dem Farbregister
  (tp_farbe). Sauberlauf etwa fuehrt 12 echte Farbvarianten, aber kein Foto je
  Farbe - die Karte blieb dadurch leer, obwohl die Farben kaufbar sind.

  Faellt still aus, wenn das Produkt keine Farboption hat: Fixpreis- und
  Rollenware-Karten ohne Farbauswahl bleiben damit unveraendert.

  Genau eine Zeile (Shopvergleich 2026-10-15): Vorher brachen die Felder um,
  auf dem Handy in drei Zeilen, und schoben den Musterknopf je Karte anders
  weit nach unten. Wie viele Felder neben "+N" passen, haengt von der
  Kartenbreite ab - die kennt nur der Browser. Deshalb rechnet Liquid fuer
  jede moegliche Platzzahl den Rest vor (data-rest-N, Klasse --eng-N) und
  eine Container Query auf die Feldzeile waehlt die passende Stufe.
{% enddoc %}

{%- liquid
  assign tp_ct_product = closest.product
  assign tp_ct_max = block.settings.max_thumbs | default: 6

  # Farboption suchen. Shopify erlaubt frei benannte Optionen, deshalb
  # beide gaengigen Schreibweisen pruefen statt auf "Farbe" zu bestehen.
  assign tp_ct_position = 0
  for tp_ct_option in tp_ct_product.options_with_values
    assign tp_ct_name = tp_ct_option.name | downcase
    if tp_ct_name contains 'farbe' or tp_ct_name contains 'color' or tp_ct_name contains 'dekor'
      assign tp_ct_position = tp_ct_option.position
      assign tp_ct_values = tp_ct_option.values
      break
    endif
  endfor
-%}

{%- if tp_ct_position > 0 and tp_ct_values.size > 1 -%}
  {%- liquid
    assign tp_ct_index = tp_ct_position | minus: 1
    assign tp_ct_shown = 0
  -%}

  {%- capture tp_ct_felder -%}
    {%- for tp_ct_value in tp_ct_values -%}
      {%- if tp_ct_shown >= tp_ct_max -%}
        {%- break -%}
      {%- endif -%}

      {%- liquid
        # Erste Variante mit diesem Farbwert suchen, die auch ein Bild hat.
        assign tp_ct_match = null
        for tp_ct_variant in tp_ct_product.variants
          if tp_ct_variant.options[tp_ct_index] == tp_ct_value and tp_ct_variant.featured_media != blank
            assign tp_ct_match = tp_ct_variant
            break
          endif
        endfor

        # Ohne Bild: irgendeine Variante dieser Farbe nehmen und den Swatch
        # aus dem Farbregister zeigen. Ein Farbfeld sagt mehr als eine leere
        # Karte - und mehr als ein Foto, das eine andere Farbe zeigt.
        assign tp_ct_swatch = ''
        assign tp_ct_fallback = null
        unless tp_ct_match
          for tp_ct_variant in tp_ct_product.variants
            if tp_ct_variant.options[tp_ct_index] == tp_ct_value
              assign tp_ct_fallback = tp_ct_variant
              break
            endif
          endfor
          if tp_ct_fallback
            capture tp_ct_swatch
              render 'tp-farbe-daten', variant: tp_ct_fallback, product: tp_ct_product, feld: 'swatch'
            endcapture
            assign tp_ct_swatch = tp_ct_swatch | strip
          endif
        endunless
      -%}

      {%- if tp_ct_match == null and tp_ct_swatch != blank -%}
        {%- assign tp_ct_shown = tp_ct_shown | plus: 1 -%}
        <a
          class="tp-card-color-thumbs__item tp-card-color-thumbs__item--farbe"
          href="{{ tp_ct_fallback.url }}"
          title="{{ tp_ct_value | escape }}"
          aria-label="{{ tp_ct_value | escape }}"
          style="--tp-ct-farbe: {{ tp_ct_swatch }}"
        ></a>
      {%- elsif tp_ct_match -%}
        {%- assign tp_ct_shown = tp_ct_shown | plus: 1 -%}
        <a
          class="tp-card-color-thumbs__item"
          href="{{ tp_ct_match.url }}"
          title="{{ tp_ct_value | escape }}"
          aria-label="{{ tp_ct_value | escape }}"
        >
          {%- if tp_ct_match.featured_media.aspect_ratio < 1 -%}
          {{ tp_ct_match.featured_media | image_url: width: 80, height: 80, crop: 'center' | image_tag:
              loading: 'lazy',
              width: 40,
              height: 40,
              class: 'tp-card-color-thumbs__image',
              alt: tp_ct_value }}
          {%- else -%}
          {{ tp_ct_match.featured_media | image_url: width: 80 | image_tag:
              loading: 'lazy',
              width: 40,
              height: 40,
              class: 'tp-card-color-thumbs__image',
              alt: tp_ct_value }}
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    assign tp_ct_gesamt = tp_ct_values.size
    assign tp_ct_rest = tp_ct_gesamt | minus: tp_ct_shown
    # Plaetze, die die volle Zeile braucht: alle gezeigten Felder plus "+N".
    assign tp_ct_bedarf = tp_ct_shown
    if tp_ct_rest > 0
      assign tp_ct_bedarf = tp_ct_bedarf | plus: 1
    endif
    # Je Platzzahl n (1 bis 12, siehe Stylesheet), die nicht reicht: Klasse
    # --eng-n und der Rest, wenn nur n - 1 Felder plus "+N" stehen.
    assign tp_ct_klassen = ''
    assign tp_ct_daten = ''
    for tp_ct_n in (1..12)
      if tp_ct_bedarf > tp_ct_n
        assign tp_ct_rest_n = tp_ct_gesamt | minus: tp_ct_n | plus: 1
        assign tp_ct_klassen = tp_ct_klassen | append: ' tp-card-color-thumbs--eng-' | append: tp_ct_n
        assign tp_ct_daten = tp_ct_daten | append: ' data-rest-' | append: tp_ct_n | append: '="+' | append: tp_ct_rest_n | append: '"'
      endif
    endfor
  -%}

  {%- if tp_ct_shown > 0 -%}
    <div
      class="tp-card-color-thumbs{% if tp_ct_rest > 0 %} tp-card-color-thumbs--rest{% endif %}{{ tp_ct_klassen }}"
      {{ block.shopify_attributes }}
    >
      {{- tp_ct_felder -}}
      {%- if tp_ct_bedarf > 1 -%}
        <span class="tp-card-color-thumbs__more" aria-hidden="true" data-rest="+{{ tp_ct_rest }}"{{ tp_ct_daten }}></span>
      {%- endif -%}
      <span class="visually-hidden">{{ tp_ct_gesamt }} Farben</span>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* Eine Zeile: Feld 44 px, Abstand 6 px, also 50 px je Platz. Die Zeile ist
     ihr eigener Container (tp-farben); width: 100 %, weil eine Flexspalte mit
     align-items: flex-start sie sonst auf ihren Inhalt schrumpfen liesse - mit
     inline-size-Containment hiesse das Breite 0. */
  .tp-card-color-thumbs {
    container: tp-farben / inline-size;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 6px;
    width: 100%;
    align-self: stretch;
    margin: 4px 0 0;
    overflow: hidden;
  }

  .tp-card-color-thumbs__item {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .tp-card-color-thumbs__item--farbe {
    background: var(--tp-ct-farbe, transparent);
    box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb, 34 34 34) / 0.18);
  }

  .tp-card-color-thumbs__item:hover,
  .tp-card-color-thumbs__item:focus-visible {
    border-color: var(--color-foreground);
    transform: scale(1.08);
  }

  /* Zwei Bildsorten liegen an den Varianten: flache Farbkacheln und
     Produktfotos der Leiste. Ein enger Mittenausschnitt macht aus beiden
     dieselbe ruhige Farbflaeche - bei der flachen Kachel aendert er nichts,
     beim Foto zeigt er die Sichtflaeche statt Wand und Boden. */
  /* Das Bild kommt quadratisch mittig beschnitten vom CDN (Perf Runde 3) -
     sichtbar ist ohnehin nur die Mitte; der Ausschnitt bleibt derselbe. */
  .tp-card-color-thumbs__image {
    width: 170%;
    height: 170%;
    margin: -35%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  /* "+N": Zahl aus data-rest bzw. data-rest-N (Stufe je nach Breite). Fuer
     Screenreader steht die Gesamtzahl der Farben unsichtbar daneben. */
  .tp-card-color-thumbs__more {
    display: none;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-width: 44px;
    height: 44px;
    padding-inline: 6px;
    border-radius: 6px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    font-size: var(--font-size--xs);
    font-weight: 600;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  .tp-card-color-thumbs--rest > .tp-card-color-thumbs__more {
    display: inline-flex;
  }

  .tp-card-color-thumbs__more::before {
    content: attr(data-rest);
  }

  /* Kein Verkleinern auf dem Handy: 44 px ist die kleinste Flaeche, die sich
     zuverlaessig treffen laesst. Bei zwei Karten je Reihe stehen dort zwei
     Felder plus "+N". Stufen absteigend: die schmalere gewinnt. */
  @container tp-farben (width < 644px) {
    .tp-card-color-thumbs--eng-12 > .tp-card-color-thumbs__item:nth-of-type(n + 12) { display: none; }
    .tp-card-color-thumbs--eng-12 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-12 > .tp-card-color-thumbs__more::before { content: attr(data-rest-12); }
  }

  @container tp-farben (width < 594px) {
    .tp-card-color-thumbs--eng-11 > .tp-card-color-thumbs__item:nth-of-type(n + 11) { display: none; }
    .tp-card-color-thumbs--eng-11 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-11 > .tp-card-color-thumbs__more::before { content: attr(data-rest-11); }
  }

  @container tp-farben (width < 544px) {
    .tp-card-color-thumbs--eng-10 > .tp-card-color-thumbs__item:nth-of-type(n + 10) { display: none; }
    .tp-card-color-thumbs--eng-10 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-10 > .tp-card-color-thumbs__more::before { content: attr(data-rest-10); }
  }

  @container tp-farben (width < 494px) {
    .tp-card-color-thumbs--eng-9 > .tp-card-color-thumbs__item:nth-of-type(n + 9) { display: none; }
    .tp-card-color-thumbs--eng-9 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-9 > .tp-card-color-thumbs__more::before { content: attr(data-rest-9); }
  }

  @container tp-farben (width < 444px) {
    .tp-card-color-thumbs--eng-8 > .tp-card-color-thumbs__item:nth-of-type(n + 8) { display: none; }
    .tp-card-color-thumbs--eng-8 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-8 > .tp-card-color-thumbs__more::before { content: attr(data-rest-8); }
  }

  @container tp-farben (width < 394px) {
    .tp-card-color-thumbs--eng-7 > .tp-card-color-thumbs__item:nth-of-type(n + 7) { display: none; }
    .tp-card-color-thumbs--eng-7 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-7 > .tp-card-color-thumbs__more::before { content: attr(data-rest-7); }
  }

  @container tp-farben (width < 344px) {
    .tp-card-color-thumbs--eng-6 > .tp-card-color-thumbs__item:nth-of-type(n + 6) { display: none; }
    .tp-card-color-thumbs--eng-6 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-6 > .tp-card-color-thumbs__more::before { content: attr(data-rest-6); }
  }

  @container tp-farben (width < 294px) {
    .tp-card-color-thumbs--eng-5 > .tp-card-color-thumbs__item:nth-of-type(n + 5) { display: none; }
    .tp-card-color-thumbs--eng-5 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-5 > .tp-card-color-thumbs__more::before { content: attr(data-rest-5); }
  }

  @container tp-farben (width < 244px) {
    .tp-card-color-thumbs--eng-4 > .tp-card-color-thumbs__item:nth-of-type(n + 4) { display: none; }
    .tp-card-color-thumbs--eng-4 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-4 > .tp-card-color-thumbs__more::before { content: attr(data-rest-4); }
  }

  @container tp-farben (width < 194px) {
    .tp-card-color-thumbs--eng-3 > .tp-card-color-thumbs__item:nth-of-type(n + 3) { display: none; }
    .tp-card-color-thumbs--eng-3 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-3 > .tp-card-color-thumbs__more::before { content: attr(data-rest-3); }
  }

  @container tp-farben (width < 144px) {
    .tp-card-color-thumbs--eng-2 > .tp-card-color-thumbs__item:nth-of-type(n + 2) { display: none; }
    .tp-card-color-thumbs--eng-2 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-2 > .tp-card-color-thumbs__more::before { content: attr(data-rest-2); }
  }

  @container tp-farben (width < 94px) {
    .tp-card-color-thumbs--eng-1 > .tp-card-color-thumbs__item:nth-of-type(n + 1) { display: none; }
    .tp-card-color-thumbs--eng-1 > .tp-card-color-thumbs__more { display: inline-flex; }
    .tp-card-color-thumbs--eng-1 > .tp-card-color-thumbs__more::before { content: attr(data-rest-1); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Farb-Varianten",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "max_thumbs",
      "label": "Maximale Anzahl Farben",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "TP Farb-Varianten"
    }
  ]
}
{% endschema %}
