{% doc %}
  Kompakter Vorteilsbereich direkt nach Titel/Preis - nur fuer Teppiche
  (eigenstaendig, nicht die Bodenbelag-Variante tp-vorteile). Zeigt
  ausschliesslich Werte, die am Produkt tatsaechlich als Metafeld gesetzt
  sind. Maximal 3 Eintraege, damit der Kaufbereich ruhig bleibt.
{% enddoc %}

{%- liquid
  assign tp_tv_id = block.id | replace: '_', '' | downcase
  assign tp_tv_items = ''
  assign tp_tv_count = 0
  assign tp_tv_max = 3
-%}

{%- capture tp_tv_material -%}{{ product.metafields.custom.material.value }}{%- endcapture -%}
{%- assign tp_tv_material = tp_tv_material | strip -%}
{%- if tp_tv_material != blank and tp_tv_count < tp_tv_max -%}
  {%- capture tp_tv_items -%}{{ tp_tv_items }}|{{ tp_tv_material }}{%- endcapture -%}
  {%- assign tp_tv_count = tp_tv_count | plus: 1 -%}
{%- endif -%}

{%- capture tp_tv_florhohe -%}{{ product.metafields.custom.florhohe.value }}{%- endcapture -%}
{%- assign tp_tv_florhohe = tp_tv_florhohe | strip -%}
{%- if tp_tv_florhohe != blank and tp_tv_count < tp_tv_max -%}
  {%- capture tp_tv_items -%}{{ tp_tv_items }}|Florhöhe {{ tp_tv_florhohe }}{%- endcapture -%}
  {%- assign tp_tv_count = tp_tv_count | plus: 1 -%}
{%- endif -%}

{%- assign tp_tv_heating_mf = product.metafields.custom.fusbodenheizung -%}
{%- assign tp_tv_heating_val = tp_tv_heating_mf.value -%}
{%- assign tp_tv_heating = tp_tv_heating_val.fusbodenheizung.value | default: tp_tv_heating_val.fusbodenheizung | default: tp_tv_heating_val.name | default: tp_tv_heating_val -%}
{%- if tp_tv_heating == 'Ja' and tp_tv_count < tp_tv_max -%}
  {%- capture tp_tv_items -%}{{ tp_tv_items }}|Fußbodenheizung geeignet{%- endcapture -%}
  {%- assign tp_tv_count = tp_tv_count | plus: 1 -%}
{%- endif -%}

{%- assign tp_tv_wunschmass_preis = product.metafields.custom.wunschmass_mindestbreite_cm.value -%}
{%- if tp_tv_wunschmass_preis != blank and tp_tv_count < tp_tv_max -%}
  {%- capture tp_tv_items -%}{{ tp_tv_items }}|Auch im Wunschmaß erhältlich{%- endcapture -%}
  {%- assign tp_tv_count = tp_tv_count | plus: 1 -%}
{%- endif -%}

{%- assign tp_tv_list = tp_tv_items | split: '|' -%}

{%- if tp_tv_count > 0 -%}
  <ul class="tp-teppich-vorteile-{{ tp_tv_id }}" {{ block.shopify_attributes }}>
    {%- for entry in tp_tv_list -%}
      {%- if entry != blank -%}
        <li>{{ entry | strip }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  <style>
    .tp-teppich-vorteile-{{ tp_tv_id }} {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 16px;
      margin: 12px 0 0 0;
      padding: 0;
      list-style: none;
    }

    .tp-teppich-vorteile-{{ tp_tv_id }} li {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.5;
      color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.85);
    }

    .tp-teppich-vorteile-{{ tp_tv_id }} li::before {
      content: '';
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      background: linear-gradient(135deg, #008a2e 0%, #006b23 100%);
      border-radius: 50%;
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      flex: 0 0 auto;
    }

    .tp-teppich-vorteile-{{ tp_tv_id }} li::before {
      content: '✓';
    }

    @media screen and (max-width: 749px) {
      .tp-teppich-vorteile-{{ tp_tv_id }} {
        gap: 8px 12px;
        margin-top: 8px;
      }

      .tp-teppich-vorteile-{{ tp_tv_id }} li {
        font-size: 14px;
      }

      .tp-teppich-vorteile-{{ tp_tv_id }} li::before {
        width: 18px;
        height: 18px;
        font-size: 11px;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "TP Teppich Vorteile",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "TP Teppich Vorteile"
    }
  ]
}
{% endschema %}
