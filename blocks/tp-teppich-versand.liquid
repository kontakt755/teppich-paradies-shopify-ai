{% doc %}
  Kaufservice-/Lieferzone fuer Teppiche - eigenstaendiger Block, NICHT
  tp-service-links (Bodenbelag/Rollenware). Zeigt bewusst keine pauschale
  "frei Bordsteinkante"-Aussage, da Teppiche in Standardgroessen ueblicherweise
  per Paketdienst verschickt werden. Nur wenn ein Produkt ueber das optionale
  Metafeld custom.versandart explizit als Speditionsware markiert ist (z.B.
  sehr grosse Sonderformate), wird die Speditions-Formulierung inkl.
  Bordsteinkante-Erklaerung angezeigt. Ohne dieses Metafeld gilt Paketversand
  als Standardfall fuer Teppiche.
{% enddoc %}

{%- liquid
  assign tp_tv2_id = block.id | replace: '_', '' | downcase
  # Ziel des Muster-Links: siehe snippets/tp-musteroption
  capture tp_tv2_sample_url
    render 'tp-musteroption', product: product
  endcapture
  assign tp_tv2_sample_url = tp_tv2_sample_url | strip
  assign tp_tv2_delivery_time = block.settings.delivery_time | strip
  assign tp_tv2_shipping_page = pages['versand-lieferung']
  assign tp_tv2_versandart = product.metafields.custom.versandart.value | downcase | strip
-%}

<div class="tp-teppich-versand-{{ tp_tv2_id }}" {{ block.shopify_attributes }}>
  <a class="tp-teppich-versand__sample-{{ tp_tv2_id }}" href="{{ tp_tv2_sample_url }}">
    Kostenloses Muster anfragen
  </a>

  <div class="tp-teppich-versand__shipping-{{ tp_tv2_id }}" aria-label="Lieferung und Versand">
    {%- if tp_tv2_delivery_time != blank -%}
      <p><strong>Lieferzeit:</strong> {{ tp_tv2_delivery_time | escape }}</p>
    {%- endif -%}

    {%- if tp_tv2_versandart == 'spedition' -%}
      <p><strong>Speditionsversand</strong></p>
      <p>Aufgrund der Größe wird dieser Teppich per Spedition frei Bordsteinkante geliefert.</p>

      <details class="tp-teppich-versand__shipping-details-{{ tp_tv2_id }}">
        <summary>Was bedeutet „frei Bordsteinkante“?</summary>
        <p>
          Die Spedition bringt die Ware bis zur nächstmöglichen, für das Lieferfahrzeug erreichbaren Stelle an
          Ihrer Lieferadresse. Der Weitertransport ins Gebäude oder in die Wohnung ist nicht Bestandteil der
          Lieferung.
        </p>
        {%- if tp_tv2_shipping_page != blank -%}
          <a href="{{ tp_tv2_shipping_page.url }}">Alle Versanddetails</a>
        {%- endif -%}
      </details>
    {%- else -%}
      <p><strong>Versand per Paketdienst</strong></p>
      <p>Bequeme Lieferung direkt zu Ihrer Haus- bzw. Wohnungstür.</p>

      <details class="tp-teppich-versand__shipping-details-{{ tp_tv2_id }}">
        <summary>Wie läuft die Lieferung ab?</summary>
        <p>
          Ihr Teppich wird versandfertig verpackt und über einen gängigen Paketdienst zugestellt. Die konkreten
          Versandkosten werden im Checkout vor Abschluss der Bestellung angezeigt.
        </p>
        {%- if tp_tv2_shipping_page != blank -%}
          <a href="{{ tp_tv2_shipping_page.url }}">Alle Versanddetails</a>
        {%- endif -%}
      </details>
    {%- endif -%}
  </div>

  <div class="tp-teppich-versand__secondary-{{ tp_tv2_id }}">
    <a href="tel:+4933015733720">Beratung: 03301 573 37 20</a>
    <span aria-hidden="true">·</span>
    <a href="https://wa.me/4917657931322" target="_blank" rel="noopener">WhatsApp</a>
  </div>
</div>

<style>
  .tp-teppich-versand-{{ tp_tv2_id }} {
    margin-top: 32px;
    padding: 32px;
    background: linear-gradient(135deg, #f8f5f0 0%, #faf8f4 100%);
    border-radius: 16px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.06);
  }

  .tp-teppich-versand__sample-{{ tp_tv2_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #b4976c 0%, #a0855a 100%);
    border: none;
    border-radius: 8px;
    color: #ffffff;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.3px;
    box-shadow: 0 2px 8px rgba(180, 151, 108, 0.15);
    transition: all 0.3s ease;
  }

  .tp-teppich-versand__sample-{{ tp_tv2_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(180, 151, 108, 0.25);
  }

  .tp-teppich-versand__shipping-{{ tp_tv2_id }} {
    margin-top: 28px;
    padding: 24px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.1);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.8);
    font-size: 14px;
    line-height: 1.6;
  }

  .tp-teppich-versand__shipping-{{ tp_tv2_id }} p {
    margin: 0;
  }

  .tp-teppich-versand__shipping-{{ tp_tv2_id }} p strong {
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.95);
    font-weight: 600;
  }

  .tp-teppich-versand__shipping-{{ tp_tv2_id }} p + p {
    margin-top: 12px;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }} {
    margin-top: 16px;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }} summary {
    width: fit-content;
    cursor: pointer;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.8);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
    padding: 4px 0;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }} summary:hover {
    color: #b4976c;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }}[open] summary {
    color: #b4976c;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }} p {
    margin-top: 12px;
    max-width: 64ch;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }} a {
    display: inline-block;
    margin-top: 12px;
    color: #b4976c;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid #b4976c;
    padding-bottom: 2px;
    transition: all 0.2s ease;
  }

  .tp-teppich-versand__shipping-details-{{ tp_tv2_id }} a:hover {
    color: #a0855a;
    border-bottom-color: #a0855a;
  }

  .tp-teppich-versand__secondary-{{ tp_tv2_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 20px;
    font-size: 13px;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.6);
  }

  .tp-teppich-versand__secondary-{{ tp_tv2_id }} a {
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.7);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1.5px solid #b4976c;
    padding-bottom: 1px;
    transition: color 0.2s ease;
  }

  .tp-teppich-versand__secondary-{{ tp_tv2_id }} a:hover {
    color: #b4976c;
  }

  @media screen and (max-width: 749px) {
    .tp-teppich-versand-{{ tp_tv2_id }} {
      margin-top: 24px;
      padding: 20px;
    }

    .tp-teppich-versand__sample-{{ tp_tv2_id }} {
      font-size: 15px;
      min-height: 44px;
      padding: 10px 16px;
    }

    .tp-teppich-versand__shipping-{{ tp_tv2_id }} {
      margin-top: 20px;
      padding: 16px;
      font-size: 13px;
    }

    .tp-teppich-versand__secondary-{{ tp_tv2_id }} {
      font-size: 12px;
      margin-top: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "TP Teppich Versand",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "delivery_time",
      "label": "Lieferzeit",
      "info": "Nur eine verifizierte Lieferzeit eintragen. Leer lassen, wenn keine Angabe vorliegt."
    }
  ],
  "presets": [
    {
      "name": "TP Teppich Versand"
    }
  ]
}
{% endschema %}
