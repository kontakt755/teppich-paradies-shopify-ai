{% doc %}
  Kompakte Kaufservice-Zone direkt am Produkt. Lieferzeit kommt aus der
  jeweiligen Template-Konfiguration; Versanddetails werden nur verlinkt,
  wenn das Shopify-Seitenobjekt bereits existiert.
{% enddoc %}

{%- liquid
  assign tp_sl_id = block.id | replace: '_', '' | downcase
  assign tp_sl_handle = product.handle | url_encode
  assign tp_sl_delivery_time = block.settings.delivery_time | strip
  assign tp_sl_shipping_page = pages['versand-lieferung']
-%}

<div class="tp-service-links-{{ tp_sl_id }}" {{ block.shopify_attributes }}>
  <a class="tp-service-links__sample-{{ tp_sl_id }}" href="/pages/kontakt?thema=muster&produkt={{ tp_sl_handle }}">
    Kostenloses Muster anfragen
  </a>

  <div class="tp-service-links__shipping-{{ tp_sl_id }}" aria-label="Lieferung und Versand">
    {%- if tp_sl_delivery_time != blank -%}
      <p><strong>Lieferzeit:</strong> {{ tp_sl_delivery_time | escape }}</p>
    {%- endif -%}
    <p><strong>Deutschlandweiter Versand</strong></p>
    <p>Speditionsware: frei Bordsteinkante</p>

    <details class="tp-service-links__shipping-details-{{ tp_sl_id }}">
      <summary>Was bedeutet „frei Bordsteinkante“?</summary>
      <p>
        Frei Bordsteinkante bedeutet: Die Spedition bringt die Ware bis zur nächstmöglichen, für das
        Lieferfahrzeug erreichbaren Stelle an Ihrer Lieferadresse. Der Weitertransport ins Gebäude oder in die
        Wohnung ist nicht Bestandteil der Lieferung.
      </p>
      {%- if tp_sl_shipping_page != blank -%}
        <a href="{{ tp_sl_shipping_page.url }}">Alle Versanddetails</a>
      {%- endif -%}
    </details>
  </div>

  <div class="tp-service-links__secondary-{{ tp_sl_id }}">
    <a href="tel:+4933015733720">Beratung: 03301 5733720</a>
    <span aria-hidden="true">·</span>
    <a href="https://wa.me/491792612211" target="_blank" rel="noopener">WhatsApp</a>
    <span aria-hidden="true">·</span>
    <a href="/pages/liefer-verlegeservice">Verlegeservice</a>
  </div>
</div>

<style>
  .tp-service-links-{{ tp_sl_id }} {
    margin-top: 12px;
  }

  .tp-service-links__sample-{{ tp_sl_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    background: #b4976c;
    border: 1px solid #b4976c;
    border-radius: var(--style-border-radius-buttons-primary, 7px);
    color: #ffffff;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
  }

  .tp-service-links__sample-{{ tp_sl_id }}:hover {
    opacity: 0.9;
  }

  .tp-service-links__shipping-{{ tp_sl_id }} {
    margin-top: 12px;
    padding: 12px 14px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.14);
    border-radius: 8px;
    background: rgb(var(--color-foreground-rgb, 34 34 34) / 0.025);
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.76);
    font-size: 13px;
    line-height: 1.45;
  }

  .tp-service-links__shipping-{{ tp_sl_id }} p {
    margin: 0;
  }

  .tp-service-links__shipping-{{ tp_sl_id }} p + p {
    margin-top: 3px;
  }

  .tp-service-links__shipping-details-{{ tp_sl_id }} {
    margin-top: 8px;
  }

  .tp-service-links__shipping-details-{{ tp_sl_id }} summary {
    width: fit-content;
    cursor: pointer;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tp-service-links__shipping-details-{{ tp_sl_id }} p {
    margin-top: 8px;
    max-width: 64ch;
  }

  .tp-service-links__shipping-details-{{ tp_sl_id }} a {
    display: inline-block;
    margin-top: 8px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tp-service-links__secondary-{{ tp_sl_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px 8px;
    margin-top: 10px;
    font-size: 13px;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.7);
  }

  .tp-service-links__secondary-{{ tp_sl_id }} a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .tp-service-links__sample-{{ tp_sl_id }} {
      font-size: 14px;
    }

    .tp-service-links__shipping-{{ tp_sl_id }},
    .tp-service-links__secondary-{{ tp_sl_id }} {
      font-size: 12.5px;
    }
  }
</style>

{% schema %}
{
  "name": "TP Service-Links",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "delivery_time",
      "label": "Lieferzeit",
      "info": "Nur eine verifizierte Lieferzeit eintragen. Leer lassen, wenn keine Angabe vorliegt."
    }
  ],
  "presets": [
    {
      "name": "TP Service-Links"
    }
  ]
}
{% endschema %}
