{% doc %}
  @prompt
    Paket-Auswahl für Teppiche. m² pro Paket kommt aus einem Produkt-Metafeld.
    Primäre Eingabe: frei editierbare benötigte Fläche in m². Pakete werden
    daraus abgeleitet (aufgerundet, nie unterberechnet) und im Ergebnisblock
    immer sichtbar, aber optisch sekundär (kleiner +/- Steller) angeboten.
{% enddoc %}

{% assign package_selector_id = block.id | replace: '_', '' | downcase %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% comment %}
  Ohne custom.qm_pro_paket rendert der Block nichts. Der fruehere Standardwert
  2,05 m2 hat Sockelleisten und anderes Zubehoer ohne Metafeld als Paketware
  mit erfundener Flaeche angezeigt (Audit 2026-09-08).
{% endcomment %}
{% assign sqm_per_package = product.metafields.custom.qm_pro_paket.value | times: 1.0 %}
{% assign initial_packages = 1 %}
{% if sqm_per_package > 0 %}

{% style %}
  .carpet-package__message-{{ package_selector_id }} {
    margin-top: 10px;
    font-size: 15px;
    color: var(--cp-muted);
  }

  .carpet-package__message-{{ package_selector_id }}[data-error="true"] {
    color: #b00020;
  }

  .carpet-package-{{ package_selector_id }} {
    --cp-text: var(--color-foreground, #222222);
    --cp-background: rgb(var(--color-foreground-rgb, 34 34 34) / 0.045);
    --cp-surface: var(--color-background, #ffffff);
    --cp-border: rgb(var(--color-foreground-rgb, 34 34 34) / 0.18);
    --cp-border-strong: rgb(var(--color-foreground-rgb, 34 34 34) / 0.7);
    --cp-muted: rgb(var(--color-foreground-rgb, 34 34 34) / 0.68);
    --cp-success: #008a2e;
    --cp-button-bg: var(--color-foreground, #111111);
    --cp-button-text: var(--color-background, #ffffff);

    width: 100%;
    max-width: 440px;
    background: var(--cp-background);
    border-radius: var(--style-border-radius, 8px);
    padding: 16px 16px 16px;
    color: var(--cp-text);
    font-family: inherit;
  }

  .carpet-package__label-{{ package_selector_id }} {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .carpet-package__primary-{{ package_selector_id }} {
    min-width: 0;
  }

  .carpet-package__input-row-{{ package_selector_id }} {
    display: grid;
    grid-template-columns: 38px 1fr auto 38px;
    align-items: center;
    height: 44px;
    background: var(--cp-surface);
    border: 1px solid var(--cp-border-strong);
    border-radius: 7px;
    overflow: hidden;
  }

  .carpet-package__button-{{ package_selector_id }} {
    height: 100%;
    border: 0;
    background: var(--cp-surface);
    color: var(--cp-text);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .carpet-package__input-row-{{ package_selector_id }} .carpet-package__button-{{ package_selector_id }}:first-child {
    border-right: 1px solid var(--cp-border);
  }

  .carpet-package__input-row-{{ package_selector_id }} .carpet-package__button-{{ package_selector_id }}:last-child {
    border-left: 1px solid var(--cp-border);
  }

  .carpet-package__button-{{ package_selector_id }}:hover {
    background: rgb(var(--color-foreground-rgb, 34 34 34) / 0.06);
  }

  .carpet-package__input-{{ package_selector_id }} {
    width: 100%;
    height: 100%;
    border: 0;
    text-align: center;
    font-weight: 700;
    font-size: 18px;
    color: var(--cp-text);
    background: transparent;
    -moz-appearance: textfield;
  }

  .carpet-package__input-{{ package_selector_id }}::-webkit-outer-spin-button,
  .carpet-package__input-{{ package_selector_id }}::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .carpet-package__input-unit-{{ package_selector_id }} {
    padding-right: 10px;
    font-size: 15px;
    font-weight: 700;
    color: var(--cp-muted);
  }

  .carpet-package__waste-{{ package_selector_id }} {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 10px;
    font-size: 16px;
    color: var(--cp-muted);
  }

  .carpet-package__waste-{{ package_selector_id }} input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--cp-text);
  }

  .carpet-package__reserve-{{ package_selector_id }} {
    margin: 8px 0 0;
    font-size: 0.85em;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.72);
  }

  .carpet-package__results-{{ package_selector_id }} {
    margin: 16px 0 0;
    padding: 12px 14px;
    background: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-radius: 7px;
    font-size: 16px;
  }

  .carpet-package__results-row-{{ package_selector_id }} {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 0;
    color: var(--cp-muted);
  }

  /* Der Zahlenwert bleibt einzeilig; umbrechen darf nur die Beschriftung. */
  .carpet-package__results-row-{{ package_selector_id }} > span:last-child {
    white-space: nowrap;
  }

  .carpet-package__results-row-{{ package_selector_id }}[data-emphasis] {
    color: var(--cp-text);
    font-weight: 700;
    border-top: 1px solid var(--cp-border);
    margin-top: 4px;
    padding-top: 8px;
  }

  .carpet-package__packages-control-{{ package_selector_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .carpet-package__packages-control-{{ package_selector_id }} button {
    width: 32px;
    height: 32px;
    border: 1px solid var(--cp-border);
    border-radius: 6px;
    background: var(--cp-surface);
    color: var(--cp-text);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }

  .carpet-package__packages-control-{{ package_selector_id }} button:hover {
    background: rgb(var(--color-foreground-rgb, 34 34 34) / 0.06);
  }

  .carpet-package__packages-control-{{ package_selector_id }} [data-package-display] {
    min-width: 1.5ch;
    text-align: center;
    font-weight: 700;
  }

  .carpet-package__packages-unit-{{ package_selector_id }} {
    color: var(--cp-muted);
    font-weight: 400;
  }

  .carpet-package__unit-hint-{{ package_selector_id }} {
    margin: 14px 0 0;
    padding: 10px 12px;
    border-left: 3px solid var(--cp-border-strong);
    background: var(--cp-surface);
    border-radius: 5px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--cp-text);
  }

  .carpet-package__unit-hint-{{ package_selector_id }} strong {
    display: block;
    font-weight: 600;
  }

  .carpet-package__unit-hint-detail-{{ package_selector_id }} {
    display: block;
    margin-top: 2px;
    color: var(--cp-muted);
  }

  .carpet-package__results-title-{{ package_selector_id }} {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cp-muted);
  }

  .carpet-package__total-{{ package_selector_id }} {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 16px 0 12px;
    font-size: 19px;
    font-weight: 800;
    color: var(--cp-text);
  }

  .carpet-package__submit-{{ package_selector_id }} {
    width: 100%;
    min-height: 74px;
    border: 0;
    border-radius: var(--style-border-radius-buttons-primary, 7px);
    background: var(--cp-button-bg);
    color: var(--cp-button-text);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    font-size: 20px;
  }

  .carpet-package__submit-{{ package_selector_id }}:hover {
    opacity: 0.88;
  }

  @media screen and (max-width: 749px) {
    .carpet-package-{{ package_selector_id }} {
      max-width: none;
      padding: 14px 12px 14px;
    }

    .carpet-package__total-{{ package_selector_id }} {
      font-size: 16px;
    }

    .carpet-package__submit-{{ package_selector_id }} {
      font-size: 18px;
    }

    /* Auf schmalen Schirmen bricht "Sie bestellen" neben dem Paket-Steller
       zweizeilig um. Label und Steller stehen dort deshalb untereinander. */
    .carpet-package__results-row-{{ package_selector_id }}[data-emphasis] {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
{% endstyle %}

{% comment %}
  Die Klasse tp-paket-auswahl ist der stabile Anker: Der Elementname traegt die
  Block-ID und ist damit je Template verschieden. assets/sticky-add-to-cart.js
  findet ueber diese Klasse den Kaufweg, weil Paketprodukte keinen
  Standard-Kaufblock mehr rendern (siehe blocks/buy-buttons.liquid).
{% endcomment %}
<carpet-package-selector-{{ package_selector_id }}
  class="carpet-package-{{ package_selector_id }} tp-paket-auswahl"
  data-sqm-per-package="{{ sqm_per_package }}"
  data-package-price-cents="{{ selected_variant.price }}"
  data-variant-id="{{ selected_variant.id }}"
  data-initial-packages="{{ initial_packages }}"
  {%- comment -%}
    Stueckzahl und Format nur, wenn sie am Produkt gepflegt sind. Nie aus der
    Flaeche oder dem Titel geschaetzt - im Warenkorb waere das eine Zusicherung,
    die niemand belegen kann.
  {%- endcomment -%}
  data-piece-count="{{ product.metafields.custom.stueck_pro_paket.value }}"
  data-piece-label="{{ product.metafields.custom.stueck_bezeichnung.value | default: 'Stück' }}"
  data-piece-format="{{ product.metafields.custom.format_cm.value }}"
  {{ block.shopify_attributes }}
>
  <div class="carpet-package__primary-{{ package_selector_id }}">
    <label class="carpet-package__label-{{ package_selector_id }}" for="tp-sqm-input-{{ package_selector_id }}">
      Wie viel Fläche benötigen Sie?
    </label>

    <div class="carpet-package__input-row-{{ package_selector_id }}">
      <button
        class="carpet-package__button-{{ package_selector_id }}"
        type="button"
        data-decrease-sqm
        aria-label="Fläche verringern"
      >
        −
      </button>

      {%- comment -%}
        Bewusst type="text": In einem number-Input ist "1,5" ein ungueltiger
        Wert, den der Browser als leeren String liefert - deutsche
        Kommaeingabe war damit unmoeglich. inputmode="decimal" oeffnet auf
        dem Handy trotzdem die Zifferntastatur.
      {%- endcomment -%}
      <input
        class="carpet-package__input-{{ package_selector_id }}"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        id="tp-sqm-input-{{ package_selector_id }}"
        placeholder="z. B. 18,00"
        data-sqm-input
      >

      <span class="carpet-package__input-unit-{{ package_selector_id }}">m²</span>

      <button
        class="carpet-package__button-{{ package_selector_id }}"
        type="button"
        data-increase-sqm
        aria-label="Fläche erhöhen"
      >
        +
      </button>
    </div>

    {% comment %}
      Verschnitt ist vorausgewaehlt. Abgewaehlt empfahl der Rechner die
      knappest moegliche Bestellung - beim Bodenbelag der teure Fehler, weil
      fehlendes Material eine Nachbestellung aus anderer Charge bedeutet
      (Befund 2026-09-10). Abwaehlbar bleibt es fuer alle, die selbst
      gerechnet haben.
    {% endcomment %}
    <label class="carpet-package__waste-{{ package_selector_id }}">
      <input type="checkbox" data-waste-checkbox checked>
      <span>+ 5% Verschnitt (empfohlen)</span>
    </label>
  </div>

  {% comment %}
    Der Hinweis erscheint nur, wenn der Kunde weniger eingibt als ein Paket
    fasst - genau der Moment, in dem sonst der Eindruck entsteht, es werde
    willkuerlich aufgerundet. Das Wort "aufgerundet" kommt hier bewusst nicht
    mehr vor: Ein Paket ist eine reale Verkaufseinheit, keine Rundung.
  {% endcomment %}
  <p class="carpet-package__unit-hint-{{ package_selector_id }}" data-unit-hint hidden>
    <strong>Dieses Produkt wird ausschließlich in vollständigen Originalpaketen geliefert.</strong>
    <span class="carpet-package__unit-hint-detail-{{ package_selector_id }}">
      Kleinste Verkaufseinheit: {% render 'tp-paketinhalt', product: product, sqm_per_package: sqm_per_package %}
    </span>
  </p>

  <div
    class="carpet-package__results-{{ package_selector_id }}"
    role="status"
    aria-live="polite"
  >
    <p class="carpet-package__results-title-{{ package_selector_id }}">Ihre Bestellung</p>

    <div class="carpet-package__results-row-{{ package_selector_id }}">
      <span data-need-label>Benötigte Fläche</span>
      <span data-need-display>–</span>
    </div>

    <div class="carpet-package__results-row-{{ package_selector_id }}" data-emphasis>
      <span>Sie bestellen</span>
      <span class="carpet-package__packages-control-{{ package_selector_id }}">
        <button type="button" data-decrease-packages aria-label="Ein Paket weniger">−</button>
        <span data-package-display>–</span>
        <button type="button" data-increase-packages aria-label="Ein Paket mehr">+</button>
        <span class="carpet-package__packages-unit-{{ package_selector_id }}" data-package-word>Originalpakete</span>
      </span>
    </div>

    <div class="carpet-package__results-row-{{ package_selector_id }}">
      <span>Gesamtfläche</span>
      <span data-sqm-display>–</span>
    </div>
  </div>

  {% comment %}
    Reserve-Hinweis nur bei Fliesen: Dort ersetzt man ein beschaedigtes
    Stueck einzeln, uebrige Fliesen sind also echte Ersatzteile. Bei Planken
    und Rollenware waere der Satz fachlich schief. Quelle ist
    custom.stueck_bezeichnung - kein Titel-Parsing.
  {% endcomment %}
  {%- assign tp_pa_bezeichnung = product.metafields.custom.stueck_bezeichnung.value | strip -%}
  {%- if tp_pa_bezeichnung == 'Fliesen' -%}
    <p class="carpet-package__reserve-{{ package_selector_id }}">
      Übrige Fliesen können als Reserve für spätere Reparaturen oder Verschmutzungen aufbewahrt werden.
    </p>
  {%- endif -%}

  <div class="carpet-package__total-{{ package_selector_id }}">
    <div>Gesamtpreis <span data-total-display>–</span></div>
  </div>

  <button
    class="carpet-package__submit-{{ package_selector_id }}"
    type="button"
    data-add-to-cart
  >
    In den Warenkorb
  </button>

  <div
    class="carpet-package__message-{{ package_selector_id }}"
    data-cart-message
  ></div>
</carpet-package-selector-{{ package_selector_id }}>

<script>
  (function () {
    const component = document.querySelector('carpet-package-selector-{{ package_selector_id }}');
    if (!component) return;

    const sqmPerPackageRaw = component.dataset.sqmPerPackage || '0';
    const sqmPerPackage = parseFloat(sqmPerPackageRaw);
    // Variante und Preis sind veraenderlich: Der Farbwaehler tauscht die
    // Variante ohne Seitenwechsel aus, und dieser Block wird dabei nicht neu
    // gerendert. Bis 2026-09-10 blieb deshalb die beim Seitenaufbau gewaehlte
    // Variante stehen - wer "Blau Tief" waehlte, bekam "Blau Dunkel" in den
    // Warenkorb. Beides wird jetzt aus variant:update nachgefuehrt.
    let packagePriceCents = parseInt(component.dataset.packagePriceCents || '0', 10);
    let variantId = component.dataset.variantId;
    const WASTE_FACTOR = 1.05;
    const SQM_STEP = 0.25;

    // Einheitliche Nachkommastellen-Anzahl fuer alle m²-Anzeigen dieses
    // Rechners, abgeleitet aus der tatsaechlichen Praezision des
    // Paket-Metafelds (z.B. 0.794 -> 3 Nachkommastellen). So verschwindet
    // nie echte Praezision durch Rundung, ohne unnoetige Nullen anzuhaengen.
    // Mindestens 2 Nachkommastellen fuer ein einheitliches, lesbares Format.
    const sqmDecimalsFromValue = (sqmPerPackageRaw.split('.')[1] || '').length;
    const sqmDecimals = Math.min(3, Math.max(2, sqmDecimalsFromValue));

    // Gewünschte Fläche ist der einzige Zustand ("single source of truth").
    // Paketanzahl wird daraus IMMER über computePackages() abgeleitet - dieselbe
    // Funktion wird für die Anzeige (update) und für den Warenkorb-Payload
    // (addToCart) verwendet, damit beide niemals auseinanderlaufen. Sowohl das
    // primäre m²-Feld als auch die sekundäre manuelle Paketanpassung verändern
    // ausschließlich desiredSqm - es gibt keinen zweiten, unabhängigen Zustand.
    // Startwert so waehlen, dass der Ruhezustand der Seite genau ein Paket
    // zeigt - AUCH mit vorausgewaehltem Verschnitt. Ein glatter Startwert von
    // einer vollen Paketflaeche wuerde mit dem Zuschlag darueber liegen und
    // die Seite unaufgefordert mit zwei Paketen und doppeltem Preis oeffnen.
    // Abgerundet auf zwei Nachkommastellen, damit die Rueckrechnung im
    // Eingabefeld nicht durch Rundung wieder ueber die Paketgrenze kippt.
    const initialPackages = parseInt(component.dataset.initialPackages || '1', 10);
    const initialWasteFactor = component.querySelector('[data-waste-checkbox]')?.checked ? WASTE_FACTOR : 1.0;
    let desiredSqm =
      Math.floor(((Math.max(1, initialPackages) * sqmPerPackage) / initialWasteFactor) * 100) / 100;

    const sqmInput = component.querySelector('[data-sqm-input]');
    const needLabel = component.querySelector('[data-need-label]');
    const needDisplay = component.querySelector('[data-need-display]');
    const sqmDisplay = component.querySelector('[data-sqm-display]');
    const packageDisplay = component.querySelector('[data-package-display]');
    const packageWord = component.querySelector('[data-package-word]');
    const unitHint = component.querySelector('[data-unit-hint]');
    const totalDisplay = component.querySelector('[data-total-display]');
    const wasteCheckbox = component.querySelector('[data-waste-checkbox]');
    const addToCartButton = component.querySelector('[data-add-to-cart]');
    const cartMessage = component.querySelector('[data-cart-message]');

    function formatGermanNumber(value, decimals) {
      const places = typeof decimals === 'number' ? decimals : 2;
      return value.toFixed(places).replace('.', ',');
    }

    function formatSqm(value) {
      return formatGermanNumber(value, sqmDecimals);
    }

    // Tausenderpunkt, damit "1.178,00 €" nicht als "1178,00 €" dasteht.
    const moneyFormat = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function formatMoney(cents) {
      return moneyFormat.format(cents / 100) + ' €';
    }

    // Epsilon faengt Gleitkomma-Rauschen ab (z.B. wiederholtes += auf
    // sqmPerPackage), damit eine Flaeche, die exakt einem Vielfachen der
    // Paketgroesse entspricht, nicht durch minimale Rundungsfehler ein
    // ganzes Zusatzpaket erzwingt.
    const FLOAT_EPSILON = 1e-9;

    function getWasteFactor() {
      return wasteCheckbox && wasteCheckbox.checked ? WASTE_FACTOR : 1.0;
    }

    // Umkehrung von computePackages: die Flaeche, die genau n Pakete deckt -
    // Verschnittzuschlag herausgerechnet. Abgerundet auf zwei Nachkommastellen,
    // damit die Rueckrechnung ueber das Eingabefeld (toFixed(2)) nicht durch
    // Rundung ueber die Paketgrenze kippt und ein Paket zu viel bestellt.
    function sqmForPackages(packages) {
      return Math.floor(((Math.max(1, packages) * sqmPerPackage) / getWasteFactor()) * 100) / 100;
    }

    function getRequiredSqm() {
      return Math.max(0, desiredSqm) * getWasteFactor();
    }

    // Einzige Berechnungsquelle: gewünschte Fläche -> Verschnitt -> auf volle
    // Pakete aufrunden. Wird nie abgerundet, damit Warenkorb/Checkout nie zu
    // wenig berechnen.
    function computePackages() {
      if (!sqmPerPackage) return 1;
      return Math.max(1, Math.ceil(getRequiredSqm() / sqmPerPackage - FLOAT_EPSILON));
    }

    function setMessage(text, isError) {
      if (!cartMessage) return;

      cartMessage.textContent = text || '';

      if (isError) {
        cartMessage.setAttribute('data-error', 'true');
      } else {
        cartMessage.removeAttribute('data-error');
      }
    }

    // Aktualisiert nur die Ergebnis-Anzeigen, nicht den Wert des m²-Eingabefelds
    // selbst - damit der Cursor beim Tippen nicht springt.
    function renderResults() {
      const packages = computePackages();
      const requiredSqm = getRequiredSqm();
      const actualSqm = packages * sqmPerPackage;
      const totalCents = packages * packagePriceCents;

      // Solange niemand eine Flaeche genannt hat, wird auch keine behauptet.
      // Der Ruhezustand ist "1 Paket" - eine vorbelegte Zahl im Feld waere
      // eine erfundene Kundenangabe (und mit Verschnittzuschlag zusaetzlich
      // krumm).
      const hatEingabe = !!sqmInput && sqmInput.value.trim() !== '';

      if (needLabel) {
        needLabel.textContent =
          getWasteFactor() > 1 ? 'Benötigte Fläche inkl. 5% Verschnitt' : 'Benötigte Fläche';
      }

      if (needDisplay) {
        needDisplay.textContent = hatEingabe ? formatSqm(requiredSqm) + ' m²' : '–';
      }

      if (sqmDisplay) {
        sqmDisplay.textContent = formatSqm(actualSqm) + ' m²';
      }

      if (packageDisplay) {
        packageDisplay.textContent = String(packages);
      }

      if (packageWord) {
        packageWord.textContent = packages === 1 ? 'Originalpaket' : 'Originalpakete';
      }

      // Der Hinweis auf die Verkaufseinheit erscheint genau dann, wenn der
      // Kunde weniger eingegeben hat, als ein Paket fasst - sonst waere er
      // ueberfluessiger Text. Ohne Eingabe steht die Paketangabe bereits im
      // Preisblock darueber.
      if (unitHint) {
        unitHint.hidden = !(hatEingabe && desiredSqm > 0 && desiredSqm < sqmPerPackage);
      }

      if (totalDisplay) {
        totalDisplay.textContent = formatMoney(totalCents);
      }

      return packages;
    }

    // Wird von den sekundären +/- Bedienelementen (m²-Feinsteuerung und
    // manuelle Paketanpassung) genutzt: schreibt desiredSqm zurück in das
    // Eingabefeld, weil der Nutzer hier gerade nicht selbst tippt.
    function syncInputValue() {
      if (sqmInput) {
        sqmInput.value = desiredSqm.toFixed(2).replace('.', ',');
      }
    }

    function setDesiredSqm(value, options) {
      const opts = options || {};
      desiredSqm = Math.max(0.01, value);
      if (opts.syncInput !== false) {
        syncInputValue();
      }
      renderResults();
    }

    async function addToCart() {
      const packages = renderResults();
      const actualSqm = packages * sqmPerPackage;
      setMessage('', false);

      if (!variantId) {
        setMessage('Variante konnte nicht gefunden werden.', true);
        return;
      }

      addToCartButton.disabled = true;
      addToCartButton.textContent = 'Wird hinzugefügt...';

      // Alle Eigenschaften tragen einen Unterstrich und sind damit im
      // Warenkorb unsichtbar (snippets/cart-products.liquid blendet sie aus),
      // stehen aber weiterhin in der Bestellung fuer Kommissionierung und
      // Support. Die Klartextzeile im Warenkorb rechnet Liquid aus der echten
      // Zeilenmenge - eine hier mitgeschriebene Menge waere falsch, sobald der
      // Kunde im Warenkorb nachjustiert.
      const properties = {
        _bedarf_qm: formatSqm(desiredSqm),
        _pakete: String(packages),
        _qm_gesamt: formatSqm(actualSqm),
        _qm_pro_paket: formatSqm(sqmPerPackage),
        _verschnitt: wasteCheckbox && wasteCheckbox.checked ? '5%' : '0%',
      };

      const payload = {
        id: variantId,
        quantity: packages,
        properties: properties,
      };

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          const error = await response.json().catch(function () {
            return {};
          });

          throw new Error(error.description || error.message || 'Produkt konnte nicht hinzugefügt werden.');
        }

        // Rueckmeldung am Ort des Klicks: Warenkorb-Drawer oeffnen (Horizon
        // hoert auf cart:update und oeffnet bei auto-open). Header-Bubble
        // bekommt die Paketzahl. Ohne Drawer bleibt die Weiterleitung.
        const added = await response.json();
        document.dispatchEvent(
          new CustomEvent('cart:update', {
            bubbles: true,
            detail: {
              resource: added,
              sourceId: component.id || 'paket-auswahl',
              data: { itemCount: packages, source: 'product-form-component' },
            },
          })
        );
        const drawer = document.querySelector('cart-drawer-component');
        if (drawer && typeof drawer.open === 'function') {
          drawer.open();
          addToCartButton.textContent = 'Im Warenkorb';
          setTimeout(function () {
            addToCartButton.disabled = false;
            addToCartButton.textContent = 'In den Warenkorb';
          }, 2500);
        } else {
          window.location.href = '/cart';
        }
      } catch (error) {
        setMessage(error.message, true);
        addToCartButton.disabled = false;
        addToCartButton.textContent = 'In den Warenkorb';
      }
    }

    // Akzeptiert "1,5" und "1.5", ignoriert Leerzeichen und alles andere.
    function parseSqm(raw) {
      const text = String(raw == null ? '' : raw).replace(/\s/g, '').replace(',', '.');
      if (text === '') return null;
      const parsed = parseFloat(text);
      return isNaN(parsed) ? null : parsed;
    }

    if (sqmInput) {
      sqmInput.addEventListener('input', function () {
        const parsed = parseSqm(sqmInput.value);
        desiredSqm = parsed == null || parsed <= 0 ? 0 : parsed;
        renderResults();
      });

      // Beim Verlassen wird die Eingabe normalisiert. Eine leere, eine 0 und
      // eine negative Eingabe fuehren zurueck in den Ruhezustand: Feld leer,
      // ein Paket kaufbar. Vorher schrieb das Feld dort "0,01" hinein - eine
      // Zahl, die der Kunde nie eingegeben hat.
      sqmInput.addEventListener('blur', function () {
        const parsed = parseSqm(sqmInput.value);
        if (parsed == null || parsed <= 0) {
          sqmInput.value = '';
          desiredSqm = sqmForPackages(1);
          renderResults();
          return;
        }
        setDesiredSqm(parsed);
      });
    }

    component.addEventListener('click', function (event) {
      const increaseSqm = event.target.closest('[data-increase-sqm]');
      const decreaseSqm = event.target.closest('[data-decrease-sqm]');
      const increasePackages = event.target.closest('[data-increase-packages]');
      const decreasePackages = event.target.closest('[data-decrease-packages]');
      const cartButton = event.target.closest('[data-add-to-cart]');

      if (increaseSqm) {
        setDesiredSqm(desiredSqm + SQM_STEP);
        return;
      }

      if (decreaseSqm) {
        setDesiredSqm(desiredSqm - SQM_STEP);
        return;
      }

      // Sekundäre, manuelle Paketanpassung: verändert ebenfalls nur
      // desiredSqm, kein zweiter Zustand. Der Schritt zielt auf die
      // Paketanzahl selbst (sqmForPackages), nicht auf "plus eine
      // Paketfläche" - sonst addierte man eine Bruttofläche auf einen
      // Nettobedarf, und ein Klick sprang bei aktivem Verschnitt von einem
      // auf drei Pakete.
      if (increasePackages) {
        setDesiredSqm(sqmForPackages(computePackages() + 1));
        return;
      }

      if (decreasePackages) {
        setDesiredSqm(sqmForPackages(Math.max(1, computePackages() - 1)));
        return;
      }

      if (cartButton) {
        event.preventDefault();
        event.stopPropagation();
        addToCart();
      }
    });

    if (wasteCheckbox) {
      wasteCheckbox.addEventListener('change', function () {
        renderResults();
      });
    }

    // Horizon meldet den Variantenwechsel als "variant:update" am Abschnitt.
    // Nur Ereignisse dieses Produkts zaehlen - eine Empfehlungskarte daneben
    // darf den Rechner nicht umstellen.
    const section = component.closest('.shopify-section');
    const productId = '{{ product.id }}';

    (section || document).addEventListener('variant:update', function (event) {
      const detail = event.detail || {};
      if (detail.data && String(detail.data.productId) !== productId) return;

      const variant = detail.resource;
      if (!variant || !variant.id) return;

      variantId = String(variant.id);
      component.dataset.variantId = variantId;

      // variant.price kommt als Betrag in Cent aus dem Variant-JSON.
      const preis = parseInt(variant.price, 10);
      if (!isNaN(preis) && preis > 0) {
        packagePriceCents = preis;
        component.dataset.packagePriceCents = String(preis);
      }

      renderResults();
    });

    // Kein syncInputValue() beim Start: das Feld bleibt leer, bis der Kunde
    // seine Flaeche nennt. desiredSqm traegt trotzdem den Wert fuer genau ein
    // Paket, damit die Seite kaufbereit oeffnet.
    renderResults();
  })();
</script>
{% endif %}

