{% doc %}
  Eigenständige nummerierte Schritt-Überschrift für den Produktkonfigurator.

  Gedacht für Konfigurator-Schritte, deren Bedienelement wir nicht selbst
  rendern - etwa die Variantenauswahl oder den Preisrechner der App. Dort lässt
  sich keine Überschrift von innen einsetzen, also steht sie als eigener Block
  davor. Farbauswahl und andere eigene Bausteine rufen 'tp-step-heading'
  weiterhin direkt auf.

  Nummer und Text sind im Theme-Editor pflegbar, damit sich die Reihenfolge
  ohne Code-Änderung umstellen lässt.
{% enddoc %}

{%- liquid
  # Eine Schrittzeile ohne Bedienelement darunter ist eine Frage ohne Antwort.
  # Genau das stand auf Rollenware ohne Farboption (z. B. einfarbiges
  # Rollenvinyl): "1 Farbe waehlen" und darunter nichts. Die Erkennung ist
  # dieselbe wie in blocks/tp-farbanzeige.liquid. Standard ist aus, damit
  # bestehende Vorlagen unveraendert bleiben.
  assign tp_st_zeigen = true
  if block.settings.nur_mit_farboption
    assign tp_st_zeigen = false
    for tp_st_option in product.options_with_values
      assign tp_st_oname = tp_st_option.name | downcase
      if tp_st_oname contains 'farbe' or tp_st_oname contains 'color' or tp_st_oname contains 'dekor'
        assign tp_st_zeigen = true
        break
      endif
    endfor
  endif
-%}

{%- if tp_st_zeigen -%}
  <div class="tp-step" {{ block.shopify_attributes }}>
    {% render 'tp-step-heading', number: block.settings.number, label: block.settings.label %}
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-step {
    margin-block-start: var(--margin-lg, 24px);
  }

  .tp-step:first-child {
    margin-block-start: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Schritt-Überschrift",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "number",
      "label": "Schrittnummer",
      "min": 1,
      "max": 9,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "label",
      "label": "Text",
      "default": "Wählen Sie Ihre Breite"
    },
    {
      "type": "checkbox",
      "id": "nur_mit_farboption",
      "label": "Nur anzeigen, wenn das Produkt eine Farboption hat",
      "info": "Für die Schrittzeile der Farbwahl. Ohne Farboption steht sonst eine Überschrift über einer leeren Stelle.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "TP Schritt-Überschrift"
    }
  ]
}
{% endschema %}
