{% doc %}
  @prompt
    Tabellarische Anzeige von Produktinformationen. Links Key, rechts entsprechender Wert.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-info-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-product-info-table__wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-product-info-table__row-{{ ai_gen_id }} {
    border-bottom: {{ block.settings.row_border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-product-info-table__row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-product-info-table__key-{{ ai_gen_id }},
  .ai-product-info-table__value-{{ ai_gen_id }} {
    padding: {{ block.settings.cell_padding }}px;
    text-align: left;
    vertical-align: top;
  }

  .ai-product-info-table__key-{{ ai_gen_id }} {
    font-weight: {{ block.settings.key_font_weight }};
    color: {{ block.settings.key_text_color }};
    width: {{ block.settings.key_column_width }}%;
    font-size: {{ block.settings.key_font_size }}px;
  }

  .ai-product-info-table__value-{{ ai_gen_id }} {
    color: {{ block.settings.value_text_color }};
    font-size: {{ block.settings.value_font_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-info-table__key-{{ ai_gen_id }},
    .ai-product-info-table__value-{{ ai_gen_id }} {
      display: block;
      width: 100%;
    }

    .ai-product-info-table__key-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.cell_padding | divided_by: 2 }}px;
    }

    .ai-product-info-table__value-{{ ai_gen_id }} {
      padding-top: 0;
    }
  }
{% endstyle %}

{% comment %}
  Format:
  Label::metafield_key::display_field
  display_field:
  - name = Metaobject-Feld "name" verwenden
  - value = direkten Wert/String verwenden
  - optik / fasermaterial / nutzungsklasse / brandverhalten = entsprechendes Feld verwenden
{% endcomment %}
{% capture table_config %}
Marke::marke::name|
Belagsart::belagsart::name|
Optik::optik::optik|
Material::material::name|
Fasermaterial::fasermaterial::fasermaterial|
Zimmer::zimmer::zimmer|
Aufbau::aufbau::name|
Rücken::ruckenausstattung::name|
Florhöhe::florhohe::name|
Gesamtstärke::gesamtstarke::name|
Poleneinsatzgewicht::poleneinsatzgewicht::name|
Nutzungsklasse (EN ISO 10874)::nutzungsklassen::nutzungsklasse|
Komfortklasse::komfortklasse::name|
Fußbodenheizung geeignet::fusbodenheizung::fusbodenheizung|
Trittschallverbesserung::trittschallverbesserung::name|
Brandklasse (EN 13501-1)::brandverhalten::brandverhalten
{% endcapture %}

{% assign table_rows = table_config | strip | split: '|' %}

{% comment %}
  Rollenbreite (Rollenware): echte Datenquelle sind die Varianten-Metafelder
  custom.rollenbreite (siehe snippets/tp-card-roll-widths.liquid), Fallback
  Produkt-Metafeld. Nur eindeutige Werte, aufsteigend nach cm sortiert.
{% endcomment %}
{%- liquid
  assign tp_pit_rw_seen = '|'
  assign tp_pit_rw_entries = ''
  assign tp_pit_rw_count = 0

  for tp_pit_rw_variant in product.variants
    assign tp_pit_rw_metres = tp_pit_rw_variant.metafields.custom.rollenbreite.value
    if tp_pit_rw_metres != blank
      assign tp_pit_rw_cm = tp_pit_rw_metres | times: 100 | round
      assign tp_pit_rw_token = '|' | append: tp_pit_rw_cm | append: '|'
      if tp_pit_rw_cm > 0
        unless tp_pit_rw_seen contains tp_pit_rw_token
          assign tp_pit_rw_seen = tp_pit_rw_seen | append: tp_pit_rw_cm | append: '|'
          assign tp_pit_rw_sort_key = tp_pit_rw_cm | prepend: '000000'
          assign tp_pit_rw_sort_key = tp_pit_rw_sort_key | slice: -6, 6
          if tp_pit_rw_entries != blank
            assign tp_pit_rw_entries = tp_pit_rw_entries | append: ','
          endif
          assign tp_pit_rw_entries = tp_pit_rw_entries | append: tp_pit_rw_sort_key | append: ':' | append: tp_pit_rw_cm
          assign tp_pit_rw_count = tp_pit_rw_count | plus: 1
        endunless
      endif
    endif
  endfor

  if tp_pit_rw_count == 0
    assign tp_pit_rw_product_metafield = product.metafields.custom.rollenbreite
    assign tp_pit_rw_product_value = tp_pit_rw_product_metafield.value
    if tp_pit_rw_product_value != blank
      if tp_pit_rw_product_metafield.type contains 'list.'
        for tp_pit_rw_metres in tp_pit_rw_product_value
          assign tp_pit_rw_cm = tp_pit_rw_metres | times: 100 | round
          assign tp_pit_rw_token = '|' | append: tp_pit_rw_cm | append: '|'
          if tp_pit_rw_cm > 0
          unless tp_pit_rw_seen contains tp_pit_rw_token
            assign tp_pit_rw_seen = tp_pit_rw_seen | append: tp_pit_rw_cm | append: '|'
            assign tp_pit_rw_sort_key = tp_pit_rw_cm | prepend: '000000'
            assign tp_pit_rw_sort_key = tp_pit_rw_sort_key | slice: -6, 6
            if tp_pit_rw_entries != blank
              assign tp_pit_rw_entries = tp_pit_rw_entries | append: ','
            endif
            assign tp_pit_rw_entries = tp_pit_rw_entries | append: tp_pit_rw_sort_key | append: ':' | append: tp_pit_rw_cm
            assign tp_pit_rw_count = tp_pit_rw_count | plus: 1
          endunless
          endif
        endfor
      else
        assign tp_pit_rw_cm = tp_pit_rw_product_value | times: 100 | round
        if tp_pit_rw_cm > 0
          assign tp_pit_rw_entries = '000000:' | append: tp_pit_rw_cm
          assign tp_pit_rw_count = 1
        endif
      endif
    endif
  endif

  assign tp_pit_rw_sorted = tp_pit_rw_entries | split: ',' | sort

  assign tp_pit_paket_qm = product.metafields.custom.qm_pro_paket.value
-%}

<product-info-table-{{ ai_gen_id }}
  class="ai-product-info-table-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <table class="ai-product-info-table__wrapper-{{ ai_gen_id }}">
    {% for row in table_rows %}
      {% assign row_parts = row | split: '::' %}
      {% assign row_label = row_parts[0] | strip %}
      {% assign metafield_key = row_parts[1] | strip %}
      {% assign display_field = row_parts[2] | strip %}
      {% assign metafield = product.metafields.custom[metafield_key] %}
      {% assign metafield_value = metafield.value %}

      {% if metafield_value != blank %}
        <tr class="ai-product-info-table__row-{{ ai_gen_id }}">
          <td class="ai-product-info-table__key-{{ ai_gen_id }}">{{ row_label }}</td>

          <td class="ai-product-info-table__value-{{ ai_gen_id }}">
            {% if metafield != blank and metafield_value != blank %}
              {% if metafield.type contains 'list.' %}
                {%- for item in metafield_value -%}
                  {%- if display_field == 'value' -%}
                    {{- item -}}
                  {%- elsif display_field == 'name' -%}
                    {{- item.name | default: item -}}
                  {%- else -%}
                    {%- assign field_drop = item[display_field] -%}
                    {{- field_drop.value | default: field_drop | default: item.name | default: item -}}
                  {%- endif -%}
                  {%- unless forloop.last -%}, {% endunless -%}
                {%- endfor -%}

              {% else %}
                {% if display_field == 'value' %}
                  {{ metafield_value }}
                {% elsif display_field == 'name' %}
                  {{ metafield_value.name | default: metafield_value }}
                {% else %}
                  {% assign field_drop = metafield_value[display_field] %}
                  {{
                    field_drop.value
                    | default: field_drop
                    | default: metafield_value.name
                    | default: metafield_value
                  }}
                {% endif %}
              {% endif %}
            {% endif %}
          </td>
        </tr>
      {% endif %}
    {% endfor %}

    {% if tp_pit_rw_count > 0 %}
      <tr class="ai-product-info-table__row-{{ ai_gen_id }}">
        <td class="ai-product-info-table__key-{{ ai_gen_id }}">Rollenbreite</td>
        <td class="ai-product-info-table__value-{{ ai_gen_id }}">
          {%- for tp_pit_rw_entry in tp_pit_rw_sorted -%}
            {%- assign tp_pit_rw_value = tp_pit_rw_entry | split: ':' | last -%}
            {{- tp_pit_rw_value -}} cm{%- unless forloop.last -%}, {% endunless -%}
          {%- endfor -%}
        </td>
      </tr>
    {% endif %}

    {% if tp_pit_paket_qm != blank %}
      <tr class="ai-product-info-table__row-{{ ai_gen_id }}">
        <td class="ai-product-info-table__key-{{ ai_gen_id }}">m² pro Paket</td>
        <td class="ai-product-info-table__value-{{ ai_gen_id }}">{{ tp_pit_paket_qm }} m²</td>
      </tr>
    {% endif %}
  </table>
</product-info-table-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductInfoTable{{ ai_gen_id }} extends HTMLElement {}

    if (!customElements.get('product-info-table-{{ ai_gen_id }}')) {
      customElements.define('product-info-table-{{ ai_gen_id }}', ProductInfoTable{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Produktinformationen",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop-Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "key_column_width",
      "label": "Breite Bezeichnungsspalte",
      "min": 20,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "cell_padding",
      "label": "Zellenabstand",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_border_width",
      "label": "Trennlinienstärke",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Trennlinien",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "key_text_color",
      "label": "Bezeichnungstext",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "value_text_color",
      "label": "Werttext",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "range",
      "id": "key_font_size",
      "label": "Schriftgröße Bezeichnung",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "key_font_weight",
      "label": "Schriftstärke Bezeichnung",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Mittel" },
        { "value": "600", "label": "Halbfett" },
        { "value": "700", "label": "Fett" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "value_font_size",
      "label": "Schriftgröße Wert",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Produktinformationen"
    }
  ]
}
{% endschema %}
