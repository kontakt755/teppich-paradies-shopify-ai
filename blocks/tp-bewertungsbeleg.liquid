{% doc %}
  Bewertungsbeleg unter den Kauf-Buttons: Sternebewertung + Link zu
  Google-Bewertungen. Ergaenzt tp-vertrauen.liquid (das nur Fliesstext zeigt)
  um eine konkrete, glaubwuerdige Zahl.

  Zeigt bewusst KEINE Bewertungsanzahl. "1.200+" stand hier als Platzhalter-
  Default und wurde nie durch eine echte Zahl ersetzt - am 2026-09-05 als
  falsche Angabe erkannt und entfernt. Erst nach echter Elfsight/Reviews-
  API-Anbindung wieder mit echtem Wert ergaenzen, nie mit einer Schaetzung.

  Dasselbe galt fuer die Sterne: "4.8" war Schema-Default, nie gegen das
  Google-Profil geprueft, waehrend Startseite und Trust-Streifen bewusst leer
  sind. Seit 2026-09-11 (Audit B-02): Wert leer = keine Sterne, nur der Link.
{% enddoc %}

{%- liquid
  assign tp_bb_id = block.id | replace: '_', '' | downcase
  assign tp_bb_rating = block.settings.rating | strip
  assign tp_bb_link = block.settings.review_link
-%}

{%- if tp_bb_rating != blank or tp_bb_link != blank -%}
<div class="tp-bewertungsbeleg-{{ tp_bb_id }}" {{ block.shopify_attributes }}>
  {%- if tp_bb_rating != blank -%}
    <span class="tp-bewertungsbeleg__stars-{{ tp_bb_id }}" aria-label="{{ tp_bb_rating }} von 5 Sternen">
      {%- assign tp_bb_full = tp_bb_rating | replace: ',', '.' | floor -%}
      {%- for i in (1..5) -%}
        {%- if i <= tp_bb_full -%}★{%- else -%}☆{%- endif -%}
      {%- endfor -%}
    </span>
    <span class="tp-bewertungsbeleg__score-{{ tp_bb_id }}">{{ tp_bb_rating }}/5</span>
  {%- endif -%}
  {%- if tp_bb_link != blank -%}
    <a class="tp-bewertungsbeleg__link-{{ tp_bb_id }}" href="{{ tp_bb_link }}" target="_blank" rel="noopener noreferrer">{% if tp_bb_rating != blank %}Auf Google lesen{% else %}Kundenbewertungen auf Google lesen{% endif %}</a>
  {%- endif -%}
</div>
{%- endif -%}

<style>
  .tp-bewertungsbeleg-{{ tp_bb_id }} {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--color-foreground);
  }

  .tp-bewertungsbeleg__stars-{{ tp_bb_id }} {
    color: #ffb400;
    letter-spacing: 1px;
  }

  .tp-bewertungsbeleg__score-{{ tp_bb_id }} {
    font-weight: 650;
  }

  .tp-bewertungsbeleg__link-{{ tp_bb_id }} {
    color: var(--color-foreground);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .tp-bewertungsbeleg-{{ tp_bb_id }} {
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "TP Bewertungsbeleg",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "rating",
      "label": "Sternebewertung (leer = ausgeblendet)",
      "info": "Nur aus dem Google-Unternehmensprofil abschreiben, nie schaetzen."
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Link zu Google-Bewertungen"
    }
  ],
  "presets": [
    {
      "name": "TP Bewertungsbeleg"
    }
  ]
}
{% endschema %}
