{% comment %}
  Band ueber dem Warenkorb, sichtbar nur im Verlegeservice-Modus (Phase 3,
  Issue #167).

  Es steht BEWUSST ueber dem Warenkorb und ersetzt ihn nicht. Die Kaufbuttons
  bleiben unveraendert an ihrer Stelle - wer im Servicemodus doch selbst
  verlegen will, kauft ohne Umweg. Und eine rein optische Umsortierung der
  Buttons wuerde Tastatur und Screenreader in der alten Reihenfolge lassen;
  genau dieser Fehler steckte in der ersten Fassung der Startseiten-Boxen.

  Das Markup liegt immer im HTML und wird per CSS eingeblendet, sobald am
  <html>-Element data-tp-modus="service" steht. Kein Nachladen, kein Sprung.

  Vorbefuellung: Produkt und Variante kommen aus Liquid. Breite und Laenge
  stehen erst nach der Eingabe fest, deshalb haengt ein kleines Skript sie
  beim Klick an - wenn der Rollenware-Rechner auf der Seite ist und Werte hat.
{% endcomment %}

{%- liquid
  assign tp_ma_ziel = block.settings.ziel | default: '/pages/kontakt'
  assign tp_ma_variante = product.selected_or_first_available_variant
-%}

<div class="tp-ma" {{ block.shopify_attributes }} data-tp-ma>
  <p class="tp-ma__titel">{{ block.settings.titel }}</p>
  <p class="tp-ma__text">{{ block.settings.text }}</p>

  <div class="tp-ma__actions">
    <a
      class="tp-ma__cta"
      data-tp-ma-link
      data-basis="{{ tp_ma_ziel }}"
      href="{{ tp_ma_ziel }}?produkt={{ product.title | url_encode }}{% if tp_ma_variante.title != 'Default Title' %}&variante={{ tp_ma_variante.title | url_encode }}{% endif %}"
    >
      {{ block.settings.cta }}
    </a>

    {%- if block.settings.telefon != blank -%}
      <a class="tp-ma__tel" href="tel:{{ block.settings.telefon | remove: ' ' | remove: '/' }}">
        {{ block.settings.telefon_label | default: block.settings.telefon }}
      </a>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var band = document.currentScript && document.currentScript.previousElementSibling;
    if (!band || !band.hasAttribute('data-tp-ma')) {
      band = document.querySelector('[data-tp-ma]');
    }
    if (!band) return;

    var link = band.querySelector('[data-tp-ma-link]');
    if (!link) return;

    // Erst beim Klick lesen: vorher sind die Felder oft noch leer, und ein
    // Listener auf jedem Tastendruck waere Aufwand ohne Nutzen.
    link.addEventListener('click', function () {
      try {
        var url = new URL(link.href, window.location.origin);

        var laenge = document.querySelector('[data-length-input]');
        if (laenge && laenge.value) url.searchParams.set('laenge_cm', laenge.value);

        var breite = document.querySelector('[data-width-seg] [aria-checked="true"], [data-width-seg] .is-active');
        if (breite && breite.textContent.trim()) {
          url.searchParams.set('breite', breite.textContent.trim());
        }

        link.href = url.pathname + url.search;
      } catch (e) {
        /* Vorbefuellung ist Komfort, kein Muss: im Zweifel geht der Link
           ohne Masse auf die Anfrageseite. */
      }
    });
  })();
</script>

{% stylesheet %}
  .tp-ma {
    display: none;
    margin: 0 0 16px;
    padding: 16px 18px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.03);
  }

  [data-tp-modus='service'] .tp-ma {
    display: block;
  }

  .tp-ma__titel {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .tp-ma__text {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.45;
  }

  .tp-ma__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .tp-ma__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 20px;
    border-radius: 8px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-weight: 600;
    text-decoration: none;
  }

  .tp-ma__tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Aufmaß-Band (Modus)",
  "settings": [
    {
      "type": "text",
      "id": "titel",
      "label": "Überschrift",
      "default": "Diesen Boden verlegen lassen?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Wir messen auf, liefern und verlegen – in Oranienburg und 50 km Umkreis."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button",
      "default": "Aufmaß anfragen"
    },
    {
      "type": "url",
      "id": "ziel",
      "label": "Ziel des Buttons"
    },
    {
      "type": "text",
      "id": "telefon",
      "label": "Telefonnummer für den Anruf-Link",
      "info": "Leer lassen blendet die Zeile aus.",
      "default": "+4933015733720"
    },
    {
      "type": "text",
      "id": "telefon_label",
      "label": "Beschriftung der Telefonzeile",
      "default": "oder anrufen: 03301 5733720"
    }
  ],
  "presets": [
    { "name": "TP Aufmaß-Band (Modus)" }
  ]
}
{% endschema %}
