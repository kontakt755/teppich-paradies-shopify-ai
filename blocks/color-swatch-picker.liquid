{% doc %}
  @prompt
    Farb-Auswahl mit Bild-Swatches. Wenn kein Bild vorhanden ist, wird die Farbe als Swatch gerendert.
    Beim Wechsel der Farbe soll die Seite nicht neu laden. Stattdessen sollen Variante,
    URL, aktiver Farbtext und Produktbild aktualisiert werden.
{% enddoc %}

{% assign color_picker_id = block.id | replace: '_', '' | downcase %}
{% assign color_option = blank %}
{% assign color_option_index = 0 %}

{% for option in product.options_with_values %}
  {% assign option_name = option.name | downcase %}
  {% if option_name == 'farbe' or option_name == 'color' or option_name == 'dekor' %}
    {% assign color_option = option %}
    {% assign color_option_index = option.position | minus: 1 %}
    {% break %}
  {% endif %}
{% endfor %}

{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign selected_color = blank %}

{% if color_option != blank %}
  {% assign selected_color = selected_variant.options[color_option_index] | default: color_option.selected_value %}
{% endif %}

{% style %}
  .color-swatch-picker-{{ color_picker_id }} {
    display: block;
    width: 100%;
    color: var(--color-foreground, #222);
  }

  .color-swatch-picker__active-{{ color_picker_id }} {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .color-swatch-picker__active-label-{{ color_picker_id }} {
    opacity: 0.7;
  }

  .color-swatch-picker__active-value-{{ color_picker_id }} {
    margin-left: 6px;
  }

  .color-swatch-picker__list-{{ color_picker_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
    gap: 10px;
    align-items: stretch;
  }

  @media (min-width: 750px) {
    .color-swatch-picker__list-{{ color_picker_id }} {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 12px;
    }
  }

  .color-swatch-picker__item-{{ color_picker_id }} {
    position: relative;
  }

  .color-swatch-picker__input-{{ color_picker_id }} {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .color-swatch-picker__button-{{ color_picker_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 48px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.14);
    border-radius: 6px;
    background: transparent;
    padding: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .color-swatch-picker__input-{{ color_picker_id }}:checked + .color-swatch-picker__button-{{ color_picker_id }} {
    border-color: var(--color-foreground, #111);
    box-shadow: 0 0 0 2px var(--color-foreground, #111);
  }

  .color-swatch-picker__input-{{ color_picker_id }}:focus-visible + .color-swatch-picker__button-{{ color_picker_id }} {
    outline: 2px solid var(--color-foreground, #111);
    outline-offset: 3px;
  }

  .color-swatch-picker__button-{{ color_picker_id }}:hover {
    border-color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.35);
  }

  .color-swatch-picker__image-{{ color_picker_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .color-swatch-picker__color-{{ color_picker_id }} {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.18);
    display: block;
  }

  .color-swatch-picker__fallback-{{ color_picker_id }} {
    background: var(--swatch-color, #d8d8d8);
  }

  /* Farbname unter dem Feld. Zwei Zeilen genuegen fuer die laengsten Namen
     ("Anthrazit Warm Meliert"); alles darueber wird abgeschnitten - der volle
     Name steht weiterhin in title und aria-label. */
  .color-swatch-picker__name-{{ color_picker_id }} {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 4px;
    font-size: 11px;
    line-height: 1.25;
    text-align: center;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.72);
  }

  .color-swatch-picker__input-{{ color_picker_id }}:checked ~ .color-swatch-picker__name-{{ color_picker_id }} {
    color: var(--color-foreground, #111);
    font-weight: 600;
  }

  .color-swatch-picker__werkzeuge-{{ color_picker_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
  }

  .color-swatch-picker__suche-wrap-{{ color_picker_id }} {
    display: block;
  }

  .color-swatch-picker__suche-label-{{ color_picker_id }} {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .color-swatch-picker__suche-{{ color_picker_id }} {
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.22);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 14px;
  }

  .color-swatch-picker__familien-{{ color_picker_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .color-swatch-picker__familie-{{ color_picker_id }} {
    /* 44 px: in der Pruefung vom 2026-09-15 als zu kleines Trefferziel
       gemeldet, auf Desktop und Telefon. */
    min-height: 44px;
    padding: 6px 14px;
    border: 1px solid rgb(var(--color-foreground-rgb, 34 34 34) / 0.22);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 12.5px;
    cursor: pointer;
  }

  .color-swatch-picker__familie-{{ color_picker_id }}[aria-pressed='true'] {
    background: var(--color-foreground, #111);
    border-color: var(--color-foreground, #111);
    color: var(--color-background, #fff);
  }

  .color-swatch-picker__zaehler-{{ color_picker_id }} {
    margin: 0;
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.62);
  }

  .color-swatch-picker__item-{{ color_picker_id }}[hidden] {
    display: none;
  }

  /* hidden-Attribut-Falle: eigene Klassen mit display gewinnen sonst gegen
     das UA-hidden. Deshalb hier explizit und mit !important im Block-Scope. */
  /* Zentrale Farbauswahl aktiv (snippets/tp-farbauswahl): Raster samt Werkzeugen
     weg, die Radio-Felder bleiben im DOM und tragen weiter die Auswahl. Greift
     erst, wenn assets/tp-farbauswahl.js das Attribut gesetzt hat - ohne JS
     bleibt das Raster benutzbar. */
  .color-swatch-picker-{{ color_picker_id }}[data-tp-fa-aktiv] [data-farb-werkzeuge],
  .color-swatch-picker-{{ color_picker_id }}[data-tp-fa-aktiv] [data-farb-liste] {
    display: none !important;
  }

  .color-swatch-picker-{{ color_picker_id }} [hidden] {
    display: none !important;
  }
{% endstyle %}

{% if color_option != blank %}
  <color-swatch-picker-{{ color_picker_id }}
    class="color-swatch-picker-{{ color_picker_id }}"
    data-option-name="{{ color_option.name | escape }}"
    data-darstellung="{{ block.settings.darstellung }}"
    {{ block.shopify_attributes }}
  >
    {%- comment -%}
      Farbname als Vorlesetext. Sichtbar zeigt ihn tp-farbanzeige.liquid mit
      Swatch und Hinweis auf fehlende Fotos; zwei Namen nebeneinander waren
      Dopplung. Das Element bleibt, weil das Skript unten es bei jedem
      Farbwechsel neu beschriftet - eine Live-Region fuer Screenreader.
    {%- endcomment -%}
    <p class="color-swatch-picker__active-{{ color_picker_id }}" data-active-color aria-live="polite">{{ selected_color }}</p>

    {%- comment -%}
      Werkzeugleiste erst ab 8 Farben. Darunter sieht man alles auf einen Blick,
      und eine Suche ueber sechs Felder waere mehr Bedienung als Hilfe. Die
      Leiste steht ausserhalb der Liste und ruehrt kein Radio-Feld an - sie
      blendet nur Eintraege aus. Ohne JavaScript bleibt sie unsichtbar
      (hidden wird erst vom Skript entfernt), dann sind schlicht alle Farben da.
    {%- endcomment -%}
    {%- if color_option.values.size >= 8 -%}
      <div class="color-swatch-picker__werkzeuge-{{ color_picker_id }}" data-farb-werkzeuge hidden>
        <label class="color-swatch-picker__suche-wrap-{{ color_picker_id }}">
          <span class="color-swatch-picker__suche-label-{{ color_picker_id }}">Farbe suchen</span>
          <input
            type="search"
            class="color-swatch-picker__suche-{{ color_picker_id }}"
            data-farb-suche
            placeholder="z. B. Grau oder Taupe"
            autocomplete="off"
          >
        </label>
        <div class="color-swatch-picker__familien-{{ color_picker_id }}" data-farb-familien role="group" aria-label="Nach Farbfamilie filtern"></div>
        <p class="color-swatch-picker__zaehler-{{ color_picker_id }}" data-farb-zaehler aria-live="polite"></p>
      </div>
    {%- endif -%}

    <div class="color-swatch-picker__list-{{ color_picker_id }}" data-farb-liste>
      {% for value in color_option.values %}
        {% assign value_name = value | append: '' %}
        {% assign swatch_image = blank %}
        {% assign swatch_color = blank %}

        {% if value.swatch.image != blank %}
          {% assign swatch_image = value.swatch.image %}
        {% elsif value.swatch.color != blank %}
          {% assign swatch_color = value.swatch.color %}
        {% endif %}

        {% if swatch_image == blank %}
          {% for variant in product.variants %}
            {% if variant.options[color_option_index] == value_name and variant.featured_image != blank %}
              {% assign swatch_image = variant.featured_image %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if swatch_color == blank %}
          {% assign value_downcase = value_name | downcase %}

          {% case value_downcase %}
            {% when 'weiß', 'weiss', 'white' %}
              {% assign swatch_color = '#ffffff' %}
            {% when 'schwarz', 'black' %}
              {% assign swatch_color = '#000000' %}
            {% when 'grau', 'gray', 'grey' %}
              {% assign swatch_color = '#808080' %}
            {% when 'rot', 'red' %}
              {% assign swatch_color = '#d92d2d' %}
            {% when 'blau', 'blue' %}
              {% assign swatch_color = '#1f5fbf' %}
            {% when 'grün', 'gruen', 'green' %}
              {% assign swatch_color = '#2f9e44' %}
            {% when 'gelb', 'yellow' %}
              {% assign swatch_color = '#f2c500' %}
            {% when 'braun', 'brown' %}
              {% assign swatch_color = '#8b5a3c' %}
            {% when 'beige' %}
              {% assign swatch_color = '#e8d7ad' %}
            {% when 'orange' %}
              {% assign swatch_color = '#ff8f1f' %}
            {% when 'sand' %}
              {% assign swatch_color = '#d9c7a1' %}
            {% else %}
              {% assign swatch_color = '#d8d8d8' %}
          {% endcase %}
        {% endif %}

        {% if value_name contains '/' %}
          {% assign first_color = '#ffffff' %}
          {% assign second_color = swatch_color %}

          {% if value_name contains 'Gelb' or value_name contains 'gelb' %}
            {% assign second_color = '#f2c500' %}
          {% endif %}

          {% if value_name contains 'Rot' or value_name contains 'rot' %}
            {% assign second_color = '#d92d2d' %}
          {% endif %}

          {% if value_name contains 'Blau' or value_name contains 'blau' %}
            {% assign second_color = '#1f5fbf' %}
          {% endif %}

          {% assign swatch_color = 'repeating-linear-gradient(135deg, '
            | append: first_color
            | append: ' 0 7px, '
            | append: second_color
            | append: ' 7px 14px)'
          %}
        {% endif %}

        {%- comment -%}
          Farbfamilie aus dem Namen ableiten. Sie ist nur ein Filter fuer die
          Anzeige - Variante, Preis und Verfuegbarkeit haengen weiter allein am
          Optionswert im Radio-Feld darunter. Faellt die Zuordnung aus (neuer
          Farbname, den keine Regel kennt), landet der Wert in "uebrige" und
          bleibt ueber "Alle" und die Suche erreichbar; verschwinden kann eine
          Farbe dadurch nie.
        {%- endcomment -%}
        {%- liquid
          assign tp_cs_low = value_name | downcase
          assign tp_cs_familie = 'uebrige'
          assign tp_cs_familie_label = 'Uebrige'

          if tp_cs_low contains 'grau' or tp_cs_low contains 'anthrazit' or tp_cs_low contains 'schwarz' or tp_cs_low contains 'silber'
            assign tp_cs_familie = 'grau'
            assign tp_cs_familie_label = 'Grau & Schwarz'
          elsif tp_cs_low contains 'beige' or tp_cs_low contains 'sand' or tp_cs_low contains 'creme' or tp_cs_low contains 'taupe' or tp_cs_low contains 'greige' or tp_cs_low contains 'braun' or tp_cs_low contains 'ocker' or tp_cs_low contains 'nuss' or tp_cs_low contains 'eiche'
            assign tp_cs_familie = 'beige'
            assign tp_cs_familie_label = 'Beige & Braun'
          elsif tp_cs_low contains 'blau' or tp_cs_low contains 'petrol' or tp_cs_low contains 'tuerkis' or tp_cs_low contains 'türkis'
            assign tp_cs_familie = 'blau'
            assign tp_cs_familie_label = 'Blau'
          elsif tp_cs_low contains 'gruen' or tp_cs_low contains 'grün' or tp_cs_low contains 'oliv' or tp_cs_low contains 'salbei'
            assign tp_cs_familie = 'gruen'
            assign tp_cs_familie_label = 'Gruen'
          elsif tp_cs_low contains 'rot' or tp_cs_low contains 'bordeaux' or tp_cs_low contains 'orange' or tp_cs_low contains 'terra'
            assign tp_cs_familie = 'rot'
            assign tp_cs_familie_label = 'Rot & Orange'
          elsif tp_cs_low contains 'gelb' or tp_cs_low contains 'senf'
            assign tp_cs_familie = 'gelb'
            assign tp_cs_familie_label = 'Gelb'
          elsif tp_cs_low contains 'weiss' or tp_cs_low contains 'weiß'
            assign tp_cs_familie = 'weiss'
            assign tp_cs_familie_label = 'Weiss'
          endif
        -%}
        <label
          class="color-swatch-picker__item-{{ color_picker_id }}"
          data-farb-item
          data-farb-name="{{ value_name | downcase | escape }}"
          data-farb-familie="{{ tp_cs_familie }}"
          data-farb-familie-label="{{ tp_cs_familie_label | escape }}"
        >
          <input
            class="color-swatch-picker__input-{{ color_picker_id }}"
            type="radio"
            name="color-swatch-{{ color_picker_id }}"
            value="{{ value_name | escape }}"
            {% if value_name == selected_color %}
              checked
            {% endif %}
          >

          <span
            class="color-swatch-picker__button-{{ color_picker_id }}"
            title="{{ value_name | escape }}"
            aria-label="{{ value_name | escape }}"
          >
            {% if swatch_image != blank %}
              <img
                class="color-swatch-picker__image-{{ color_picker_id }}"
                src="{{ swatch_image | image_url: width: 120 }}"
                alt="{{ value_name | escape }}"
                width="60"
                height="46"
                loading="lazy"
              >
            {% else %}
              <span
                class="color-swatch-picker__color-{{ color_picker_id }} color-swatch-picker__fallback-{{ color_picker_id }}"
                style="--swatch-color: {{ swatch_color }};"
              ></span>
            {% endif %}
          </span>
          {%- comment -%}
            Der Name stand bisher nur in title und aria-label. Auf dem Telefon
            gibt es kein Hover - bei 20 Farben, von denen mehrere "Taupe Dunkel
            Heller" und "Taupe Dunkel Dunkler" heissen, war die Auswahl ein
            Ratespiel. Jetzt steht er sichtbar unter dem Feld.
          {%- endcomment -%}
          <span class="color-swatch-picker__name-{{ color_picker_id }}">{{ value_name }}</span>
        </label>
      {% endfor %}
    </div>
  </color-swatch-picker-{{ color_picker_id }}>

  <script>
    (function() {
      const picker = document.querySelector('color-swatch-picker-{{ color_picker_id }}');
      if (!picker || picker.dataset.initialized === 'true') return;
      picker.dataset.initialized = 'true';

      const swatchInputs = Array.from(
        picker.querySelectorAll('.color-swatch-picker__input-{{ color_picker_id }}')
      );
      const activeColorLabel = picker.querySelector('[data-active-color]');

      const variants = {{ product.variants | json }};
      const optionNames = {{ product.options | json }};
      const colorOptionName = {{ color_option.name | json }};
      const colorOptionIndex = {{ color_option_index }};
      const productUrl = {{ product.url | json }};
      // Letzter Rueckfall fuer die aktuellen Optionswerte. Auf Rollenware-
      // Seiten gibt es weder native Optionsfelder noch ein /cart/add-Formular
      // (der Rollenware-Rechner ersetzt es) und beim ersten Aufruf auch kein
      // ?variant= in der URL. Ohne diesen Wert lieferte getCurrentOptionValues
      // fuer jede Option null, findMatchingVariant fand nie eine Variante und
      // der Change-Handler brach ab: Die Farbe liess sich sichtbar anklicken,
      // bestellt wurde aber weiter die zuerst geladene.
      const initialOptions = {{ selected_variant.options | json }};

      function getNativeOptionInputs(optionName) {
        const radioInputs = Array.from(
          document.querySelectorAll('input[type="radio"][name="options[' + optionName + ']"]')
        );

        if (radioInputs.length > 0) {
          return radioInputs;
        }

        const selectInput = document.querySelector('select[name="options[' + optionName + ']"]');
        return selectInput ? [selectInput] : [];
      }

      function getCurrentVariantIdFromForms() {
        const variantInput = document.querySelector('form[action*="/cart/add"] input[name="id"]');
        return variantInput ? String(variantInput.value) : null;
      }

      function getCurrentOptionValues() {
        return optionNames.map(function(optionName, index) {
          const nativeInputs = getNativeOptionInputs(optionName);

          if (nativeInputs.length === 0) {
            const currentVariantId =
              getCurrentVariantIdFromForms() ||
              new URLSearchParams(window.location.search).get('variant');

            const currentVariant = variants.find(function(variant) {
              return String(variant.id) === String(currentVariantId);
            });

            if (currentVariant) return currentVariant.options[index];
            return initialOptions && initialOptions[index] != null ? initialOptions[index] : null;
          }

          const firstInput = nativeInputs[0];

          if (firstInput.tagName === 'SELECT') {
            return firstInput.value;
          }

          const checkedInput = nativeInputs.find(function(input) {
            return input.checked;
          });

          return checkedInput ? checkedInput.value : null;
        });
      }

      function findMatchingVariant(nextColor) {
        const nextOptions = getCurrentOptionValues();
        nextOptions[colorOptionIndex] = nextColor;

        return variants.find(function(variant) {
          return variant.options.every(function(optionValue, index) {
            return optionValue === nextOptions[index];
          });
        });
      }

      function setNativeColorValue(colorValue) {
        const nativeInputs = getNativeOptionInputs(colorOptionName);
        if (nativeInputs.length === 0) return;

        const firstInput = nativeInputs[0];

        if (firstInput.tagName === 'SELECT') {
          if (firstInput.value === colorValue) return;

          firstInput.value = colorValue;
          firstInput.dispatchEvent(new Event('input', { bubbles: true }));
          firstInput.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }

        const matchingInput = nativeInputs.find(function(input) {
          return input.value === colorValue;
        });

        if (!matchingInput || matchingInput.checked) return;

        nativeInputs.forEach(function(input) {
          input.checked = input.value === colorValue;
        });

        matchingInput.dispatchEvent(new Event('input', { bubbles: true }));
        matchingInput.dispatchEvent(new Event('change', { bubbles: true }));
      }

      function setVariantIdInput(variantId) {
        document.querySelectorAll('form[action*="/cart/add"] input[name="id"]').forEach(function(input) {
          input.value = variantId;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }

      function syncSwatchUI(colorValue) {
        swatchInputs.forEach(function(input) {
          input.checked = input.value === colorValue;
        });

        if (activeColorLabel) {
          activeColorLabel.textContent = colorValue;
        }
      }

      function updateUrl(variantId) {
        const nextUrl = productUrl + '?variant=' + variantId;
        window.history.replaceState({ path: nextUrl }, '', nextUrl);
      }

      function updateProductMedia(variant) {
        if (!variant) return;

        const featuredMediaId = variant.featured_media ? String(variant.featured_media.id) : null;
        const featuredImageSrc = variant.featured_image ? variant.featured_image.src : null;

        if (featuredMediaId) {
          document.querySelectorAll('[data-media-id], [data-product-media-id], [data-media-item]').forEach(function(item) {
            const mediaId =
              item.getAttribute('data-media-id') ||
              item.getAttribute('data-product-media-id') ||
              item.getAttribute('data-media-item');

            if (!mediaId) return;

            const normalizedId = String(mediaId).replace(/^.+-/, '');

            if (normalizedId === featuredMediaId || String(mediaId) === featuredMediaId) {
              const trigger = item.querySelector('button, [role="button"], img') || item;

              if (trigger && typeof trigger.click === 'function') {
                trigger.click();
              }
            }
          });
        }

        if (featuredImageSrc) {
          const mainImages = document.querySelectorAll(
            '.product__media img, .product-media img, media-gallery img'
          );

          mainImages.forEach(function(image) {
            image.src = featuredImageSrc;
            image.removeAttribute('srcset');
          });
        }
      }

      picker.addEventListener('change', function(event) {
        const input = event.target;
        if (!input.matches('input[type="radio"]')) return;

        const variant = findMatchingVariant(input.value);
        if (!variant) return;

        syncSwatchUI(input.value);
        setVariantIdInput(variant.id);
        updateUrl(variant.id);
        updateProductMedia(variant);
        setNativeColorValue(input.value);
        // Farbanzeige und Farbnummer-Properties nachziehen (assets/tp-farbe.js).
        // Auf Rollenware-Seiten gibt es keinen nativen Variantenwaehler, also kein variant:update.
        document.dispatchEvent(new CustomEvent('tp:farbe-wechsel', { detail: { variantId: String(variant.id) } }));
      });

      syncSwatchUI({{ selected_color | json }});
    })();
  </script>

  {%- comment -%}
    Kompakte Darstellung ueber die zentrale Farbauswahl (snippets/tp-farbauswahl):
    Ausloeser mit Farbbild und Name, dahinter Bottom Sheet bzw. Dialog. Das
    Snippet ist reine Oberflaeche und klickt nur die Radio-Felder dieses Blocks
    an - derselbe Codepfad wie ein Klick im Raster (change-Handler oben).
    Ab 2 Farben (Vorgabe Inhaber 2026-09-21): ueberall dieselbe Bedienung. Bei
    nur einer Farbe gibt es nichts zu waehlen. Ohne JS oder bei
    darstellung = "raster" bleibt das Raster sichtbar.
  {%- endcomment -%}
  {%- if block.settings.darstellung == 'dropdown' and color_option.values.size > 1 -%}
    {%- liquid
      assign tp_cs_muster_url = ''
      unless product.tags contains 'zubehoer'
        capture tp_cs_muster_url
          render 'tp-musteroption', product: product
        endcapture
        assign tp_cs_muster_url = tp_cs_muster_url | strip
      endunless
      assign tp_cs_host = 'color-swatch-picker-' | append: color_picker_id
    -%}
    {%- render 'tp-farbauswahl',
      product: product,
      option: color_option,
      selected: selected_color,
      id: color_picker_id,
      host: tp_cs_host,
      muster_url: tp_cs_muster_url
    -%}
  {%- endif -%}
{% endif %}

{%- comment -%}
  Farbfilter. Bewusst ein eigener script-Block NACH der Variantenlogik: faellt
  hier etwas aus, bleibt die Farbauswahl selbst voll funktionsfaehig. Dieser
  Code liest nur Namen und setzt hidden - er fasst weder ein Radio-Feld noch
  die URL noch den Warenkorb an.
{%- endcomment -%}
{%- if color_option != blank and color_option.values.size >= 8 -%}
<script>
  (function () {
    var wurzel = document.querySelector('color-swatch-picker-{{ color_picker_id }}');
    if (!wurzel || wurzel.dataset.filterBereit === '1') return;
    wurzel.dataset.filterBereit = '1';

    var werkzeuge = wurzel.querySelector('[data-farb-werkzeuge]');
    var suche = wurzel.querySelector('[data-farb-suche]');
    var familienBox = wurzel.querySelector('[data-farb-familien]');
    var zaehler = wurzel.querySelector('[data-farb-zaehler]');
    var eintraege = Array.prototype.slice.call(wurzel.querySelectorAll('[data-farb-item]'));
    if (!werkzeuge || !eintraege.length) return;

    var aktiveFamilie = 'alle';

    // Familien in der Reihenfolge ihres ersten Auftretens - so stehen die
    // Toene, die das Produkt praegen, vorn statt einer festen Liste.
    var familien = [];
    eintraege.forEach(function (el) {
      var key = el.getAttribute('data-farb-familie');
      var label = el.getAttribute('data-farb-familie-label');
      if (!familien.some(function (f) { return f.key === key; })) {
        familien.push({ key: key, label: label, anzahl: 0 });
      }
      familien.filter(function (f) { return f.key === key; })[0].anzahl++;
    });

    function knopf(key, label) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'color-swatch-picker__familie-{{ color_picker_id }}';
      b.textContent = label;
      b.setAttribute('aria-pressed', key === aktiveFamilie ? 'true' : 'false');
      b.addEventListener('click', function () {
        aktiveFamilie = (aktiveFamilie === key && key !== 'alle') ? 'alle' : key;
        Array.prototype.forEach.call(familienBox.children, function (k) {
          k.setAttribute('aria-pressed', k.dataset.key === aktiveFamilie ? 'true' : 'false');
        });
        anwenden();
      });
      b.dataset.key = key;
      return b;
    }

    familienBox.appendChild(knopf('alle', 'Alle (' + eintraege.length + ')'));
    // Eine Familie, die alles enthaelt, ist kein Filter - dann bleibt es bei
    // der Suche.
    if (familien.length > 1) {
      familien.forEach(function (f) {
        familienBox.appendChild(knopf(f.key, f.label + ' (' + f.anzahl + ')'));
      });
    }

    function anwenden() {
      var q = (suche.value || '').trim().toLowerCase();
      var sichtbar = 0;

      eintraege.forEach(function (el) {
        var name = el.getAttribute('data-farb-name') || '';
        var gewaehlt = !!el.querySelector('input:checked');
        var passtFamilie = aktiveFamilie === 'alle' || el.getAttribute('data-farb-familie') === aktiveFamilie;
        var passtSuche = !q || name.indexOf(q) !== -1;

        // Die gewaehlte Farbe bleibt immer stehen. Sonst verschwaende sie beim
        // Tippen aus dem Raster, und der Kunde saehe nicht mehr, was im
        // Warenkorb landet - obwohl sich an der Auswahl nichts geaendert hat.
        var zeigen = (passtFamilie && passtSuche) || gewaehlt;
        el.hidden = !zeigen;
        if (zeigen) sichtbar++;
      });

      // "1 von 20" waere irrefuehrend, wenn dieses eine Feld nur die weiterhin
      // eingeblendete Auswahl ist und zur Suche gar nicht passt.
      var trefferOhneAuswahl = eintraege.filter(function (el) {
        var name = el.getAttribute('data-farb-name') || '';
        var passtFamilie = aktiveFamilie === 'alle' || el.getAttribute('data-farb-familie') === aktiveFamilie;
        return passtFamilie && (!q || name.indexOf(q) !== -1);
      }).length;

      if (trefferOhneAuswahl === 0) {
        zaehler.textContent = 'Keine Farbe passt – unten bleibt Ihre gewählte Farbe stehen.';
      } else if (sichtbar === eintraege.length) {
        zaehler.textContent = eintraege.length + ' Farben';
      } else {
        zaehler.textContent = trefferOhneAuswahl + ' von ' + eintraege.length + ' Farben';
      }
    }

    suche.addEventListener('input', anwenden);

    // Erst jetzt sichtbar machen: ohne JavaScript waeren Suchfeld und Chips
    // ein totes Bedienelement.
    werkzeuge.hidden = false;
    anwenden();
  })();
</script>
{%- endif -%}

<script>
  (function () {
    if (window.__hideColorOptionsInitialized) return;
    window.__hideColorOptionsInitialized = true;

    function hideColorOptions() {
      document.querySelectorAll('legend, label, .variant-option__legend').forEach(function (label) {
        const text = label.textContent.trim().toLowerCase();

        if (text === 'farbe' || text.startsWith('farbe:') || text === 'color' || text.startsWith('color:') || text === 'dekor' || text.startsWith('dekor:')) {
          const optionGroup = label.closest('fieldset, .variant-option, .product-form__input');

          if (optionGroup) {
            optionGroup.style.display = 'none';
          }
        }
      });
    }

    hideColorOptions();

    const observer = new MutationObserver(hideColorOptions);
    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });
  })();
</script>

