{% doc %}
  Farbvorschau fuer Leisten-Produktseiten: Eine Sockelleiste im Querschnitt-
  Schema (Wand, Leiste, Boden). Was die Sichtflaeche zeigt, haengt davon ab,
  welches Bild die gewaehlte Farbe hat:

    muster  Ein Farbmuster fuellt die Leiste im Schema: entweder eine
            quadratische Kachel bis 800 px (RAL-Kacheln der Feldwin- und
            Basira-Leisten) oder ein breiter Dekorstreifen ab Verhaeltnis 2:1
            (Herstellermuster der Skarven-Holzdekore, 915 x 355). Das Bild
            wird dabei genau einmal ueber die ganze Leiste gelegt - nie
            gekachelt. Ein Produktfoto im Pattern zu wiederholen war der
            Fehler, der bei Cortessa fuenf kleine Leisten nebeneinander zeigte.
    foto    Ein echtes Foto dieser Farbe (Cortessa, die 17 Skarven-Farbfotos)
            wird als Foto im Rahmen gezeigt, statt in das Schema gepresst
            oder darin wiederholt zu werden.
    ohne    Kein eigenes Bild: Das Schema bleibt neutral, mit Hinweis. Kein
            fremdes Foto, keine geratene Farbe.

  Ehrlichkeitsregel: Ein Bild gehoert nur dann zu dieser Farbe, wenn keine
  andere Farbe dasselbe Bild traegt (gleiche Regel wie in der Farbwahl). Die
  Leistenhoehe kommt aus dem Tag "hoehe:"; fehlt er, wird das Schema in einer
  Standardhoehe gezeichnet, aber keine Millimeterzahl behauptet.

  Der Block rendert nur die gewaehlte Farbe. Beim Variantenwechsel holt sich
  assets/tp-leisten-vorschau.js den frisch gerenderten Block aus der Antwort,
  die Horizon ohnehin laedt, und uebernimmt Bild und Beschriftung - eine
  Quelle (dieses Liquid), keine zweite Bildlogik im Browser.
{% enddoc %}

{%- liquid
  assign tp_lv_product = closest.product | default: product
  assign tp_lv_position = 0
  for tp_lv_option in tp_lv_product.options_with_values
    assign tp_lv_name = tp_lv_option.name | downcase
    if tp_lv_name contains 'farbe' or tp_lv_name contains 'dekor' or tp_lv_name contains 'color'
      assign tp_lv_position = tp_lv_option.position
      assign tp_lv_values = tp_lv_option.values
      assign tp_lv_selected = tp_lv_option.selected_value
      assign tp_lv_label = tp_lv_option.name
      break
    endif
  endfor
-%}

{%- if tp_lv_position > 0 and tp_lv_values.size > 0 -%}
  {%- liquid
    assign tp_lv_index = tp_lv_position | minus: 1
    assign tp_lv_id = block.id | replace: '_', '' | downcase

    capture tp_lv_raw
      render 'tp-leisten-merkmale', product: tp_lv_product
    endcapture
    assign tp_lv_parts = tp_lv_raw | strip | split: '|'
    assign tp_lv_hoehe_label = tp_lv_parts[1] | strip
    assign tp_lv_hoehe_key = tp_lv_parts[4] | strip
    assign tp_lv_hoehe_mm = tp_lv_hoehe_key | remove: 'mm-xl' | remove: 'mm' | plus: 0
    assign tp_lv_hoehe_bekannt = true
    if tp_lv_hoehe_mm < 20
      assign tp_lv_hoehe_bekannt = false
      assign tp_lv_hoehe_mm = 60
    endif
    # 100 mm entsprechen 150 px im Schema
    assign tp_lv_board_h = tp_lv_hoehe_mm | times: 1.5 | round
    assign tp_lv_board_top = 262 | minus: tp_lv_board_h

    # Bild der gewaehlten Farbe: erste Variante dieser Farbe mit Bild
    assign tp_lv_variante = null
    assign tp_lv_media = null
    for tp_lv_v in tp_lv_product.variants
      if tp_lv_v.options[tp_lv_index] == tp_lv_selected
        unless tp_lv_variante
          assign tp_lv_variante = tp_lv_v
        endunless
        if tp_lv_v.featured_media != blank
          unless tp_lv_media
            assign tp_lv_media = tp_lv_v.featured_media
          endunless
        endif
      endif
    endfor

    assign tp_lv_eigen = false
    if tp_lv_media
      assign tp_lv_eigen = true
      for tp_lv_v in tp_lv_product.variants
        if tp_lv_v.featured_media != blank and tp_lv_v.featured_media.id == tp_lv_media.id and tp_lv_v.options[tp_lv_index] != tp_lv_selected
          assign tp_lv_eigen = false
          break
        endif
      endfor
    endif

    assign tp_lv_art = 'ohne'
    assign tp_lv_src = ''
    if tp_lv_eigen
      assign tp_lv_w = tp_lv_media.preview_image.width | default: 0
      assign tp_lv_h = tp_lv_media.preview_image.height | default: 0
      # Farbmuster sind entweder kleine Quadrate (RAL-Kacheln, 800 px) oder
      # breite Dekorstreifen (Herstellermuster, z. B. 915 x 355). Produktfotos
      # sind gross und annaehernd 1:1 bis 3:2.
      assign tp_lv_quadrat = false
      if tp_lv_w > 0 and tp_lv_w == tp_lv_h and tp_lv_w <= 800
        assign tp_lv_quadrat = true
      endif
      assign tp_lv_streifen = false
      if tp_lv_h > 0
        assign tp_lv_verhaeltnis = tp_lv_w | times: 1.0 | divided_by: tp_lv_h
        if tp_lv_verhaeltnis >= 2.0
          assign tp_lv_streifen = true
        endif
      endif
      if tp_lv_quadrat or tp_lv_streifen
        assign tp_lv_art = 'muster'
        assign tp_lv_src = tp_lv_media | image_url: width: 960
      else
        assign tp_lv_art = 'foto'
        assign tp_lv_src = tp_lv_media | image_url: width: 900
      endif
    endif

    capture tp_lv_farbname
      if tp_lv_variante
        render 'tp-farbe-daten', variant: tp_lv_variante, product: tp_lv_product, feld: 'name'
      endif
    endcapture
    assign tp_lv_farbname = tp_lv_farbname | strip | default: tp_lv_selected

    case tp_lv_art
      when 'foto'
        assign tp_lv_art_text = 'Produktfoto dieser Farbe'
      when 'muster'
        assign tp_lv_art_text = 'Schematische Ansicht mit Farbmuster'
      else
        assign tp_lv_art_text = 'Schematische Ansicht'
    endcase
  -%}

  <script src="{{ 'tp-leisten-vorschau.js' | asset_url }}" defer></script>
  <tp-leisten-vorschau
    class="tp-lv tp-lv--{{ tp_lv_art }}"
    id="tp-lv-{{ tp_lv_id }}"
    data-tp-vorschau
    data-tp-vorschau-art="{{ tp_lv_art }}"
    {{ block.shopify_attributes }}
  >
    <figure class="tp-lv__figure">
      <div class="tp-lv__frame">
        <img
          class="tp-lv__foto"
          data-tp-vorschau-foto
          {% if tp_lv_art == 'foto' %}src="{{ tp_lv_src }}"{% endif %}
          alt="{{ tp_lv_label | escape }} {{ tp_lv_farbname | escape }}"
          width="900"
          height="495"
          loading="lazy"
        >
        <svg class="tp-lv__svg" viewBox="0 0 600 330" role="img" aria-labelledby="tp-lv-title-{{ tp_lv_id }}">
          <title id="tp-lv-title-{{ tp_lv_id }}">Schematische Ansicht der Sockelleiste in der gewählten Farbe</title>
          <defs>
            <linearGradient id="tp-lv-wall-{{ tp_lv_id }}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f3f2f0"/>
              <stop offset="1" stop-color="#e6e4e0"/>
            </linearGradient>
            <linearGradient id="tp-lv-floor-{{ tp_lv_id }}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#d9cbb3"/>
              <stop offset="1" stop-color="#c9b797"/>
            </linearGradient>
            <linearGradient id="tp-lv-shade-{{ tp_lv_id }}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.22"/>
              <stop offset="0.35" stop-color="#ffffff" stop-opacity="0"/>
              <stop offset="1" stop-color="#000000" stop-opacity="0.12"/>
            </linearGradient>
            {%- comment -%}
              Das Pattern ist genau so gross wie die Leiste, das Bild wird
              einmal darueber gelegt (slice) - keine Wiederholung.
            {%- endcomment -%}
            <pattern id="tp-lv-muster-{{ tp_lv_id }}" patternUnits="userSpaceOnUse" x="60" y="{{ tp_lv_board_top }}" width="480" height="{{ tp_lv_board_h }}">
              <image data-tp-vorschau-bild href="{% if tp_lv_art == 'muster' %}{{ tp_lv_src }}{% endif %}" x="0" y="0" width="480" height="{{ tp_lv_board_h }}" preserveAspectRatio="xMidYMid slice"/>
            </pattern>
          </defs>
          <rect x="0" y="0" width="600" height="262" fill="url(#tp-lv-wall-{{ tp_lv_id }})"/>
          <rect x="0" y="262" width="600" height="68" fill="url(#tp-lv-floor-{{ tp_lv_id }})"/>
          <g class="tp-lv__floor-lines" stroke="#b8a88a" stroke-opacity="0.35">
            <line x1="0" y1="284" x2="600" y2="284"/>
            <line x1="0" y1="306" x2="600" y2="306"/>
            <line x1="150" y1="262" x2="150" y2="284"/><line x1="360" y1="262" x2="360" y2="284"/>
            <line x1="80" y1="284" x2="80" y2="306"/><line x1="290" y1="284" x2="290" y2="306"/><line x1="500" y1="284" x2="500" y2="306"/>
            <line x1="200" y1="306" x2="200" y2="330"/><line x1="420" y1="306" x2="420" y2="330"/>
          </g>
          <rect x="60" y="264" width="480" height="6" fill="#000" opacity="0.12"/>
          <g class="tp-lv__board">
            <rect x="60" y="{{ tp_lv_board_top }}" width="480" height="{{ tp_lv_board_h }}" fill="#d6d3cf"/>
            <rect class="tp-lv__flaeche" x="60" y="{{ tp_lv_board_top }}" width="480" height="{{ tp_lv_board_h }}" fill="url(#tp-lv-muster-{{ tp_lv_id }})"/>
            <rect x="60" y="{{ tp_lv_board_top }}" width="480" height="{{ tp_lv_board_h }}" fill="url(#tp-lv-shade-{{ tp_lv_id }})"/>
            <rect x="60" y="{{ tp_lv_board_top }}" width="480" height="3" fill="#fff" opacity="0.45"/>
            <rect x="60" y="{{ tp_lv_board_top }}" width="480" height="{{ tp_lv_board_h }}" fill="none" stroke="#000" stroke-opacity="0.18"/>
          </g>
          {%- if tp_lv_hoehe_bekannt -%}
            <g class="tp-lv__mass" font-family="inherit" font-size="15" fill="#5b5855">
              <line x1="562" y1="{{ tp_lv_board_top }}" x2="562" y2="262" stroke="#8a8683" stroke-width="1.5"/>
              <line x1="556" y1="{{ tp_lv_board_top }}" x2="568" y2="{{ tp_lv_board_top }}" stroke="#8a8683" stroke-width="1.5"/>
              <line x1="556" y1="262" x2="568" y2="262" stroke="#8a8683" stroke-width="1.5"/>
              <text x="562" y="{{ tp_lv_board_top | minus: 8 }}" text-anchor="middle" font-size="13">{{ tp_lv_hoehe_mm }} mm</text>
            </g>
          {%- endif -%}
        </svg>
        <p class="tp-lv__leer">Für diese Farbe ist noch kein Musterbild hinterlegt.</p>
      </div>
      <figcaption class="tp-lv__caption">
        <span class="tp-lv__caption-label" data-tp-vorschau-art>{{ tp_lv_art_text }}</span>
        <span class="tp-lv__caption-value">{{ tp_lv_label | escape }}: <strong data-tp-vorschau-name>{{ tp_lv_farbname | escape }}</strong>{% if tp_lv_hoehe_label != blank %} · {{ tp_lv_hoehe_label }} hoch{% endif %}</span>
      </figcaption>
    </figure>
  </tp-leisten-vorschau>
{%- endif -%}

{% stylesheet %}
  .tp-lv {
    display: block;
    width: 100%;
  }

  .tp-lv__figure {
    margin: 0;
  }

  .tp-lv__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 600 / 330;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: var(--style-border-radius-md, 8px);
    background: #f3f2f0;
  }

  .tp-lv__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tp-lv__leer {
    display: none;
    position: absolute;
    inset-inline: 12px;
    top: 12px;
    margin: 0;
    padding: 8px 12px;
    background: rgb(255 255 255 / 0.92);
    border-radius: 6px;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.75);
    text-align: center;
  }

  .tp-lv--ohne .tp-lv__leer {
    display: block;
  }

  .tp-lv--ohne .tp-lv__flaeche {
    opacity: 0;
  }

  /* Foto dieser Farbe: fuellt den Rahmen, das Schema bleibt dahinter aus */
  .tp-lv__foto {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #f6f5f3;
  }

  .tp-lv--foto .tp-lv__foto {
    display: block;
  }

  .tp-lv--foto .tp-lv__svg {
    visibility: hidden;
  }

  .tp-lv__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    margin-block-start: 6px;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .tp-lv__caption strong {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Leisten-Farbvorschau",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "TP Leisten-Farbvorschau"
    }
  ]
}
{% endschema %}
