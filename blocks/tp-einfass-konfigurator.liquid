{% doc %}
  Konfigurator fuer Teppiche nach Mass mit Einfassung (Cover, gekettelt,
  Einfassband, Paspelband). Rechenkern: assets/tp-masstepich-rechnung.js,
  Bedienung und Vorschau: assets/tp-einfass-konfigurator.js.

  Fail closed - der Block rendert nichts, sobald eine Angabe fehlt oder
  unbekannt ist:
    service.einfassung      Cover | Ketteln | Einfassband | Paspelband
    service.max_breite_cm   > 0 (Cover: Rollenbreite minus 10 cm)
    service.max_laenge_cm   > 0
    custom.preis_pro_001_qm true (Variantenpreis gilt pro 0,01 m2)
  Angeboten werden nur Varianten mit service.einfassen exakt "Verfuegbar"
  (mit Umlaut) und Preis > 0. Formen aus service.formen (Rechteck, Rund,
  Oval, Schablone, Skizze); unbekannte Werte fallen weg, ohne Angabe gibt es
  nur Rechteck. Schablone und Skizze gehen als Anfrage, nicht in den Warenkorb.

  Abgerechnet wird Variantenpreis x Menge durch Shopify. Menge = abgerechnete
  Flaeche in 0,01-m2-Einheiten (rund und oval: umschliessendes Rechteck),
  mindestens service.mindestpreis (EUR).
{% enddoc %}

{%- liquid
  assign tp_ek_id = block.id | replace: '_', '' | downcase
  assign tp_ek_art = product.metafields.service.einfassung.value | strip | downcase
  assign tp_ek_arten = 'cover,ketteln,einfassband,paspelband' | split: ','
  # Groesste Breite kommt vom Teppichboden (snippets/tp-teppich-max-breite), hier ueber
  # alle Farben; je Farbe steht sie unten an der Variante.
  capture tp_ek_max_b
    render 'tp-teppich-max-breite', product: product
  endcapture
  assign tp_ek_max_b = tp_ek_max_b | strip | times: 1
  assign tp_ek_max_l = product.metafields.service.max_laenge_cm.value | times: 1

  assign tp_ek_raum_keys = 'wohnzimmer,esszimmer,schlafzimmer,kinderzimmer,flur' | split: ','
  assign tp_ek_raum_namen = 'Wohnzimmer,Esszimmer,Schlafzimmer,Kinderzimmer,Flur' | split: ','
  assign tp_ek_boden = block.settings.boden_prozent | default: 34 | times: 1
  assign tp_ek_raum_aktiv = block.settings.raumansicht_aktiv
  # Streichpreis nur bei aktiver Aktion - dieselbe Quelle wie ueberall (S-20, S-32).
  capture tp_ek_aktion
    render 'tp-rabatt-sichtbar', product: product
  endcapture
  assign tp_ek_aktion = tp_ek_aktion | strip
  assign tp_ek_raumbreite = block.settings.raum_breite_cm | default: 420 | times: 1

  assign tp_ek_ok = false
  if tp_ek_arten contains tp_ek_art and tp_ek_max_b > 0 and tp_ek_max_l > 0
    if product.metafields.custom.preis_pro_001_qm.value == true
      assign tp_ek_ok = true
    endif
  endif

  assign tp_ek_anzahl = 0
  if tp_ek_ok
    for tp_ek_v in product.variants
      if tp_ek_v.metafields.service.einfassen.value == 'Verfügbar' and tp_ek_v.price > 0
        assign tp_ek_anzahl = tp_ek_anzahl | plus: 1
      endif
    endfor
  endif

  assign tp_ek_formen = ''
  for tp_ek_f in product.metafields.service.formen.value
    assign tp_ek_fk = tp_ek_f | strip | downcase
    case tp_ek_fk
      when 'rechteck', 'rund', 'oval', 'schablone', 'skizze'
        unless tp_ek_formen contains tp_ek_fk
          assign tp_ek_formen = tp_ek_formen | append: tp_ek_fk | append: ','
        endunless
    endcase
  endfor
  if tp_ek_formen == blank
    assign tp_ek_formen = 'rechteck,'
  endif
  assign tp_ek_formen = tp_ek_formen | split: ','

  # Mindestpreis als Zahl (EUR) oder als Geldbetrag - beides ergibt Cent.
  assign tp_ek_mp = product.metafields.service.mindestpreis.value
  if tp_ek_mp.amount
    assign tp_ek_mindest_cent = tp_ek_mp.amount | times: 100 | round
  else
    assign tp_ek_mindest_cent = tp_ek_mp | times: 100 | round
  endif
  assign tp_ek_wa = block.settings.whatsapp | remove: '+' | remove: ' ' | strip

  # Gekettelt wird zusaetzlich zur Flaeche berechnet: je 0,01 laufendem Meter
  # Kante, damit der Umfang zentimetergenau aufgeht. Nur bei der Art "ketteln"
  # und nur mit gewaehltem Service-Produkt; sonst bleibt es bei der reinen
  # Flaechenrechnung wie bei den Bandarten.
  assign tp_ek_kettel_v = nil
  # TP-005: von "kein separater Service konfiguriert" (Inklusivpreis, legitim)
  # unterscheiden wir jetzt ausdruecklich "Service konfiguriert, aber gerade
  # nicht kaufbar" - Letzteres darf den Teppich nicht stillschweigend als
  # vollstaendig gekettelt anbieten (siehe audit/ISSUES.md TP-005).
  assign tp_ek_kettel_service_failed = false
  if tp_ek_art == 'ketteln' and block.settings.kettelservice_produkt != blank
    assign tp_ek_kettel_v = block.settings.kettelservice_produkt.selected_or_first_available_variant
    unless tp_ek_kettel_v.available and tp_ek_kettel_v.price > 0
      assign tp_ek_kettel_v = nil
      assign tp_ek_kettel_service_failed = true
    endunless
  endif

  # Rohwarenbreiten der Meterware, aus der zugeschnitten wird - nur fuer die
  # interne Angabe im Warenkorb. Der Kunde waehlt keine Rolle.
  assign tp_ek_rollen = ','
  for tp_ek_bv in product.metafields.service.einfass_basis.value.variants
    assign tp_ek_rb = tp_ek_bv.metafields.custom.rollenbreite.value | times: 100 | round
    if tp_ek_rb > 0
      capture tp_ek_rb_s
        echo tp_ek_rb
      endcapture
      capture tp_ek_rb_key
        echo ','
        echo tp_ek_rb_s
        echo ','
      endcapture
      unless tp_ek_rollen contains tp_ek_rb_key
        assign tp_ek_rollen = tp_ek_rollen | append: tp_ek_rb_s | append: ','
      endunless
    endif
  endfor
  assign tp_ek_rollen_liste = tp_ek_rollen | split: ','
-%}

{%- if tp_ek_ok and tp_ek_anzahl > 0 -%}
  {%- liquid
    assign tp_ek_mit_band = false
    if tp_ek_art == 'einfassband' or tp_ek_art == 'paspelband'
      assign tp_ek_mit_band = true
    endif
    assign tp_ek_mit_anfrage = false
    if tp_ek_formen contains 'schablone' or tp_ek_formen contains 'skizze'
      assign tp_ek_mit_anfrage = true
    endif
  -%}
  {%- if tp_ek_mit_band -%}
    {%- capture tp_ek_baender -%}{% render 'tp-bandfarben' %}{%- endcapture -%}
  {%- endif -%}

  <div class="tp-ek tp-kaufweg" id="tp-ek-{{ tp_ek_id }}" data-tp-ek {{ block.shopify_attributes }}>
    <div class="tp-ek__schritt" data-schritt="form"{% if tp_ek_formen.size < 2 %} hidden{% endif %}>
      {% render 'tp-step-heading', number: 2, label: 'Form' %}
      <div class="tp-ek__formen" role="radiogroup" aria-label="Form">
        {%- for tp_ek_f in tp_ek_formen -%}
          {%- case tp_ek_f -%}
            {%- when 'rechteck' -%}{%- assign tp_ek_fl = 'Rechteck' -%}
            {%- when 'rund' -%}{%- assign tp_ek_fl = 'Rund' -%}
            {%- when 'oval' -%}{%- assign tp_ek_fl = 'Oval' -%}
            {%- when 'schablone' -%}{%- assign tp_ek_fl = 'Schablone' -%}
            {%- when 'skizze' -%}{%- assign tp_ek_fl = 'Skizze' -%}
          {%- endcase -%}
          <label class="tp-ek__form">
            <input type="radio" name="tp-ek-form-{{ tp_ek_id }}" value="{{ tp_ek_f }}"{% if forloop.first %} checked{% endif %}>
            <span class="tp-ek__form-karte">
              <svg viewBox="0 0 40 28" aria-hidden="true" focusable="false">
                {%- case tp_ek_f -%}
                  {%- when 'rechteck' -%}<rect x="5" y="6" width="30" height="16" rx="1.5"/>
                  {%- when 'rund' -%}<circle cx="20" cy="14" r="10"/>
                  {%- when 'oval' -%}<ellipse cx="20" cy="14" rx="15" ry="9"/>
                  {%- when 'schablone' -%}<path d="M6 22 V7 H17 V12 H34 V22 Z" stroke-dasharray="3 2"/>
                  {%- when 'skizze' -%}<path d="M6 21 C10 8, 16 24, 21 12 S31 6, 34 18"/><path d="M29 4 l5 5 -11 11 -6 1 1 -6 z"/>
                {%- endcase -%}
              </svg>
              <span>{{ tp_ek_fl }}</span>
            </span>
          </label>
        {%- endfor -%}
      </div>
    </div>

    <div class="tp-ek__konfig" data-konfig>
      <div class="tp-ek__schritt" data-schritt="masse">
        {% render 'tp-step-heading', number: 3, label: 'Maße' %}
        <div class="tp-ek__masse">
          <label class="tp-ek__mass">
            <span class="tp-ek__mass-label" data-label-breite>Breite</span>
            <span class="tp-ek__eingabe">
              <input type="number" inputmode="numeric" min="50" step="1" placeholder="250" data-breite>
              <span>cm</span>
            </span>
          </label>
          <span class="tp-ek__mal" data-feld-laenge aria-hidden="true">×</span>
          <label class="tp-ek__mass" data-feld-laenge>
            <span class="tp-ek__mass-label">Länge</span>
            <span class="tp-ek__eingabe">
              <input type="number" inputmode="numeric" min="50" step="1" placeholder="400" data-laenge>
              <span>cm</span>
            </span>
          </label>
        </div>
        <div class="tp-ek__groessen" data-groessen></div>
        <p class="tp-ek__grenzen" data-grenzen></p>
        <p class="tp-ek__fehler" role="alert" data-fehler hidden></p>
      </div>

      {%- if tp_ek_mit_band -%}
        <div class="tp-ek__schritt" data-schritt="band">
          {% render 'tp-step-heading', number: 4, label: 'Bandfarbe' %}
          <div class="tp-ek__baender" role="radiogroup" aria-label="Bandfarbe" data-baender></div>
          <p class="tp-ek__bandname" data-band-name>Bitte eine Farbe wählen</p>
        </div>
      {%- endif -%}

      <figure class="tp-ek__vorschau" data-vorschau hidden>
        {%- comment -%}
          Zwei Ansichten auf dieselbe Konfiguration: der Teppich im Raum (Groessenwirkung)
          und die Masszeichnung mit Bemassung und Kantenlupe (Nachpruefbarkeit). Beide
          zeigen immer denselben Stand - Farbe, Mass und Kante kommen aus einer Rechnung.
        {%- endcomment -%}
{%- comment -%}
          Raumansicht ist ueber "raumansicht_aktiv" abschaltbar (Standard: aus). Dann wird
          weder Umschalter noch Buehne noch Raumwahl ausgegeben und die Raumliste bleibt
          leer - das Skript faellt damit von selbst auf die Masszeichnung zurueck.
        {%- endcomment -%}
        {%- if tp_ek_raum_aktiv -%}
                <div class="tp-ek__ansicht" role="group" aria-label="Ansicht wählen">
          <button type="button" data-ansicht="raum" aria-pressed="true">Im Raum</button>
          <button type="button" data-ansicht="plan" aria-pressed="false">Maßzeichnung</button>
        </div>

        <div class="tp-ek__buehne" data-buehne>
          <img class="tp-ek__raumbild" data-raumbild alt="" width="360" height="240" hidden>
          <svg class="tp-ek__kulisse" viewBox="0 0 360 240" preserveAspectRatio="none" aria-hidden="true" data-kulisse></svg>
          <div class="tp-ek__boden" data-boden>
            <div class="tp-ek__teppich" data-teppich></div>
          </div>
        </div>
        <div class="tp-ek__raeume" role="group" aria-label="Raum wählen" data-raeume></div>
        {%- endif -%}

        <svg class="tp-ek__svg is-aus" viewBox="0 0 360 250" role="img" aria-label="Vorschau Ihres Teppichs" data-svg></svg>
        <figcaption class="tp-ek__legende" data-legende></figcaption>
      </figure>

      {%- comment -%}
        Der Kunde sieht eine Zahl: seinen Preis. Die fruehere Aufschluesselung
        "So rechnen wir" ist aus der Kundenansicht entfernt (Entscheidung des
        Inhabers 2026-09-20); gerechnet wird unveraendert im Skript.
      {%- endcomment -%}
      <div class="tp-ek__preis" aria-live="polite" data-rechnung hidden>
        <div class="tp-ek__summe"><span>Ihr Preis</span><span class="tp-ek__summe-werte"><s class="tp-ek__summe-alt" data-summe-alt hidden></s><strong data-summe>–</strong></span></div>
        {%- comment -%}
          Keine Rechenaufschluesselung in der Kundenansicht (Entscheidung 2026-09-20):
          sichtbar sind Endpreis und die zwei Hinweise, die den Preis erklaeren muessen.
          Die Rechnung selbst laeuft unveraendert in tp-masstepich-rechnung.js.
        {%- endcomment -%}
        <p class="tp-ek__preishinweis" data-rund-hinweis hidden>Rund und oval: berechnet wird das umschließende Rechteck – so viel Teppich wird zugeschnitten.</p>
        <p class="tp-ek__preishinweis" data-mindest-hinweis hidden></p>
      </div>

      <button type="button" class="tp-ek__cta" data-cta data-add-to-cart disabled hidden>In den Warenkorb</button>
      <a href="{{ routes.cart_url }}" class="tp-ek__warenkorb" data-warenkorb hidden>Warenkorb ansehen</a>
    </div>

    {%- if tp_ek_mit_anfrage -%}
      {%- assign tp_ek_form_id = 'TPEinfassAnfrage-' | append: tp_ek_id -%}
      <div class="tp-ek__anfrage" data-anfrage hidden>
        <p class="tp-ek__anfrage-titel" data-anfrage-titel></p>
        <p class="tp-ek__anfrage-text" data-anfrage-text></p>
        {%- if tp_ek_wa != blank -%}
          <a class="tp-ek__whatsapp" href="https://wa.me/{{ tp_ek_wa | url_encode }}" target="_blank" rel="noopener" data-whatsapp data-wa="{{ tp_ek_wa | escape }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"/><path d="M9 9.5c.3 2 2.2 4.1 4.6 4.6l1.2-1.1 2 .9-.5 1.9c-3.9.2-8.1-4-7.9-7.9l1.9-.5.9 2z"/></svg>
            Foto per WhatsApp senden
          </a>
          <p class="tp-ek__oder">oder per E-Mail</p>
        {%- endif -%}
        {%- form 'contact', id: tp_ek_form_id, class: 'tp-ek__formular' -%}
          <input type="hidden" name="contact[id]" value="{{ tp_ek_form_id }}">
          {%- if form.posted_successfully? and form.id == tp_ek_form_id -%}
            <p class="tp-ek__erfolg" role="status" data-anfrage-status="ok">Danke! Wir melden uns mit einem Angebot.</p>
          {%- elsif form.errors and form.id == tp_ek_form_id -%}
            <p class="tp-ek__fehler" role="alert" data-anfrage-status="fehler">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[Produkt]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[Farbe]" value="" data-anfrage-farbe>
          <input type="hidden" name="contact[Form]" value="" data-anfrage-form>
          <div class="tp-ek__formular-reihe">
            <input type="text" name="contact[name]" autocomplete="name" placeholder="Name" aria-label="Name" required>
            <input type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" placeholder="E-Mail" aria-label="E-Mail" required>
          </div>
          <input type="tel" name="contact[phone]" autocomplete="tel" placeholder="Telefon (optional)" aria-label="Telefon">
          <textarea name="contact[body]" rows="3" placeholder="Ungefähre Maße und Wünsche" aria-label="Ungefähre Maße und Wünsche"></textarea>
          <button type="submit" class="tp-ek__cta tp-ek__cta--zweit">Anfrage senden</button>
        {%- endform -%}
      </div>
    {%- endif -%}

    <script type="application/json" data-tp-ek-daten>
      {
        "art": {{ tp_ek_art | json }},
        "max_breite_cm": {{ tp_ek_max_b | json }},
        "max_laenge_cm": {{ tp_ek_max_l | json }},
        "mindestpreis_cent": {{ tp_ek_mindest_cent | json }},
        {%- comment -%} Preis je 0,01 lfm Kante, Rollenbreiten in cm {%- endcomment -%}
        "kettel": {% if tp_ek_kettel_v %}{ "id": {{ tp_ek_kettel_v.id | json }}, "price": {{ tp_ek_kettel_v.price | json }} }{% else %}null{% endif %},
        "kettel_service_failed": {{ tp_ek_kettel_service_failed | json }},
        "rollen": {{ tp_ek_rollen_liste | json }},
        "formen": {{ tp_ek_formen | json }},
        "produkt": {{ product.title | json }},
        {%- comment -%}
          Raumansicht: Foto je Raum kommt aus den Block-Einstellungen, damit es ohne
          Code-Deploy austauschbar ist. Ohne Foto zeichnet das Skript eine Kulisse -
          die Raumwahl funktioniert in beiden Faellen. "boden_prozent" ist die Hoehe
          der Bodenlinie im Bild, "raum_breite_cm" die Breite des Raums an der
          vorderen Bildkante; beide zusammen geben dem Teppich seinen Massstab.
        {%- endcomment -%}
        "boden_prozent": {{ tp_ek_boden | json }},
        "raum_breite_cm": {{ tp_ek_raumbreite | json }},
        "raeume": [
          {%- if tp_ek_raum_aktiv -%}
          {%- for tp_ek_r_key in tp_ek_raum_keys -%}
            {%- capture tp_ek_r_feld -%}raum_{{ tp_ek_r_key }}{%- endcapture -%}
            {%- assign tp_ek_r_bild = block.settings[tp_ek_r_feld] -%}
            {
              "key": {{ tp_ek_r_key | json }},
              "label": {{ tp_ek_raum_namen[forloop.index0] | json }},
              "bild": {% if tp_ek_r_bild %}{{ tp_ek_r_bild | image_url: width: 1200 | json }}{% else %}null{% endif %}
            },
          {%- endfor -%}
          {%- endif -%}
          null
        ],
        "selected_id": {{ product.selected_or_first_available_variant.id | json }},
        "baender": {% if tp_ek_mit_band %}{{ tp_ek_baender | strip }}{% else %}[]{% endif %},
        "varianten": [
          {%- for tp_ek_v in product.variants -%}
            {%- if tp_ek_v.metafields.service.einfassen.value == 'Verfügbar' and tp_ek_v.price > 0 -%}
              {%- capture tp_ek_v_name -%}{% render 'tp-farbe-daten', variant: tp_ek_v, product: product, feld: 'name' %}{%- endcapture -%}
              {%- capture tp_ek_v_nr -%}{% render 'tp-farbe-daten', variant: tp_ek_v, product: product, feld: 'nummer' %}{%- endcapture -%}
              {%- capture tp_ek_v_max -%}{% render 'tp-teppich-max-breite', product: product, farbe: tp_ek_v.option1 %}{%- endcapture -%}
              {%- assign tp_ek_v_max = tp_ek_v_max | strip | times: 1 -%}
              {
                "id": {{ tp_ek_v.id | json }},
                "price": {{ tp_ek_v.price | json }},
                "compare_at_price": {% if tp_ek_aktion == 'ja' and tp_ek_v.compare_at_price > tp_ek_v.price %}{{ tp_ek_v.compare_at_price | json }}{% else %}null{% endif %},
                "available": {{ tp_ek_v.available | json }},
                "max_breite_cm": {{ tp_ek_v_max | json }},
                "farbe": {{ tp_ek_v_name | strip | json }},
                "farbnummer": {{ tp_ek_v_nr | strip | json }},
                "optionen": {{ tp_ek_v.options | json }},
                "bild": {% if tp_ek_v.featured_image %}{{ tp_ek_v.featured_image | image_url: width: 480 | json }}{% else %}null{% endif %}
              },
            {%- endif -%}
          {%- endfor -%}
          null
        ]
      }
    </script>
    <script src="{{ 'tp-masstepich-rechnung.js' | asset_url }}" defer></script>
    <script src="{{ 'tp-zuschnitt-abgleich.js' | asset_url }}" defer></script>
    <script src="{{ 'tp-einfass-konfigurator.js' | asset_url }}" defer></script>
  </div>
{%- endif -%}

{{ 'tp-einfass-konfigurator.css' | asset_url | stylesheet_tag }}
{% comment %} CSS ausgelagert nach assets/tp-einfass-konfigurator.css (Shop 2.0 M10, Performance): nicht mehr im globalen Section-Bundle. {% endcomment %}

{% schema %}
{
  "name": "TP Einfass-Konfigurator",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Rendert nur bei vollstaendigen Metafeldern (service.einfassung, service.max_breite_cm, service.max_laenge_cm, custom.preis_pro_001_qm) und nur fuer Varianten mit service.einfassen = Verfuegbar."
    },
    {
      "type": "product",
      "id": "kettelservice_produkt",
      "label": "Kettelservice (Preis je 0,01 laufendem Meter Kante)",
      "info": "Nur fuer die Einfassart Ketteln. Ohne Produkt wird die Kante nicht getrennt berechnet."
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp-Nummer fuer Fotos",
      "info": "Nur Ziffern mit Laendervorwahl, z. B. 4917657931322. Leer lassen, um den Link auszublenden.",
      "default": "4917657931322"
    },
    {
      "type": "header",
      "content": "Raumansicht"
    },
    {
      "type": "checkbox",
      "id": "raumansicht_aktiv",
      "label": "Raumansicht (Im Raum) anzeigen",
      "info": "Aus: Kunden sehen nur die Masszeichnung. Fotos und Massstab unten bleiben gespeichert.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Fotos leerer Raeume mit freier Bodenflaeche, alle aus derselben Hoehe fotografiert. Ohne Foto zeichnet der Konfigurator eine schlichte Kulisse - die Raumwahl funktioniert trotzdem."
    },
    {
      "type": "image_picker",
      "id": "raum_wohnzimmer",
      "label": "Foto Wohnzimmer"
    },
    {
      "type": "image_picker",
      "id": "raum_esszimmer",
      "label": "Foto Esszimmer"
    },
    {
      "type": "image_picker",
      "id": "raum_schlafzimmer",
      "label": "Foto Schlafzimmer"
    },
    {
      "type": "image_picker",
      "id": "raum_kinderzimmer",
      "label": "Foto Kinderzimmer"
    },
    {
      "type": "image_picker",
      "id": "raum_flur",
      "label": "Foto Flur"
    },
    {
      "type": "range",
      "id": "boden_prozent",
      "label": "Bodenlinie im Foto",
      "unit": "%",
