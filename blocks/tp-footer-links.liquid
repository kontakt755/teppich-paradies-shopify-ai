{%- comment -%}
  B4 / Rechtliches: Spalten aus Menues statt fest codiert. Sortiment nimmt nur
  Kollektions-Links des gewaehlten Menues (Hauptmenue enthaelt auch Service und
  Kontakt). Rechtliches kommt aus dem Menue "footer" - dort steht Widerrufsrecht.
  Ohne Service-Menue greift die feste Liste darunter.
{%- endcomment -%}
{%- liquid
  assign tp_footer_shipping_page = pages['versand-lieferung']
  assign tp_fl_sortiment = block.settings.sortiment_menu
  assign tp_fl_service = block.settings.service_menu
  assign tp_fl_recht = block.settings.rechtliches_menu
  assign tp_fl_sonderposten = collections['sonderposten-im-laden']
  assign tp_fl_sonderposten_verlinkt = false
  # Geschenkgutschein (Werkbank w-034): Link erscheint erst, wenn das Produkt veroeffentlicht ist; Entwuerfe liefert all_products nicht
  assign tp_fl_gutschein = all_products['geschenkgutschein']
-%}

<div class="tp-footer-links" {{ block.shopify_attributes }}>
  <nav aria-labelledby="tp-footer-assortment-{{ block.id }}">
    <h2 id="tp-footer-assortment-{{ block.id }}" class="tp-footer-links__heading">Sortiment</h2>
    <ul role="list">
      {%- if tp_fl_sortiment != blank and tp_fl_sortiment.links.size > 0 -%}
        {%- for link in tp_fl_sortiment.links -%}
          {%- capture tp_mls -%}{%- render 'tp-menu-link-sichtbar', link: link -%}{%- endcapture -%}
          {%- if tp_mls contains 'nein' -%}{%- continue -%}{%- endif -%}
          {%- if link.url contains '/collections/' -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- if link.url == tp_fl_sonderposten.url -%}
              {%- assign tp_fl_sonderposten_verlinkt = true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <li><a href="{{ collections['teppichboden'].url }}">Teppichboden</a></li>
        <li><a href="{{ collections['vinylboden-1'].url }}">Vinylboden</a></li>
        <li><a href="{{ collections['linoleumboden-1'].url }}">Linoleum</a></li>
      {%- endif -%}
      {%- if tp_fl_sonderposten.products_count > 0 and tp_fl_sonderposten_verlinkt == false -%}
        <li><a href="{{ tp_fl_sonderposten.url }}">{{ tp_fl_sonderposten.title | escape }}</a></li>
      {%- endif -%}
    </ul>
  </nav>

  <nav aria-labelledby="tp-footer-service-{{ block.id }}">
    <h2 id="tp-footer-service-{{ block.id }}" class="tp-footer-links__heading">Service</h2>
    <ul role="list">
      {%- if tp_fl_service != blank and tp_fl_service.links.size > 0 -%}
        {%- for link in tp_fl_service.links -%}
          <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="/pages/muster">Kostenlose Muster</a></li>
        <li><a href="/pages/liefer-verlegeservice">Verlegeservice</a></li>
        {%- if tp_footer_shipping_page != blank -%}
          <li><a href="{{ tp_footer_shipping_page.url }}">Versand &amp; Lieferung</a></li>
        {%- endif -%}
        <li><a href="/pages/ratgeber">Ratgeber</a></li>
        <li><a href="/pages/kontakt">Kontakt</a></li>
      {%- endif -%}
      {%- if tp_fl_gutschein.id != blank and tp_fl_gutschein.gift_card? and tp_fl_gutschein.available -%}
        <li><a href="{{ tp_fl_gutschein.url }}">Geschenkgutschein</a></li>
      {%- endif -%}
    </ul>
  </nav>

  <div class="tp-footer-links__laden" aria-labelledby="tp-footer-shop-{{ block.id }}" role="group">
    <h2 id="tp-footer-shop-{{ block.id }}" class="tp-footer-links__heading">Fachgeschäft</h2>
    {%- if block.settings.adresse != blank -%}
      <p>{{ block.settings.adresse | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if block.settings.zeiten != blank -%}
      <p>{{ block.settings.zeiten | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if block.settings.telefon != blank -%}
      <p><a href="tel:{{ block.settings.telefon | remove: ' ' | remove: '/' }}">{{ block.settings.telefon | escape }}</a></p>
    {%- endif -%}
    {%- comment -%} Profile aus den Theme-Einstellungen (TP Firmendaten), dieselbe Quelle wie sameAs im Schema {%- endcomment -%}
    {%- if settings.tp_instagram_url != blank or settings.tp_facebook_url != blank -%}
      <p class="tp-footer-links__profile">
        {%- if settings.tp_instagram_url != blank -%}
          <a href="{{ settings.tp_instagram_url | escape }}" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if settings.tp_instagram_url != blank and settings.tp_facebook_url != blank %} · {% endif -%}
        {%- if settings.tp_facebook_url != blank -%}
          <a href="{{ settings.tp_facebook_url | escape }}" target="_blank" rel="noopener">Facebook</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  <nav aria-labelledby="tp-footer-legal-{{ block.id }}">
    <h2 id="tp-footer-legal-{{ block.id }}" class="tp-footer-links__heading">Rechtliches</h2>
    <ul role="list">
      {%- if tp_fl_recht != blank and tp_fl_recht.links.size > 0 -%}
        {%- for link in tp_fl_recht.links -%}
          <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="/policies/legal-notice">Impressum</a></li>
        <li><a href="/policies/privacy-policy">Datenschutz</a></li>
        <li><a href="/policies/terms-of-service">AGB</a></li>
        <li><a href="/policies/refund-policy">Widerrufsrecht</a></li>
      {%- endif -%}
      {%- comment -%}
        Cookie-Einstellungen stehen fest im Block, nicht im Menue: menuUpdate
        ersetzt den ganzen Baum und koennte den Link sonst still entfernen.
        Die Einwilligung muss so leicht widerrufbar sein wie sie erteilt wurde.
      {%- endcomment -%}
      <li><a href="#cookie-einstellungen" data-tp-cookie-einstellungen>Cookie-Einstellungen</a></li>
      {%- comment -%}
        Widerrufsfunktion nach § 356a BGB: muss staendig erreichbar und
        hervorgehoben sein, deshalb fest im Block (wie Cookie-Einstellungen)
        und als Schaltflaeche abgesetzt. Ziel: sections/tp-widerruf.liquid.
      {%- endcomment -%}
      <li class="tp-footer-links__widerruf-zeile"><a class="tp-footer-links__widerruf" href="/pages/vertrag-widerrufen">Vertrag widerrufen</a></li>
    </ul>
  </nav>
</div>
{%- comment -%}
  Preisangabe nach PAngV einmal je Seite im Footer: Kategorie- und
  Suchseiten zeigen Preise auf Karten, dort steht der Hinweis bewusst nicht
  pro Karte (show_tax_info false). Produktseiten tragen ihn zusaetzlich am
  Kaufbereich.
{%- endcomment -%}
<div class="tp-footer-links__preisangabe">
  {%- render 'tp-preisangabe' -%}
</div>

{% javascript %}
  /* Cookie-Einstellungen: oeffnet den Einstellungsdialog des Shopify-Banners.
     Greift fuer jeden Link auf #cookie-einstellungen, also auch fuer Links im
     Text der Datenschutzerklaerung (/policies/* rendert im Theme-Layout), und
     beim Aufruf einer Seite mit diesem Anker. Das Banner-Skript kann spaeter
     laden als dieser Code, deshalb mehrere Versuche. */
  (function () {
    var ANKER = '#cookie-einstellungen';
    function oeffnen(versuche) {
      var banner = window.privacyBanner;
      if (banner && typeof banner.showPreferences === 'function') {
        banner.showPreferences();
        return;
      }
      if (versuche > 0) setTimeout(function () { oeffnen(versuche - 1); }, 250);
    }
    document.addEventListener('click', function (event) {
      var link = event.target.closest && event.target.closest('a[href$="' + ANKER + '"]');
      if (!link) return;
      event.preventDefault();
      oeffnen(20);
    });
    if (window.location.hash === ANKER) oeffnen(20);
  })();
{% endjavascript %}

{% stylesheet %}
  .tp-footer-links__preisangabe {
    margin-top: 16px;
  }

  .tp-footer-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    width: 100%;
  }

  /* B4: vier Spalten brauchen die volle Footer-Breite; Newsletter und
     Zahlarten ruecken in die Zeile darunter. */
  .footer-content > .tp-footer-links {
    grid-column: 1 / -1;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .tp-footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tp-footer-links__heading {
    margin: 0 0 10px;
    font: inherit;
    font-weight: var(--font-heading--weight);
  }

  .tp-footer-links ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Trefferflaeche: die Links waren 20 px hoch, weniger als das Mindestmass
     von 24 px und weit unter den 44 px, die der Rest des Shops einhaelt -
     ausgerechnet bei Impressum, Datenschutz und AGB, die jemand antippt, wenn
     er unsicher ist (gemessen 2026-09-16, alle Seiten, Handy und Desktop).
     Die Hoehe kommt aus min-height, nicht aus Abstand: der Zeilenabstand der
     Liste bleibt optisch gleich, weil der Listen-gap darunter kleiner wird. */
  .tp-footer-links__laden p { margin: 0 0 8px; line-height: 1.5; }

  .tp-footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: inherit;
    text-decoration: none;
  }

  .tp-footer-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Widerrufsfunktion (§ 356a BGB): hervorgehoben statt einer von vielen Links */
  .tp-footer-links__widerruf-zeile { margin-top: 8px; }

  .tp-footer-links a.tp-footer-links__widerruf {
    min-height: 40px;
    padding: 0 16px;
    font-weight: 600;
    color: var(--tp-red, #b0303f);
    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .tp-footer-links a.tp-footer-links__widerruf:hover {
    text-decoration: none;
    color: #fff;
    background: var(--tp-red, #b0303f);
    border-color: var(--tp-red, #b0303f);
  }

  @media screen and (max-width: 749px) {
    .tp-footer-links a.tp-footer-links__widerruf { min-height: 44px; }
  }

  @media screen and (max-width: 749px) {
    .tp-footer-links {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .tp-footer-links a {
      min-height: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Footer-Links",
  "tag": null,
  "settings": [
    { "type": "link_list", "id": "sortiment_menu", "label": "Sortiment (nur Kollektions-Links)", "default": "main-menu" },
    { "type": "link_list", "id": "service_menu", "label": "Service", "info": "Leer: Muster, Verlegeservice, Versand, Ratgeber, Kontakt" },
    { "type": "textarea", "id": "adresse", "label": "Fachgeschaeft Adresse", "default": "Teppich Paradies Oranienburg GmbH\nSaarlandstraße 73–81\n16515 Oranienburg" },
    { "type": "text", "id": "zeiten", "label": "Oeffnungszeiten", "default": "Mo–Fr 8:30–18:00, Sa 8:30–14:30 Uhr" },
    { "type": "text", "id": "telefon", "label": "Telefon", "default": "03301 573 37 20" },
    { "type": "link_list", "id": "rechtliches_menu", "label": "Rechtliches", "default": "footer" }
  ],
  "presets": [
    {
      "name": "TP Footer-Links"
    }
  ]
}
{% endschema %}
