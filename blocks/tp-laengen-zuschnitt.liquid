{% doc %}
  Laengen-Zuschnitt fuer Profile nach Mass (Treppenkanten) und Laeufer nach
  Mass. Der Kunde gibt die Laenge je Stueck in cm, die Stueckzahl und die
  Bohrung bzw. Einfassung an; abgerechnet wird wie beim Kettelservice:
  Variantenpreis je 0,01 laufendem Meter (1 cm), Menge = Laenge je Stueck x
  Stueckzahl in cm. Rechenkern und Bedienung: assets/tp-laengen-zuschnitt.js.

  Laeufer (Einstellung modus = laeufer, domains/shopify/laeufer-nach-mass.md):
  statt service.bohrung gibt es die Einfassung der beiden Schnittkanten - die
  Varianten des Einfass-Produkts (Option 1 Breite wie die Option "Breite" des
  Laeufers, Option 2 Ausfuehrung; Bandfarben je Ausfuehrung im JSON-Metafeld
  service.bandfarben des Einfass-Produkts) - und je Laeufer die Pauschale.
  Fehlt eines der beiden Produkte oder ist es nicht kaufbar, rendert der Block
  nichts.

  Fail closed - der Block rendert nichts, sobald eine Angabe fehlt:
    custom.preis_pro_001_lfm  true (Variantenpreis gilt je 0,01 lfm)
    service.max_laenge_cm     > 0, groesste Laenge je Stueck
    service.bohrung           Liste der lieferbaren Ausfuehrungen, z. B.
                              ["gebohrt", "ungebohrt"]; der erste Wert ist
                              vorgewaehlt, ein einzelner Wert wird nur genannt
  Optional service.min_seite_cm (Zahl): kleinste Laenge je Stueck, sonst 10 cm.
  Angeboten werden nur Varianten mit Preis > 0.

  Profile: Schrauben (Einstellung schrauben_produkt, Preis je Schraube, Option 1
  = Ausfuehrung wie "vernickelt"). Jede Profil-Variante nennt im Metafeld
  service.schraube die passende Ausfuehrung; fehlt sie oder gibt es die
  Variante nicht, wird keine Schraube angeboten. Nur bei "gebohrt" und nur auf
  ausdruecklichen Wunsch (Kaestchen nicht vorbelegt). Stueckzahl je Profil aus
  dem Bohrbild des Lieferanten: Randabstand und Lochabstand (Einstellungen),
  siehe TPLaengenZuschnitt.lochzahl.

  Die Warenkorbzeile traegt "Laenge je Stueck", "Anzahl", "Gesamtlaenge",
  "Bohrung" und eine eigene _Gruppe (Menge gesperrt, siehe
  snippets/tp-cart-gruppe.liquid). Eine Zeile dieses Produkts ohne
  "Laenge je Stueck" sperrt den Checkout.
{% enddoc %}

{%- liquid
  assign tp_lz_id = block.id | replace: '_', '' | downcase
  assign tp_lz_max = product.metafields.service.max_laenge_cm.value | times: 1
  assign tp_lz_min = product.metafields.service.min_seite_cm.value | default: 10 | times: 1 | at_least: 1
  assign tp_lz_bohrungen = product.metafields.service.bohrung.value
  assign tp_lz_max_stueck = block.settings.max_stueck | default: 50 | times: 1

  # Laeufer: Einfassung und Pauschale aus zwei Service-Produkten statt Bohrung.
  assign tp_lz_laeufer = false
  assign tp_lz_ausf_ok = false
  if block.settings.modus == 'laeufer'
    assign tp_lz_laeufer = true
    assign tp_lz_pv = block.settings.pauschale_produkt.selected_or_first_available_variant
    if block.settings.einfass_produkt != blank and tp_lz_pv.available and tp_lz_pv.price > 0
      assign tp_lz_ausf_ok = true
    endif
  elsif tp_lz_bohrungen.size > 0
    assign tp_lz_ausf_ok = true
  endif
  # Profile: Schrauben-Produkt (nur ausserhalb des Laeufer-Modus).
  assign tp_lz_schrauben = false
  if tp_lz_laeufer == false and block.settings.schrauben_produkt != blank
    for tp_lz_s in block.settings.schrauben_produkt.variants
      if tp_lz_s.available and tp_lz_s.price > 0
        assign tp_lz_schrauben = true
        break
      endif
    endfor
  endif
  # Breite des Laeufers = Wert der Option "Breite" (zum Abgleich mit der Einfassung).
  assign tp_lz_bi = -1
  for tp_lz_o in product.options_with_values
    if tp_lz_o.name == 'Breite'
      assign tp_lz_bi = forloop.index0
    endif
  endfor
  # Ohne Option "Breite" findet der Laeufer keine Einfassung - nicht rendern,
  # statt einen Knopf zu zeigen, der nie freigeht.
  if tp_lz_laeufer and tp_lz_bi < 0
    assign tp_lz_ausf_ok = false
  endif

  assign tp_lz_ok = false
  if product.metafields.custom.preis_pro_001_lfm.value == true and tp_lz_max > tp_lz_min and tp_lz_ausf_ok
    for tp_lz_v in product.variants
      if tp_lz_v.price > 0
        assign tp_lz_ok = true
        break
      endif
    endfor
  endif

  # Streichpreis nur bei aktiver Aktion - dieselbe Quelle wie ueberall (S-20).
  capture tp_lz_aktion
    render 'tp-rabatt-sichtbar', product: product
  endcapture
  assign tp_lz_aktion = tp_lz_aktion | strip
-%}

{%- if tp_lz_ok -%}
  <div class="tp-ek tp-lz" id="tp-lz-{{ tp_lz_id }}" data-tp-lz {{ block.shopify_attributes }}>
    <div class="tp-ek__schritt" data-schritt="mass">
      {% render 'tp-step-heading', number: 2, label: block.settings.titel_masse %}
      <div class="tp-ek__masse">
        <label class="tp-ek__mass">
          <span class="tp-ek__mass-label">{{ block.settings.label_laenge | escape }}</span>
          <span class="tp-ek__eingabe">
            <input type="number" inputmode="numeric" min="{{ tp_lz_min }}" max="{{ tp_lz_max }}" step="1" placeholder="100" data-laenge>
            <span>cm</span>
          </span>
        </label>
        <span class="tp-ek__mal" aria-hidden="true">×</span>
        <label class="tp-ek__mass">
          <span class="tp-ek__mass-label">Anzahl</span>
          <span class="tp-ek__eingabe">
            <input type="number" inputmode="numeric" min="1" max="{{ tp_lz_max_stueck }}" step="1" value="1" data-anzahl>
            <span>Stück</span>
          </span>
        </label>
      </div>
      <p class="tp-ek__grenzen">Zentimetergenau von {{ tp_lz_min }} bis {{ tp_lz_max }} cm je {% if tp_lz_laeufer %}Läufer{% else %}Stück{% endif %}.{% if block.settings.messhilfe != blank %} {{ block.settings.messhilfe | escape }}{% endif %}</p>
      <p class="tp-ek__fehler" role="alert" data-fehler hidden></p>
    </div>

    {%- if tp_lz_laeufer -%}
      <div class="tp-ek__schritt" data-schritt="einfassung">
        {% render 'tp-step-heading', number: 3, label: 'Einfassung der Schnittkanten' %}
        <label class="tp-ek__mass tp-lz__einfassung">
          <span class="tp-ek__mass-label">Band an beiden Enden</span>
          <select data-einfassung><option value="">Bitte wählen</option></select>
        </label>
        <label class="tp-ek__mass tp-lz__einfassung" data-bandfarbe-feld hidden>
          <span class="tp-ek__mass-label">Bandfarbe</span>
          <select data-bandfarbe></select>
        </label>
        {%- if block.settings.einfass_hinweis != blank -%}<p class="tp-ek__grenzen">{{ block.settings.einfass_hinweis | escape }}</p>{%- endif -%}
        <p class="tp-ek__grenzen" data-ohne-hinweis hidden>Ohne Einfassung bleiben die Schnittkanten offen und fransen aus – nur wählen, wenn Sie selbst einfassen.</p>
      </div>
    {%- elsif tp_lz_bohrungen.size > 1 -%}
      <div class="tp-ek__schritt" data-schritt="bohrung">
        {% render 'tp-step-heading', number: 3, label: 'Bohrung' %}
        <div class="tp-ek__formen" role="radiogroup" aria-label="Bohrung">
          {%- for tp_lz_b in tp_lz_bohrungen -%}
            <label class="tp-ek__form">
              <input type="radio" name="tp-lz-bohrung-{{ tp_lz_id }}" value="{{ tp_lz_b | escape }}"{% if forloop.first %} checked{% endif %}>
              <span class="tp-ek__form-karte">
                <svg viewBox="0 0 40 28" aria-hidden="true" focusable="false">
                  <rect x="3" y="9" width="34" height="10" rx="1.5"/>
                  {%- assign tp_lz_bk = tp_lz_b | downcase -%}
                  {%- unless tp_lz_bk contains 'ungebohrt' -%}<circle cx="10" cy="14" r="1.8"/><circle cx="20" cy="14" r="1.8"/><circle cx="30" cy="14" r="1.8"/>{%- endunless -%}
                </svg>
                <span>{{ tp_lz_b | escape }}</span>
              </span>
            </label>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <p class="tp-ek__bandfest">Bohrung: <span>{{ tp_lz_bohrungen.first | escape }}</span></p>
    {%- endif -%}

    {%- if tp_lz_schrauben -%}
      <div class="tp-lz__schrauben" data-schrauben-feld hidden>
        <label class="tp-lz__schrauben-wahl">
          <input type="checkbox" data-schrauben>
          <span>Passende Schrauben mitbestellen <span data-schrauben-text></span></span>
        </label>
        {%- if block.settings.schrauben_hinweis != blank -%}<p class="tp-ek__grenzen">{{ block.settings.schrauben_hinweis | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="tp-ek__preis" aria-live="polite" data-rechnung hidden>
      <div class="tp-ek__summe"><span>Gesamtpreis</span><span class="tp-ek__summe-werte"><s class="tp-ek__summe-alt" data-summe-alt hidden></s><strong data-summe>–</strong></span></div>
      <p class="tp-ek__rechenzeile" data-rechenzeile></p>
      <p class="tp-ek__preishinweis">{{ block.settings.preishinweis | escape }} Inkl. MwSt.; <a href="{{ pages['versand-lieferung'].url | default: '/pages/versand-lieferung' }}">Versand</a> in Deutschland ab {{ settings.tp_versand_frei_ab }} € Bestellwert kostenlos.</p>
    </div>

    {%- if block.settings.widerruf_hinweis -%}
      {% render 'tp-widerruf-massanfertigung', art: 'zuschnitt' %}
    {%- endif -%}
    <button type="button" class="tp-ek__cta" data-cta disabled>In den Warenkorb</button>
    <a href="{{ routes.cart_url }}" class="tp-ek__warenkorb" data-warenkorb hidden>Warenkorb ansehen</a>

    <script type="application/json" data-tp-lz-daten>
      {
        "min_cm": {{ tp_lz_min | json }},
        "max_cm": {{ tp_lz_max | json }},
        "max_stueck": {{ tp_lz_max_stueck | json }},
        "bohrungen": {{ tp_lz_bohrungen | json }},
        "modus": {% if tp_lz_laeufer %}"laeufer"{% else %}"profil"{% endif %},
        "produkt": {{ product.title | json }},
        "produkt_id": {{ product.id | json }},
        {%- if tp_lz_laeufer %}
        "pauschale": { "id": {{ tp_lz_pv.id | json }}, "price": {{ tp_lz_pv.price | json }} },
        "bandfarben": {{ block.settings.einfass_produkt.metafields.service.bandfarben.value | json }},
        "einfassungen": [
          {%- for tp_lz_e in block.settings.einfass_produkt.variants -%}
            {%- if tp_lz_e.available and tp_lz_e.price > 0 -%}
              { "id": {{ tp_lz_e.id | json }}, "price": {{ tp_lz_e.price | json }}, "breite": {{ tp_lz_e.option1 | json }}, "art": {{ tp_lz_e.option2 | json }} },
            {%- endif -%}
          {%- endfor -%}
          null
        ],
        {%- endif %}
        {%- if tp_lz_schrauben %}
        "schrauben": {
          "produkt": {{ block.settings.schrauben_produkt.title | json }},
          "rand_mm": {{ block.settings.schrauben_rand_mm | default: 30 | json }},
          "lochabstand_mm": {{ block.settings.schrauben_lochabstand_mm | default: 160 | json }},
          "varianten": [
            {%- for tp_lz_s in block.settings.schrauben_produkt.variants -%}
              {%- if tp_lz_s.available and tp_lz_s.price > 0 -%}
                { "id": {{ tp_lz_s.id | json }}, "price": {{ tp_lz_s.price | json }}, "art": {{ tp_lz_s.option1 | json }} },
              {%- endif -%}
            {%- endfor -%}
            null
          ]
        },
        {%- endif %}
        "selected_id": {{ product.selected_or_first_available_variant.id | json }},
        "varianten": [
          {%- for tp_lz_v in product.variants -%}
            {%- if tp_lz_v.price > 0 -%}
              {
                "id": {{ tp_lz_v.id | json }},
                "price": {{ tp_lz_v.price | json }},
                "compare_at_price": {% if tp_lz_aktion == 'ja' and tp_lz_v.compare_at_price > tp_lz_v.price %}{{ tp_lz_v.compare_at_price | json }}{% else %}null{% endif %},
                "available": {{ tp_lz_v.available | json }},
                "breite": {% if tp_lz_bi >= 0 %}{{ tp_lz_v.options[tp_lz_bi] | json }}{% else %}null{% endif %},
                "schraube": {{ tp_lz_v.metafields.service.schraube.value | json }},
                "titel": {{ tp_lz_v.title | json }}
              },
            {%- endif -%}
          {%- endfor -%}
          null
        ]
      }
    </script>
    <script src="{{ 'tp-laengen-zuschnitt.js' | asset_url }}" defer></script>
  </div>
  {{ 'tp-einfass-konfigurator.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% stylesheet %}
  .tp-lz .tp-ek__formen { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
  .tp-lz .tp-ek__form-karte svg circle { fill: currentColor; stroke: none; }
  .tp-lz .tp-ek__rechenzeile { margin: 6px 0 0; font-size: var(--tp-fs-sm); color: var(--tp-ek-muted); white-space: pre-line; }
  .tp-lz__einfassung { display: flex; flex-direction: column; gap: 6px; max-width: 420px; }
  .tp-lz__schrauben { margin: 4px 0 0; }
  .tp-lz__schrauben-wahl { display: flex; align-items: flex-start; gap: 10px; min-height: 44px; font-size: var(--tp-fs-md); cursor: pointer; }
  .tp-lz__schrauben-wahl input { width: 20px; height: 20px; margin: 2px 0 0; flex: none; accent-color: var(--tp-ink, #15171a); }
  .tp-lz__einfassung select { min-height: 44px; padding: 0 12px; border: 1px solid var(--tp-ek-border, #d8d6d2); border-radius: 8px; background: #fff; font: inherit; font-size: var(--tp-fs-base); }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Längen-Zuschnitt",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Rendert nur bei vollstaendigen Metafeldern: custom.preis_pro_001_lfm = true (Variantenpreis je 0,01 lfm), service.max_laenge_cm und service.bohrung (Liste, z. B. gebohrt, ungebohrt). Laeufer: statt service.bohrung das Einfass- und das Pauschale-Produkt."
    },
    {
      "type": "select",
      "id": "modus",
      "label": "Art",
      "options": [
        { "value": "profil", "label": "Profil (Bohrung)" },
        { "value": "laeufer", "label": "Läufer (Einfassung + Pauschale)" }
      ],
      "default": "profil"
    },
    {
      "type": "product",
      "id": "einfass_produkt",
      "label": "Läufer: Einfass-Produkt",
      "info": "Varianten: Option 1 = Breite wie am Läufer (z. B. 65 cm), Option 2 = Ausführung, Bandfarben je Ausführung im JSON-Metafeld service.bandfarben. Eine Einheit je Läufer."
    },
    {
      "type": "product",
      "id": "pauschale_produkt",
      "label": "Läufer: Pauschale je Läufer"
    },
    {
      "type": "text",
      "id": "einfass_hinweis",
      "label": "Läufer: Hinweis unter der Einfassung"
    },
    {
      "type": "product",
      "id": "schrauben_produkt",
      "label": "Profil: Schrauben-Produkt",
      "info": "Preis je Schraube, Option 1 = Ausführung (z. B. vernickelt, vermessingt). Die Profil-Variante nennt die passende Ausführung im Metafeld service.schraube."
    },
    {
      "type": "range",
      "id": "schrauben_rand_mm",
      "label": "Profil: Randabstand der Bohrung",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "mm",
      "default": 30
    },
    {
      "type": "range",
      "id": "schrauben_lochabstand_mm",
      "label": "Profil: Lochabstand höchstens",
      "info": "Der Abstand zwischen zwei Bohrungen bleibt unter diesem Wert.",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "mm",
      "default": 160
    },
    {
      "type": "text",
      "id": "schrauben_hinweis",
      "label": "Profil: Hinweis unter den Schrauben",
      "default": "Für Holzstufen. Auf Beton oder Stein zusätzlich Dübel verwenden."
    },
    {
      "type": "text",
      "id": "titel_masse",
      "label": "Überschrift der Maßeingabe",
      "default": "Länge und Stückzahl"
    },
    {
      "type": "text",
      "id": "label_laenge",
      "label": "Bezeichnung des Längenfelds",
      "default": "Länge je Stück"
    },
    {
      "type": "range",
      "id": "max_stueck",
      "label": "Höchste Stückzahl je Bestellung",
      "min": 5,
      "max": 99,
      "step": 1,
      "default": 50
    },
    {
      "type": "text",
      "id": "messhilfe",
      "label": "Messhilfe unter den Eingabefeldern",
      "default": "Gemessen wird die Länge der Stufenkante."
    },
    {
      "type": "text",
      "id": "preishinweis",
      "label": "Hinweis unter dem Preis",
      "default": "Zuschnitt und Bohrung nach Ihrem Maß ohne Aufpreis."
    },
    {
      "type": "checkbox",
      "id": "widerruf_hinweis",
      "label": "Hinweis \"kein Widerrufsrecht\" über dem Warenkorb-Knopf",
      "info": "Wie beim Einfass-Konfigurator standardmaessig aus (Inhaber 2026-10-02).",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "TP Längen-Zuschnitt"
    }
  ]
}
{% endschema %}
