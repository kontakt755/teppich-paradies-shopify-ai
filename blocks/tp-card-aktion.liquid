{% doc %}
  Aktionshinweis auf der Produktkarte (Kollektion). Zeigt "−15 % Aktion bis TT.MM."
  nur, wenn fuer das Produkt eine zentral gesteuerte Aktion laeuft
  (snippets/tp-aktion-laufend, Metaobjekt tp_aktion) - sonst rendert der Block nichts.

  Inhaberentscheidung 2026-09-22: kein Streichpreis, sondern Hinweis mit Prozent und
  Enddatum; der Rabatt wird im Warenkorb vom automatischen Shopify-Rabatt abgezogen.
  Der Kartenpreis bleibt deshalb der normale Preis.
{% enddoc %}
{%- liquid
  capture tp_ca_raw
    render 'tp-aktion-laufend', product: closest.product
  endcapture
  assign tp_ca_raw = tp_ca_raw | strip
  capture tp_ca_leiste
    render 'tp-leisten-paket', product: closest.product
  endcapture
-%}
{%- if tp_ca_raw != blank or tp_ca_leiste contains 'ja' -%}
  <div class="tp-card-aktion__gruppe" {{ block.shopify_attributes }}>
{%- endif -%}
{%- if tp_ca_raw != blank -%}
  {%- liquid
    assign tp_ca_teile = tp_ca_raw | split: '|'
    assign tp_ca_ende = tp_ca_teile[1] | date: '%d.%m.'
  -%}
  <p class="tp-card-aktion">
    <span class="tp-card-aktion__badge">−{{ tp_ca_teile[0] }} %</span>
    <span class="tp-card-aktion__text">Aktion bis {{ tp_ca_ende }}</span>
  </p>
{%- endif -%}
{%- if tp_ca_leiste contains 'ja' -%}
  <p class="tp-card-aktion">
    <span class="tp-card-aktion__badge">Sockelleiste inklusive</span>
    <span class="tp-card-aktion__text">ab 10&nbsp;m²</span>
  </p>
{%- endif -%}
{%- if tp_ca_raw != blank or tp_ca_leiste contains 'ja' -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-card-aktion__gruppe {
    display: grid;
    gap: 4px;
  }

  .tp-card-aktion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin: 0;
    font-size: var(--tp-fs-xs);
    line-height: 1.3;
  }

  .tp-card-aktion__badge {
    padding: 2px 7px;
    border-radius: 999px;
    background: #b3261e;
    color: #fff;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tp-card-aktion__text {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Karte: Aktion",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "TP Karte: Aktion"
    }
  ]
}
{% endschema %}
