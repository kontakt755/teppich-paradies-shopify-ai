{% doc %}
  Aktionshinweis auf der Produktkarte (Kollektion). Zeigt "−15 % Aktion bis TT.MM."
  nur, wenn fuer das Produkt eine zentral gesteuerte Aktion laeuft
  (snippets/tp-aktion-laufend, Metaobjekt tp_aktion) - sonst rendert der Block nichts.

  Seit 2026-11-06 zeigt der Kartenpreis den Preis nach Abzug mit Streichpreis
  (snippets/price); dieser Block nennt Prozent und Enddatum. Abgerechnet wird
  ueber den automatischen Shopify-Rabatt.

  Restrollen (Tag "sonderposten") zeigen hier ihre Restmenge aus Shopify
  (snippets/tp-rollenrest, Inhaber 2026-11-03) samt Restlaenge bei voller Breite
  und dem Link zum Kettelteppich derselben Rolle. Ohne gesicherten Bestand keine Angabe.
{% enddoc %}
{%- liquid
  capture tp_ca_raw
    render 'tp-aktion-laufend', product: closest.product
  endcapture
  assign tp_ca_raw = tp_ca_raw | strip
  capture tp_ca_leiste
    render 'tp-leisten-paket', product: closest.product
  endcapture
  assign tp_ca_rest_qm = 0
  if closest.product.tags contains 'sonderposten'
    capture tp_ca_rest
      render 'tp-rollenrest', product: closest.product
    endcapture
    assign tp_ca_rest = tp_ca_rest | strip | split: '|'
    assign tp_ca_rest_qm = tp_ca_rest[2] | times: 1
    assign tp_ca_rest_m = tp_ca_rest[0] | times: 0.01
  endif
  # Kettelteppich derselben Rolle (service.einfass_basis zeigt auf sie): auf der
  # Reste-Seite hat er keine eigene Karte (sections/main-collection), hier der Weg hin.
  assign tp_ca_kettel = nil
  if tp_ca_rest_qm > 0
    for tp_ca_p in collections['reste-sonderposten'].products
      if tp_ca_p.tags contains 'gekettelt' and tp_ca_p.available and tp_ca_p.metafields.service.einfass_basis.value.id == closest.product.id
        assign tp_ca_kettel = tp_ca_p
        break
      endif
    endfor
  endif
-%}
{%- if tp_ca_rest_qm > 0 -%}
  {%- capture tp_ca_rest_m_txt -%}{%- render 'tp-zahl-de', zahl: tp_ca_rest_m -%}{%- endcapture -%}
  <p class="tp-card-aktion tp-card-aktion--rest" {{ block.shopify_attributes }}>Noch {{ tp_ca_rest_qm }}&nbsp;m² · {{ tp_ca_rest_m_txt | strip }}&nbsp;m Restlänge</p>
  {%- if tp_ca_kettel -%}
    <a class="tp-card-aktion__kettel" href="{{ tp_ca_kettel.url }}">Auch als Teppich nach Maß, gekettelt<span class="visually-hidden">: {{ tp_ca_kettel.title | escape }}</span> →</a>
  {%- endif -%}
{%- endif -%}
{%- if tp_ca_raw != blank or tp_ca_leiste contains 'ja' -%}
  <div class="tp-card-aktion__gruppe" {{ block.shopify_attributes }}>
{%- endif -%}
{%- if tp_ca_raw != blank -%}
  {%- liquid
    assign tp_ca_teile = tp_ca_raw | split: '|'
    assign tp_ca_ende = tp_ca_teile[1] | date: '%d.%m.'
  -%}
  <p class="tp-card-aktion">
    <span class="tp-card-aktion__badge">−{{ tp_ca_teile[0] }} %</span>
    <span class="tp-card-aktion__text">Aktion bis {{ tp_ca_ende }}</span>
  </p>
{%- endif -%}
{%- if tp_ca_leiste contains 'ja' -%}
  <p class="tp-card-aktion">
    <span class="tp-card-aktion__badge">Sockelleiste inklusive</span>
    <span class="tp-card-aktion__text">ab 10&nbsp;m²</span>
  </p>
{%- endif -%}
{%- if tp_ca_raw != blank or tp_ca_leiste contains 'ja' -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-card-aktion__gruppe {
    display: grid;
    gap: 4px;
  }

  .tp-card-aktion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin: 0;
    font-size: var(--tp-fs-xs);
    line-height: 1.3;
  }

  .tp-card-aktion--rest {
    font-weight: 600;
    color: var(--tp-ink);
  }

  .tp-card-aktion__kettel {
    position: relative;
    z-index: 1;
    justify-self: start;
    font-size: var(--tp-fs-xs);
    color: var(--tp-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tp-card-aktion__badge {
    padding: 2px 7px;
    border-radius: 999px;
    background: #b3261e;
    color: #fff;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tp-card-aktion__text {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Karte: Aktion",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "TP Karte: Aktion"
    }
  ]
}
{% endschema %}
