{% doc %}
  Hinweis "Sockelleiste zum halben Preis" auf Klick- und Klebevinyl.

  Gehoert zum automatischen Shopify-Rabatt "Vinyl-Paket: Sockelleiste zum
  halben Preis" (#1452, Freigabe Inhaber 20.10.2026): je 3 Pakete Klick- oder
  Klebevinyl 2 Stangen Faventa oder Nerissa mit -50 %. Der Rabatt selbst
  laeuft in Shopify, dieser Block erklaert ihn nur. Ob er gilt, entscheidet
  snippets/tp-leisten-paket (ein Schalter fuer Seite, Karte, Warenkorb).
{% enddoc %}

{%- liquid
  capture lph_gilt
    render 'tp-leisten-paket', product: product
  endcapture
  assign lph_leiste = all_products['faventa-sockelleiste']
-%}

{%- if block.settings.aktiv and lph_gilt contains 'ja' -%}
  <div class="tp-lph" {{ block.shopify_attributes }}>
    <p class="tp-lph__titel"><span class="tp-lph__badge">−50&nbsp;%</span> Sockelleiste zum halben Preis</p>
    <p class="tp-lph__text">
      Je 3 Pakete erhalten Sie 2 Stangen Faventa oder Nerissa (je 2,4&nbsp;m) zum halben Preis. Legen Sie die Leisten zusätzlich in den Warenkorb; der Rabatt wird automatisch abgezogen.
    </p>
    <details>
      <summary>Aktionsbedingungen</summary>
      <p class="tp-lph__text">Höchstens 60 rabattierte Stangen pro Bestellung. Nicht mit anderen Produkt- oder Bestellrabatten kombinierbar.</p>
    </details>
    {%- if lph_leiste -%}
      <a class="tp-lph__link" href="{{ lph_leiste.url }}">Passende Sockelleiste wählen</a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .tp-lph {
    margin-top: 12px;
    padding: 14px 16px;
    border: 2px solid #8d714c;
    border-radius: 8px;
    background: rgb(141 113 76 / 0.12);
    font-size: var(--tp-fs-sm);
    line-height: 1.5;
  }

  .tp-lph__titel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    color: var(--color-foreground, #222);
    font-size: var(--tp-fs-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .tp-lph__badge {
    padding: 3px 10px;
    border-radius: 999px;
    background: #b3261e;
    color: #fff;
    font-size: var(--tp-fs-md);
    font-variant-numeric: tabular-nums;
  }

  .tp-lph__text {
    margin: 6px 0 0;
    color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.85);
  }

  .tp-lph__link {
    display: inline-block;
    margin-top: 6px;
    color: var(--tp-ink, inherit);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .tp-lph__link::after {
    content: '\00a0\2192';
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP Leisten-Paketvorteil",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "aktiv",
      "label": "Hinweis zeigen",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Erscheint nur bei Klickvinyl und Klebevinyl. Muss zum automatischen Rabatt in Shopify passen."
    }
  ],
  "presets": [
    {
      "name": "TP Leisten-Paketvorteil"
    }
  ]
}
{% endschema %}
