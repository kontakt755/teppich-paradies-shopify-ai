{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__tabs_close_mcp",
      "mcp__claude-in-chrome__switch_browser",
      "mcp__claude-in-chrome__select_browser",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__computer",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__computer",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__browser_batch",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__tabs_create",
      "mcp__Claude_Browser__tabs_close",
      "Read",
      "Edit",
      "Write",
      "Bash(npm run:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qE 'workflow:(preview|live)|theme (push|publish)' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Shopify-Deploy-Befehl erkannt: vor dem Ausfuehren .ai/DEPLOYMENT-TROUBLESHOOTING.md lesen, falls in dieser Session noch nicht geschehen - dort stehen bereits geloeste Fehler mit funktionierendem Fix.\"}}' || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qE 'workflow:(preview|live)|theme (push|publish)' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUseFailure\",\"additionalContext\":\"Dieser Shopify-Deploy-Befehl ist fehlgeschlagen. Zuerst .ai/DEPLOYMENT-TROUBLESHOOTING.md pruefen, ob der Fehler dort schon dokumentiert ist. Falls nicht: nach dem Beheben dort als neuen Eintrag ergaenzen (Fehlercode, Ursache, funktionierender Fix) - Format wie die bestehenden Eintraege.\"}}' || true"
          }
        ]
      }
    ]
  }
}
