{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dashboard"
      ],
      "port": 8001,
      "autoPort": true
    },
    {
      "name": "dashboard-static",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dashboard:serve"
      ],
      "port": 8002,
      "autoPort": true
    }
  ]
}
