    "tbk_faq": {
      "type": "tp-teppichboden-faq",
      "blocks": {
        "menge": {
          "type": "frage",
          "settings": {
            "question": "Wie bestelle ich die richtige Menge?",
            "answer": "<p>Auf der Produktseite wählen Sie die Rollenbreite und geben die gewünschte Länge ein. Preis pro Quadratmeter und Gesamtpreis sehen Sie vor dem Warenkorb.</p>"
          }
        },
        "muster": {
          "type": "frage",
          "settings": {
            "question": "Kann ich die Farbe vorher zu Hause prüfen?",
            "answer": "<p>Ja. Bis zu drei Muster sind kostenlos. Wählen Sie Ihre Wunschfarbe am Produkt oder auf der <a href=\"/pages/muster\">Musterseite</a>.</p>"
          }
        },
        "versand": {
          "type": "frage",
          "settings": {
            "question": "Wie wird Teppichboden geliefert?",
            "answer": "<p>Wir liefern deutschlandweit. Rollenware kommt per Spedition frei Bordsteinkante. Die Versandkosten sehen Sie vor dem Kauf; in Deutschland liefern wir ab 50 € Bestellwert versandkostenfrei. <a href=\"/pages/versand-lieferung\">Mehr zu Versand und Lieferung</a>.</p>"
          }
        },
        "verlegung": {
          "type": "frage",
          "settings": {
            "question": "Kann ich den Teppichboden auch verlegen lassen?",
            "answer": "<p>Rund um Oranienburg bieten wir Aufmaß und Verlegung an. <a href=\"/pages/teppichboden-verlegen-lassen\">Verlegeservice ansehen</a>.</p>"
          }
        },
        "raum": {
          "type": "frage",
          "settings": {
            "question": "Welcher Teppichboden passt in welchen Raum?",
            "answer": "<p>Velours ist dicht geschoren und fühlt sich weich an, Schlinge ist strapazierfähig und eignet sich für Flure und viel genutzte Räume. Ob ein Boden zu Ihrem Raum passt, steht am Produkt (Zimmer, Nutzungsklasse, Florhöhe); in der Liste filtern Sie danach. Zu den Unterkategorien: <a href=\"/collections/teppichboden-velours\">Velours</a>, <a href=\"/collections/teppichboden-schlinge\">Schlinge</a>, <a href=\"/collections/teppichboden-wolle\">Wolle</a>.</p>"
          }
        },
        "fliesen": {
          "type": "frage",
          "settings": {
            "question": "Kann ich Teppichboden auf Fliesen verlegen?",
            "answer": "<p>Oft ja – lose mit Verlegeband, fixiert oder vollflächig verklebt. Entscheidend sind der Untergrund und der Teppichrücken. Die Schritte stehen im Ratgeber <a href=\"/blogs/ratgeber-teppichboden/teppichboden-auf-fliesen\">Teppichboden auf Fliesen verlegen</a>; die Menge ermitteln Sie mit <a href=\"/blogs/ratgeber-teppichboden/teppichboden-richtig-ausmessen\">Teppichboden richtig ausmessen</a>.</p>"
          }
        },
        "wellen": {
          "type": "frage",
          "settings": {
            "question": "Mein Teppichboden wirft Wellen – was tun?",
            "answer": "<p>Meist hat sich der Belag durch Temperatur oder Feuchte bewegt und ist nicht fest genug befestigt. Ursachen und Abhilfe stehen im Ratgeber <a href=\"/blogs/ratgeber-teppichboden/teppichboden-wirft-wellen\">Teppichboden wirft Wellen</a>. Neu verlegen oder nachspannen lassen können Sie über unseren <a href=\"/pages/teppichboden-verlegen-lassen\">Verlegeservice</a>.</p>"
          }
        }
      },
      "block_order": [
        "menge",
        "muster",
        "versand",
        "verlegung",
        "raum",
        "fliesen",
        "wellen"
      ],
      "settings": {}
