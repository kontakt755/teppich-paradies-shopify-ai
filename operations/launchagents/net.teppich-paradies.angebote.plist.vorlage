<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.teppich-paradies.angebote</string>

  <!-- Angebote-Abgleich (docs/weiterentwicklung/angebote.md): haelt den Tag
       "angebot" deckungsgleich mit dem, was der Shop als Rabatt anzeigt. Die
       Smart-Kollektion "Angebote" und der Menuepunkt folgen dem Tag.
       Laeuft aus dem Dienst-Checkout ~/tp-dashboard (Shopify-Zugang aus dessen .env.local).
       Einrichten: Platzhalter __HOME__ ersetzen, nach ~/Library/LaunchAgents kopieren,
       launchctl load <datei>. Inhaber-Entscheidung 2026-10-08: taeglich 0:00. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/tp-dashboard" &amp;&amp; date &amp;&amp; exec npm run -s angebote:abgleich -- --schreiben</string>
  </array>

  <!-- Taeglich 0:00 Ortszeit. Kein RunAtLoad: der Lauf schreibt in den Shop. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>0</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/teppich-paradies-analyse/angebote/abgleich.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/teppich-paradies-analyse/angebote/abgleich.log</string>
</dict>
</plist>
