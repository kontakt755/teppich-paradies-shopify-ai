<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.teppich-paradies.spiegel-waechter</string>

  <!-- Waechter gegen fremde Spiegelseiten des Shops (operations/scripts/spiegel-waechter.mjs):
       taeglich 7:10, nur lesende Abrufe, ohne KI. Befund = Mitteilung auf dem Mac, To-do im
       Control Center und roter Status. Laeuft aus dem Dienst-Checkout ~/tp-dashboard.
       Einrichten: bash operations/scripts/dienste-einrichten.sh -\-spiegel-waechter -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PFAD__</string>
    <string>__HOME__/tp-dashboard/operations/scripts/spiegel-waechter.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/tp-dashboard</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TP_PRIVAT_DIR</key><string>__HOME__/teppich-paradies-analyse</string>
    <key>PATH</key><string>__NODE_DIR__:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TZ</key><string>Europe/Berlin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/teppich-paradies-spiegel-waechter.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/teppich-paradies-spiegel-waechter.log</string>
</dict>
</plist>
