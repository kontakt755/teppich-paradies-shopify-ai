<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.teppich-paradies.fehler-vorpruefung</string>

  <!-- Fehlermeldungen -> Werkbank als Mac-Dienst (operations/scripts/claude-lauf.mjs, Inhaber
       2026-10-26): ersetzt die App-Aufgabe "fehlermeldungen-werkbank". Prueft alle 15 Minuten
       ohne KI (npm run -s fehler -\- abgleich); Claude startet per claude -p nur bei neuen
       Meldungen oder - hoechstens alle zwei Stunden - fuer den Stand laufender. Ausserhalb
       Mo-Sa 7-19 Uhr endet der Lauf sofort (das Skript prueft die Zeit).
       Laeuft aus dem Dienst-Checkout ~/tp-dashboard. Einrichten:
       bash operations/scripts/dienste-einrichten.sh -\-routinen (kopiert nur), laden von Hand. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/tp-dashboard" &amp;&amp; exec node operations/scripts/claude-lauf.mjs fehlermeldungen</string>
  </array>

  <!-- Viertelstuendlich; launchd holt einen im Ruhezustand verpassten Termin einmal nach. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>

  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/teppich-paradies-analyse/routinen/fehlermeldungen/dienst.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/teppich-paradies-analyse/routinen/fehlermeldungen/dienst.log</string>
</dict>
</plist>
