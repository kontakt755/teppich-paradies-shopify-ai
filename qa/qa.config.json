{
  "baseUrl": "https://www.teppich-paradies.net",
  "browserExecutable": "auto",
  "navigationTimeoutMs": 30000,
  "overflowTolerancePx": 2,
  "viewports": {
    "Desktop": { "width": 1440, "height": 1000 },
    "Mobile": { "width": 390, "height": 844 }
  },
  "allowlist": {
    "console": [],
    "requests": []
  },
  "knownConsoleIssues": [
    {
      "id": "header-menu-overflowMenu",
      "type": "pageerror",
      "exactMessage": "Required ref \"overflowMenu\" not found in component header-menu",
      "reportLabel": "header-menu / overflowMenu"
    }
  ],
  "pages": [
    { "name": "Startseite", "path": "/", "type": "home", "minVisibleImages": 1 },
    { "name": "Vinylboden", "path": "/collections/vinylboden-1", "type": "vinylCollection", "minVisibleImages": 1 },
    { "name": "Teppichboden", "path": "/collections/teppichboden", "type": "carpetCollection", "minVisibleImages": 1 },
    { "name": "Teppichboden Hochflor", "path": "/collections/teppichboden-hochflor", "type": "carpetCollection", "minVisibleImages": 1, "forbiddenText": ["14.000 Bewertungen", "Trusted Shops", "Trusted-Shops"] },
    { "name": "Teppichboden Schlinge", "path": "/collections/teppichboden-schlinge", "type": "carpetCollection", "minVisibleImages": 1 },
    { "name": "Klickvinyl Collection", "path": "/collections/vinylboden-klickvinyl", "type": "vinylCollection", "minVisibleImages": 1 },
    { "name": "Klebevinyl Collection", "path": "/collections/vinylboden-klebevinyl", "type": "vinylCollection", "minVisibleImages": 1 },
    { "name": "Vinyl von der Rolle", "path": "/collections/vinylboden-vinyl-von-der-rolle", "type": "vinylCollection", "minVisibleImages": 1 },
    { "name": "Klickvinyl PDP", "path": "/products/marlow-eiche-nordisch-klickvinyl-7mm", "type": "packageProduct", "expect": { "pricePerSquareMeter": true, "cart": true, "sample": true, "compare": true } },
    { "name": "Klebevinyl PDP", "path": "/products/alvora-eiche-bernstein-klebevinyl-2-5mm", "type": "packageProduct", "expect": { "pricePerSquareMeter": true, "cart": true, "sample": true, "compare": true } },
    { "name": "Rollen-Vinyl PDP", "path": "/products/marano-eiche-braun-vinylboden-von-der-rolle", "type": "rollProduct", "expect": { "pricePerSquareMeter": true, "cart": true, "sample": true, "compare": true } },
    { "name": "Teppichboden PDP", "path": "/products/kalvea-teppichboden-400cm-500cm", "type": "carpetProduct", "expect": { "cart": true, "sample": true, "compare": true } },
    { "name": "Suche", "path": "/search?q=teppichboden", "type": "search" },
    { "name": "Warenkorb", "path": "/cart", "type": "cart" },
    { "name": "Versand & Lieferung", "path": "/pages/versand-lieferung", "type": "page" }
  ]
}
